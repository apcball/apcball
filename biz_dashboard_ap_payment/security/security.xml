<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ap_payment_dashboard" model="ir.module.category">
        <field name="name">Budget &amp; Payment Control</field>
        <field name="sequence">60</field>
    </record>

    <record id="group_ap_payment_dashboard_user" model="res.groups">
        <field name="name">Dashboard User</field>
        <field name="category_id" ref="module_category_ap_payment_dashboard"/>
        <field name="comment">Can open the Budget &amp; Payment Control dashboard, export it and maintain manual loan entries.</field>
    </record>

    <!-- Admins always get access -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_ap_payment_dashboard_user'))]"/>
    </record>
</odoo>
