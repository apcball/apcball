<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_bsf" model="ir.module.category">
        <field name="name">Smart Finance</field>
        <field name="description">CFO Cockpit และข้อมูลการเงินระดับบริหาร</field>
        <field name="sequence">32</field>
    </record>

    <record id="group_bsf_user" model="res.groups">
        <field name="name">CFO Cockpit / Viewer</field>
        <field name="category_id" ref="module_category_bsf"/>
        <field name="comment">เห็น dashboard และข้อมูลการเงินระดับบริหาร (อ่านอย่างเดียว)</field>
    </record>

    <record id="group_bsf_manager" model="res.groups">
        <field name="name">CFO Cockpit / Manager</field>
        <field name="category_id" ref="module_category_bsf"/>
        <field name="implied_ids" eval="[(4, ref('group_bsf_user'))]"/>
        <field name="comment">ตั้งค่า/กรอกข้อมูลการเงิน (config, forecast, risk, VO)</field>
    </record>

    <!-- multi-company: เห็นเฉพาะบริษัทที่ผู้ใช้มีสิทธิ์ -->
    <record id="rule_bsf_config_company" model="ir.rule">
        <field name="name">Smart Finance config: multi-company</field>
        <field name="model_id" ref="model_biz_smart_finance_config"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_bsf_collection_followup_company" model="ir.rule">
        <field name="name">Smart Finance collection follow-up: multi-company</field>
