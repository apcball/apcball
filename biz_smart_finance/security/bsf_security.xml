    <!-- บทสนทนา Copilot เป็นของส่วนตัว — เห็น/แก้ได้เฉพาะของตัวเอง -->
    <record id="rule_bsf_conversation_own" model="ir.rule">
        <field name="name">Smart Finance conversation: own only</field>
        <field name="model_id" ref="model_biz_smart_finance_conversation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
