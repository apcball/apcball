    <record id="view_bsf_cost_period_form" model="ir.ui.view">
        <field name="name">biz.smart.finance.cost.period.form</field>
        <field name="model">biz.smart.finance.cost.period</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="ยืนยันข้อมูล" class="oe_highlight" invisible="state != 'draft'" groups="biz_smart_finance.group_bsf_manager" />
                    <button name="action_revision" type="object" string="สร้างฉบับแก้ไข" invisible="state != 'confirmed'" groups="biz_smart_finance.group_bsf_manager" />
                    <button name="action_import" type="object" string="นำเข้า CSV/XLSX" invisible="state != 'draft'" groups="biz_smart_finance.group_bsf_manager" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="company_id" />
                            <field name="currency_id" readonly="1" string="สกุลเงินบริษัท" />
                            <field name="month" />
                            <field name="state" readonly="1" />
                            <field name="origin_id" readonly="1" />
                            <field name="confirmed_by" />
                            <field name="confirmed_at" />
                        </group>
                        <group>
                            <field name="complete" />
                            <field name="target_profit" />
                            <field name="has_budget" />
                            <field name="budget_cost" />
                            <field name="notes" />
                        </group>
                    </group>
                    <notebook>
                        <page string="รายได้และต้นทุน">
                            <p>ใส่ยอดระดับฝ่ายและส่วนกลางเพียงครั้งเดียว ไม่กรอกยอดรวมบริษัทซ้ำ ส่วนคงที่ 0% คือผันแปรทั้งหมด</p>
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="company_id" column_invisible="1" />
                                    <field name="name" />
                                    <field name="source_key" />
                                    <field name="department_id" />
                                    <field name="category" />
                                    <field name="amount" />
                                    <field name="fixed_pct" />
                                    <field name="one_off" />
                                    <field name="allocation_complete" />
                                </tree>
                            </field>
                        </page>
                        <page string="กำลังคน">
                            <field name="staffing_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="company_id" column_invisible="1" />
                                    <field name="department_id" />
                                    <field name="headcount" />
                                    <field name="fte" />
                                    <field name="complete" />
                                </tree>
                            </field>
                        </page>
                        <page string="ผลวิเคราะห์">
                            <group>
                                <field name="sales" />
                                <field name="variable" />
                                <field name="fixed" />
                                <field name="one_off" />
                                <field name="personnel" />
                                <field name="operating_profit" />
                                <field name="break_even" />
                                <field name="calculation_note" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
