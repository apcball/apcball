    <record id="view_bsf_action_form" model="ir.ui.view">
        <field name="name">biz.smart.finance.action.form</field>
        <field name="model">biz.smart.finance.action</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="ส่งอนุมัติ" invisible="state != 'draft'" groups="biz_smart_finance.group_bsf_manager" />
                    <button name="action_approve" type="object" string="อนุมัติ" invisible="state != 'review'" groups="biz_smart_finance.group_bsf_manager" />
                    <button name="action_start" type="object" string="เริ่มงาน" invisible="state != 'approved'" />
                    <button name="action_verify" type="object" string="ส่งตรวจผล" invisible="state != 'doing'" />
                    <button name="action_done" type="object" string="ปิดงาน" invisible="state != 'verify'" groups="biz_smart_finance.group_bsf_manager" />
                    <button name="action_rework" type="object" string="ส่งกลับแก้ไข" invisible="state != 'verify'" groups="biz_smart_finance.group_bsf_manager" />
                    <button name="action_reopen" type="object" string="เปิดทบทวน" invisible="state != 'done'" groups="biz_smart_finance.group_bsf_manager" />
                    <button name="action_cancel" type="object" string="ยกเลิก" invisible="state in ('done', 'cancelled')" groups="biz_smart_finance.group_bsf_manager" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,approved,doing,verify,done" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="company_id" />
                            <field name="currency_id" readonly="1" string="สกุลเงินบริษัท" />
                            <field name="category" />
                            <field name="owner_id" />
                            <field name="due_date" />
                            <field name="priority" />
                        </group>
                        <group>
                            <field name="plan_revision" />
                            <field name="approved_by" />
                            <field name="verified_by" />
                            <field name="overdue" />
                            <field name="blocked" />
                            <field name="progress" />
                        </group>
                    </group>
                    <group>
                        <field name="instructions" />
                        <field name="shared_evidence" />
                        <field name="progress_note" />
                        <field name="result_evidence" />
                    </group>
                    <notebook>
                        <page string="ฝ่ายการเงิน" groups="biz_smart_finance.group_bsf_user">
                            <group>
                                <field name="issue_id" />
                                <field name="goal_id" />
                                <field name="risk_id" />
                                <field name="followup_id" />
                                <field name="expected_saving" />
                                <field name="implementation_cost" />
                                <field name="verified_saving" />
                            </group>
                            <field name="review_ids">
                                <tree>
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="company_id" column_invisible="1" />
                                    <field name="month" />
                                    <field name="accepted_saving" />
                                    <field name="verified" />
                                    <field name="verified_by" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
