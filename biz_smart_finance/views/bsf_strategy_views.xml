                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="company_id" />
                            <field name="currency_id" readonly="1" string="สกุลเงินบริษัท" />
                            <field name="base_period_id" />
                            <field name="kind" />
