                            <field name="one_time_cost" />
                            <field name="captured_at" />
                            <field name="stale" />
                        </group>
                    </group>
                    <group>
                        <field name="assumptions" />
                    </group>
                    <notebook>
                        <page string="ลดต้นทุนคงที่">
                            <field name="effect_ids">
                                <tree editable="bottom">
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="company_id" column_invisible="1" />
                                    <field name="action_id" />
                                    <field name="source_line_id" />
                                    <field name="monthly_saving" />
                                    <field name="alternative_group" />
                                </tree>
                            </field>
                        </page>
                        <page string="เงินสด">
                            <p>กรอกส่วนต่างเทียบ Forecast ฐาน การเลื่อนเงินรับต้องหักเดือนเดิมและเพิ่มเดือนใหม่ รวมค่าใช้จ่ายเปลี่ยนแผนด้วย</p>
                            <field name="cash_complete" />
                            <field name="cash_ids">
                                <tree editable="bottom">
                                    <field name="currency_id" column_invisible="1" />
                                    <field name="company_id" column_invisible="1" />
                                    <field name="reference" />
                                    <field name="shift_key" />
                                    <field name="action_id" />
                                    <field name="month" />
                                    <field name="delta" />
                                    <field name="note" />
                                </tree>
                            </field>
                        </page>
                        <page string="ผลก่อน–หลัง">
                            <field name="result_html" widget="html" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_bsf_cost_scenario" model="ir.actions.act_window">
        <field name="name">จำลองทางเลือก</field>
        <field name="res_model">biz.smart.finance.cost.scenario</field>
        <field name="view_mode">tree,form</field>
    </record>
    <menuitem id="menu_bsf_cost_scenario" name="จำลองทางเลือก" parent="menu_bsf_strategy_root" action="action_bsf_cost_scenario" />
    <record id="action_bsf_my_actions" model="ir.actions.act_window">
        <field name="name">งานของฉัน</field>
        <field name="res_model">biz.smart.finance.action</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('owner_id', '=', uid)]</field>
    </record>
    <menuitem id="menu_bsf_my_actions_root" name="งาน CFO ของฉัน" action="action_bsf_my_actions" sequence="16" groups="biz_smart_finance.group_bsf_action_owner" />
    <record id="view_bsf_cost_config" model="ir.ui.view">
        <field name="name">CFO cost thresholds</field>
        <field name="model">biz.smart.finance.config</field>
        <field name="inherit_id" ref="view_bsf_config_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="เกณฑ์ต้นทุนและกลยุทธ์ (0 = ยังไม่ตั้ง)">
                    <field name="cost_personnel_pct" />
                    <field name="cost_ot_pct" />
                    <field name="cost_growth_gap_pp" />
                    <field name="cost_cm_drop_pp" />
                    <field name="cost_dio_days" />
                    <field name="cost_channel_margin_pct" />
                </group>
            </xpath>
        </field>
    </record>
    <record id="cron_bsf_action_overdue" model="ir.cron">
        <field name="name">CFO: ติดตาม Action เกินกำหนด</field>
        <field name="model_id" ref="model_biz_smart_finance_action" />
        <field name="state">code</field>
        <field name="code">model._cron_overdue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
    </record>
    <record id="view_bsf_cost_import_form" model="ir.ui.view">
        <field name="name">CFO cost import</field>
        <field name="model">biz.smart.finance.cost.import</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <button name="action_template_csv" type="object" string="ตัวอย่าง CSV" />
                    <button name="action_template_xlsx" type="object" string="ตัวอย่าง XLSX" />
                    <p>รหัส source_key เดิมจะอัปเดตรายการในชุดร่าง ไม่บวกซ้ำ ต้องสร้างฝ่ายก่อนนำเข้า ช่อง department ว่างคือยังไม่จัดสรร</p>
                    <group>
                        <field name="company_id" />
                        <field name="period_id" />
                        <field name="file_data" filename="file_name" />
                        <field name="file_name" invisible="1" />
                        <field name="state" invisible="1" />
                    </group>
                    <group invisible="state != 'preview'">
                        <field name="valid_count" />
                        <field name="error_count" />
                    </group>
                    <field name="line_ids" invisible="state != 'preview'">
                        <tree editable="bottom" decoration-danger="not valid">
                            <field name="valid" column_invisible="1" />
                            <field name="row_index" />
                            <field name="source_key" />
                            <field name="name" />
                            <field name="department" />
                            <field name="category" />
                            <field name="amount" />
                            <field name="fixed_pct" />
                            <field name="one_off" />
                            <field name="allocation_complete" />
                            <field name="warning" />
                        </tree>
                    </field>
                </sheet>
                <footer>
                    <button name="action_preview" type="object" string="ตรวจไฟล์" invisible="state != 'draft'" />
                    <button name="action_validate" type="object" string="ตรวจข้อมูล" invisible="state != 'preview'" />
                    <button name="action_import" type="object" string="นำเข้าชุดร่าง" class="btn-primary" invisible="state != 'preview'" />
                    <button special="cancel" string="ยกเลิก" />
                </footer>
            </form>
        </field>
    </record>
</odoo>