        <field name="name">biz.smart.finance.cost.scenario.form</field>
        <field name="model">biz.smart.finance.cost.scenario</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_capture" type="object" string="1. เก็บฐานและตั้งค่าเริ่มต้น" invisible="captured_at" groups="biz_smart_finance.group_bsf_manager" />
