<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_bsf" model="ir.ui.view">
        <field name="name">res.partner.form.bsf.strategic</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']" position="inside">
                <group string="Smart Finance" groups="biz_smart_finance.group_bsf_manager">
                    <field name="bsf_strategic_supplier"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
