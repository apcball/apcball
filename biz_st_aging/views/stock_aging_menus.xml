<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- เมนูแม่ stock.menu_warehouse_report เป็น group_stock_manager อยู่แล้ว
         ใส่ group_stock_user ตรงนี้จะได้เมนูที่มองไม่เห็น ซึ่งดูเหมือนบั๊ก -->
    <menuitem id="menu_stock_aging_screen"
              name="อายุสินค้าคงเหลือ (Stock Aging)"
              parent="stock.menu_warehouse_report"
              action="action_stock_aging_screen"
              sequence="220"
              groups="stock.group_stock_manager"/>
    <menuitem id="menu_stock_aging_wizard"
              name="พิมพ์อายุสินค้าคงเหลือ (PDF / Excel)"
              parent="stock.menu_warehouse_report"
              action="action_stock_aging_wizard"
              sequence="221"
              groups="stock.group_stock_manager"/>
    <menuitem id="menu_stock_aging_config"
              name="ตั้งค่าอายุสินค้าคงเหลือ"
              parent="stock.menu_stock_config_settings"
              action="action_stock_aging_config"
              sequence="120"
              groups="stock.group_stock_manager"/>
</odoo>
