<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="biz_st_stock_card.ScFilterBar">
        <div class="sc-filters">

            <div class="sc-filter-row">
                <div class="sc-field">
                    <label>ตั้งแต่</label>
                    <input type="date" t-att-value="props.options.date_from"
                           t-on-change="(ev) => this.onDateChange('date_from', ev)"/>
                </div>
                <div class="sc-field">
                    <label>ถึง</label>
                    <input type="date" t-att-value="props.options.date_to"
                           t-on-change="(ev) => this.onDateChange('date_to', ev)"/>
                </div>
                <div class="sc-presets">
                    <button t-foreach="presets" t-as="preset" t-key="preset.id"
                            type="button" class="sc-chip"
                            t-on-click="() => this.applyPreset(preset.id)"
                            t-esc="preset.label"/>
                </div>

                <div class="sc-field sc-menu-host" t-on-click.stop="() => {}">
                    <label>คลังสินค้า</label>
                    <button type="button" class="sc-menu-btn"
                            t-on-click.stop="() => this.state.whMenuOpen = !this.state.whMenuOpen">
                        <span t-esc="warehouseLabel"/><i class="fa fa-caret-down ms-1"/>
                    </button>
                    <div class="sc-menu" t-if="state.whMenuOpen">
                        <label class="sc-menu-all">
                            <input type="checkbox" t-att-checked="props.options.all_warehouses"
                                   t-on-change="() => this.chooseAllWarehouses()"/>
                            <span>ทุกคลัง</span>
                        </label>
                        <div class="sc-menu-sep"/>
                        <label t-foreach="props.warehouses" t-as="wh" t-key="wh.id">
                            <input type="checkbox" t-att-checked="isPicked('warehouse_ids', wh.id)"
                                   t-on-change="() => this.togglePicked('warehouse_ids', wh.id)"/>
                            <span t-esc="wh.code ? wh.code + ' — ' + wh.name : wh.name"/>
                        </label>
                        <div class="sc-menu-empty" t-if="!props.warehouses.length">ไม่มีคลังสินค้า</div>
                    </div>
                </div>

                <div class="sc-field sc-menu-host" t-if="props.companies.length > 1"
                     t-on-click.stop="() => {}">
                    <label>บริษัท</label>
                    <button type="button" class="sc-menu-btn"
                            t-on-click.stop="() => this.state.companyMenuOpen = !this.state.companyMenuOpen">
                        <span t-esc="companyLabel"/><i class="fa fa-caret-down ms-1"/>
                    </button>
                    <div class="sc-menu" t-if="state.companyMenuOpen">
                        <label t-foreach="props.companies" t-as="company" t-key="company.id">
                            <input type="checkbox" t-att-checked="isPicked('company_ids', company.id)"
                                   t-on-change="() => this.togglePicked('company_ids', company.id)"/>
                            <span t-esc="company.name"/>
                        </label>
                        <hr/>
                        <select t-att-value="props.options.company_mode"
                                t-on-change="(ev) => this.onSelectChange('company_mode', ev)">
                            <option value="consolidated">รวมทุกบริษัท</option>
                            <option value="split">แยกแถวตามบริษัท</option>
                        </select>
                    </div>
                </div>
            </div>

            <ScAxisToggle options="props.options" levels="props.levels"
                          onChange="props.onChange"/>

            <div class="sc-filter-row">
                <div class="sc-field">
                    <label>ประเภทงาน</label>
                    <select t-att-value="(props.options.picking_type_ids and props.options.picking_type_ids[0]) || 0"
                            t-on-change="(ev) => this.onPickingTypeChange(ev)">
                        <option value="0">ทุกประเภท</option>
                        <option t-foreach="props.pickingTypes" t-as="pt" t-key="pt.id"
                                t-att-value="pt.id" t-esc="pt.name"/>
                    </select>
                </div>
                <div class="sc-field">
                    <label>แสดงสินค้า</label>
                    <select t-att-value="props.options.display_product"
                            t-on-change="(ev) => this.onSelectChange('display_product', ev)">
                        <option value="movement">ที่เคลื่อนไหวหรือมียอด</option>
                        <option value="not_zero">ยอดคงเหลือไม่เป็นศูนย์</option>
                        <option value="all">ทั้งหมด</option>
                    </select>
                </div>
                <div class="sc-field">
                    <label>รายการเคลื่อนไหว</label>
                    <select t-att-value="props.options.detail_mode"
                            t-on-change="(ev) => this.onSelectChange('detail_mode', ev)">
                        <option value="none">ไม่แสดง</option>
                        <option value="unfolded">เฉพาะกลุ่มที่กาง</option>
                        <option value="all">ทั้งหมด</option>
                    </select>
                </div>
                <div class="sc-field" t-if="props.options.show_value">
                    <label>วิธีคิดมูลค่า</label>
                    <select t-att-value="props.options.value_mode"
                            t-on-change="(ev) => this.onSelectChange('value_mode', ev)">
                        <option value="imputed">ประมาณการโอนภายใน</option>
                        <option value="svl">เฉพาะที่มี SVL</option>
                    </select>
                </div>

                <div class="sc-toggles">
                    <button type="button" class="sc-chip"
                            t-att-class="props.options.include_inventory ? 'sc-chip-on' : ''"
                            t-on-click="() => this.toggle('include_inventory')">ปรับปรุงยอด</button>
                    <button type="button" class="sc-chip"
                            t-att-class="props.options.include_scrap ? 'sc-chip-on' : ''"
                            t-on-click="() => this.toggle('include_scrap')">ของเสีย</button>
                    <button type="button" class="sc-chip"
                            t-att-class="props.options.include_consignment ? 'sc-chip-on' : ''"
                            t-on-click="() => this.toggle('include_consignment')">สินค้าฝากขาย</button>
                </div>

                <div class="sc-actions">
                    <button type="button" class="btn btn-sm btn-light"
                            t-on-click="() => props.onUnfoldAll()">
                        <i class="fa fa-angle-double-down me-1"/>กางทั้งหมด
                    </button>
                    <button type="button" class="btn btn-sm btn-light"
                            t-on-click="() => props.onFoldAll()">
                        <i class="fa fa-angle-double-up me-1"/>ยุบทั้งหมด
                    </button>
                    <button type="button" class="btn btn-sm btn-light"
                            t-on-click="() => props.onPrint('pdf')">
                        <i class="fa fa-file-pdf-o me-1"/>PDF
                    </button>
                    <button type="button" class="btn btn-sm btn-light"
                            t-on-click="() => props.onPrint('xlsx')">
                        <i class="fa fa-file-excel-o me-1"/>Excel
                    </button>
                    <button type="button" class="btn btn-sm btn-primary"
                            t-att-disabled="props.loading or undefined"
                            t-on-click="() => props.onRefresh()">
                        <i class="fa fa-refresh"
                           t-att-class="props.loading ? 'fa-spin' : ''"/>
                    </button>
                </div>
            </div>
        </div>
    </t>

</templates>
