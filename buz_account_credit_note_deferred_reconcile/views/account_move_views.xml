<odoo>
    <record id="view_move_form_buz_deferred_reconcile" model="ir.ui.view">
        <field name="name">account.move.form.buz.deferred.reconcile</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="buz_show_manual_reconcile" invisible="1"/>
                <button name="action_reconcile_with_original_invoice"
                        type="object"
                        string="Reconcile with Original Invoice"
                        class="btn-secondary"
                        invisible="not buz_show_manual_reconcile"
                        groups="buz_account_credit_note_deferred_reconcile.group_buz_credit_note_reconcile_manager"/>
            </header>
            <group name="accounting_info_group" position="inside">
                <field name="reversed_entry_id"
                       string="Original Invoice"
                       invisible="move_type not in ('out_refund', 'in_refund') or not reversed_entry_id"/>
            </group>
        </field>
    </record>
</odoo>
