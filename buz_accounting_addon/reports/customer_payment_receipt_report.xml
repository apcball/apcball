<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_customer_payment_receipt" model="report.paperformat">
        <field name="name">Customer Payment Receipt Voucher A4</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field><field name="margin_bottom">10</field>
        <field name="margin_left">4</field><field name="margin_right">4</field>
        <field name="header_line" eval="False"/><field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_customer_payment_receipt" model="ir.actions.report">
        <field name="name">Customer Receipt Voucher</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">buz_accounting_addon.customer_payment_receipt</field>
        <field name="report_file">buz_accounting_addon.customer_payment_receipt</field>
        <field name="print_report_name">'Receipt Voucher - %s' % object.name</field>
        <field name="paperformat_id" ref="paperformat_customer_payment_receipt"/>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
    </record>
</odoo>