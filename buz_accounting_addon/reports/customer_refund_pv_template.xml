<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_customer_refund_pv">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <style>
                            @font-face {
                                font-family: 'Sarabun';
                                src: url('/buz_custom_quotation/static/fonts/Sarabun-Bold.ttf') format('truetype');
                            }
                            .page { font-family: 'Sarabun', sans-serif; font-size: 24px; color:#000; }
                            .table-bordered { border:1px solid black; width:100%; border-collapse: collapse; color:#000; }
                            .table-bordered th, .table-bordered td { border:1px solid black; padding:4px; color:#000; }
                            .table-header th { text-align:center; vertical-align:middle; }
                        </style>
                        <div class="row mb-2">
                            <div class="col-4">
                                <img src="/buz_accounting_addon/static/img/LOGO MOGEN.png" style="max-height:80px; max-width:200px;" alt="Logo"/>
                            </div>
                            <div class="col-4 text-center">
                                <div style="font-size:30px; font-weight:bold;">ใบสำคัญจ่ายคืนลูกค้า</div>
                                <div style="font-size:27px; font-weight:bold;">CUSTOMER REFUND PAYMENT VOUCHER</div>
                            </div>
                            <div class="col-4">
                                <div style="border:1px solid black; margin-left:auto; width:220px;">
                                    <div style="text-align:center; font-size:14px; border-top:1px solid black; border-bottom:1px solid black; background-color:#f0f0f0;">หน้า 1 / 1</div>
                                    <div style="text-align:center; font-weight:bold; border-bottom:1px solid black; padding:2px;">VOUCHER NO.</div>
                                    <div style="padding:5px;">
                                        <div><strong>No.</strong> <span t-field="o.name"/></div>
                                        <div><strong>Date.</strong> <span t-field="o.date" t-options='{"widget":"date","format":"dd/MM/yyyy"}'/></div>
                                        <div><strong>Status.</strong> <span t-field="o.workflow_state"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <table class="table-bordered" style="margin-top:10px;">
                            <thead>
                                <tr class="table-header">
                                    <th style="width:15%;">รหัสลูกค้า</th>
                                    <th style="width:30%;">ชื่อลูกค้า</th>
                                    <th style="width:20%;">เอกสาร</th>
                                    <th style="width:20%;">เลขที่เอกสาร</th>
                                    <th style="width:15%;">จำนวนเงิน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center"><span t-field="o.partner_id.display_name"/></td>
                                    <td><span t-field="o.partner_id.name"/></td>
                                    <td class="text-center">ใบลดหนี้</td>
                                    <td class="text-center"><span t-field="o.credit_note_id.name"/></td>
                                    <td class="text-end"><span t-field="o.credit_note_amount" t-options='{"widget":"float","precision":2}'/></td>
                                </tr>
                                <tr>
                                    <td colspan="4" class="text-end" style="font-weight:bold;">จำนวนเงิน</td>
                                    <td class="text-end" style="font-weight:bold;"><span t-field="o.credit_note_amount" t-options='{"widget":"float","precision":2}'/></td>
                                </tr>
                            </tbody>
                        </table>

                        <table class="table-bordered" style="margin-top:15px;">
                            <thead>
                                <tr class="table-header">
                                    <th>Credit Note</th>
                                    <th>ยอดเดิม</th>
                                    <th>ยอดคงเหลือก่อนทำรายการ</th>
                                    <th>ยอดคืนจริง</th>
                                    <th>วิธีจัดการส่วนต่าง</th>
                                    <th>ยอดส่วนต่าง</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center"><span t-field="o.credit_note_id.name"/></td>
                                    <td class="text-end"><span t-field="o.credit_note_amount" t-options='{"widget":"float","precision":2}'/></td>
                                    <td class="text-end"><span t-esc="o.residual_before_snapshot or o.amount_residual_before" t-options='{"widget":"float","precision":2}'/></td>
                                    <td class="text-end"><span t-field="o.refund_amount" t-options='{"widget":"float","precision":2}'/></td>
                                    <td class="text-center"><span t-field="o.difference_handling"/></td>
                                    <td class="text-end"><span t-field="o.difference_amount" t-options='{"widget":"float","precision":2}'/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div t-if="o.writeoff_account_id">
                            <p><strong>Write-off Account:</strong> <span t-field="o.writeoff_account_id.display_name"/> <strong>Reason:</strong> <span t-field="o.writeoff_reason"/></p>
                        </div>

                        <table class="table-bordered" style="margin-top:15px;">
                            <thead>
                                <tr class="table-header">
                                    <th>ชำระ</th>
                                    <th>Journal</th>
                                    <th>เลขที่เช็ค</th>
                                    <th>วันที่</th>
                                    <th>สั่งจ่ายในนาม</th>
                                    <th>จำนวนเงิน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="text-center">
                                        <span t-if="o.payment_type=='check'">เช็ค</span>
                                        <span t-elif="o.payment_type=='transfer'">โอนเงิน</span>
                                        <span t-else="">เงินสด</span>
                                    </td>
                                    <td><span t-field="o.destination_journal_id.name"/></td>
                                    <td class="text-center"><span t-field="o.check_number"/></td>
                                    <td class="text-center">
                                        <span t-if="o.payment_type=='check'" t-field="o.check_date" t-options='{"widget":"date","format":"dd/MM/yyyy"}'/>
                                        <span t-else="" t-field="o.date" t-options='{"widget":"date","format":"dd/MM/yyyy"}'/>
                                    </td>
                                    <td><span t-field="o.check_pay_to"/></td>
                                    <td class="text-end"><span t-field="o.refund_amount" t-options='{"widget":"float","precision":2}'/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div t-if="o.payment_ids">
                            <p><strong>Payment(s):</strong> <t t-foreach="o.payment_ids" t-as="p"><span t-field="p.name"/> (<span t-field="p.date"/>) </t></p>
                            <p t-if="o.payment_ids[0].move_id"><strong>Journal Entry:</strong> <span t-field="o.payment_ids[0].move_id.name"/></p>
                        </div>
                        <div t-else="">
                            <p><em>รายการบัญชีคาดการณ์ / Proposed Journal Entry</em></p>
                        </div>

                        <t t-set="preview_lines" t-value="o.get_preview_moves()"/>
                        <table class="table-bordered" style="margin-top:10px;">
                            <thead>
                                <tr class="table-header">
                                    <th>เลขที่บัญชี</th>
                                    <th>ชื่อบัญชี</th>
                                    <th>เลขที่เอกสาร</th>
                                    <th>วันที่</th>
                                    <th>Dr.</th>
                                    <th>Cr.</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="preview_lines" t-as="line">
                                    <td class="text-center"><span t-esc="line['code']"/></td>
                                    <td><span t-esc="line['name']"/></td>
                                    <td class="text-center"><span t-esc="line['ref']"/></td>
                                    <td class="text-center"><span t-esc="line['date']" t-options='{"widget":"date","format":"dd/MM/yyyy"}'/></td>
                                    <td class="text-end"><span t-esc="line['debit']" t-options='{"widget":"float","precision":2}'/></td>
                                    <td class="text-end"><span t-esc="line['credit']" t-options='{"widget":"float","precision":2}'/></td>
                                </tr>
                                <t t-set="total_debit" t-value="sum(l['debit'] for l in preview_lines)"/>
                                <t t-set="total_credit" t-value="sum(l['credit'] for l in preview_lines)"/>
                                <tr>
                                    <td colspan="4" class="text-end" style="font-weight:bold;">Total</td>
                                    <td class="text-end" style="font-weight:bold;"><span t-esc="total_debit" t-options='{"widget":"float","precision":2}'/></td>
                                    <td class="text-end" style="font-weight:bold;"><span t-esc="total_credit" t-options='{"widget":"float","precision":2}'/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div style="margin-top:10px;"><strong>หมายเหตุ:</strong> <span t-field="o.note"/></div>
                        <div style="margin-top:5px; font-size:12px;">Printed At: <span t-field="o.printed_at"/> By: <span t-field="o.printed_by.name"/></div>

                        <table style="width:100%; text-align:center; margin-top:40px; border:1px solid #000; border-collapse:collapse;">
                            <thead>
                                <tr>
                                    <th style="width:20%; border:1px solid #000; padding:5px;">Prepare By:</th>
                                    <th style="width:20%; border:1px solid #000; padding:5px;">Checked(1):</th>
                                    <th style="width:20%; border:1px solid #000; padding:5px;">Checked(2):</th>
                                    <th style="width:20%; border:1px solid #000; padding:5px;">Approved(1):</th>
                                    <th style="width:20%; border:1px solid #000; padding:5px;">Approved(2):</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="border:1px solid #000; padding:10px; height:80px; vertical-align:bottom;">
                                        <div><span t-field="o.create_uid.name"/></div>
                                        <div style="font-size:18px;">Date <span t-field="o.create_date" t-options='{"widget":"date","format":"dd/MM/yyyy"}'/></div>
                                    </td>
                                    <td style="border:1px solid #000; padding:10px; vertical-align:bottom;"><div style="border-bottom:1px dotted #000; width:80%; margin:0 auto 5px auto;"></div><div style="font-size:20px;">Date ........./........./.........</div></td>
                                    <td style="border:1px solid #000; padding:10px; vertical-align:bottom;"><div style="border-bottom:1px dotted #000; width:80%; margin:0 auto 5px auto;"></div><div style="font-size:20px;">Date ........./........./.........</div></td>
                                    <td style="border:1px solid #000; padding:10px; vertical-align:bottom;"><div style="border-bottom:1px dotted #000; width:80%; margin:0 auto 5px auto;"></div><div style="font-size:20px;">Date ........./........./.........</div></td>
                                    <td style="border:1px solid #000; padding:10px; vertical-align:bottom;"><div style="border-bottom:1px dotted #000; width:80%; margin:0 auto 5px auto;"></div><div style="font-size:20px;">Date ........./........./.........</div></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
