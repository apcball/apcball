<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_customer_refund_voucher" model="report.paperformat">
        <field name="name">Customer Refund Voucher A4</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">4</field>
        <field name="margin_right">4</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_buz_customer_refund_voucher" model="ir.actions.report">
        <field name="name">Customer Refund Voucher (Internal)</field>
        <field name="model">buz.customer.refund.voucher</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">buz_accounting_addon.report_buz_customer_refund_voucher</field>
        <field name="report_file">buz_accounting_addon.report_buz_customer_refund_voucher</field>
        <field name="print_report_name">'CV-%s' % (object.name)</field>
        <field name="paperformat_id" ref="paperformat_customer_refund_voucher"/>
        <field name="binding_model_id" ref="model_buz_customer_refund_voucher"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_buz_customer_refund_voucher_document">
        <t t-call="web.external_layout">
            <div class="page">
                        <style>
                            @font-face {
                                font-family: 'Sarabun';
                                src: url('/buz_custom_quotation/static/fonts/Sarabun-Bold.ttf') format('truetype');
                            }
                            .page {
                                font-family: 'Sarabun', sans-serif;
                                font-size: 24px;
                                padding: 0;
                                width: 100%;
                                margin: 0;
                                color: #000;
                            }
                            .table-bordered {
                                border: 1px solid black;
                                width: 100%;
                                border-collapse: collapse;
                                color: #000;
                            }
                            .table-bordered th, .table-bordered td {
                                border: 1px solid black;
                                padding: 4px;
                                color: #000;
                            }
                            .table-header th {
                                text-align: center;
                                vertical-align: middle;
                            }
                            .no-border-bottom {
                                border-bottom: none !important;
                            }
                        </style>

                        <!-- Header Area -->
                        <div class="row mb-2">
                            <div class="col-4">
                                <img src="/buz_accounting_addon/static/img/LOGO MOGEN.png"
                                     style="max-height: 80px; max-width: 200px;" alt="Company Logo"/>
                            </div>
                            <div class="col-4 text-center">
                                <div style="font-size: 30px; font-weight: bold;">ใบสำคัญจ่ายเงินคืนลูกค้า</div>
                                <div style="font-size: 27px; font-weight: bold;">CUSTOMER REFUND VOUCHER</div>
                            </div>
                            <div class="col-4">
                                <div style="border: 1px solid black; margin-left: auto; width: 220px;">
                                    <div style="text-align: center; font-size: 14px; border-top: 1px solid black; border-bottom: 1px solid black; background-color: #f0f0f0;">
                                        หน้า 1 / 1
                                    </div>
                                    <div style="text-align: center; font-weight: bold; border-bottom: 1px solid black; padding: 2px;">
                                        VOUCHER NO.
                                    </div>
                                    <div style="padding: 5px;">
                                        <div><strong>No.</strong> <span t-field="o.name"/></div>
                                        <div><strong>Date.</strong> <span t-field="o.date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/></div>
                                        <div t-if="o.payment_type == 'check'"><strong>Cheque No.</strong> <span t-field="o.check_number"/></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 1. Customer / Credit Note Table -->
                        <table class="table-bordered" style="margin-top: 10px;">
                            <thead>
                                <tr class="table-header">
                                    <th style="width: 15%;">รหัสลูกค้า</th>
                                    <th style="width: 30%;">ชื่อลูกค้า</th>
                                    <th style="width: 20%;">เอกสาร</th>
                                    <th style="width: 20%;">เลขที่เอกสาร</th>
                                    <th style="width: 15%;">จำนวนเงิน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Single or multi line from o.line_ids -->
                                <t t-if="o.line_ids">
                                    <tr t-foreach="o.line_ids" t-as="line" style="height: auto; vertical-align: top;">
                                        <td class="text-center" style="vertical-align: middle;">
                                            <span t-if="line.partner_id and line.partner_id.partner_code" t-field="line.partner_id.partner_code"/>
                                            <span t-elif="o.partner_id and o.partner_id.partner_code" t-field="o.partner_id.partner_code"/>
                                            <span t-else="">-</span>
                                        </td>
                                        <td style="vertical-align: middle;">
                                            <span t-field="line.partner_id.name" t-if="line.partner_id"/>
                                            <span t-field="o.partner_id.name" t-if="not line.partner_id"/>
                                        </td>
                                        <td class="text-center" style="vertical-align: middle;">
                                            <span>ใบลดหนี้ลูกค้า</span>
                                        </td>
                                        <td class="text-center" style="vertical-align: middle;">
                                            <span t-if="line.credit_note_id" t-field="line.credit_note_id.name"/>
                                            <span t-else="">-</span>
                                        </td>
                                        <td class="text-end" style="vertical-align: middle;">
                                            <span t-field="line.refund_amount" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="not o.line_ids">
                                    <tr style="height: auto; vertical-align: top;">
                                        <td class="text-center" style="vertical-align: middle;">
                                            <span t-if="o.partner_id.partner_code" t-field="o.partner_id.partner_code"/>
                                            <span t-else="">-</span>
                                        </td>
                                        <td style="vertical-align: middle;">
                                            <span t-field="o.partner_id.name"/>
                                        </td>
                                        <td class="text-center" style="vertical-align: middle;">
                                            <span>ใบลดหนี้ลูกค้า</span>
                                        </td>
                                        <td class="text-center" style="vertical-align: middle;">
                                            <span t-field="o.credit_note_id.name"/>
                                        </td>
                                        <td class="text-end" style="vertical-align: middle;">
                                            <span t-field="o.refund_amount" t-options='{"widget": "float", "precision": 2}'/>
                                        </td>
                                    </tr>
                                </t>
                                <!-- Total Row -->
                                <tr>
                                    <td colspan="4" class="text-end" style="font-weight: bold; padding-right: 10px;">
                                        จำนวนเงิน
                                    </td>
                                    <td class="text-end" style="font-weight: bold;">
                                        <span t-field="o.refund_amount" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- 2. Payment Method Table -->
                        <table class="table-bordered" style="margin-top: 15px;">
                            <thead>
                                <tr class="table-header">
                                    <th style="width: 10%;">ชำระ</th>
                                    <th style="width: 25%;">ชื่อ</th>
                                    <th style="width: 15%;">เลขที่เช็ค</th>
                                    <th style="width: 15%;">วันที่</th>
                                    <th style="width: 20%;">สั่งจ่ายในนาม</th>
                                    <th style="width: 15%;">จำนวนเงิน</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr style="vertical-align: top;">
                                    <td class="text-center">
                                        <span t-if="o.payment_type == 'check'">เช็ค</span>
                                        <span t-elif="o.payment_type == 'transfer'">โอนเงิน</span>
                                        <span t-elif="o.payment_type == 'cash'">เงินสด</span>
                                    </td>
                                    <td>
                                        <span t-if="o.destination_journal_id" t-field="o.destination_journal_id.name"/>
                                        <span t-else="">-</span>
                                    </td>
                                    <td class="text-center">
                                        <span t-if="o.payment_type == 'check'" t-field="o.check_number"/>
                                        <span t-else="">-</span>
                                    </td>
                                    <td class="text-center">
                                        <span t-if="o.payment_type == 'check' and o.check_date" t-field="o.check_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                        <span t-elif="o.date" t-field="o.date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/>
                                        <span t-else="">-</span>
                                    </td>
                                    <td>
                                        <span t-if="o.payment_type == 'check'" t-field="o.check_pay_to"/>
                                        <span t-else="">-</span>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="o.refund_amount" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </tr>
                                <!-- Total Row -->
                                <tr>
                                    <td colspan="5" class="text-end" style="font-weight: bold; padding-right: 10px;">
                                        จำนวนเงิน
                                    </td>
                                    <td class="text-end" style="font-weight: bold;">
                                        <span t-field="o.refund_amount" t-options='{"widget": "float", "precision": 2}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Note -->
                        <div style="margin-top: 10px;">
                            <strong>หมายเหตุ:</strong>
                            <span t-if="o.refund_reason" t-field="o.refund_reason"/>
                            <span t-if="o.refund_reason and o.note"> — </span>
                            <span t-if="o.note" t-field="o.note"/>
                            <span t-if="not o.refund_reason and not o.note">-</span>
                        </div>

                        <!-- Signatures -->
                        <table style="width: 100%; text-align: center; margin-top: 40px; border: 1px solid #000; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th style="width: 20%; border: 1px solid #000; padding: 5px;">Prepare By:</th>
                                    <th style="width: 20%; border: 1px solid #000; padding: 5px;">Checked(1):</th>
                                    <th style="width: 20%; border: 1px solid #000; padding: 5px;">Checked(2):</th>
                                    <th style="width: 20%; border: 1px solid #000; padding: 5px;">Approved(1):</th>
                                    <th style="width: 20%; border: 1px solid #000; padding: 5px;">Approved(2):</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td style="border: 1px solid #000; padding: 10px; vertical-align: bottom; height: 80px;">
                                        <div style="margin-bottom: 5px;">
                                            <span t-if="o.create_uid" t-field="o.create_uid.name"/>
                                            <span t-else="">_________________</span>
                                        </div>
                                        <div style="font-size: 18px;">
                                            Date <span t-if="o.create_date" t-field="o.create_date" t-options='{"widget": "date", "format": "dd/MM/yyyy"}'/><span t-else="">.../.../...</span>
                                        </div>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 10px; vertical-align: bottom;">
                                        <div style="border-bottom: 1px dotted #000; width: 80%; margin: 0 auto 5px auto;"></div>
                                        <div style="font-size: 20px;">
                                            Date ........./........./.........
                                        </div>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 10px; vertical-align: bottom;">
                                        <div style="border-bottom: 1px dotted #000; width: 80%; margin: 0 auto 5px auto;"></div>
                                        <div style="font-size: 20px;">
                                            Date ........./........./.........
                                        </div>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 10px; vertical-align: bottom;">
                                        <div style="border-bottom: 1px dotted #000; width: 80%; margin: 0 auto 5px auto;"></div>
                                        <div style="font-size: 20px;">
                                            Date ........./........./.........
                                        </div>
                                    </td>
                                    <td style="border: 1px solid #000; padding: 10px; vertical-align: bottom;">
                                        <div style="border-bottom: 1px dotted #000; width: 80%; margin: 0 auto 5px auto;"></div>
                                        <div style="font-size: 20px;">
                                            Date ........./........./.........
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Receipt &amp; Paid Box -->
                        <table style="width: 100%; border-collapse: collapse; margin-top: 5px; border: 1px solid black;">
                            <tbody>
                                <tr>
                                    <td style="width: 60%; border: 1px solid black;" rowspan="2"></td>
                                    <td style="width: 20%; border: 1px solid black; text-align: center; padding: 5px; font-weight: bold;">
                                        RECEIVED
                                    </td>
                                    <td style="width: 20%; border: 1px solid black; text-align: center; padding: 5px; font-weight: bold;">
                                        PAID
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border: 1px solid black; padding: 10px; vertical-align: bottom; height: 80px; text-align: center;">
                                        <div style="border-bottom: 1px dotted #000; width: 80%; margin: 0 auto 5px auto;"></div>
                                        <div style="font-size: 20px;">Date ........./........./.........</div>
                                    </td>
                                    <td style="border: 1px solid black; padding: 10px; vertical-align: bottom; height: 80px; text-align: center;">
                                        <div style="border-bottom: 1px dotted #000; width: 80%; margin: 0 auto 5px auto;"></div>
                                        <div style="font-size: 20px;">Date ........./........./.........</div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
    </template>

    <template id="report_buz_customer_refund_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="buz_accounting_addon.report_buz_customer_refund_voucher_document" t-lang="o.company_id.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
