<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Make amount readonly when Register from Refund PV (force_amount) -->
    <record id="view_account_payment_register_form_inherit_refund_pv" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.refund.pv</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="readonly">context.get('buz_customer_refund_pv_id')</attribute>
            </xpath>
        </field>
    </record>
</odoo>
