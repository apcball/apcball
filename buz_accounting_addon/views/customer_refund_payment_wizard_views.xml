<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_customer_refund_payment_wizard_form" model="ir.ui.view">
        <field name="name">buz.customer.refund.payment.wizard.form</field>
        <field name="model">buz.customer.refund.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Refund Payment">
                <group>
                    <field name="voucher_id" readonly="1"/>
                    <field name="company_id" readonly="1" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="payment_date" required="1"/>
                    <field name="refund_amount" readonly="1" widget="monetary"/>
                    <field name="difference_handling" readonly="1"/>
                    <field name="difference_amount" readonly="1" widget="monetary"/>
                    <field name="writeoff_account_id" readonly="1" invisible="difference_handling != 'writeoff'"/>
                    <field name="destination_journal_id" readonly="1"/>
                    <field name="payment_method_line_id" readonly="1"/>
                    <field name="payment_type" readonly="1"/>
                </group>
                <footer>
                    <button name="action_create_payment" type="object" string="Create Payment" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
