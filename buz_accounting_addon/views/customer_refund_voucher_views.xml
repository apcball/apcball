<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Action -->
    <record id="action_buz_customer_refund_voucher" model="ir.actions.act_window">
        <field name="name">Customer Refund Vouchers</field>
        <field name="res_model">buz.customer.refund.voucher</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a CV from a Posted Customer Credit Note.
            </p>
            <p>Open a Posted Credit Note (out_refund) and click "Create CV".</p>
        </field>
    </record>

    <!-- Tree -->
    <record id="view_buz_customer_refund_voucher_tree" model="ir.ui.view">
        <field name="name">buz.customer.refund.voucher.tree</field>
        <field name="model">buz.customer.refund.voucher</field>
        <field name="arch" type="xml">
            <tree string="Customer Refund Vouchers" create="false">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="credit_note_id"/>
                <field name="refund_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="payment_type"/>
                <field name="state" widget="badge" decoration-info="state=='draft'" decoration-warning="state=='confirmed'" decoration-success="state=='registered'" decoration-danger="state in ['payment_cancelled','cancel']"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Search -->
    <record id="view_buz_customer_refund_voucher_search" model="ir.ui.view">
        <field name="name">buz.customer.refund.voucher.search</field>
        <field name="model">buz.customer.refund.voucher</field>
        <field name="arch" type="xml">
            <search string="Customer Refund Vouchers">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="credit_note_id"/>
                <field name="date"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="registered" string="Registered" domain="[('state','=','registered')]"/>
                <filter name="payment_cancelled" string="Payment Cancelled" domain="[('state','=','payment_cancelled')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Form โ€” layout close to Vendor Payment Voucher (PV) -->
    <record id="view_buz_customer_refund_voucher_form" model="ir.ui.view">
        <field name="name">buz.customer.refund.voucher.form</field>
        <field name="model">buz.customer.refund.voucher</field>
        <field name="arch" type="xml">
            <form string="Customer Refund Voucher">
                <header>
                    <button name="action_print_cv" type="object" string="Print Internal CV" class="oe_highlight" invisible="state not in ['draft','confirmed','registered','payment_cancelled']"/>
                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_register_refund" type="object" string="Register Refund" class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ['draft','confirmed','payment_cancelled']" groups="account.group_account_manager"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state not in ['confirmed','cancel','payment_cancelled']" groups="account.group_account_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,registered,payment_cancelled,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_credit_note" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_text">Credit Note</span>
                                <span class="o_stat_value"><field name="credit_note_id" nolabel="1" widget="many2one"/></span>
                            </div>
                        </button>
                        <button name="action_open_payment" type="object" class="oe_stat_button" icon="fa-money" invisible="not payment_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Payment</span>
                                <span class="o_stat_value"><field name="payment_count" widget="statinfo" nolabel="1"/></span>
                            </div>
                        </button>
                    </div>
                    <field name="company_id" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" string="CV Number" class="oe_edit_only"/>
                        <h1><field name="name" required="1" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group name="header_left">
                            <field name="partner_id" string="Customer" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="credit_note_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="date" readonly="state not in ['draft','confirmed']"/>
                            <field name="billing_note" placeholder="Billing Note..." readonly="state not in ['draft','confirmed']"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        </group>
                        <group name="header_right">
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total_gross" invisible="1"/>
                            <field name="amount_total_net" invisible="1"/>
                            <field name="amount_total_net_display" invisible="1"/>
                            <field name="cn_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="cn_residual" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="refund_amount" readonly="state not in ['draft','confirmed']" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="other_income_dis" string="Other Income" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="other_income_account_id" readonly="state not in ['draft','confirmed']" options="{'no_create': True}" invisible="other_income_dis == 0"/>
                            <field name="payment_type" readonly="state not in ['draft','confirmed']"/>
                            <field name="destination_journal_id" readonly="state not in ['draft','confirmed']" required="state in ['draft','confirmed']" options="{'no_create': True}"/>
                            <field name="payment_method_line_id" readonly="state not in ['draft','confirmed']" required="state in ['draft','confirmed']" options="{'no_create': True}"/>
                            <field name="customer_account_id" readonly="1" options="{'no_create': True}"/>
                            <field name="check_pay_to" string="Pay To" readonly="state not in ['draft','confirmed']" invisible="payment_type != 'check'"/>
                            <field name="check_number" string="Cheque No." readonly="state not in ['draft','confirmed']" invisible="payment_type != 'check'"/>
                        </group>
                    </group>
                    <group string="Payment Details" invisible="payment_type != 'check'">
                        <group>
                            <field name="check_date" readonly="state not in ['draft','confirmed']"/>
                        </group>
                    </group>
                    <group col="4" colspan="4" name="payment_status_info" string="Payment Information" invisible="state == 'draft'">
                        <group name="payment_status_group" string="Payment Status" colspan="2">
                            <field name="state" readonly="1" widget="badge" decoration-info="state=='draft'" decoration-warning="state=='confirmed'" decoration-success="state=='registered'" decoration-danger="state in ['payment_cancelled','cancel']"/>
                        </group>
                        <group name="payment_amounts" string="Amounts" colspan="2" col="2">
                            <field name="refund_amount" readonly="1" string="Refund Amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="payment_id" readonly="1" string="Payment" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payment Lines" name="payment_lines">
                            <field name="line_ids" readonly="state not in ['draft','confirmed']" options="{'no_create': True}">
                                <tree string="Payment Lines" create="false" delete="false" editable="bottom">
                                    <field name="voucher_id" column_invisible="1"/>
                                    <field name="company_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="credit_note_id" readonly="1" string="Credit Note"/>
                                    <field name="cn_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" string="CN Amount"/>
                                    <field name="refund_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" sum="Total Refund"/>
                                    <field name="payment_state" readonly="1" widget="badge" decoration-success="payment_state=='paid'" decoration-warning="payment_state=='partial'" decoration-info="payment_state=='not_paid'"/>
                                </tree>
                            </field>
                            <p class="text-muted">One line auto-created from the Credit Note. Refund Amount is editable within CN Residual โ€” Partial refund is allowed. Single CN per CV in MVP.</p>
                        </page>
                        <page string="Bank Transfers" name="bank_transfers">
                            <field name="bank_transfer_ids"
                                   readonly="state not in ['draft','confirmed']"
                                   context="{
                                       'default_journal_id': destination_journal_id,
                                       'default_date': date,
                                       'default_amount': amount_total_net_display,
                                       'default_buz_customer_refund_voucher_id': id,
                                   }">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="journal_id"/>
                                    <field name="destination_journal_id"/>
                                    <field name="amount"/>
                                    <field name="ref"/>
                                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'posted'" decoration-muted="state == 'cancel'"/>
                                    <button name="action_confirm" type="object" string="Confirm" class="oe_highlight" invisible="state != 'draft'"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <group>
                                <field name="refund_reason" placeholder="Reason for refund..." required="other_income_dis > 0" readonly="state not in ['draft','confirmed']"/>
                            </group>
                            <group string="Internal Notes">
                                <field name="note" readonly="state not in ['draft','confirmed']" placeholder="Internal notes..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Menu under Receivables -->
    <menuitem id="menu_buz_customer_refund_voucher"
              name="Customer Refund Vouchers"
              parent="account.menu_finance_receivables"
              action="action_buz_customer_refund_voucher"
              sequence="15"/>

    <!-- Inherit Credit Note form to add Create CV button and CV smart button -->
    <record id="view_move_form_inherit_buz_cv" model="ir.ui.view">
        <field name="name">account.move.form.inherit.buz.cv</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_buz_cvs" type="object" class="oe_stat_button" icon="fa-money" invisible="move_type != 'out_refund' or buz_cv_count == 0">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Refund Vouchers</span>
                        <span class="o_stat_value"><field name="buz_cv_count" widget="statinfo" nolabel="1"/></span>
                    </div>
                </button>
            </xpath>
            <xpath expr="/form/header" position="inside">
                <button name="action_create_customer_refund_voucher" type="object" string="Create CV" class="oe_highlight" invisible="move_type != 'out_refund' or state != 'posted' or payment_state == 'paid' or amount_residual == 0"/>
            </xpath>
        </field>
    </record>

    <!-- Payment form inherit to show CV link -->
    <record id="view_account_payment_form_inherit_buz_cv" model="ir.ui.view">
        <field name="name">account.payment.form.inherit.buz.cv</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='ref']" position="after">
                <field name="buz_customer_refund_voucher_id" readonly="1" string="Refund Voucher" options="{'no_open': False}" invisible="not buz_customer_refund_voucher_id"/>
            </xpath>
        </field>
    </record>

    <!-- Payment list to show CV -->
    <record id="view_account_payment_tree_inherit_buz_cv" model="ir.ui.view">
        <field name="name">account.payment.tree.inherit.buz.cv</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="buz_customer_refund_voucher_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
