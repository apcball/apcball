<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_buz_customer_refund_voucher" model="ir.actions.act_window">
        <field name="name">Customer Refund Vouchers</field>
        <field name="res_model">buz.customer.refund.voucher</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'create': False}</field>
    </record>

    <record id="view_buz_customer_refund_voucher_tree" model="ir.ui.view">
        <field name="name">buz.customer.refund.voucher.tree</field>
        <field name="model">buz.customer.refund.voucher</field>
        <field name="arch" type="xml">
            <tree string="Customer Refund Vouchers" create="false">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="credit_note_id"/>
                <field name="refund_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="destination_journal_id"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirmed'"
                       decoration-success="state == 'registered'"
                       decoration-danger="state == 'cancel'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_buz_customer_refund_voucher_search" model="ir.ui.view">
        <field name="name">buz.customer.refund.voucher.search</field>
        <field name="model">buz.customer.refund.voucher</field>
        <field name="arch" type="xml">
            <search string="Customer Refund Vouchers">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="credit_note_id"/>
                <field name="state"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="registered" string="Registered" domain="[('state','=','registered')]"/>
                <filter name="cancel" string="Cancelled" domain="[('state','=','cancel')]"/>
            </search>
        </field>
    </record>

    <record id="view_buz_customer_refund_voucher_form" model="ir.ui.view">
        <field name="name">buz.customer.refund.voucher.form</field>
        <field name="model">buz.customer.refund.voucher</field>
        <field name="arch" type="xml">
            <form string="Customer Refund Voucher">
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_print_cv" type="object" string="Print CV"
                            invisible="state == 'cancel'"/>
                    <button name="action_register_refund" type="object" string="Register Payment"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ['draft', 'confirmed']"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            groups="account.group_account_manager"
                            invisible="state not in ['confirmed', 'cancel']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,registered,cancel"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_credit_note" type="object" class="oe_stat_button"
                                icon="fa-file-text-o">
                            <field name="credit_note_id" widget="statinfo" string="Credit Note"/>
                        </button>
                        <button name="action_open_payment" type="object" class="oe_stat_button"
                                icon="fa-money" invisible="not payment_id">
                            <field name="payment_count" widget="statinfo" string="Payment"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" text="Cancelled" bg_color="text-bg-danger"
                            invisible="state != 'cancel'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                    </div>
                    <group name="document_information" string="Document Information">
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="1"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="credit_note_id" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="cn_amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="cn_residual" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="refund_amount" widget="monetary" options="{'currency_field': 'currency_id'}"
                                   readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="payment_information" string="Payment Information">
                            <group>
                                <group>
                                    <field name="destination_journal_id" readonly="state != 'draft'"/>
                                    <field name="payment_method_line_id" readonly="state != 'draft'"/>
                                    <field name="partner_bank_id" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="payment_id" readonly="1"/>
                                    <field name="journal_entry_id" readonly="1"/>
                                    <field name="customer_account_id" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Payment Lines"/>
                            <group>
                                <field name="credit_note_id" readonly="1"/>
                                <field name="cn_residual" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                <field name="refund_amount" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                            </group>
                        </page>
                        <page name="adjustment" string="Adjustment / Write-off">
                            <group>
                                <field name="other_income_dis" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                <field name="adjustment_method" readonly="state != 'draft'"/>
                                <field name="other_income_account_id" readonly="state != 'draft'"
                                       invisible="other_income_dis &lt;= 0"/>
                                <field name="refund_reason" readonly="state != 'draft'"
                                       invisible="other_income_dis &lt;= 0"/>
                            </group>
                        </page>
                        <page name="notes" string="Notes">
                            <group>
                                <field name="note" placeholder="Internal notes..." readonly="state != 'draft'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>