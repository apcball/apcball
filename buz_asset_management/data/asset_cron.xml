<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_post_due_depreciation" model="ir.cron">
        <field name="name">ทรัพย์สิน: ลงบัญชีค่าเสื่อมราคาที่ครบกำหนด</field>
        <field name="model_id" ref="model_buz_asset_depreciation_line"/>
        <field name="state">code</field>
        <field name="code">model._cron_post_due_lines()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_maintenance_reminder" model="ir.cron">
        <field name="name">ทรัพย์สิน: เตือนงานบำรุงรักษาใกล้ถึงกำหนด</field>
        <field name="model_id" ref="model_buz_asset_maintenance"/>
        <field name="state">code</field>
        <field name="code">model._cron_remind_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_coverage_reminder" model="ir.cron">
        <field name="name">ทรัพย์สิน: เตือนการรับประกัน/ประกันภัยใกล้หมดอายุ</field>
        <field name="model_id" ref="model_buz_asset_coverage"/>
        <field name="state">code</field>
        <field name="code">model._cron_remind_expiring()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
