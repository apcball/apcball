<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_buz_asset" model="ir.module.category">
        <field name="name">บริหารทรัพย์สิน</field>
        <field name="sequence">45</field>
    </record>

    <record id="group_asset_user" model="res.groups">
        <field name="name">ผู้ใช้ทรัพย์สิน</field>
        <field name="category_id" ref="module_category_buz_asset"/>
    </record>
    <record id="group_asset_officer" model="res.groups">
        <field name="name">เจ้าหน้าที่ทรัพย์สิน</field>
        <field name="category_id" ref="module_category_buz_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_user'))]"/>
    </record>
    <record id="group_asset_manager" model="res.groups">
        <field name="name">ผู้จัดการทรัพย์สิน</field>
        <field name="category_id" ref="module_category_buz_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_officer'))]"/>
    </record>
    <record id="group_asset_accountant" model="res.groups">
        <field name="name">นักบัญชีทรัพย์สิน</field>
        <field name="category_id" ref="module_category_buz_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_user'))]"/>
    </record>
    <record id="group_asset_accounting_manager" model="res.groups">
        <field name="name">ผู้จัดการบัญชีทรัพย์สิน</field>
        <field name="category_id" ref="module_category_buz_asset"/>
        <field name="implied_ids" eval="[(4, ref('group_asset_accountant'))]"/>
    </record>

    <!-- Company isolation (global rules: no groups) -->
    <record id="rule_buz_asset_company" model="ir.rule">
        <field name="name">BUZ Asset: multi-company</field>
        <field name="model_id" ref="model_buz_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_category_company" model="ir.rule">
        <field name="name">BUZ Asset Category: multi-company</field>
        <field name="model_id" ref="model_buz_asset_category"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_location_company" model="ir.rule">
        <field name="name">BUZ Asset Location: multi-company</field>
        <field name="model_id" ref="model_buz_asset_location"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_depreciation_line_company" model="ir.rule">
        <field name="name">BUZ Asset Depreciation Line: multi-company</field>
        <field name="model_id" ref="model_buz_asset_depreciation_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_disposal_company" model="ir.rule">
        <field name="name">BUZ Asset Disposal: multi-company</field>
        <field name="model_id" ref="model_buz_asset_disposal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_acquisition_company" model="ir.rule">
        <field name="name">BUZ Asset Acquisition: multi-company</field>
        <field name="model_id" ref="model_buz_asset_acquisition"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_transfer_company" model="ir.rule">
        <field name="name">BUZ Asset Transfer: multi-company</field>
        <field name="model_id" ref="model_buz_asset_transfer"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_audit_company" model="ir.rule">
        <field name="name">BUZ Asset Audit: multi-company</field>
        <field name="model_id" ref="model_buz_asset_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_audit_line_company" model="ir.rule">
        <field name="name">BUZ Asset Audit Line: multi-company</field>
        <field name="model_id" ref="model_buz_asset_audit_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_maintenance_company" model="ir.rule">
        <field name="name">BUZ Asset Maintenance: multi-company</field>
        <field name="model_id" ref="model_buz_asset_maintenance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_maintenance_part_company" model="ir.rule">
        <field name="name">BUZ Asset Maintenance Part: multi-company</field>
        <field name="model_id" ref="model_buz_asset_maintenance_part"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_buz_asset_coverage_company" model="ir.rule">
        <field name="name">BUZ Asset Coverage: multi-company</field>
        <field name="model_id" ref="model_buz_asset_coverage"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
