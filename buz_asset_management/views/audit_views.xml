<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_asset_audit_tree" model="ir.ui.view">
        <field name="name">buz.asset.audit.tree</field>
        <field name="model">buz.asset.audit</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="title"/>
                <field name="date"/>
                <field name="responsible_id"/>
                <field name="line_count"/>
                <field name="completion_rate" widget="progressbar"/>
                <field name="exception_count"/>
                <field name="unresolved_count"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_buz_asset_audit_form" model="ir.ui.view">
        <field name="name">buz.asset.audit.form</field>
        <field name="model">buz.asset.audit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" string="เริ่มตรวจนับ" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="buz_asset_management.group_asset_officer"
                            confirm="ระบบจะบันทึกข้อมูลที่คาดหวังของทรัพย์สินตามขอบเขต และเปลี่ยนขอบเขตไม่ได้อีก ยืนยัน?"/>
                    <button name="action_open_scan" string="สแกน/ค้นหา" type="object" class="btn-primary"
                            invisible="state != 'in_progress'"/>
                    <button name="action_close" string="ปิดรอบตรวจนับ" type="object"
                            invisible="state != 'in_progress'" groups="buz_asset_management.group_asset_manager"/>
                    <button name="action_cancel" string="ยกเลิก" type="object"
                            invisible="state not in ('draft', 'in_progress')"
                            groups="buz_asset_management.group_asset_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_lines" type="object" class="oe_stat_button" icon="fa-list-ul"
                                invisible="state == 'draft'">
                            <field name="checked_count" widget="statinfo" string="ตรวจแล้ว"/>
                        </button>
                    </div>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="title" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="responsible_id" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="snapshot_date"/>
                            <field name="line_count"/>
                            <field name="completion_rate" widget="progressbar"/>
                            <field name="exception_count"/>
                            <field name="unresolved_count"/>
                        </group>
                    </group>
                    <group string="ขอบเขต (ไม่เลือก = ทั้งหมด)">
                        <field name="department_ids" widget="many2many_tags" readonly="state != 'draft'"
                               options="{'no_create': True}"/>
                        <field name="location_ids" widget="many2many_tags" readonly="state != 'draft'"
                               options="{'no_create': True}"/>
                        <field name="category_ids" widget="many2many_tags" readonly="state != 'draft'"
                               options="{'no_create': True}"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_buz_asset_audit" model="ir.actions.act_window">
        <field name="name">การตรวจนับทรัพย์สิน</field>
        <field name="res_model">buz.asset.audit</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Lines -->
    <record id="view_buz_asset_audit_line_tree" model="ir.ui.view">
        <field name="name">buz.asset.audit.line.tree</field>
        <field name="model">buz.asset.audit.line</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0" decoration-success="result == 'found'"
                  decoration-danger="result in ('not_found', 'damaged')"
                  decoration-warning="result in ('wrong_location', 'wrong_custodian')"
                  decoration-muted="result == 'not_checked'">
                <field name="audit_id" optional="hide"/>
                <field name="asset_code"/>
                <field name="asset_id"/>
                <field name="expected_location_id"/>
                <field name="expected_employee_id" optional="show"/>
                <field name="result" widget="badge"/>
                <field name="actual_location_id" optional="show"/>
                <field name="resolution" optional="show"/>
                <field name="scanned_by_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_buz_asset_audit_line_form" model="ir.ui.view">
        <field name="name">buz.asset.audit.line.form</field>
        <field name="model">buz.asset.audit.line</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_found" string="พบ" type="object" class="btn-success"
                            invisible="audit_state != 'in_progress'"/>
                    <button name="action_not_found" string="ไม่พบ" type="object" class="btn-danger"
                            invisible="audit_state != 'in_progress'"/>
                    <button name="action_wrong_location" string="ผิดสถานที่" type="object"
                            invisible="audit_state != 'in_progress'"/>
                    <button name="action_wrong_custodian" string="ผิดผู้ถือครอง" type="object"
                            invisible="audit_state != 'in_progress'"/>
                    <button name="action_damaged" string="ชำรุด" type="object"
                            invisible="audit_state != 'in_progress'"/>
                    <button name="action_retired" string="เลิกใช้" type="object"
                            invisible="audit_state != 'in_progress'"/>
                    <button name="action_create_transfer" string="สร้างการโอนย้าย" type="object"
                            invisible="result not in ('wrong_location', 'wrong_custodian')"
                            groups="buz_asset_management.group_asset_officer"/>
                    <field name="result" widget="statusbar" statusbar_visible="not_checked,found"/>
                </header>
                <sheet>
                    <field name="audit_state" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <h1><field name="asset_id"/></h1>
                    <group>
                        <group string="ที่คาดหวัง (ตอนเริ่มรอบ)">
                            <field name="expected_location_id"/>
                            <field name="expected_employee_id"/>
                            <field name="expected_department_id"/>
                        </group>
                        <group string="ที่พบจริง">
                            <field name="actual_location_id" options="{'no_create': True}"/>
                            <field name="actual_employee_id" options="{'no_create': True}"/>
                            <field name="scanned_by_id"/>
                            <field name="scanned_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                        <field name="photo" widget="image" options="{'size': [0, 160]}"/>
                    </group>
                    <group string="การแก้ไขรายการผิดปกติ" invisible="result in ('not_checked', 'found')">
                        <field name="resolution" groups="buz_asset_management.group_asset_officer"/>
                        <field name="resolution_note" groups="buz_asset_management.group_asset_officer"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_buz_asset_audit_line_search" model="ir.ui.view">
        <field name="name">buz.asset.audit.line.search</field>
        <field name="model">buz.asset.audit.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_id"/>
                <field name="asset_code"/>
                <field name="audit_id"/>
                <filter name="not_checked" string="ยังไม่ตรวจ" domain="[('result', '=', 'not_checked')]"/>
                <filter name="exceptions" string="ผิดปกติ"
                        domain="[('result', 'not in', ('not_checked', 'found'))]"/>
                <filter name="unresolved" string="ผิดปกติที่ยังไม่แก้ไข"
                        domain="[('result', 'not in', ('not_checked', 'found')), ('resolution', '=', False)]"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_result" string="ผลการตรวจ" context="{'group_by': 'result'}"/>
                    <filter name="group_audit" string="รอบตรวจนับ" context="{'group_by': 'audit_id'}"/>
                    <filter name="group_location" string="สถานที่ที่คาดหวัง" context="{'group_by': 'expected_location_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_buz_asset_audit_line_pivot" model="ir.ui.view">
        <field name="name">buz.asset.audit.line.pivot</field>
        <field name="model">buz.asset.audit.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="audit_id" type="row"/>
                <field name="result" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_buz_report_audit" model="ir.actions.act_window">
        <field name="name">รายงานผลการตรวจนับ</field>
        <field name="res_model">buz.asset.audit.line</field>
        <field name="view_mode">pivot,tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_buz_asset_audit_line_pivot')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_buz_asset_audit_line_tree')})]"/>
        <field name="search_view_id" ref="view_buz_asset_audit_line_search"/>
    </record>

    <record id="view_buz_asset_audit_scan_wizard_form" model="ir.ui.view">
        <field name="name">buz.asset.audit.scan.wizard.form</field>
        <field name="model">buz.asset.audit.scan.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="audit_id"/>
                    <field name="code" placeholder="ยิงบาร์โค้ด/QR หรือพิมพ์รหัส แล้วกดค้นหา" autofocus="1"/>
                </group>
                <footer>
                    <button name="action_find" string="ค้นหา" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="ยกเลิก" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- QR label -->
    <record id="paperformat_buz_asset_label" model="report.paperformat">
        <field name="name">BUZ Asset Label</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">8</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_spacing">0</field>
    </record>

    <record id="action_report_asset_label" model="ir.actions.report">
        <field name="name">ป้าย QR ทรัพย์สิน</field>
        <field name="model">buz.asset</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">buz_asset_management.report_asset_label</field>
        <field name="report_file">buz_asset_management.report_asset_label</field>
        <field name="paperformat_id" ref="paperformat_buz_asset_label"/>
        <field name="binding_model_id" ref="model_buz_asset"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('buz_asset_management.group_asset_officer'))]"/>
    </record>

    <template id="report_asset_label">
        <t t-call="web.basic_layout">
            <div class="page">
                <t t-foreach="docs" t-as="o">
                    <div style="display:inline-block; width:92mm; height:42mm; border:1px solid #444; margin:1mm; padding:2mm; vertical-align:top; page-break-inside:avoid; overflow:hidden;">
                        <table style="width:100%;">
                            <tr>
                                <td style="width:60%; vertical-align:top;">
                                    <div style="font-size:9pt;" t-out="o.company_id.name"/>
                                    <div style="font-size:15pt; font-weight:bold;" t-out="o.code"/>
                                    <div style="font-size:10pt;" t-out="(o.name or '')[:50]"/>
                                </td>
                                <td style="width:40%; text-align:right;">
                                    <img t-att-src="o._qr_image_src(120)" style="width:30mm; height:30mm;" alt="QR"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </div>
        </t>
    </template>
</odoo>
