<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_buz_asset" model="ir.ui.view">
        <field name="name">res.company.form.buz.asset</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="buz_asset_auto_post" groups="buz_asset_management.group_asset_accounting_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
