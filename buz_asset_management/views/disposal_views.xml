<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_asset_disposal_tree" model="ir.ui.view">
        <field name="name">buz.asset.disposal.tree</field>
        <field name="model">buz.asset.disposal</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="disposal_type"/>
                <field name="disposal_date"/>
                <field name="carrying_value" optional="show"/>
                <field name="gain_loss" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="view_buz_asset_disposal_form" model="ir.ui.view">
        <field name="name">buz.asset.disposal.form</field>
        <field name="model">buz.asset.disposal</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="อนุมัติ" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="buz_asset_management.group_asset_manager"/>
                    <button name="action_post" string="ลงบัญชี" type="object" class="btn-primary"
                            invisible="state != 'approved'"
                            groups="buz_asset_management.group_asset_accounting_manager"
                            confirm="ยืนยันการลงบัญชีการจำหน่ายทรัพย์สิน?"/>
                    <button name="action_cancel" string="ยกเลิก" type="object"
                            invisible="state not in ('draft', 'approved')"
                            groups="buz_asset_management.group_asset_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,posted"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'draft'"/>
                            <field name="disposal_type" readonly="state != 'draft'"/>
                            <field name="disposal_date" readonly="state != 'draft'"/>
                            <field name="sale_move_id" readonly="state != 'draft'"
                                   invisible="disposal_type != 'sale'"/>
                        </group>
                        <group>
                            <field name="company_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cost"/>
                            <field name="accumulated_depreciation"/>
                            <field name="carrying_value"/>
                            <field name="proceeds"/>
                            <field name="gain_loss"/>
                            <field name="move_id"/>
                        </group>
                    </group>
                    <group><field name="reason" readonly="state != 'draft'"/></group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_buz_asset_disposal" model="ir.actions.act_window">
        <field name="name">การจำหน่ายทรัพย์สิน</field>
        <field name="res_model">buz.asset.disposal</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
