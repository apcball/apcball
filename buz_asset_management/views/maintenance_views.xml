<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_asset_maintenance_tree" model="ir.ui.view">
        <field name="name">buz.asset.maintenance.tree</field>
        <field name="model">buz.asset.maintenance</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_overdue" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="maintenance_type"/>
                <field name="planned_date"/>
                <field name="responsible_id" optional="show"/>
                <field name="vendor_id" optional="hide"/>
                <field name="total_cost" sum="รวม" optional="show"/>
                <field name="warranty_covered" optional="hide"/>
                <field name="state" widget="badge"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_buz_asset_maintenance_form" model="ir.ui.view">
        <field name="name">buz.asset.maintenance.form</field>
        <field name="model">buz.asset.maintenance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_plan" string="วางแผน" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="buz_asset_management.group_asset_officer"/>
                    <button name="action_start" string="เริ่มดำเนินการ" type="object" class="btn-primary"
                            invisible="state not in ('draft', 'planned')"
                            groups="buz_asset_management.group_asset_officer"/>
                    <button name="action_done" string="เสร็จสิ้น" type="object" class="btn-primary"
                            invisible="state != 'in_progress'" groups="buz_asset_management.group_asset_officer"/>
                    <button name="action_cancel" string="ยกเลิก" type="object"
                            invisible="state not in ('draft', 'planned', 'in_progress')"
                            groups="buz_asset_management.group_asset_officer"/>
                    <button name="action_reset_to_draft" string="กลับเป็นร่าง" type="object"
                            invisible="state != 'cancelled'" groups="buz_asset_management.group_asset_officer"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,in_progress,done"/>
                </header>
                <sheet>
                    <field name="is_overdue" invisible="1"/>
                    <widget name="web_ribbon" title="เลยกำหนด" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="maintenance_type" readonly="state in ('done', 'cancelled')"/>
                            <field name="planned_date" readonly="state in ('done', 'cancelled')"/>
                            <field name="responsible_id" readonly="state in ('done', 'cancelled')"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="vendor_id" readonly="state in ('done', 'cancelled')" options="{'no_create': True}"/>
                            <field name="technician" readonly="state in ('done', 'cancelled')"/>
                            <field name="warranty_covered" readonly="state in ('done', 'cancelled')"/>
                            <field name="actual_start"/>
                            <field name="actual_end"/>
                            <field name="downtime_hours" readonly="state in ('done', 'cancelled')"/>
                            <field name="recurrence_months" readonly="state in ('done', 'cancelled')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="งาน" name="work">
                            <group>
                                <field name="description" readonly="state in ('done', 'cancelled')"/>
                                <field name="result" readonly="state in ('done', 'cancelled')"/>
                            </group>
                        </page>
                        <page string="ค่าใช้จ่ายและอะไหล่" name="cost">
                            <group>
                                <field name="cost" readonly="state in ('done', 'cancelled')"/>
                            </group>
                            <field name="part_ids" readonly="state in ('done', 'cancelled')">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_cost"/>
                                    <field name="subtotal" sum="รวม"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="parts_cost"/>
                                <field name="total_cost" class="oe_subtotal_footer_separator"/>
                            </group>
                            <p class="text-muted">ค่าใช้จ่ายนี้เป็นข้อมูลการดำเนินงาน ไม่เพิ่มราคาทุนของทรัพย์สินและไม่สร้างรายการบัญชี</p>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_buz_asset_maintenance_search" model="ir.ui.view">
        <field name="name">buz.asset.maintenance.search</field>
        <field name="model">buz.asset.maintenance</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="vendor_id"/>
                <filter name="open" string="ยังไม่เสร็จ" domain="[('state', 'in', ('draft', 'planned', 'in_progress'))]"/>
                <filter name="overdue" string="เลยกำหนด" domain="[('is_overdue', '=', True)]"/>
                <filter name="warranty" string="อยู่ในประกัน" domain="[('warranty_covered', '=', True)]"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_type" string="ประเภท" context="{'group_by': 'maintenance_type'}"/>
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}"/>
                    <filter name="group_asset" string="ทรัพย์สิน" context="{'group_by': 'asset_id'}"/>
                    <filter name="group_month" string="เดือนที่วางแผน" context="{'group_by': 'planned_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_buz_asset_maintenance_pivot" model="ir.ui.view">
        <field name="name">buz.asset.maintenance.pivot</field>
        <field name="model">buz.asset.maintenance</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="planned_date" interval="month" type="row"/>
                <field name="maintenance_type" type="col"/>
                <field name="total_cost" type="measure"/>
                <field name="downtime_hours" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_buz_asset_maintenance" model="ir.actions.act_window">
        <field name="name">งานบำรุงรักษา</field>
        <field name="res_model">buz.asset.maintenance</field>
        <field name="view_mode">tree,form,pivot</field>
        <field name="search_view_id" ref="view_buz_asset_maintenance_search"/>
    </record>

    <record id="action_buz_report_maintenance" model="ir.actions.act_window">
        <field name="name">รายงานค่าบำรุงรักษา</field>
        <field name="res_model">buz.asset.maintenance</field>
        <field name="view_mode">pivot,tree,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_buz_asset_maintenance_pivot')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_buz_asset_maintenance_tree')})]"/>
        <field name="search_view_id" ref="view_buz_asset_maintenance_search"/>
    </record>
</odoo>
