<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tax_form_buz_asset" model="ir.ui.view">
        <field name="name">account.tax.form.buz.asset</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='include_base_amount']" position="after">
                <field name="buz_vat_non_recoverable" invisible="type_tax_use != 'purchase'"/>
            </xpath>
        </field>
    </record>
</odoo>
