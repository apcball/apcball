<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_asset_transfer_tree" model="ir.ui.view">
        <field name="name">buz.asset.transfer.tree</field>
        <field name="model">buz.asset.transfer</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state in ('cancelled', 'rejected')">
                <field name="name"/>
                <field name="asset_id"/>
                <field name="effective_date"/>
                <field name="from_employee_id" optional="show"/>
                <field name="to_employee_id" optional="show"/>
                <field name="from_department_id" optional="hide"/>
                <field name="to_department_id" optional="hide"/>
                <field name="from_location_id" optional="show"/>
                <field name="to_location_id" optional="show"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_buz_asset_transfer_form" model="ir.ui.view">
        <field name="name">buz.asset.transfer.form</field>
        <field name="model">buz.asset.transfer</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="ส่งขออนุมัติ" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="buz_asset_management.group_asset_officer"/>
                    <button name="action_approve" string="อนุมัติ" type="object" class="btn-primary"
                            invisible="state != 'submitted'" groups="buz_asset_management.group_asset_manager"/>
                    <button name="action_reject" string="ไม่อนุมัติ" type="object"
                            invisible="state != 'submitted'" groups="buz_asset_management.group_asset_manager"/>
                    <button name="action_done" string="ดำเนินการโอนย้าย" type="object" class="btn-primary"
                            invisible="state != 'approved'" groups="buz_asset_management.group_asset_officer"
                            confirm="ยืนยันการโอนย้าย? ข้อมูลของทรัพย์สินจะถูกเปลี่ยนทันที"/>
                    <button name="action_acknowledge" string="รับทราบ" type="object"
                            invisible="state not in ('approved', 'done') or acknowledged_by_id"/>
                    <button name="action_cancel" string="ยกเลิก" type="object"
                            invisible="state not in ('draft', 'submitted', 'approved')"
                            groups="buz_asset_management.group_asset_officer"/>
                    <button name="action_reset_to_draft" string="กลับเป็นร่าง" type="object"
                            invisible="state not in ('rejected', 'cancelled')"
                            groups="buz_asset_management.group_asset_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,done"/>
                </header>
                <sheet>
                    <h1><field name="name"/></h1>
                    <group>
                        <group>
                            <field name="asset_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="effective_date" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="requestor_id"/>
                            <field name="approver_id"/>
                            <field name="completer_id"/>
                            <field name="done_date"/>
                            <field name="acknowledged_by_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="ข้อมูลเดิม (บันทึกไว้ตอนขอโอนย้าย)">
                            <field name="from_employee_id"/>
                            <field name="from_department_id"/>
                            <field name="from_location_id"/>
                        </group>
                        <group string="ข้อมูลใหม่">
                            <field name="to_employee_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="to_department_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="to_location_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group><field name="reason" readonly="state != 'draft'"/></group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_buz_asset_transfer_search" model="ir.ui.view">
        <field name="name">buz.asset.transfer.search</field>
        <field name="model">buz.asset.transfer</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="asset_id"/>
                <field name="to_employee_id"/>
                <filter name="open" string="ยังไม่เสร็จ" domain="[('state', 'in', ('draft', 'submitted', 'approved'))]"/>
                <filter name="done" string="โอนย้ายแล้ว" domain="[('state', '=', 'done')]"/>
                <group expand="0" string="จัดกลุ่มตาม">
                    <filter name="group_state" string="สถานะ" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="เดือน" context="{'group_by': 'effective_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_buz_asset_transfer" model="ir.actions.act_window">
        <field name="name">การโอนย้ายทรัพย์สิน</field>
        <field name="res_model">buz.asset.transfer</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_buz_asset_transfer_search"/>
    </record>

    <!-- Movement report -->
    <record id="view_buz_transfer_report_pivot" model="ir.ui.view">
        <field name="name">buz.asset.transfer.pivot</field>
        <field name="model">buz.asset.transfer</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="effective_date" interval="month" type="row"/>
                <field name="to_department_id" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_buz_report_movement" model="ir.actions.act_window">
        <field name="name">รายงานการโอนย้าย</field>
        <field name="res_model">buz.asset.transfer</field>
        <field name="view_mode">tree,pivot,form</field>
        <field name="domain">[('state', '=', 'done')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_buz_asset_transfer_tree')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_buz_transfer_report_pivot')})]"/>
        <field name="search_view_id" ref="view_buz_asset_transfer_search"/>
    </record>
</odoo>
