<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_cogs_export_wizard_form" model="ir.ui.view">
        <field name="name">buz.cogs.export.wizard.form</field>
        <field name="model">buz.cogs.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Actual COGS to Excel">
                <group>
                    <group>
                        <field name="period" widget="radio"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="warehouse_ids" widget="many2many_tags"/>
                        <field name="product_categ_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export Excel" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_buz_cogs_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Actual COGS (Excel)</field>
        <field name="res_model">buz.cogs.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="groups_id" eval="[(4, ref('group_buz_cogs_report_user'))]"/>
    </record>

    <menuitem id="menu_buz_cogs_export"
              name="Actual COGS - Export Excel"
              parent="stock.menu_warehouse_report"
              action="action_buz_cogs_export_wizard"
              groups="group_buz_cogs_report_user"
              sequence="96"/>
</odoo>
