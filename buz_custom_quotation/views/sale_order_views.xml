<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_buz" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.buz</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="customer_name" placeholder="Customer Name"/>
                <field name="project_name" placeholder="Project Name"/>
                <field name="quotation_no" readonly="0"/>
            </xpath>
        </field>
    </record>

    <record id="sale_order_tree_inherit_buz_quotation_no" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.buz.quotation.no</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="quotation_no" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_sales_order_filter_inherit_buz_quotation_no" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.buz.quotation.no</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="quotation_no" string="Quotation No."/>
            </field>
        </field>
    </record>
</odoo>