<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_order_form_inherit_warehouse" model="ir.ui.view">
            <field name="name">sale.order.form.inherit.warehouse</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='warehouse_id']" position="replace"/>
                <xpath expr="//field[@name='sale_order_template_id']" position="after">
                    <field name="warehouse_id" 
                           options="{'no_create': True}" 
                           groups="stock.group_stock_multi_warehouses"/>
                </xpath>
                <xpath expr="//page[@name='customer_signature']" position="after">
                    <page name="signature_approved_sale_order"
                          string="Signature Approved Sale Order"
                          groups="buz_customize_sale.group_sale_signature_approved_page">
                        <group string="Signatures Used BY Proforma Invoice">
                            <field name="approver_id"
                                   class="oe_inline"
                                   style="width: 150px;"/>
                            <field name="approval_date" widget="date"
                                    class="oe_inline" 
                                    style="width: 150px;"/>
                            <field name="approval_signature"
                                   widget="signature"
                                   options="{'size': [205, 73]}"
                                   class="oe_inline"
                                   style="width: 205px !important; height: 73px !important; min-width: 205px; min-height: 73px;"
                                   readonly="1"/>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_order_form_hide_unlock_cancel" model="ir.ui.view">
            <field name="name">sale.order.form.hide.unlock.cancel</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form/sheet" position="inside">
                    <field name="hide_unlock_cancel_buttons" invisible="1"/>
                </xpath>
                <xpath expr="//header/button[@name='action_unlock']" position="attributes">
                    <attribute name="invisible">not locked or hide_unlock_cancel_buttons</attribute>
                </xpath>
                <xpath expr="//header/button[@name='action_cancel']" position="attributes">
                    <attribute name="invisible">state not in ['draft', 'sent', 'sale'] or not id or locked or hide_unlock_cancel_buttons</attribute>
                </xpath>
            </field>
        </record>
</odoo>
