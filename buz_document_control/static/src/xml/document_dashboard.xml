<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_document_control.DocumentDashboard">
        <div class="o_bdc bdc-center" t-att-aria-busy="state.loading ? 'true' : 'false'">
            <div class="bdc-container">
                <header class="bdc-header bdc-hero">
                    <div class="bdc-hero-title">
                        <div class="bdc-hero-art" aria-hidden="true"><i class="fa fa-file-text-o"/><span><i class="fa fa-check"/></span></div>
                        <div><span class="bdc-eyebrow">DOCUMENT CENTER</span><h1>Document Control</h1><p>เอกสารและแบบฟอร์มบริษัท จัดเก็บ ควบคุม และเข้าถึงได้อย่างปลอดภัย</p></div>
                    </div>
                    <blockquote>“เอกสารที่ถูกต้อง<br/>คือรากฐานของคุณภาพ”</blockquote>
                    <div class="bdc-welcome"><strong t-esc="dateToday"/><span>ยินดีต้อนรับกลับ</span><span t-esc="user.name"/></div>
                    <div class="bdc-mountains" aria-hidden="true"><span/><span/><span/></div>
                </header>
                <section class="bdc-search-panel" aria-label="Search documents">
                    <form class="bdc-search-row" t-on-submit.prevent="submitSearch">
                        <div class="bdc-search"><i class="fa fa-search" aria-hidden="true"/><input type="search" t-att-value="state.query" t-on-input="search" placeholder="ค้นหาชื่อเอกสาร, Document No., QP, WI, FM..." aria-label="Search document number, name, type, department, category or revision"/></div>
                        <button type="button" class="btn bdc-refresh" t-on-click="refresh" t-att-disabled="state.loading" title="Refresh documents" aria-label="Refresh documents"><i t-att-class="state.loading ? 'fa fa-refresh fa-spin' : 'fa fa-refresh'" aria-hidden="true"/></button>
                        <button type="submit" class="btn btn-primary bdc-search-submit"><i class="fa fa-search me-2" aria-hidden="true"/>ค้นหา</button>
                    </form>
                    <div class="bdc-filter-row">
                        <div class="bdc-filters"><button t-foreach="filters" t-as="filter" t-key="filter.key" class="bdc-chip" t-att-class="{ active: state.filter === filter.key }" t-att-aria-pressed="state.filter === filter.key ? 'true' : 'false'" t-on-click="() => this.setFilter(filter.key)" t-esc="filter.label"/></div>
                        <button class="btn bdc-filter-toggle" t-att-aria-expanded="state.moreFilters ? 'true' : 'false'" aria-controls="bdc-extra-filters" t-on-click="() => state.moreFilters = !state.moreFilters"><i class="fa fa-filter me-2" aria-hidden="true"/>ตัวกรองเพิ่มเติม<i t-if="state.typeId || extraFilters.some(f => f.key === state.filter)" class="fa fa-circle bdc-filter-dot ms-2" aria-label="Additional filter active"/></button>
                    </div>
                    <div t-if="state.moreFilters" id="bdc-extra-filters" class="bdc-extra-filters">
                        <div class="bdc-filters"><button t-foreach="extraFilters" t-as="filter" t-key="filter.key" class="bdc-chip" t-att-class="{ active: state.filter === filter.key }" t-att-aria-pressed="state.filter === filter.key ? 'true' : 'false'" t-on-click="() => this.setFilter(filter.key)" t-esc="filter.label"/>
                            <t t-if="state.summary"><button t-foreach="state.summary.document_types" t-as="type" t-key="type.id" class="bdc-chip" t-att-class="{ active: state.typeId === type.id }" t-att-aria-pressed="state.typeId === type.id ? 'true' : 'false'" t-on-click="() => this.setType(type.id)" t-esc="type.code"/></t>
                        </div>
                    </div>
                    <div t-if="isSearching" class="bdc-search-context"><span>ผลการค้นหาตามตัวกรองที่เลือก</span><button class="btn btn-link btn-sm" t-on-click="reset">Clear filters</button></div>
                </section>
                <div t-if="state.error" class="bdc-empty" role="alert"><i class="fa fa-exclamation-circle" aria-hidden="true"/><h2>Unable to load documents</h2><p>Check your connection and document access, then try again.</p><button class="btn btn-primary" t-on-click="refresh">Try Again</button></div>
                <t t-elif="state.data">
                    <section t-if="state.data.is_manager and state.summary" class="bdc-kpis" aria-label="Manager dashboard">
                        <button t-foreach="kpis" t-as="kpi" t-key="kpi.key" t-attf-class="bdc-kpi bdc-stat-#{kpi.tone}" t-on-click="() => this.openSummary(kpi.key)">
                            <span class="bdc-kpi-icon"><i t-attf-class="fa #{kpi.icon}" aria-hidden="true"/></span>
                            <span class="bdc-kpi-body"><strong t-esc="state.summary.counts[kpi.key] || 0"/><span class="bdc-kpi-label" t-esc="kpi.label"/>
                                <small t-if="kpi.key === 'all'" class="bdc-month-growth"><i class="fa fa-arrow-up me-1" aria-hidden="true"/>+<t t-esc="state.summary.created_this_month"/> เดือนนี้</small>
                                <small t-elif="kpi.key === 'published'"><t t-esc="percent('published')"/>% ของทั้งหมด</small>
                                <small t-elif="kpi.key === 'due'">ภายใน <t t-esc="state.summary.review_warning_days"/> วัน</small>
                                <small t-elif="kpi.key === 'overdue'">เกินกำหนด</small>
                                <small t-else="">รอการพิจารณา</small>
                                <span t-if="kpi.key !== 'all'" class="bdc-stat-track" aria-hidden="true"><span t-att-style="'width: ' + percent(kpi.key) + '%'"/></span>
                            </span>
                        </button>
                        <button class="bdc-kpi bdc-deadline" t-on-click="() => this.openSummary('due')"><i class="fa fa-calendar-check-o" aria-hidden="true"/><span><b>เอกสารใกล้ครบกำหนด</b><span><strong t-esc="state.summary.counts.due || 0"/> รายการ</span></span><i class="fa fa-angle-right" aria-hidden="true"/></button>
                    </section>
                    <div class="bdc-dashboard-layout" t-att-class="{ 'bdc-reader-layout': !state.data.is_manager }">
                        <section t-if="state.data.is_manager and state.summary" class="bdc-section bdc-panel bdc-attention" aria-label="Needs action">
                            <div class="bdc-section-heading"><h2>ต้องดำเนินการ (Needs Action)</h2><button class="btn btn-link btn-sm" t-on-click="() => this.openSummary('attention')">ดูทั้งหมด <i class="fa fa-arrow-right" aria-hidden="true"/></button></div>
                            <div class="bdc-table-wrap">
                                <table class="table bdc-table bdc-attention-table"><thead><tr><th>เอกสาร</th><th>ประเภท</th><th>แผนก</th><th>สถานะ</th><th>กำหนดทบทวน</th><th>การดำเนินการ</th></tr></thead>
                                    <tbody><tr t-foreach="state.summary.needs_attention.slice(0, 4)" t-as="row" t-key="row.id">
                                        <td><button class="bdc-row-document" t-on-click="() => this.openDocument(row.id)"><i t-attf-class="fa fa-file-text-o bdc-type-#{typeTone(typeCode(row))}" aria-hidden="true"/><span><strong t-esc="row.document_no"/><small t-esc="row.name"/></span></button></td>
                                        <td><span class="bdc-type-pill" t-esc="typeCode(row)"/></td><td t-esc="row.department_id?.[1] || '—'"/>
                                        <td><span t-attf-class="bdc-badge bdc-#{attentionStatus(row)}" t-esc="attentionStatusLabel(row)"/></td>
                                        <td><span t-esc="date(row.review_date)"/><small t-att-class="row.review_status === 'overdue' ? 'bdc-days-overdue' : 'bdc-days-due'" t-esc="daysLabel(row.review_date)"/></td>
                                        <td><button t-att-class="attentionStatus(row) === 'draft' ? 'btn btn-outline-primary btn-sm' : 'btn btn-primary btn-sm'" t-on-click="() => this.openPending(row)" t-esc="attentionLabel(row)"/></td>
                                    </tr></tbody>
                                </table>
                            </div>
                            <p t-if="!state.summary.needs_attention.length" class="bdc-panel-empty"><i class="fa fa-check-circle-o me-2" aria-hidden="true"/>Everything is up to date.</p>
                        </section>
                        <section t-if="state.summary" class="bdc-section bdc-panel bdc-types-panel" aria-label="Document types">
                            <div class="bdc-section-heading"><h2>ประเภทเอกสาร</h2><button class="btn btn-link btn-sm" t-on-click="() => this.openSummary()">ดูทั้งหมด <i class="fa fa-arrow-right" aria-hidden="true"/></button></div>
                            <div class="bdc-categories">
                                <button t-foreach="state.summary.document_types" t-as="type" t-key="type.id" t-attf-class="bdc-category bdc-type-#{typeTone(type.code)}" t-on-click="() => this.openNative(type.id)">
                                    <i class="fa fa-file-text-o" aria-hidden="true"/><span class="bdc-category-code" t-esc="type.code"/><strong t-esc="type.count"/><small t-esc="type.name"/>
                                </button>
                            </div>
                            <p t-if="!state.summary.document_types.length" class="bdc-panel-empty">ยังไม่มีประเภทเอกสาร</p>
                        </section>
                        <section class="bdc-section bdc-recent" aria-label="Recent documents">
                            <div class="bdc-section-heading"><h2 t-esc="isSearching ? 'ผลการค้นหา' : 'เอกสารอัปเดตล่าสุด'"/><div class="bdc-header-actions"><button class="btn btn-link btn-sm" t-on-click="() => this.openNative()">ดูทั้งหมด <i class="fa fa-arrow-right" aria-hidden="true"/></button><button t-if="state.data.is_manager" class="btn btn-outline-primary btn-sm" t-on-click="createDocument"><i class="fa fa-plus me-1" aria-hidden="true"/>Create Document</button></div></div>
                            <div t-if="state.loading" class="bdc-loading" role="status"><i class="fa fa-circle-o-notch fa-spin me-2" aria-hidden="true"/>Loading documents…</div>
                            <div t-elif="!state.data.documents.length" class="bdc-empty"><i class="fa fa-folder-open-o" aria-hidden="true"/><h3>ไม่มีเอกสารในหมวดนี้</h3><p>ลองเปลี่ยน Filter หรือค้นหาด้วยคำอื่น</p><button class="btn btn-outline-secondary" t-on-click="reset">Clear filters</button></div>
                            <div t-else="" class="bdc-document-grid">
                                <article t-foreach="visibleDocuments" t-as="document" t-key="document.id" class="bdc-document-card bdc-dashboard-card">
                                    <div class="bdc-card-heading"><span t-attf-class="bdc-file-icon bdc-file-#{fileInfo(document.original_filename).tone}"><i t-attf-class="fa #{fileInfo(document.original_filename).icon}" aria-hidden="true"/></span>
                                        <button class="bdc-document-title" t-on-click="() => this.openDocument(document.id)"><span class="bdc-document-number" t-esc="document.document_no"/><h3 t-esc="document.name"/></button>
                                        <span t-attf-class="bdc-badge bdc-#{document.security_level}" t-esc="badgeLabel(document.security_level)"/>
                                    </div>
                                    <div class="bdc-card-info"><div><span>Rev.<t t-esc="document.current_revision || '—'"/></span><span t-esc="document.department_id?.[1] || '—'"/></div><span>Updated <t t-esc="date(document.write_date)"/></span></div>
                                    <div class="bdc-card-footer"><button class="btn btn-outline-primary btn-sm" t-on-click="() => this.openDocument(document.id)"><i class="fa fa-eye me-1" aria-hidden="true"/>Preview</button><button t-if="document.current_revision_id" class="btn btn-outline-primary btn-sm" t-on-click="() => this.download(document.id)" aria-label="Download Original"><i class="fa fa-download me-1" aria-hidden="true"/>Download</button></div>
                                </article>
                            </div>
                            <nav t-if="isSearching and state.data.total > 12" class="bdc-pagination" aria-label="Document pages"><button class="btn btn-outline-secondary btn-sm" t-att-disabled="state.offset === 0 || state.loading" t-on-click="() => this.page(-1)">Previous</button><span><t t-esc="state.offset + 1"/>–<t t-esc="Math.min(state.offset + 12, state.data.total)"/> / <t t-esc="state.data.total"/></span><button class="btn btn-outline-secondary btn-sm" t-att-disabled="state.offset + 12 >= state.data.total || state.loading" t-on-click="() => this.page(1)">Next</button></nav>
                        </section>
                        <section t-if="state.summary" class="bdc-section bdc-panel bdc-departments" aria-label="Documents by department">
                            <div class="bdc-section-heading"><h2>การกระจายเอกสาร (ตามแผนก)</h2><button class="btn btn-link btn-sm" t-on-click="() => this.openSummary()">ดูทั้งหมด <i class="fa fa-arrow-right" aria-hidden="true"/></button></div>
                            <div class="bdc-department-chart"><button t-foreach="departmentBars" t-as="department" t-key="department.id" class="bdc-department-row" t-on-click="() => this.openSummary('all', department.domain)"><span t-att-title="department.name" t-esc="department.name"/><span class="bdc-department-track" aria-hidden="true"><span t-attf-class="bdc-bar-#{department.tone}" t-att-style="'width: ' + department.width + '%'"/></span><span t-esc="department.count"/></button></div>
                            <p t-if="!departmentBars.length" class="bdc-panel-empty">ยังไม่มีเอกสารสำหรับแสดงกราฟ</p>
                        </section>
                    </div>
                </t>
                <div t-else="" class="bdc-loading" role="status"><i class="fa fa-circle-o-notch fa-spin me-2" aria-hidden="true"/>Loading Document Center…</div>
            </div>
        </div>
    </t>
</templates>
