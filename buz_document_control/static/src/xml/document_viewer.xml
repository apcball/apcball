<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_document_control.DocumentViewer">
        <div class="o_bdc bdc-viewer" t-att-aria-busy="state.busy ? 'true' : 'false'">
            <div class="bdc-container">
                <button class="btn btn-link bdc-back" t-on-click="back"><i class="fa fa-arrow-left me-2" aria-hidden="true"/>Back to Documents</button>
                <div t-if="state.loading" class="bdc-loading" role="status">Loading document…</div>
                <div t-elif="state.error" class="bdc-empty" role="alert"><i class="fa fa-lock" aria-hidden="true"/><h2>Document unavailable</h2><p>The document may have changed, or you may no longer have access.</p><button class="btn btn-outline-secondary" t-on-click="load">Try Again</button></div>
                <t t-elif="state.data">
                    <header class="bdc-header"><div><div class="d-flex align-items-center gap-2 flex-wrap"><span class="bdc-document-number" t-esc="doc.document_no"/><span t-attf-class="bdc-badge bdc-#{doc.state}" t-esc="badgeLabel(doc.state)"/></div><h1 t-esc="doc.name"/><p class="text-muted mb-0"><t t-esc="doc.department_id?.[1] || '—'"/> · <t t-esc="doc.document_type_id?.[1] || '—'"/></p></div>
                        <div class="bdc-header-actions">
                            <button t-if="revision" class="btn btn-primary" t-on-click="download" t-att-disabled="state.busy || !revision.original_filename"><i class="fa fa-download me-2" aria-hidden="true"/>Download Original</button>
                            <t t-if="state.data.is_manager">
                                <button class="btn btn-outline-primary" t-on-click="newRevision" t-att-disabled="state.busy"><i class="fa fa-plus me-1" aria-hidden="true"/><t t-esc="state.data.current ? 'New Revision' : 'Upload Document'"/></button>
                                <details class="bdc-more"><summary class="btn btn-outline-secondary">More <i class="fa fa-angle-down ms-1" aria-hidden="true"/></summary><div class="bdc-more-menu"><button class="btn text-start" t-on-click="openManagement">Manage Document / Access</button><button t-if="revision" class="btn text-start" t-on-click="regenerate" t-att-disabled="state.busy" title="Regenerate PDF from the original document">Regenerate Preview</button><button class="btn text-start text-danger" t-on-click="archive" t-att-disabled="state.busy">Archive</button></div></details>
                            </t>
                        </div>
                    </header>
                    <nav t-if="state.data.is_manager" class="bdc-tabs" aria-label="Document sections"><button t-foreach="tabs" t-as="tab" t-key="tab.key" class="bdc-tab" t-att-class="{ active: state.tab === tab.key }" t-att-aria-current="state.tab === tab.key ? 'page' : undefined" t-on-click="() => this.selectTab(tab.key)" t-esc="tab.label"/></nav>
                    <t t-if="state.tab === 'overview' || state.tab === 'current'">
                        <div t-if="revision and state.data.is_manager and ['draft', 'review'].includes(revision.state)" class="bdc-workflow alert alert-info"><span>Rev.<t t-esc="revision.revision"/> · <t t-esc="badgeLabel(revision.state)"/></span><div class="d-flex gap-2"><button t-if="revision.state === 'draft'" class="btn btn-outline-primary btn-sm" t-on-click="sendReview" t-att-disabled="state.busy">Send to Review</button><button class="btn btn-primary btn-sm" t-on-click="publish" t-att-disabled="state.busy">Publish</button><button class="btn btn-outline-secondary btn-sm" t-on-click="() => this.openRevision(revision.id)">Edit Draft</button></div></div>
                        <div t-if="revision and revision.state === 'obsolete'" class="alert alert-warning" role="status">You are viewing an obsolete revision. Use Current Revision to return to the published document.</div>
                        <div class="bdc-viewer-layout">
                            <section class="bdc-preview" t-ref="preview" aria-label="Document preview">
                                <div class="bdc-preview-toolbar"><span><i class="fa fa-file-pdf-o me-2" aria-hidden="true"/>Document Preview</span><div class="d-flex gap-2"><button t-if="revision?.preview_status === 'ready'" class="btn btn-outline-secondary btn-sm" t-on-click="openPreview">Open Preview</button><button class="btn btn-light btn-sm" t-on-click="fullscreen" title="Fullscreen preview" aria-label="Fullscreen preview"><i class="fa fa-expand" aria-hidden="true"/></button></div></div>
                                <iframe t-if="revision?.preview_status === 'ready'" t-key="previewUrl" t-att-src="previewUrl" class="bdc-pdf-frame" title="PDF document preview" allow="fullscreen"/>
                                <div t-elif="revision?.preview_status === 'pending'" class="bdc-preview-empty" role="status"><i class="fa fa-circle-o-notch fa-spin" aria-hidden="true"/><h2>Preparing preview</h2><p>The PDF preview will appear when it is ready.</p><button class="btn btn-outline-secondary" t-on-click="download" t-att-disabled="state.busy">Download Original</button></div>
                                <div t-else="" class="bdc-preview-empty"><i class="fa fa-file-o" aria-hidden="true"/><h2>Preview unavailable</h2><p t-if="revision?.preview_status === 'failed'">We could not generate a PDF preview.</p><p t-if="revision?.original_filename">You can still download the original document.</p><p t-else="">There is no published file yet.</p><button t-if="revision?.original_filename" class="btn btn-primary" t-on-click="download" t-att-disabled="state.busy">Download Original</button><button t-if="state.data.is_manager and !revision" class="btn btn-primary" t-on-click="newRevision">Create First Revision</button></div>
                            </section>
                            <aside class="bdc-information">
                                <section class="bdc-info-card"><div class="d-flex justify-content-between align-items-center gap-2"><div><span class="bdc-eyebrow">REVISION</span><h2 class="bdc-revision-number">Rev.<t t-esc="revision?.revision || '—'"/></h2></div><span t-if="revision" t-attf-class="bdc-badge bdc-#{revision.state}" t-esc="badgeLabel(revision.state)"/></div>
                                    <dl class="bdc-details"><dt>Document No.</dt><dd t-esc="doc.document_no"/><dt>Effective Date</dt><dd t-esc="revision?.effective_date || '—'"/><dt>Review Date</dt><dd><t t-esc="revision?.review_date || '—'"/><span t-if="doc.review_status !== 'ok'" t-attf-class="bdc-badge bdc-#{doc.review_status} ms-1" t-esc="badgeLabel(doc.review_status)"/></dd><dt>Department</dt><dd t-esc="doc.department_id?.[1] || '—'"/><dt>Document Type</dt><dd t-esc="doc.document_type_id?.[1] || '—'"/><dt>Category</dt><dd t-esc="doc.category_id?.[1] || '—'"/><dt>Security</dt><dd><span t-attf-class="bdc-badge bdc-#{doc.security_level}" t-esc="badgeLabel(doc.security_level)"/></dd><dt>Published Date</dt><dd t-esc="revision?.published_date || '—'"/><dt>Published By</dt><dd t-esc="revision?.published_by?.[1] || '—'"/></dl>
                                </section>
                                <section class="bdc-info-card"><h3>Original Document</h3><div class="bdc-original"><span t-attf-class="bdc-file-icon bdc-file-#{fileInfo(revision?.original_filename).tone}"><i t-attf-class="fa #{fileInfo(revision?.original_filename).icon}" aria-hidden="true"/></span><div><strong t-esc="revision?.original_filename || 'No file uploaded'"/><small class="text-muted d-block" t-esc="fileInfo(revision?.original_filename).label"/></div></div><button t-if="revision?.original_filename" class="btn btn-outline-primary w-100 mt-3" t-on-click="download" t-att-disabled="state.busy"><i class="fa fa-download me-2" aria-hidden="true"/>Download Original</button></section>
                                <section class="bdc-info-card"><h3>Description of Change</h3><p class="bdc-description mb-0" t-esc="revision?.change_description || '—'"/></section>
                                <section t-if="doc.description" class="bdc-info-card"><h3>About this Document</h3><p class="bdc-description mb-0" t-esc="doc.description"/></section>
                            </aside>
                        </div>
                    </t>
                    <section t-if="state.tab === 'history' || state.tab === 'overview'" class="bdc-section bdc-history">
                        <div class="bdc-section-heading"><h2>Revision History</h2><button t-if="state.data.is_manager" class="btn btn-link btn-sm" t-on-click="allHistory">View all (<t t-esc="state.data.history_count"/>)</button></div>
                        <p t-if="!state.data.is_manager" class="text-muted small">Only revisions available under your document permissions are shown.</p>
                        <div class="bdc-table-wrap"><table class="table bdc-table"><thead><tr><th>Revision</th><th>Status</th><th>Effective Date</th><th>Published Date</th><th>Change Description</th><th>Published By</th><th t-if="state.data.is_manager">Actions</th></tr></thead><tbody><tr t-foreach="state.data.history" t-as="row" t-key="row.id" t-att-class="{ 'bdc-current-row': row.id === state.data.current?.id }"><td><strong>Rev.<t t-esc="row.revision"/></strong></td><td><span t-attf-class="bdc-badge bdc-#{row.state}" t-esc="badgeLabel(row.state)"/></td><td t-esc="row.effective_date || '—'"/><td t-esc="row.published_date || '—'"/><td class="bdc-change-cell" t-esc="row.change_description"/><td t-esc="row.published_by?.[1] || '—'"/><td t-if="state.data.is_manager"><button class="btn btn-link btn-sm" t-on-click="() => this.selectRevision(row)">View</button><button class="btn btn-link btn-sm" t-on-click="() => this.openRevision(row.id)">Open</button></td></tr></tbody></table></div>
                        <p t-if="!state.data.history.length" class="text-muted">No revisions available.</p>
                    </section>
                    <section t-if="state.tab === 'access' and state.data.is_manager" class="bdc-info-card bdc-access"><div class="bdc-section-heading"><h2>Distribution &amp; Access</h2><button class="btn btn-outline-primary btn-sm" t-on-click="openManagement">Manage Access</button></div><span t-attf-class="bdc-badge bdc-#{doc.security_level}" t-esc="badgeLabel(doc.security_level)"/><p t-if="doc.security_level === 'general'" class="mt-3">Visible to all Document Users</p><p t-if="doc.security_level === 'restricted'" class="mt-3 text-muted">Visible to users in an allowed group or department.</p><p t-if="doc.security_level === 'confidential'" class="mt-3 text-muted">Requires Confidential Document User permission and any configured group or employee assignment. Department assignments do not grant confidential access.</p><h3 class="mt-4">Allowed Groups</h3><div class="bdc-filters"><span t-foreach="state.data.access.groups" t-as="group" t-key="group" class="bdc-chip" t-esc="group"/><span t-if="!state.data.access.groups.length" class="text-muted">No group assignments</span></div><h3 class="mt-4">Allowed Departments</h3><div class="bdc-filters"><span t-foreach="state.data.access.departments" t-as="department" t-key="department" class="bdc-chip" t-esc="department"/><span t-if="!state.data.access.departments.length" class="text-muted">No department assignments</span></div><h3 class="mt-4">Allowed Employees</h3><div class="bdc-filters"><span t-foreach="state.data.access.employees" t-as="employee" t-key="employee" class="bdc-chip" t-esc="employee"/><span t-if="!state.data.access.employees.length" class="text-muted">No employee assignments</span></div></section>
                    <section t-if="state.tab === 'audit' and state.data.is_manager" class="bdc-info-card"><div class="bdc-section-heading"><h2>Recent Activity</h2><button class="btn btn-link" t-on-click="openManagement">Open Chatter</button></div><p class="text-muted small">Latest 20 preview and download events. Events are recorded when download audit logging is enabled.</p><div t-foreach="state.data.activity" t-as="event" t-key="event.id" class="bdc-attention-row"><i t-att-class="event.action_type === 'preview' ? 'fa fa-eye' : 'fa fa-download'" aria-hidden="true"/><div class="bdc-attention-name"><strong t-esc="event.user_id[1]"/><span t-esc="event.revision_id[1]"/></div><span t-esc="event.action_type"/><time t-esc="event.download_date"/></div><p t-if="!state.data.activity.length" class="text-muted">No recorded activity for this document.</p></section>
                </t>
            </div>
        </div>
    </t>
</templates>
