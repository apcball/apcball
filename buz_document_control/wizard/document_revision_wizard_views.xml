<odoo>
    <record id="view_document_revision_wizard" model="ir.ui.view">
        <field name="name">buz.document.revision.wizard.form</field>
        <field name="model">buz.document.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="New Revision" class="o_bdc_revision_wizard">
                <div class="alert alert-info" role="status">Create a draft for review. The published revision stays available until this draft is published.</div>
                <group>
                    <group>
                        <field name="document_id" options="{'no_open': True}"/>
                        <field name="current_revision" string="Current Revision"/>
                        <field name="revision"/>
                    </group>
                    <group>
                        <field name="effective_date"/>
                        <field name="review_date"/>
                    </group>
                </group>
                <field name="original_filename" invisible="1"/>
                <field name="original_file" widget="bdc_dropzone" filename="original_filename" nolabel="1" class="w-100 d-block"/>
                <group><field name="change_description" placeholder="What changed in this revision?"/></group>
                <footer>
                    <button name="action_create_draft" type="object" string="Create Draft" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
