<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_asset_company" model="ir.rule">
        <field name="name">IT Asset: allowed companies</field>
        <field name="model_id" ref="model_buz_it_asset"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_assignment_company" model="ir.rule">
        <field name="name">IT Assignment: allowed companies</field>
        <field name="model_id" ref="model_buz_it_asset_assignment"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_assignment_requester" model="ir.rule">
        <field name="name">IT Assignment: own history</field>
        <field name="model_id" ref="model_buz_it_asset_assignment"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('buz_it_helpdesk.group_it_requester'))]"/>
    </record>
    <record id="rule_assignment_it_all" model="ir.rule">
        <field name="name">IT Assignment: IT team sees all</field>
        <field name="model_id" ref="model_buz_it_asset_assignment"/>
        <field name="domain_force">[('id', '!=', 0)]</field>
        <field name="groups" eval="[(4, ref('buz_it_helpdesk.group_it_support_agent')), (4, ref('buz_it_helpdesk.group_it_helpdesk_manager'))]"/>
    </record>
    <record id="rule_category_company" model="ir.rule">
        <field name="name">IT Asset Category: allowed companies</field>
        <field name="model_id" ref="model_buz_it_asset_category"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_location_company" model="ir.rule">
        <field name="name">IT Asset Location: allowed companies</field>
        <field name="model_id" ref="model_buz_it_asset_location"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_product_company" model="ir.rule">
        <field name="name">Software Product: allowed companies</field>
        <field name="model_id" ref="model_buz_it_software_product"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_license_company" model="ir.rule">
        <field name="name">Software License: allowed companies</field>
        <field name="model_id" ref="model_buz_it_software_license"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_installation_company" model="ir.rule">
        <field name="name">Software Installation: allowed companies</field>
        <field name="model_id" ref="model_buz_it_software_installation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_asset_requester_own" model="ir.rule">
        <field name="name">IT Asset: requester sees own assets</field>
        <field name="model_id" ref="model_buz_it_asset"/>
        <field name="domain_force">[('assigned_employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('buz_it_helpdesk.group_it_requester'))]"/>
    </record>
    <record id="rule_asset_it_all" model="ir.rule">
        <field name="name">IT Asset: IT team sees all</field>
        <field name="model_id" ref="model_buz_it_asset"/>
        <field name="domain_force">[('id', '!=', 0)]</field>
        <field name="groups" eval="[(4, ref('buz_it_helpdesk.group_it_support_agent')), (4, ref('buz_it_helpdesk.group_it_helpdesk_manager'))]"/>
    </record>
    <record id="rule_installation_requester_own" model="ir.rule">
        <field name="name">Software Installation: requester sees own installations</field>
        <field name="model_id" ref="model_buz_it_software_installation"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('asset_id.assigned_employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('buz_it_helpdesk.group_it_requester'))]"/>
    </record>
    <record id="rule_installation_it_all" model="ir.rule">
        <field name="name">Software Installation: IT team sees all</field>
        <field name="model_id" ref="model_buz_it_software_installation"/>
        <field name="domain_force">[('id', '!=', 0)]</field>
        <field name="groups" eval="[(4, ref('buz_it_helpdesk.group_it_support_agent')), (4, ref('buz_it_helpdesk.group_it_helpdesk_manager'))]"/>
    </record>
</odoo>
