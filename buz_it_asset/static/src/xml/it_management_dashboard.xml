<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_it_asset.ITManagementDashboard">
        <div class="o_it_management_dashboard">
            <header class="it-dashboard-header">
                <div class="it-dashboard-title">
                    <div class="it-eyebrow"><span class="it-live-dot"/> IT OPERATIONS</div>
                    <h1>IT Management Overview</h1>
                    <p><t t-esc="state.tab === 'overview' ? 'Executive summary and service health' : 'Workflow performance and operational analysis'"/></p>
                </div>
                <div class="it-dashboard-toolbar" role="toolbar" aria-label="Dashboard filters">
                    <label class="it-filter-control"><span>Period</span><select t-on-change="onPeriodChange" t-att-value="state.period"><option value="this_month">This Month</option><option value="last_30_days">Last 30 Days</option><option value="last_90_days">Last 90 Days</option><option value="this_year">This Year</option></select></label>
                    <label t-if="state.data" class="it-filter-control"><span>Company</span><select t-on-change="onCompanyChange" t-att-value="state.company"><option value="all">All Companies</option><option t-foreach="state.data.companies" t-as="company" t-key="company.id" t-att-value="company.id"><t t-esc="company.name"/></option></select></label>
                    <button class="btn it-refresh-button" t-on-click="refresh" t-att-disabled="state.loading"><i class="fa fa-refresh"/> <span>Refresh</span></button>
                    <div class="it-sync-status"><span class="it-sync-dot"/><span><b>Live data</b><small>Updated <t t-esc="formatLastUpdated()"/></small></span></div>
                </div>
            </header>
            <nav class="it-dashboard-tabs" role="tablist" aria-label="Dashboard views">
                <button role="tab" t-att-aria-selected="state.tab === 'overview'" t-att-class="state.tab === 'overview' ? 'active' : ''" t-on-click="() => selectTab('overview')"><i class="fa fa-th-large"/> Overview</button>
                <button role="tab" t-att-aria-selected="state.tab === 'workflow'" t-att-class="state.tab === 'workflow' ? 'active' : ''" t-on-click="() => selectTab('workflow')"><i class="fa fa-line-chart"/> Workflow Analysis</button>
            </nav>
            <div t-if="state.loading and !state.data" class="it-dashboard-skeleton" aria-label="Loading dashboard"><div class="it-skeleton-kpis"><span t-foreach="[1, 2, 3, 4, 5, 6]" t-as="item" t-key="item"/></div><div class="it-skeleton-panels"><span/><span/><span/></div></div>
            <div t-if="state.loading and state.data" class="it-refreshing"><i class="fa fa-refresh fa-spin"/> Refreshing dashboard data...</div>
            <div t-if="state.error and state.data" class="alert alert-warning it-dashboard-alert"><i class="fa fa-info-circle"/><span><t t-esc="state.error"/> Existing data may be stale.</span><button class="btn btn-sm" t-on-click="refresh">Retry</button></div>
            <div t-if="state.error and !state.data" class="it-dashboard-error"><div class="it-error-icon"><i class="fa fa-cloud-exclamation"/></div><h2>Dashboard unavailable</h2><p><t t-esc="state.error"/></p><button class="btn" t-on-click="refresh"><i class="fa fa-refresh"/> Retry</button></div>
            <t t-if="state.data">
                <t t-set="data" t-value="state.data"/>
                <t t-if="state.tab === 'overview'">
                    <section class="it-kpi-grid executive-kpis" aria-label="Executive KPIs">
                        <button class="it-kpi-card is-clickable" t-on-click="() => openDrilldown('open_tickets')"><span class="it-kpi-icon violet"><i class="fa fa-ticket"/></span><span class="it-kpi-content"><span class="it-kpi-label">Open Backlog</span><strong><t t-esc="data.kpis.open_tickets"/></strong><small class="it-kpi-context">Active tickets</small></span><i class="fa fa-arrow-up-right it-card-arrow"/></button>
                        <button class="it-kpi-card is-clickable" t-on-click="() => openDrilldown('overdue_sla')"><span class="it-kpi-icon red"><i class="fa fa-clock-o"/></span><span class="it-kpi-content"><span class="it-kpi-label">Overdue SLA</span><strong class="danger"><t t-esc="data.kpis.overdue_sla"/></strong><small class="it-kpi-context">Needs attention</small></span><i class="fa fa-arrow-up-right it-card-arrow"/></button>
                        <div class="it-kpi-card"><span class="it-kpi-icon green"><i class="fa fa-check-circle-o"/></span><span class="it-kpi-content"><span class="it-kpi-label">SLA Compliance</span><strong class="success"><t t-esc="data.kpis.sla_compliance === null ? 'N/A' : data.kpis.sla_compliance + '%'"/></strong><small class="it-kpi-context">Eligible completed tickets</small></span></div>
                        <div class="it-kpi-card"><span class="it-kpi-icon cyan"><i class="fa fa-bar-chart"/></span><span class="it-kpi-content"><span class="it-kpi-label">Asset Utilization</span><strong><t t-esc="data.kpis.asset_utilization + '%'"/></strong><small class="it-kpi-context">Available, assigned and repair</small></span></div>
                        <button class="it-kpi-card is-clickable" t-on-click="() => openDrilldown('repair_backlog')"><span class="it-kpi-icon amber"><i class="fa fa-wrench"/></span><span class="it-kpi-content"><span class="it-kpi-label">Repair Backlog</span><strong class="warning"><t t-esc="data.kpis.repair_backlog"/></strong><small class="it-kpi-context">Open maintenance jobs</small></span><i class="fa fa-arrow-up-right it-card-arrow"/></button>
                        <button class="it-kpi-card is-clickable" t-on-click="() => openDrilldown('licenses_expiring')"><span class="it-kpi-icon amber"><i class="fa fa-file-text-o"/></span><span class="it-kpi-content"><span class="it-kpi-label">License Risk</span><strong class="warning"><t t-esc="data.kpis.license_risk"/></strong><small class="it-kpi-context">Expiry or over-allocation</small></span><i class="fa fa-arrow-up-right it-card-arrow"/></button>
                    </section>
                    <div class="it-section-label"><span>Executive overview</span><i/><small><t t-esc="data.meta.date_from"/> – <t t-esc="data.meta.date_to"/></small></div>
                    <div class="it-dashboard-grid executive-grid">
                        <section class="it-panel it-dashboard-trend it-panel-featured"><div class="section-heading"><div><span class="it-panel-kicker">VOLUME TREND</span><h2>Ticket Flow</h2></div><span>Opened vs closed</span></div><div class="chart-box large"><canvas t-ref="ticketTrend"/><div t-if="!hasRows(data.ticket_trend)" class="it-chart-empty">No ticket activity in this period</div></div></section>
                        <section class="it-panel status-panel"><div class="section-heading"><div><span class="it-panel-kicker">CURRENT STATE</span><h2>Ticket Status</h2></div><span>Workflow distribution</span></div><div class="status-chart-layout"><div class="chart-box status-chart"><canvas t-ref="ticketStatus"/></div><div class="status-legend"><span t-foreach="data.ticket_status" t-as="row" t-key="row.label"><i t-att-style="'background:' + statusColor(row.label)"/><span class="status-name"><t t-esc="row.label"/></span><b><t t-esc="statusPercentage(data.ticket_status, row.value)"/>% <em>(<t t-esc="row.value"/>)</em></b></span></div></div></section>
                        <section class="it-panel status-panel"><div class="section-heading"><div><span class="it-panel-kicker">CURRENT STATE</span><h2>Asset Health</h2></div><span>Inventory status</span></div><div class="status-chart-layout"><div class="chart-box status-chart"><canvas t-ref="assetStatus"/></div><div class="status-legend"><span t-foreach="data.asset_status" t-as="row" t-key="row.label"><i t-att-style="'background:' + statusColor(row.label)"/><span class="status-name"><t t-esc="row.label"/></span><b><t t-esc="statusPercentage(data.asset_status, row.value)"/>% <em>(<t t-esc="row.value"/>)</em></b></span></div></div></section>
                        <section class="it-panel repair-panel"><div class="section-heading"><div><span class="it-panel-kicker">COST CONTROL</span><h2>Repair Backlog &amp; Cost</h2></div><span>Recorded maintenance</span></div><div class="repair-summary"><div><strong><t t-esc="data.workflow.repair_analytics.backlog"/></strong><span>Open repairs</span></div><div><b><t t-esc="formatAmount(data.workflow.repair_analytics.backlog_cost)"/></b><span>Open repair cost</span></div></div><div class="chart-box"><canvas t-ref="repairStatus"/></div></section>
                        <section class="it-panel it-attention-panel"><div class="section-heading"><div><span class="it-panel-kicker">ACTION QUEUE</span><h2><i class="fa fa-exclamation-triangle"/> Needs Attention</h2></div><button class="btn btn-link p-0" t-on-click="() => openDrilldown('needs_attention')">View all <i class="fa fa-arrow-right"/></button></div><div class="attention-grid"><t t-foreach="attentionItems(data.needs_attention)" t-as="item" t-key="item.target + '-' + item.id"><button t-att-class="'attention-item ' + item.kind" t-on-click="() => openDrilldown(item.target, item.bucket)"><span class="attention-item-icon"><i t-att-class="'fa ' + item.icon"/></span><span><b><t t-esc="item.title"/></b><small><t t-esc="item.detail"/></small></span><em><t t-esc="item.label"/></em></button></t><div t-if="!attentionItems(data.needs_attention).length" class="attention-empty"><i class="fa fa-check-circle"/> No items need attention.</div></div></section>
                    </div>
                </t>
                <t t-else="">
                    <div class="it-section-label"><span>Workflow performance</span><i/><small>Current state and selected period</small></div>
                    <section class="workflow-summary it-kpi-grid"><div class="it-kpi-card"><span class="it-kpi-icon violet"><i class="fa fa-hourglass-half"/></span><span class="it-kpi-content"><span class="it-kpi-label">Avg Response Time</span><strong><t t-esc="formatHours(data.workflow.ticket_analytics.response_hours)"/></strong><small class="it-kpi-context">From ticket start</small></span></div><div class="it-kpi-card"><span class="it-kpi-icon blue"><i class="fa fa-hourglass-end"/></span><span class="it-kpi-content"><span class="it-kpi-label">Avg Resolution Time</span><strong><t t-esc="formatHours(data.workflow.ticket_analytics.resolution_hours)"/></strong><small class="it-kpi-context">From ticket start</small></span></div><div class="it-kpi-card"><span class="it-kpi-icon green"><i class="fa fa-check"/></span><span class="it-kpi-content"><span class="it-kpi-label">SLA Eligible Closed</span><strong><t t-esc="data.workflow.ticket_analytics.sla_eligible"/></strong><small class="it-kpi-context">Selected period</small></span></div><div class="it-kpi-card"><span class="it-kpi-icon amber"><i class="fa fa-exclamation-circle"/></span><span class="it-kpi-content"><span class="it-kpi-label">SLA Met</span><strong class="warning"><t t-esc="data.workflow.ticket_analytics.sla_met"/></strong><small class="it-kpi-context">Eligible tickets</small></span></div></section>
                    <div class="it-workflow-grid">
                        <section class="it-panel workflow-wide"><div class="section-heading"><div><span class="it-panel-kicker">TICKET OPERATIONS</span><h2>Ticket Funnel</h2></div><span>Current workflow distribution</span></div><div class="chart-box large"><canvas t-ref="ticketFunnel"/></div></section>
                        <section class="it-panel"><div class="section-heading"><div><span class="it-panel-kicker">TICKET OPERATIONS</span><h2>Ticket Aging</h2></div><span>Open backlog</span></div><div class="chart-box large"><canvas t-ref="ticketAging"/></div></section>
                        <section class="it-panel"><div class="section-heading"><div><span class="it-panel-kicker">ASSET OPERATIONS</span><h2>Assets by Category</h2></div><span>Current inventory</span></div><div class="chart-box large"><canvas t-ref="assetCategory"/></div></section>
                        <section class="it-panel workflow-wide"><div class="section-heading"><div><span class="it-panel-kicker">REPAIR OPERATIONS</span><h2>Repair Workflow</h2></div><span>Maintenance status</span></div><div class="chart-box large"><canvas t-ref="repairWorkflow"/></div></section>
                        <section class="it-panel license-panel"><div class="section-heading"><div><span class="it-panel-kicker">ASSET OPERATIONS</span><h2>Software License Seats</h2></div><span>Usage and availability</span></div><div class="license-progress"><div><span>Used</span><b><t t-esc="data.license_seats.used"/></b></div><div class="progress"><span t-att-style="'width: ' + (data.license_seats.total ? Math.min(100, data.license_seats.used / data.license_seats.total * 100) : 0) + '%'"/></div><div><span>Available</span><b class="success"><t t-esc="data.license_seats.available"/></b></div></div><small t-if="data.license_seats.overallocated" class="text-danger"><i class="fa fa-warning"/> Overallocated: <t t-esc="data.license_seats.overallocated"/> seat(s)</small></section>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
