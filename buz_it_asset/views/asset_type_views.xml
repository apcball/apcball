<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Each type-specific form inherits the common asset form and replaces only
         the specifications page. There are no type-dependent invisible rules. -->
    <record id="view_it_asset_desktop_form" model="ir.ui.view">
        <field name="name">buz.it.asset.desktop.form</field>
        <field name="model">buz.it.asset</field>
        <field name="inherit_id" ref="view_it_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type_id']" position="attributes"><attribute name="readonly">1</attribute><attribute name="string">ประเภทอุปกรณ์ (Type)</attribute></xpath>
            <xpath expr="//notebook/page[1]" position="replace">
                <page string="ข้อมูลสเปค (Specifications)"><group>
                    <group string="หน่วยประมวลผลและหน่วยความจำ (Processor &amp; Memory)"><field name="cpu" string="ซีพียู (CPU / Processor)"/><field name="ram" string="แรม (RAM / Memory)"/><field name="motherboard" string="เมนบอร์ด (Motherboard)"/></group>
                    <group string="กราฟิกและพื้นที่จัดเก็บ (Graphics &amp; Storage)"><field name="gpu" string="การ์ดจอ (GPU / Graphics)"/><field name="storage" string="พื้นที่จัดเก็บ (Storage)"/><field name="storage_type" string="ประเภทพื้นที่จัดเก็บ (Storage Type)"/></group>
                </group><group>
                    <group string="จอภาพและระบบปฏิบัติการ (Display &amp; OS)"><field name="display" string="จอภาพ (Display)"/><field name="operating_system" string="ระบบปฏิบัติการ (Operating System)"/></group>
                    <group string="เครือข่าย (Network)"><field name="network" string="การเชื่อมต่อเครือข่าย (Network / Connectivity)"/><field name="mac_address" string="MAC Address"/><field name="ip_address" string="IP Address"/></group>
                </group><group>
                    <group string="ไฟเลี้ยงและพอร์ต (Power &amp; Interfaces)"><field name="power_supply" string="พาวเวอร์ซัพพลาย (Power Supply)"/><field name="ports" string="พอร์ตเชื่อมต่อ (Ports / Interfaces)"/></group>
                    <group string="ข้อมูลเพิ่มเติม (Additional Information)"><field name="accessories" string="อุปกรณ์เสริม (Included Accessories)"/><field name="other_specifications" string="สเปคอื่น ๆ (Other Specifications)"/></group>
                </group></page>
            </xpath>
        </field>
    </record>

    <record id="view_it_asset_laptop_form" model="ir.ui.view"><field name="name">buz.it.asset.laptop.form</field><field name="model">buz.it.asset</field><field name="inherit_id" ref="view_it_asset_form"/><field name="arch" type="xml"><xpath expr="//field[@name='type_id']" position="attributes"><attribute name="readonly">1</attribute></xpath><xpath expr="//notebook/page[1]" position="replace"><page string="ข้อมูลสเปค (Specifications)"><group><group string="หน่วยประมวลผลและหน่วยความจำ (Processor &amp; Memory)"><field name="cpu"/><field name="ram"/><field name="gpu"/></group><group string="พื้นที่จัดเก็บและจอภาพ (Storage &amp; Display)"><field name="storage"/><field name="storage_type"/><field name="display"/></group></group><group><group string="ระบบและเครือข่าย (System &amp; Network)"><field name="operating_system"/><field name="network"/><field name="ports"/></group><group string="ไฟเลี้ยงและอุปกรณ์เสริม (Power &amp; Accessories)"><field name="power_supply"/><field name="accessories"/><field name="other_specifications"/></group></group></page></xpath></field></record>

    <record id="view_it_asset_mobile_form" model="ir.ui.view"><field name="name">buz.it.asset.mobile.form</field><field name="model">buz.it.asset</field><field name="inherit_id" ref="view_it_asset_form"/><field name="arch" type="xml"><xpath expr="//field[@name='type_id']" position="attributes"><attribute name="readonly">1</attribute></xpath><xpath expr="//notebook/page[1]" position="replace"><page string="ข้อมูลสเปค (Specifications)"><group><group string="ประสิทธิภาพ (Performance)"><field name="cpu"/><field name="ram"/><field name="storage"/><field name="storage_type"/></group><group string="จอภาพและแบตเตอรี่ (Display &amp; Battery)"><field name="display"/><field name="battery"/><field name="operating_system"/></group></group><group><group string="เครือข่ายและตัวตนเครื่อง (Network &amp; Identity)"><field name="network"/><field name="imei"/><field name="mac_address"/></group><group string="ข้อมูลเพิ่มเติม (Additional Information)"><field name="power_supply"/><field name="accessories"/><field name="other_specifications"/></group></group></page></xpath></field></record>

