    <record id="view_it_asset_monitor_form" model="ir.ui.view"><field name="name">buz.it.asset.monitor.form</field><field name="model">buz.it.asset</field><field name="inherit_id" ref="view_it_asset_form"/><field name="arch" type="xml"><xpath expr="//field[@name='type_id']" position="attributes"><attribute name="readonly">1</attribute></xpath><xpath expr="//notebook/page[1]" position="replace"><page string="ข้อมูลสเปคจอภาพ (Display Specifications)"><group><group string="จอภาพ (Display)"><field name="display"/><field name="resolution"/><field name="refresh_rate"/></group><group string="พอร์ตและไฟเลี้ยง (Ports &amp; Power)"><field name="ports"/><field name="power_supply"/><field name="accessories"/></group></group><group string="ข้อมูลเพิ่มเติม (Additional Information)"><field name="other_specifications"/></group></page></xpath></field></record>

