    <record id="view_it_asset_server_form" model="ir.ui.view"><field name="name">buz.it.asset.server.form</field><field name="model">buz.it.asset</field><field name="inherit_id" ref="view_it_asset_form"/><field name="arch" type="xml"><xpath expr="//field[@name='type_id']" position="attributes"><attribute name="readonly">1</attribute></xpath><xpath expr="//notebook/page[1]" position="replace"><page string="ข้อมูลสเปคเซิร์ฟเวอร์ (Server Specifications)"><group><group string="ประมวลผลและหน่วยความจำ (Processor &amp; Memory)"><field name="cpu"/><field name="ram"/></group><group string="พื้นที่จัดเก็บ (Storage)"><field name="storage"/><field name="storage_type"/><field name="rack_drive_details"/></group></group><group><group string="ระบบและเครือข่าย (System &amp; Network)"><field name="operating_system"/><field name="network"/><field name="ip_address"/></group><group string="ไฟเลี้ยงและพอร์ต (Power &amp; Interfaces)"><field name="power_supply"/><field name="ports"/><field name="other_specifications"/></group></group></page></xpath></field></record>

