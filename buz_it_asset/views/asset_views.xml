<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_it_asset_tree" model="ir.ui.view">
        <field name="name">buz.it.asset.tree</field>
        <field name="model">buz.it.asset</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'retired'" decoration-danger="state in ('lost', 'repair')">
                <field name="asset_tag"/>
                <field name="legacy_asset_tag" optional="hide"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="type_id"/>
                <field name="serial_number"/>
                <field name="assigned_employee_id"/>
                <field name="responsible_department_id" optional="hide"/>
                <field name="location_id"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>
    <record id="view_it_asset_search" model="ir.ui.view">
        <field name="name">buz.it.asset.search</field>
        <field name="model">buz.it.asset</field>
        <field name="arch" type="xml">
            <search>
                <field name="asset_tag"/>
                <field name="legacy_asset_tag"/>
                <field name="name"/>
                <field name="serial_number"/>
                <field name="assigned_employee_id"/>
                <field name="responsible_department_id"/>
                <field name="category_id"/>
                <field name="type_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="assigned" string="Assigned" domain="[('state', '=', 'assigned')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'type_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_holder" string="Current Holder" context="{'group_by': 'assigned_employee_id'}"/>
                    <filter name="group_department" string="Responsible Department" context="{'group_by': 'responsible_department_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_it_asset_form" model="ir.ui.view">
        <field name="name">buz.it.asset.form</field>
        <field name="model">buz.it.asset</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_assign" type="object" string="Assign" class="oe_highlight" invisible="state != 'available'" groups="buz_it_helpdesk.group_it_support_agent"/>
                    <button name="action_return" type="object" string="Return" invisible="state != 'assigned'" groups="buz_it_helpdesk.group_it_support_agent"/>
                    <field name="state" widget="statusbar" statusbar_visible="available,assigned,repair,retired,lost"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title"><h1><field name="name" string="ชื่ออุปกรณ์ (Item Name)" placeholder="ชื่ออุปกรณ์"/></h1></div>
                    <group>
                        <group string="ข้อมูลประจำทรัพย์สิน (Asset Identification)">
                            <field name="asset_tag" string="รหัสทรัพย์สิน (Asset Code)"/>
                            <field name="type_id" string="ประเภทอุปกรณ์ (Type)" required="1" domain="[('active', '=', True)]" options="{'no_create_edit': True}"/>
                            <field name="category_id" string="หมวดหมู่ (Category)" readonly="1"/>
                        </group>
                        <group string="ข้อมูลอุปกรณ์ (Device Information)">
                            <field name="manufacturer" string="ยี่ห้อ (Brand / Manufacturer)"/>
                            <field name="model" string="รุ่น (Model)"/>
                            <field name="serial_number" string="หมายเลขเครื่อง (Serial Number)" required="1"/>
                        </group>
                    </group>
                    <field name="spec_profile" invisible="1"/>
                    <field name="legacy_asset_tag" string="Legacy Asset Code" readonly="1"/>
                    <notebook>
                        <page name="specifications" string="ข้อมูลสเปค (Specifications)">
                            <group col="2">
                            <group string="Processor &amp; Memory" invisible="spec_profile not in ['desktop', 'laptop', 'mobile', 'server']">
                                <field name="cpu" string="CPU / Processor"/>
                                <field name="ram" string="RAM / Memory"/>
                                <field name="gpu" string="GPU / Graphics" invisible="spec_profile not in ['desktop', 'laptop']"/>
                                <field name="motherboard" string="Motherboard" invisible="spec_profile != 'desktop'"/>
                            </group>
                            <group string="Storage &amp; Display" invisible="spec_profile not in ['desktop', 'laptop', 'mobile', 'server', 'storage', 'monitor', 'printer', 'ups']">
                                <field name="storage" string="Storage Capacity" invisible="spec_profile not in ['desktop', 'laptop', 'mobile', 'server']"/>
                                <field name="storage_type" string="Storage Type" invisible="spec_profile not in ['desktop', 'laptop', 'mobile', 'server', 'storage']"/>
                                <field name="capacity" string="Capacity" invisible="spec_profile not in ['storage', 'ups']"/>
                                <field name="interface" string="Interface" invisible="spec_profile not in ['storage', 'input']"/>
                                <field name="form_factor" string="Form Factor" invisible="spec_profile != 'storage'"/>
                                <field name="display" string="Display" invisible="spec_profile not in ['laptop', 'mobile', 'monitor', 'printer']"/>
                                <field name="resolution" string="Resolution" invisible="spec_profile != 'monitor'"/>
                                <field name="refresh_rate" string="Refresh Rate" invisible="spec_profile != 'monitor'"/>
                            </group>
                            <group string="Operating System &amp; Network" invisible="spec_profile not in ['desktop', 'laptop', 'mobile', 'network', 'server', 'storage', 'printer', 'ups']">
                                <field name="operating_system" string="Operating System" invisible="spec_profile not in ['desktop', 'laptop', 'mobile', 'server']"/>
                                <field name="network" string="Network / Connectivity"/>
                                <field name="mac_address" string="MAC Address" invisible="spec_profile not in ['desktop', 'laptop', 'mobile', 'network', 'storage', 'printer']"/>
                                <field name="ip_address" string="IP Address" invisible="spec_profile not in ['desktop', 'laptop', 'network', 'server', 'storage', 'printer', 'ups']"/>
                                <field name="firmware" string="Firmware" invisible="spec_profile != 'network'"/>
                                <field name="imei" string="IMEI" invisible="spec_profile != 'mobile'"/>
                            </group>
                            <group string="Power &amp; Interfaces" invisible="spec_profile not in ['desktop', 'laptop', 'mobile', 'network', 'server', 'monitor', 'printer', 'ups', 'input']">
                                <field name="power_supply" string="Power Supply / Battery"/>
                                <field name="battery" string="Battery" invisible="spec_profile not in ['laptop', 'mobile', 'ups', 'input']"/>
                                <field name="ports" string="Ports / Interfaces" invisible="spec_profile not in ['desktop', 'laptop', 'network', 'server', 'monitor', 'printer', 'ups', 'input']"/>
                                <field name="connection_type" string="Connection Type" invisible="spec_profile != 'input'"/>
                                <field name="runtime" string="Runtime" invisible="spec_profile != 'ups'"/>
                                <field name="input_output" string="Input / Output" invisible="spec_profile != 'ups'"/>
                            </group>
                            <group string="Device Details" invisible="spec_profile not in ['server', 'printer']">
                                <field name="rack_drive_details" string="RAID / Drive Details" invisible="spec_profile != 'server'"/>
                                <field name="print_scan_type" string="Print / Scan Type" invisible="spec_profile != 'printer'"/>
                            </group>
                            <group string="Additional Information" colspan="2">
                                <field name="accessories" string="Included Accessories"/>
                                <field name="other_specifications" string="Other Specifications" placeholder="Other hardware details..."/>
                            </group>
                            </group>
                        </page>
                        <page name="usage_purchase" string="การใช้งานและการจัดซื้อ (Usage &amp; Purchase)">
                            <group>
                                <group string="ผู้รับผิดชอบและสถานที่ (Responsibility &amp; Location)">
                                    <field name="company_id" string="บริษัท (Company)"/>
                                    <field name="location_id" string="สถานที่ตั้ง (Location)" domain="[('company_id', '=', company_id)]"/>
                                    <field name="assigned_employee_id" string="ผู้ใช้งานปัจจุบัน (Current User)" readonly="state != 'available'" domain="[('company_id', '=', company_id)]"/>
                                    <field name="responsible_department_id" string="แผนกรับผิดชอบ (Responsible Department)" readonly="state != 'available'" domain="[('company_id', '=', company_id)]"/>
                                </group>
                                <group string="ข้อมูลการจัดซื้อ (Purchase Information)">
                                    <field name="purchase_date" string="วันที่รับเข้า/จัดซื้อ (Purchase Date)"/>
                                    <field name="purchase_price" string="ราคาซื้อ (Purchase Price)"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="vendor_id" string="ผู้ขาย (Vendor)" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                                    <field name="warranty_end" string="วันสิ้นสุดการรับประกัน (Warranty Expiry)"/>
                                </group>
                            </group>
                        </page>
                        <page name="maintenance" string="ประวัติซ่อมบำรุง (Maintenance Log)">
                            <field name="maintenance_ids" mode="tree,form" context="{'default_asset_id': id}">
                                <tree decoration-success="state == 'done'" decoration-muted="state == 'cancelled'">



                                    <field name="sent_date"/>
                                    <field name="symptom"/>


                                    <field name="state"/>
                                    <field name="completed_date" optional="show"/>
                                    <field name="technician_employee_id" optional="show"/>
                                    <field name="external_technician_name" optional="show"/>
                                    <field name="vendor_id" optional="hide"/>
                                    <field name="cost" sum="รวมค่าใช้จ่าย" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </tree>
                                <form string="ประวัติซ่อมบำรุง (Maintenance Log)">
                                    <header>
                                        <button name="action_start" type="object" string="เริ่มซ่อม" class="oe_highlight" invisible="state != 'sent'"/>
                                        <button name="action_done" type="object" string="ซ่อมเสร็จ" class="oe_highlight" invisible="state not in ['sent', 'in_progress']"/>
                                        <button name="action_cancel" type="object" string="ยกเลิก" invisible="state in ['done', 'cancelled']"/>
                                        <field name="state" widget="statusbar" statusbar_visible="sent,in_progress,done,cancelled"/>
                                    </header>
                                    <sheet>
                                        <group>
                                            <group string="ข้อมูลงานซ่อม (Repair Information)">

                                                <field name="asset_id" readonly="1"/>

                                                <field name="sent_date"/>
                                                <field name="completed_date" readonly="state == 'done'"/>
                                                <field name="symptom"/>
                                            </group>
                                            <group string="ช่างและค่าใช้จ่าย (Technician &amp; Cost)">
                                                <field name="technician_employee_id" domain="[('company_id', '=', company_id)]"/>
                                                <field name="external_technician_name"/>
                                                <field name="vendor_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
                                                <field name="cost"/>
                                                <field name="company_id" invisible="1"/>
                                                <field name="currency_id" invisible="1"/>
                                            </group>
                                        </group>
                                        <group string="รายละเอียดเพิ่มเติม (Additional Details)">
                                            <field name="attachment_ids" widget="many2many_binary"/>
                                            <field name="notes"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page name="assignments" string="ประวัติการส่งมอบ (Assignment History)">
                            <field name="assignment_ids" readonly="1">
                                <tree>
                                    <field name="employee_id"/>
                                    <field name="department_id"/>
                                    <field name="assigned_date"/>
                                    <field name="returned_date"/>
                                    <field name="assigned_by_id"/>
                                    <field name="returned_by_id"/>
                                    <field name="location_id"/>
                                </tree>
                            </field>
                        </page>
                        <page name="notes" string="หมายเหตุ (Notes)"><field name="notes"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_it_asset_category_tree" model="ir.ui.view">
        <field name="name">buz.it.asset.category.tree</field>
        <field name="model">buz.it.asset.category</field>
        <field name="arch" type="xml"><tree><field name="sequence" widget="handle"/><field name="name"/><field name="active"/></tree></field>
    </record>
    <record id="view_it_asset_category_form" model="ir.ui.view">
        <field name="name">buz.it.asset.category.form</field>
        <field name="model">buz.it.asset.category</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="sequence"/><field name="active"/></group><field name="description"/><notebook><page string="Types"><field name="type_ids"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="active"/></tree></field></page></notebook></sheet></form></field>
    </record>
    <record id="view_it_asset_location_tree" model="ir.ui.view">
        <field name="name">buz.it.asset.location.tree</field>
        <field name="model">buz.it.asset.location</field>
        <field name="arch" type="xml"><tree><field name="name"/><field name="company_id"/><field name="active"/></tree></field>
    </record>
    <record id="view_it_asset_location_form" model="ir.ui.view">
        <field name="name">buz.it.asset.location.form</field>
        <field name="model">buz.it.asset.location</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="active"/></group><field name="description"/></sheet></form></field>
    </record>
    <record id="view_it_asset_assignment_tree" model="ir.ui.view">
        <field name="name">buz.it.asset.assignment.tree</field>
        <field name="model">buz.it.asset.assignment</field>
        <field name="arch" type="xml"><tree create="0" delete="0"><field name="asset_id"/><field name="employee_id"/><field name="department_id"/><field name="assigned_date"/><field name="returned_date"/><field name="assigned_by_id"/><field name="returned_by_id"/><field name="location_id"/><field name="company_id"/></tree></field>
    </record>
    <record id="action_it_asset" model="ir.actions.act_window">
        <field name="name">All Hardware</field><field name="res_model">buz.it.asset</field><field name="view_mode">tree,form</field><field name="search_view_id" ref="view_it_asset_search"/>
    </record>
    <record id="action_my_hardware" model="ir.actions.act_window">
        <field name="name">My Hardware</field><field name="res_model">buz.it.asset</field><field name="view_mode">tree,form</field><field name="domain">['|', ('assigned_employee_id.user_id', '=', uid), ('responsible_department_id.member_ids.user_id', '=', uid)]</field><field name="search_view_id" ref="view_it_asset_search"/>
    </record>
    <record id="action_it_asset_categories" model="ir.actions.act_window">
        <field name="name">Hardware Categories</field><field name="res_model">buz.it.asset.category</field><field name="view_mode">tree,form</field>
    </record>
    <record id="view_it_asset_maintenance_readonly_extension" model="ir.ui.view">
        <field name="name">buz.it.asset.maintenance.readonly.extension</field>
        <field name="model">buz.it.asset</field>
        <field name="inherit_id" ref="view_it_asset_form"/>
        <field name="active">False</field>
        <field name="arch" type="xml"><data/></field>
    </record>
    <record id="view_it_asset_type_tree" model="ir.ui.view">
        <field name="name">buz.it.asset.type.tree</field><field name="model">buz.it.asset.type</field>
        <field name="arch" type="xml"><tree><field name="sequence" widget="handle"/><field name="name"/><field name="category_id"/><field name="active"/></tree></field>
    </record>
    <record id="view_it_asset_type_form" model="ir.ui.view">
        <field name="name">buz.it.asset.type.form</field><field name="model">buz.it.asset.type</field>
        <field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="category_id"/><field name="spec_profile"/><field name="sequence"/><field name="active"/></group><field name="description"/></sheet></form></field>
    </record>
    <record id="action_it_asset_types" model="ir.actions.act_window">
        <field name="name">Hardware Types</field><field name="res_model">buz.it.asset.type</field><field name="view_mode">tree,form</field>
    </record>
    <record id="action_it_asset_locations" model="ir.actions.act_window">
        <field name="name">Asset Locations</field><field name="res_model">buz.it.asset.location</field><field name="view_mode">tree,form</field>
    </record>
    <record id="action_it_asset_assignments" model="ir.actions.act_window">
        <field name="name">Assignment History</field><field name="res_model">buz.it.asset.assignment</field><field name="view_mode">tree</field><field name="view_id" ref="view_it_asset_assignment_tree"/>
    </record>
    <record id="view_it_asset_type_prefix_extension" model="ir.ui.view">
        <field name="name">buz.it.asset.type.prefix.extension</field>
        <field name="model">buz.it.asset.type</field>
        <field name="inherit_id" ref="view_it_asset_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="asset_prefix"/>
            </xpath>
        </field>
    </record>
</odoo>
