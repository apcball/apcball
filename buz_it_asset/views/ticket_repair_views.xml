<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_ticket_repair_extension" model="ir.ui.view">
        <field name="name">buz.helpdesk.ticket.repair.extension</field>
        <field name="model">buz.helpdesk.ticket</field>
        <field name="inherit_id" ref="buz_it_helpdesk.view_helpdesk_ticket_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_type_ids']" position="after">
                <field name="requester_asset_ids" invisible="1"/>
        <field name="asset_id" string="Asset / อุปกรณ์" domain="[('id', 'in', requester_asset_ids)]" options="{'no_create': True}" readonly="is_closed_stage or (not can_edit_repair_details and not is_draft_stage)"/>
                <field name="asset_type_id" string="Asset Type / ประเภทอุปกรณ์" readonly="1" invisible="not asset_id"/>
                <field name="company_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <field name="can_edit_repair_details" invisible="1"/>
                <field name="show_repair_process" invisible="1"/>
                <field name="has_legacy_repair_data" invisible="1"/>
                <field name="retire_proposed" invisible="1"/>
                <field name="repair_outcome_behavior" invisible="1"/>
            </xpath>

            <xpath expr="//field[@name='description']" position="after">
                <separator string="Repair Summary / สรุปการซ่อม" invisible="not show_repair_process"/>
                <group invisible="not show_repair_process">
                    <group>
                        <field name="repair_outcome_id" readonly="not can_edit_repair_details or not is_editable or is_closed_stage"/>
                        <field name="repair_result" readonly="not can_edit_repair_details or not is_editable or is_closed_stage"/>
                        <field name="repair_instructions" readonly="not can_edit_repair_details or not is_editable or is_closed_stage"/>
                    </group>
                    <group groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager">
                        <field name="diagnosis" readonly="not can_edit_repair_details or not is_editable or is_closed_stage"/>
                        <field name="replacement_asset_id" domain="[('company_id', '=', company_id), ('id', '!=', asset_id), ('active', '=', True), ('state', 'not in', ['retired', 'lost'])]" options="{'no_create': True}" invisible="repair_outcome_behavior != 'asset_replaced'" readonly="not can_edit_repair_details or not is_editable or is_closed_stage"/>
                        <field name="retire_reason" invisible="repair_outcome_behavior != 'retired'" readonly="not can_edit_repair_details or not is_editable or is_closed_stage"/>
                        <field name="retire_reason_detail" invisible="repair_outcome_behavior != 'retired'" readonly="not can_edit_repair_details or not is_editable or is_closed_stage"/>
                        <field name="retire_approved_by_id" invisible="repair_outcome_behavior != 'retired'" readonly="1" groups="buz_it_helpdesk.group_it_helpdesk_manager"/>
                        <field name="retire_approved_date" invisible="repair_outcome_behavior != 'retired'" readonly="1" groups="buz_it_helpdesk.group_it_helpdesk_manager"/>
                        <separator string="IT Attachments / ไฟล์แนบทีม IT"/>
                        <field name="it_attachment_ids" widget="buz_helpdesk_attachment_preview" nolabel="1" readonly="not can_edit_repair_details or not is_editable or is_closed_stage"/>
                    </group>
                </group>

                <group string="Replacement Parts / รายการอะไหล่" invisible="repair_outcome_behavior != 'parts_replaced'" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager">
                    <field name="repair_part_ids" readonly="not can_edit_repair_details or not is_editable or is_closed_stage">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="quantity"/>
                            <field name="old_serial"/>
                            <field name="new_serial"/>
                            <field name="unit_price"/>
                            <field name="currency_id" column_invisible="True"/>
                            <field name="notes"/>
                        </tree>
                    </field>
                </group>

                <group string="Legacy Repair Workflow (Read-only)" invisible="not has_legacy_repair_data" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager">
                    <group>
                        <field name="repair_route" readonly="1"/>
                        <field name="repair_substate" readonly="1"/>
                        <field name="asset_state_before_repair" readonly="1"/>
                        <field name="parts_details" readonly="1"/>
                        <field name="parts_responsible_id" readonly="1"/>
                        <field name="parts_order_date" readonly="1"/>
                        <field name="parts_received_date" readonly="1"/>
                        <field name="parts_reference" readonly="1"/>
                    </group>
                    <group>
                        <field name="external_sent_date" readonly="1"/>
                        <field name="external_expected_return_date" readonly="1"/>
                        <field name="external_return_date" readonly="1"/>
                        <field name="external_reference" readonly="1"/>
                        <field name="external_quote" readonly="1"/>
                        <field name="external_cost" readonly="1"/>
                        <field name="external_warranty" readonly="1"/>
                        <field name="external_test_result" readonly="1"/>
                    </group>
                    <group string="Legacy Requester Report">
                        <field name="requester_sent_date" readonly="1"/>
                        <field name="requester_expected_return_date" readonly="1"/>
                        <field name="requester_return_date" readonly="1"/>
                        <field name="requester_repair_result" readonly="1"/>
                        <field name="requester_cost" readonly="1"/>
                        <field name="requester_warranty" readonly="1"/>
                    </group>
                </group>
            </xpath>

            <xpath expr="//header/field[@name='stage_id']" position="before">
                <button name="action_propose_retirement" type="object" string="Propose Retirement" invisible="repair_outcome_behavior != 'retired' or retire_proposed or is_closed_stage" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager"/>
                <button name="action_approve_retirement" type="object" string="Approve Retirement" class="oe_highlight" invisible="repair_outcome_behavior != 'retired' or not retire_proposed or retire_approved_by_id" groups="buz_it_helpdesk.group_it_helpdesk_manager"/>
                <button name="action_reject_retirement" type="object" string="Reject Retirement" invisible="repair_outcome_behavior != 'retired' or not retire_proposed or retire_approved_by_id" groups="buz_it_helpdesk.group_it_helpdesk_manager"/>
            </xpath>
        </field>
    </record>

    <record id="view_it_asset_maintenance_readonly_extension" model="ir.ui.view">
        <field name="name">buz.it.asset.maintenance.readonly.extension</field>
        <field name="model">buz.it.asset</field>
        <field name="inherit_id" ref="buz_it_asset.view_it_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='maintenance_ids']" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
            <xpath expr="//field[@name='maintenance_ids']/tree/field[@name='repair_result']" position="after">
                <field name="repair_outcome" optional="show"/>
                <field name="replacement_asset_id" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='maintenance_ids']/form" position="attributes">
                <attribute name="edit">0</attribute>
                <attribute name="create">0</attribute>
                <attribute name="delete">0</attribute>
            </xpath>
            <xpath expr="//field[@name='maintenance_ids']/form//field[@name='symptom']" position="after">
                <field name="repair_outcome"/>
                <field name="repair_result"/>
                <field name="recommendations"/>
                <field name="performed_by_id"/>
                <field name="replacement_asset_id"/>
                <field name="diagnosis" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager"/>
                <field name="repair_part_ids" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager">
                    <tree create="0" delete="0">
                        <field name="name"/>
                        <field name="quantity"/>
                        <field name="old_serial"/>
                        <field name="new_serial"/>
                        <field name="unit_price"/>
                        <field name="currency_id" column_invisible="True"/>
                        <field name="notes"/>
                    </tree>
                </field>
            </xpath>
            <xpath expr="//field[@name='maintenance_ids']/form/header/button[@name='action_start']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='maintenance_ids']/form/header/button[@name='action_done']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='maintenance_ids']/form/header/button[@name='action_cancel']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
