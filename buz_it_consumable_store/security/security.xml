<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_request_company" model="ir.rule">         <field name="name">IT Consumable Request: allowed companies</field>         <field name="model_id" ref="model_buz_it_consumable_request"/>         <field name="domain_force">[('company_id', 'in', company_ids)]</field>     </record>
    <record id="rule_request_line_company" model="ir.rule">         <field name="name">IT Consumable Request Line: allowed companies</field>         <field name="model_id" ref="model_buz_it_consumable_request_line"/>         <field name="domain_force">[('request_id.company_id', 'in', company_ids)]</field>     </record>
    <record id="rule_request_requester_own" model="ir.rule">         <field name="name">IT Consumable Request: requester sees own requests</field>         <field name="model_id" ref="model_buz_it_consumable_request"/>         <field name="domain_force">[('requester_id', '=', user.id)]</field>         <field name="groups" eval="[(4, ref('buz_it_helpdesk.group_it_requester'))]"/>     </record>
    <record id="rule_request_it_all" model="ir.rule">         <field name="name">IT Consumable Request: IT team sees all requests</field>         <field name="model_id" ref="model_buz_it_consumable_request"/>         <field name="domain_force">[('id', '!=', 0)]</field>         <field name="groups" eval="[(4, ref('buz_it_helpdesk.group_it_support_agent')), (4, ref('buz_it_helpdesk.group_it_helpdesk_manager'))]"/>     </record>
    <record id="rule_request_line_requester_own" model="ir.rule">         <field name="name">IT Consumable Request Line: requester sees own lines</field>         <field name="model_id" ref="model_buz_it_consumable_request_line"/>         <field name="domain_force">[('request_id.requester_id', '=', user.id)]</field>         <field name="groups" eval="[(4, ref('buz_it_helpdesk.group_it_requester'))]"/>     </record>
    <record id="rule_request_line_it_all" model="ir.rule">         <field name="name">IT Consumable Request Line: IT team sees all lines</field>         <field name="model_id" ref="model_buz_it_consumable_request_line"/>         <field name="domain_force">[('id', '!=', 0)]</field>         <field name="groups" eval="[(4, ref('buz_it_helpdesk.group_it_support_agent')), (4, ref('buz_it_helpdesk.group_it_helpdesk_manager'))]"/>     </record>
</odoo>

