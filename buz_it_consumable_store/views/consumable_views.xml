<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         STORE (user kanban: เลือกอุปกรณ์)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_consumable_store_kanban" model="ir.ui.view">
        <field name="name">buz.it.consumable.store.kanban</field>
        <field name="model">buz.it.consumable</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id" class="o_kanban_mobile"
                    group_create="false" group_delete="false">
                <field name="name"/>
                <field name="image_1920"/>
                <field name="category_id"/>
                <field name="unit"/>
                <field name="on_hand_qty"/>
                <field name="low_stock"/>
                <field name="in_current_cart"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="o_kanban_record">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                </div>
                                <span class="badge text-bg-danger" t-if="record.low_stock.raw_value" title="ใกล้หมด">
                                    <i class="fa fa-exclamation-triangle"/> ใกล้หมด
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="o_consumable_image_wrap">
                                    <t t-if="record.image_1920.raw_value">
                                        <field name="image_1920" widget="image" class="o_consumable_image"/>
                                    </t>
                                    <t t-else="">
                                        <div class="o_consumable_placeholder">
                                            <i class="fa fa-cube" title="สินค้า"/>
                                        </div>
                                    </t>
                                </div>
                                <div class="o_consumable_stock">
                                    <span class="o_consumable_stock_qty"><field name="on_hand_qty"/></span>
                                    <span class="o_consumable_stock_unit"><field name="unit"/></span>
                                    <span class="text-muted">คงเหลือ</span>
                                </div>
                                <div class="text-muted small"><field name="category_id"/></div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <button name="action_add_to_cart" type="object"
                                        class="btn btn-primary btn-sm w-100"
                                        t-if="!record.in_current_cart.raw_value">
                                    เลือก
                                </button>
                                <span class="badge text-bg-success w-100 text-center"
                                      t-if="record.in_current_cart.raw_value">
                                    <i class="fa fa-check"/> ในรายการเบิกแล้ว
                                </span>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_consumable_search" model="ir.ui.view">
        <field name="name">buz.it.consumable.search</field>
        <field name="model">buz.it.consumable</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="ชื่อสินค้า"/>
                <field name="category_id" string="หมวดหมู่"/>
                <field name="unit" string="หน่วย"/>
                <filter name="low_stock" string="ใกล้หมด"
                        domain="[('low_stock', '=', True)]"/>
                <filter name="published" string="แสดงในหน้าร้าน"
                        domain="[('is_published', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="หมวดหมู่"
                            context="{'group_by': 'category_id'}"/>
                    <filter name="group_low_stock" string="สถานะคลัง"
                            context="{'group_by': 'low_stock'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ITEM MAINTENANCE (manager)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_consumable_tree" model="ir.ui.view">
        <field name="name">buz.it.consumable.tree</field>
        <field name="model">buz.it.consumable</field>
        <field name="arch" type="xml">
            <tree decoration-danger="low_stock">
                <field name="image_1920" widget="image" class="oe_avatar o_consumable_list_image"
                       options="{'preview_image': 'image_1920', 'zoom': true, 'zoom_delay': 0, 'size': [90, 90]}"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="unit"/>
                <field name="on_hand_qty" string="ยอดคงเหลือ"/>
                <field name="low_stock" string="ใกล้หมด"/>
                <field name="max_per_request" string="สูงสุดต่อคำขอ"/>
                <field name="is_published" string="แสดงในหน้าร้าน"/>
                <field name="company_id" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="view_consumable_form" model="ir.ui.view">
        <field name="name">buz.it.consumable.form</field>
        <field name="model">buz.it.consumable</field>
        <field name="arch" type="xml">
            <form string="รายการอุปกรณ์">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="image_1920" widget="image" class="oe_avatar"/>
                        </group>
                        <group>
                            <field name="category_id" options="{'no_create': True}"/>
                            <field name="unit"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="is_published"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="การจัดการคลัง"
                           groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager">
                        <group>
                            <field name="on_hand_qty"/>
                            <field name="low_stock"/>
                        </group>
                        <group>
                            <field name="max_per_request"/>
                            <field name="low_stock_threshold"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="รายละเอียด">
                            <field name="description" nolabel="1"
                                   placeholder="รายละเอียดเพิ่มเติมของสินค้า"/>
                        </page>
                        <page string="Stock ตาม Location"
                              groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager">
                            <field name="quant_ids" nolabel="1">
                                <tree>
                                    <field name="location_id"/>
                                    <field name="qty" string="จำนวน"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         CATEGORY
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_consumable_category_tree" model="ir.ui.view">
        <field name="name">buz.it.consumable.category.tree</field>
        <field name="model">buz.it.consumable.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_consumable_category_form" model="ir.ui.view">
        <field name="name">buz.it.consumable.category.form</field>
        <field name="model">buz.it.consumable.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ACTIONS
    ═══════════════════════════════════════════════════════════════ -->
    <record id="action_consumable_store" model="ir.actions.act_window">
        <field name="name">เลือกอุปกรณ์</field>
        <field name="res_model">buz.it.consumable</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_consumable_store_kanban"/>
        <field name="search_view_id" ref="view_consumable_search"/>
        <field name="domain">[('is_published', '=', True), ('active', '=', True)]</field>
        <field name="context">{'search_default_group_category': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                เลือกอุปกรณ์ที่ต้องการเบิก
            </p>
            <p>
                กด "เลือก" บนการ์ดสินค้าเพื่อเพิ่มเข้าในรายการเบิกครั้งนี้
                จากนั้นเปิดเมนู "รายการเบิกครั้งนี้" เพื่อส่งคำขอ
            </p>
        </field>
    </record>

    <record id="action_consumable_items" model="ir.actions.act_window">
        <field name="name">รายการอุปกรณ์</field>
        <field name="res_model">buz.it.consumable</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_consumable_search"/>
    </record>

    <record id="action_consumable_categories" model="ir.actions.act_window">
        <field name="name">หมวดหมู่</field>
        <field name="res_model">buz.it.consumable.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
