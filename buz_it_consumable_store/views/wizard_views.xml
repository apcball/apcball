<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════════
         ADD TO CART (เพิ่มในรายการเบิก)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_consumable_add_wizard_form" model="ir.ui.view">
        <field name="name">buz.it.consumable.add.wizard.form</field>
        <field name="model">buz.it.consumable.add.wizard</field>
        <field name="arch" type="xml">
            <form string="เพิ่มในรายการเบิก">
                <group>
                    <field name="consumable_id"/>
                    <field name="unit" readonly="1"/>
                    <field name="on_hand_qty" readonly="1"/>
                    <field name="max_per_request" readonly="1"/>
                    <field name="qty"/>
                </group>
                <footer>
                    <button name="action_add" string="เพิ่มในรายการ" type="object" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         DELIVER (จ่ายรายการ)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_consumable_deliver_wizard_form" model="ir.ui.view">
        <field name="name">buz.it.consumable.deliver.wizard.form</field>
        <field name="model">buz.it.consumable.deliver.wizard</field>
        <field name="arch" type="xml">
            <form string="จ่ายรายการ">
                <group>
                    <field name="line_id" invisible="1"/>
                    <field name="consumable_id" readonly="1"/>
                    <field name="unit" readonly="1"/>
                    <field name="requested_qty" readonly="1"/>
                    <field name="delivered_qty" readonly="1"/>
                    <field name="remaining_qty" readonly="1"/>
                    <field name="on_hand_qty" readonly="1"/>
                    <field name="location_ids" invisible="1"/>
                    <field name="location_id"/>
                    <field name="qty"/>
                </group>
                <footer>
                    <button name="action_deliver" string="จ่าย" type="object" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         REJECT (ปฏิเสธรายการ)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_consumable_reject_wizard_form" model="ir.ui.view">
        <field name="name">buz.it.consumable.reject.wizard.form</field>
        <field name="model">buz.it.consumable.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="ปฏิเสธรายการ">
                <group>
                    <field name="line_id" invisible="1"/>
                    <field name="consumable_id" readonly="1"/>
                    <field name="unit" readonly="1"/>
                    <field name="requested_qty" readonly="1"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_reject" string="ปฏิเสธรายการ" type="object" class="btn-danger"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         RECEIVE (รับของเข้า)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_stock_receive_wizard_form" model="ir.ui.view">
        <field name="name">buz.it.stock.receive.wizard.form</field>
        <field name="model">buz.it.stock.receive.wizard</field>
        <field name="arch" type="xml">
            <form string="รับของเข้า">
                <group>
                    <group>
                        <field name="move_date"/>
                        <field name="default_location_id"/>
                    </group>
                    <group>
                        <field name="company_id"/>
                    </group>
                </group>
                <group string="รายการรับเข้า">
                    <field name="line_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="consumable_id"/>
                            <field name="qty" string="จำนวน"/>
                            <field name="location_id"/>
                        </tree>
                    </field>
                </group>
                <group string="หมายเหตุ">
                    <field name="note" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_receive" string="รับของเข้า" type="object" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_receive" model="ir.actions.act_window">
        <field name="name">รับของเข้า</field>
        <field name="res_model">buz.it.stock.receive.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════════
         ADJUST (ปรับยอด)
    ═══════════════════════════════════════════════════════════════ -->
    <record id="view_stock_adjust_wizard_form" model="ir.ui.view">
        <field name="name">buz.it.stock.adjust.wizard.form</field>
        <field name="model">buz.it.stock.adjust.wizard</field>
        <field name="arch" type="xml">
            <form string="ปรับยอด Stock">
                <group>
                    <field name="consumable_id"/>
                    <field name="location_id"/>
                    <field name="current_qty" readonly="1"/>
                    <field name="new_qty"/>
                </group>
                <footer>
                    <button name="action_adjust" string="ปรับยอด" type="object" class="btn-primary"/>
                    <button string="ยกเลิก" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_stock_adjust" model="ir.actions.act_window">
        <field name="name">ปรับยอด</field>
        <field name="res_model">buz.it.stock.adjust.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
