<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_it_asset_renewal_notifications" model="ir.cron">
        <field name="name">IT Asset Renewal Notifications</field>
        <field name="model_id" ref="model_buz_it_asset_renewal"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_notifications()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=1, minute=0, second=0)"/>
        <field name="active">True</field>
    </record>
</odoo>
