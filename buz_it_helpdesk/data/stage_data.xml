<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stage_draft" model="buz.helpdesk.stage">
        <field name="name">Draft</field>
        <field name="code">draft</field>
        <field name="sequence">10</field>
    </record>
    <record id="stage_new" model="buz.helpdesk.stage">
        <field name="name">New</field>
        <field name="code">new</field>
        <field name="sequence">20</field>
    </record>
    <record id="stage_in_progress" model="buz.helpdesk.stage">
        <field name="name">In Progress</field>
        <field name="code">in_progress</field>
        <field name="sequence">30</field>
    </record>
    <record id="stage_pending_user" model="buz.helpdesk.stage">
        <field name="name">Pending User</field>
        <field name="code">pending_user</field>
        <field name="sequence">35</field>
    </record>
    <record id="stage_resolved" model="buz.helpdesk.stage">
        <field name="name">Resolved</field>
        <field name="code">resolved</field>
        <field name="sequence">40</field>
    </record>
    <record id="stage_closed" model="buz.helpdesk.stage">
        <field name="name">Closed</field>
        <field name="code">closed</field>
        <field name="sequence">50</field>
        <field name="fold">True</field>
    </record>
    <record id="stage_cancelled" model="buz.helpdesk.stage">
        <field name="name">Cancelled</field>
        <field name="code">cancelled</field>
        <field name="sequence">60</field>
        <field name="fold">True</field>
    </record>
</odoo>
