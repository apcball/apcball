<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_it_management" model="ir.module.category">
        <field name="name">IT Management</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_it_requester" model="res.groups">
        <field name="name">Requester</field>
        <field name="category_id" ref="module_category_it_management"/>
    </record>

    <record id="group_it_support_agent" model="res.groups">
        <field name="name">Support Agent</field>
        <field name="category_id" ref="module_category_it_management"/>
        <field name="implied_ids" eval="[(4, ref('group_it_requester'))]"/>
    </record>

    <record id="group_it_helpdesk_manager" model="res.groups">
        <field name="name">Helpdesk Manager</field>
        <field name="category_id" ref="module_category_it_management"/>
        <field name="implied_ids" eval="[(4, ref('group_it_support_agent'))]"/>
    </record>

    <record id="rule_ticket_requester_own" model="ir.rule">
        <field name="name">Helpdesk Ticket: requester sees company tickets</field>
        <field name="model_id" ref="model_buz_helpdesk_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_it_requester'))]"/>
    </record>

    <record id="rule_ticket_company" model="ir.rule">
        <field name="name">Helpdesk Ticket: allowed companies</field>
        <field name="model_id" ref="model_buz_helpdesk_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_ticket_agent_all" model="ir.rule">
        <field name="name">Helpdesk Ticket: agents see submitted tickets</field>
        <field name="model_id" ref="model_buz_helpdesk_ticket"/>
        <field name="domain_force" eval="[('stage_id', '!=', ref('buz_it_helpdesk.stage_draft'))]"/>
        <field name="groups" eval="[(4, ref('group_it_support_agent'))]"/>
    </record>

    <record id="rule_ticket_manager_all" model="ir.rule">
        <field name="name">Helpdesk Ticket: managers see all tickets</field>
        <field name="model_id" ref="model_buz_helpdesk_ticket"/>
        <field name="domain_force">[('id', '!=', 0)]</field>
        <field name="groups" eval="[(4, ref('group_it_helpdesk_manager'))]"/>
    </record>
    <record id="rule_sla_config_company" model="ir.rule">
        <field name="name">Helpdesk SLA: company</field>
        <field name="model_id" ref="model_buz_helpdesk_sla_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sla_holiday_company" model="ir.rule">
        <field name="name">Helpdesk SLA Holiday: company</field>
        <field name="model_id" ref="model_buz_helpdesk_sla_holiday"/>
        <field name="domain_force">[('config_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_sla_rule_company" model="ir.rule">
        <field name="name">Helpdesk SLA Rule: company</field>
        <field name="model_id" ref="model_buz_helpdesk_sla_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
