<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_it_helpdesk.HelpdeskLineConnection">
        <div class="o_helpdesk_line_settings o_line_connection_modal">
            <div t-if="state.loading" class="o_helpdesk_line_settings_loading" role="status"><i class="fa fa-spinner fa-spin me-2"/>กำลังโหลดข้อมูลการเชื่อมต่อ LINE...</div>
            <div t-elif="state.statusLoaded and state.softReminder and !state.connected" class="o_line_invitation">
                <button type="button" class="o_line_invitation_close" aria-label="ปิด" t-on-click="remindLater"><i class="fa fa-times" aria-hidden="true"/></button>
                <div class="o_line_invitation_brand" aria-hidden="true"><span>LINE</span></div>
                <div class="o_line_invitation_success"><i class="fa fa-check-circle" aria-hidden="true"/>สร้าง Ticket สำเร็จแล้ว</div>
                <h1>เชื่อมต่อ LINE ไม่พลาดการติดต่อจาก IT</h1>
                <p class="o_line_invitation_subtitle">รับข้อความสำคัญเกี่ยวกับ Ticket ได้สะดวกขึ้น</p>
                <div class="o_line_invitation_benefits">
                    <div class="o_line_invitation_benefit"><span class="o_line_benefit_icon"><i class="fa fa-commenting-o" aria-hidden="true"/></span><span>รับข้อความจากเจ้าหน้าที่ IT</span></div>
                    <div class="o_line_invitation_benefit"><span class="o_line_benefit_icon"><i class="fa fa-bell-o" aria-hidden="true"/></span><span>รับแจ้งผลเมื่อแก้ไขเสร็จ</span></div>
                    <div class="o_line_invitation_benefit"><span class="o_line_benefit_icon"><i class="fa fa-link" aria-hidden="true"/></span><span>เปิด Ticket จากลิงก์ใน LINE</span></div>
                </div>
                <div class="o_line_invitation_note">ยังสามารถติดตามและตอบกลับผ่าน Helpdesk ได้ตามปกติ</div>
                <div class="o_line_invitation_actions">
                    <button type="button" class="btn o_line_invitation_later" t-on-click="remindLater">ไว้ภายหลัง</button>
                    <button type="button" class="btn o_line_invitation_connect" t-on-click="startConnection"><span class="o_line_button_icon" aria-hidden="true">LINE</span>เชื่อมต่อ LINE<i class="fa fa-arrow-right" aria-hidden="true"/></button>
                </div>
            </div>
            <div t-else="" class="o_line_connection_body">
                <div class="o_line_settings_header">
                    <div class="o_line_brand_icon" aria-hidden="true"><span>LINE</span></div>
                    <div class="o_line_header_text">
                        <h1>เชื่อมต่อ LINE</h1>
                        <p>เชื่อมต่อบัญชี LINE เพื่อรับการแจ้งเตือน Ticket</p>
                    </div>
                    <button type="button" class="o_line_close" aria-label="ปิด" t-on-click="close"><i class="fa fa-times" aria-hidden="true"/></button>
                </div>
                <span t-if="!state.loading" t-att-class="'o_line_connection_badge ' + (state.connected ? 'is_connected' : 'is_disconnected')" role="status">
                    <i class="fa fa-circle" aria-hidden="true"/><t t-esc="state.connected ? 'เชื่อมต่อแล้ว' : 'ยังไม่ได้เชื่อมต่อ'"/>
                </span>
                <div class="o_helpdesk_line_settings_card o_line_connection_card">
                    <div t-if="state.error" class="alert alert-danger" role="alert"><t t-esc="state.error"/></div>
                    <div t-if="state.botName or state.basicId or state.pictureUrl" class="o_line_oa_identity">
                        <h2>LINE Official Account</h2>
                        <div class="o_line_oa_profile">
                            <img t-if="state.pictureUrl" t-att-src="state.pictureUrl" t-att-alt="state.botName"/>
                            <div class="o_line_brand_icon" t-else="" aria-hidden="true"><span>LINE</span></div>
                            <div class="o_line_oa_details">
                                <strong><t t-esc="state.botName"/></strong>
                                <div t-if="state.basicId" class="text-muted">OA ID: <t t-esc="state.basicId"/></div>
                            </div>
                        </div>
                    </div>
                    <div t-if="state.connected" class="o_line_connected_body">
                        <div class="alert alert-success">บัญชี LINE นี้เชื่อมต่อกับผู้ใช้ Odoo แล้ว <span t-if="state.masked" class="font-monospace"><t t-esc="state.masked"/></span></div>
                        <button type="button" class="btn btn-outline-danger" t-on-click="cancel">ยกเลิกการเชื่อมต่อ</button>
                    </div>
                    <div t-elif="!state.addFriendUrl" class="alert alert-warning">ยังไม่ได้ตั้งค่า LINE Official Account โปรดให้ Helpdesk Manager ตรวจสอบ Channel Access Token ใน LINE Settings.</div>
                    <div t-else="" class="o_line_connect_flow">
                        <div class="o_line_qr_desktop" t-if="state.qrDataUrl">
                            <h2>สแกน QR Code ด้วยมือถือ</h2>
                            <img t-att-src="state.qrDataUrl" alt="QR Code สำหรับเพิ่มเพื่อน LINE Official Account"/>
                            <span>สแกนเพื่อเพิ่มเพื่อน LINE</span>
                        </div>
                        <div class="o_line_connection_steps">
                            <h2>วิธีเชื่อมต่อ</h2>
                            <ol>
                                <li>สแกน QR แล้วกดเพิ่มเพื่อนใน LINE</li>
                                <li>กลับมาที่หน้านี้ แล้วสร้างรหัสเชื่อมต่อ</li>
                                <li>ส่งรหัสที่ได้ในแชต LINE OA</li>
                            </ol>
                        </div>
                        <a class="btn btn-success o_line_add_friend_mobile" t-att-href="state.addFriendUrl" target="_blank" rel="noopener"><i class="fa fa-comment me-2"/>เปิด LINE OA</a>
                        <div t-if="state.qrError" class="alert alert-warning o_line_qr_error" role="alert"><t t-esc="state.qrError"/></div>
                        <div t-if="state.code" class="o_line_connection_code">
                            <div>ส่งรหัสนี้ในแชต LINE Official Account</div>
                            <strong class="font-monospace"><t t-esc="state.code"/></strong>
                            <button type="button" class="btn btn-outline-primary" t-on-click="copyCode"><i class="fa fa-copy me-1"/>คัดลอกรหัส</button>
                            <small>รหัสมีอายุ 10 นาที</small>
                            <small t-if="state.remaining">หมดอายุเวลา <t t-esc="state.expiresAtText"/> (เหลือ <t t-esc="state.remaining"/> วินาที)</small>
                            <small t-else="" class="text-danger">รหัสหมดอายุแล้ว กรุณาสร้างรหัสใหม่</small>
                        </div>
                        <button type="button" class="btn btn-success o_line_create_code" t-on-click="createCode" t-att-disabled="state.remaining > 0"><t t-esc="state.code ? 'สร้างรหัสใหม่' : 'ฉันเพิ่มเพื่อนแล้ว — สร้างรหัส'"/></button>
                        <small class="o_line_code_hint">รหัสใช้ได้ครั้งเดียวและหมดอายุภายใน 10 นาที</small>
                        <div class="o_line_waiting_status" t-if="state.code and state.remaining" role="status"><i class="fa fa-spinner fa-spin me-2"/>กำลังรอ LINE ยืนยันการเชื่อมต่อ...</div>
                    </div>
                    <div class="o_line_modal_footer"><button type="button" class="btn btn-secondary" t-on-click="close">ปิด</button></div>
                </div>
            </div>
        </div>
    </t>
</templates>
