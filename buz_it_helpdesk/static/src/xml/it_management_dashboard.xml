<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_it_helpdesk.ItManagementDashboard">
        <div class="o_it_management_dashboard" t-att-class="{'is-collapsed': state.sidebarCollapsed}">
            <aside class="o_it_management_sidebar" aria-label="IT Management Dashboard sections">
                <div class="o_it_management_brand"><span class="o_it_management_brand_mark">IT</span><span class="o_it_management_brand_text">IT MANAGEMENT</span></div>
                <button type="button" class="o_it_management_sidebar_toggle" t-on-click="toggleSidebar" t-att-aria-label="state.sidebarCollapsed ? 'Expand dashboard navigation' : 'Collapse dashboard navigation'"><i t-att-class="state.sidebarCollapsed ? 'fa fa-chevron-right' : 'fa fa-chevron-left'"/></button>
                <nav class="o_it_management_nav_group" aria-label="Dashboard sections">
                    <button type="button" class="o_it_management_nav" t-att-class="{'active': state.section == 'overview'}" t-on-click="() => selectSection('overview')"><i class="fa fa-home"/><span>Overview</span></button>
                    <button type="button" class="o_it_management_nav" t-att-class="{'active': state.section == 'helpdesk'}" t-on-click="() => selectSection('helpdesk')"><i class="fa fa-life-ring"/><span>Helpdesk</span></button>
                    <button type="button" class="o_it_management_nav" t-att-class="{'active': state.section == 'asset'}" t-on-click="() => selectSection('asset')"><i class="fa fa-laptop"/><span>IT Asset</span></button>
                </nav>
            </aside>
            <main class="o_it_management_main">
                <header class="o_it_management_header">
                    <div class="o_it_management_heading"><p class="o_it_management_eyebrow">IT MANAGEMENT</p><h1>IT Management</h1><p>Operational overview</p></div>
                    <div class="o_it_management_filter_bar" role="group" aria-label="Dashboard filters">
                        <label class="o_it_management_control"><span>Company</span><select name="company_id" t-on-change="onFilterChange" t-att-disabled="state.loading"><option value="">All companies</option><t t-foreach="state.data?.options?.companies || []" t-as="company" t-key="company.id"><option t-att-value="company.id" t-att-selected="isCompanySelected(company.id)"><t t-esc="company.label"/></option></t></select></label>
                        <label class="o_it_management_control"><span>From</span><input type="date" name="date_from" t-att-value="state.filters.date_from" t-on-change="onFilterChange" t-att-disabled="state.loading"/></label>
                        <label class="o_it_management_control"><span>To</span><input type="date" name="date_to" t-att-value="state.filters.date_to" t-on-change="onFilterChange" t-att-disabled="state.loading"/></label>
                        <button type="button" class="btn btn-outline-secondary o_it_management_refresh" t-on-click="refresh" t-att-disabled="state.loading"><i class="fa fa-refresh"/> <span>Refresh</span></button>
                    </div>
                </header>
                <div class="o_it_management_meta"><span>Last updated: <strong><t t-esc="lastUpdatedLabel"/></strong></span><span class="o_it_management_section_label"><t t-esc="state.section"/></span></div>
                <div t-if="state.loading" class="o_it_management_state o_it_management_loading" role="status" aria-live="polite"><div class="o_it_management_skeleton o_it_management_skeleton_kpi"/><div class="o_it_management_skeleton o_it_management_skeleton_kpi"/><div class="o_it_management_skeleton o_it_management_skeleton_kpi"/><div class="o_it_management_skeleton o_it_management_skeleton_panel"/><strong>Loading selected dashboard</strong></div>
                <div t-elif="state.error" class="o_it_management_state o_it_management_error" role="alert"><i class="fa fa-exclamation-triangle"/><strong>Dashboard data could not be loaded</strong><span>Check your filters and try again.</span><button type="button" class="btn btn-outline-danger" t-on-click="refresh">Try again</button></div>
                <t t-elif="state.section == 'helpdesk'"><HelpdeskDashboard t-key="filterKey" t-props="{ embedded: true, filters: state.filters }"/></t>
                <section t-elif="state.section == 'overview'" class="o_it_management_section">
                    <div class="o_it_management_kpis"><t t-foreach="state.data?.kpis || []" t-as="kpi" t-key="kpi.code"><button class="o_it_management_kpi" t-on-click="() => openSource({...kpi, res_model: kpi.code.startsWith('open') || kpi.code.includes('sla') ? 'it.helpdesk.ticket' : 'buz.it.asset'}, kpi.label)"><span><t t-esc="kpi.label"/></span><strong><t t-esc="kpi.count"/></strong></button></t></div>
                    <div class="o_it_management_cards"><article><h2>Helpdesk Status</h2><t t-foreach="state.data?.tickets || []" t-as="row" t-key="row.code"><button class="o_it_management_row" t-on-click="() => openSource({...row, res_model: 'it.helpdesk.ticket'}, row.label)"><span><t t-esc="row.label"/></span><strong><t t-esc="row.count"/></strong></button></t><div t-if="!state.data?.tickets?.length" class="o_it_management_panel_empty">No Helpdesk data for the selected filters.</div></article><article><h2>Asset Status</h2><t t-foreach="state.data?.assets || []" t-as="row" t-key="row.code"><button class="o_it_management_row" t-on-click="() => openSource({...row, res_model: 'buz.it.asset'}, row.label)"><span><t t-esc="row.label"/></span><strong><t t-esc="row.count"/></strong></button></t><div t-if="!state.data?.assets?.length" class="o_it_management_panel_empty">No Asset data for the selected filters.</div></article></div>
                    <div t-if="!hasData" class="o_it_management_empty"><i class="fa fa-inbox"/><strong>No dashboard data</strong><span>No records match the selected filters.</span></div>
                </section>
                <section t-elif="state.section == 'asset'" class="o_it_management_section"><div class="o_it_management_kpis"><t t-foreach="state.data?.kpis || []" t-as="kpi" t-key="kpi.code"><button class="o_it_management_kpi" t-on-click="() => openSource({...kpi, res_model: 'buz.it.asset'}, kpi.label)"><span><t t-esc="kpi.label"/></span><strong><t t-esc="kpi.count"/></strong></button></t></div><div class="o_it_management_cards"><article><h2>Status</h2><t t-foreach="state.data?.status || []" t-as="row" t-key="row.code"><button class="o_it_management_row" t-on-click="() => openSource({...row, res_model: 'buz.it.asset'}, row.label)"><span><t t-esc="row.label"/></span><strong><t t-esc="row.count"/></strong></button></t><div t-if="!state.data?.status?.length" class="o_it_management_panel_empty">No status data.</div></article><article><h2>By Type</h2><t t-foreach="state.data?.types || []" t-as="row" t-key="row.label"><button class="o_it_management_row" t-on-click="() => openSource({...row, res_model: 'buz.it.asset'}, row.label)"><span><t t-esc="row.label"/></span><strong><t t-esc="row.count"/></strong></button></t><div t-if="!state.data?.types?.length" class="o_it_management_panel_empty">No type data.</div></article><article><h2>By Department</h2><t t-foreach="state.data?.departments || []" t-as="row" t-key="row.label"><button class="o_it_management_row" t-on-click="() => openSource({...row, res_model: 'buz.it.asset'}, row.label)"><span><t t-esc="row.label"/></span><strong><t t-esc="row.count"/></strong></button></t><div t-if="!state.data?.departments?.length" class="o_it_management_panel_empty">No department data.</div></article></div><div t-if="!hasData" class="o_it_management_empty"><i class="fa fa-inbox"/><strong>No asset data</strong><span>No records match the selected filters.</span></div></section>
            </main>
        </div>
    </t>
</templates>