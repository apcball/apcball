<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_approval_reject_wizard" model="ir.ui.view">
        <field name="name">buz.helpdesk.approval.reject.wizard.form</field>
        <field name="model">buz.helpdesk.approval.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Approval">
                <group>
                    <field name="ticket_id"/>
                    <field name="reason" placeholder="Explain why this request is rejected..."/>
                </group>
                <footer>
                    <button name="action_confirm" string="Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
