<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_category_list" model="ir.ui.view">
        <field name="name">buz.helpdesk.category.list</field>
        <field name="model">buz.helpdesk.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_helpdesk_category_form" model="ir.ui.view">
        <field name="name">buz.helpdesk.category.form</field>
        <field name="model">buz.helpdesk.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_helpdesk_categories" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">buz.helpdesk.category</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
