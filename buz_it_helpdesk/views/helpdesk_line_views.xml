<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_line_config_form" model="ir.ui.view">
        <field name="name">buz.helpdesk.line.config.form</field>
        <field name="model">buz.helpdesk.line.config</field>
        <field name="arch" type="xml">
            <form string="LINE Notification">
                <header>
                    <button name="action_test_connection" string="Test Connection" type="object" class="btn-primary" invisible="not channel_access_token"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                        <field name="channel_access_token" password="True"/>
                        <field name="channel_secret" password="True"/>
                        <field name="webhook_url" placeholder="https://your-odoo-domain/buz_it_helpdesk/line/webhook"/>
                    </group>
                    <p class="text-muted">Invite the LINE Official Account to a group and send a message. The group will then appear under LINE Groups.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_helpdesk_line_group_tree" model="ir.ui.view">
        <field name="name">buz.helpdesk.line.group.tree</field>
        <field name="model">buz.helpdesk.line.group</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="line_group_id"/>
                <field name="active"/>
                <field name="event_count"/>
                <field name="last_event_date"/>
                <field name="company_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>
    <record id="view_helpdesk_line_group_form" model="ir.ui.view">
        <field name="name">buz.helpdesk.line.group.form</field>
        <field name="model">buz.helpdesk.line.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet><group><field name="name"/><field name="line_group_id"/><field name="active"/><field name="event_count" readonly="1"/><field name="last_event_date" readonly="1"/><field name="company_ids" widget="many2many_tags" readonly="1"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="view_helpdesk_line_queue_tree" model="ir.ui.view">
        <field name="name">buz.helpdesk.line.queue.tree</field>
        <field name="model">buz.helpdesk.line.queue</field>
        <field name="arch" type="xml">
            <tree create="0" delete="0">
                <field name="create_date"/>
                <field name="ticket_id"/>
                <field name="company_id"/>
                <field name="line_group_id"/>
                <field name="state"/>
                <field name="attempt_count"/>
                <field name="next_attempt_at"/>
                <field name="last_error"/>
            </tree>
        </field>
    </record>
    <record id="view_helpdesk_line_queue_form" model="ir.ui.view">
        <field name="name">buz.helpdesk.line.queue.form</field>
        <field name="model">buz.helpdesk.line.queue</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header><button name="action_retry" string="Retry" type="object" class="btn-primary" invisible="state != 'failed'"/></header>
                <sheet><group><field name="ticket_id" readonly="1"/><field name="company_id" readonly="1"/><field name="line_group_id" readonly="1"/><field name="state" readonly="1"/><field name="attempt_count" readonly="1"/><field name="next_attempt_at" readonly="1"/><field name="sent_at" readonly="1"/><field name="retry_key" readonly="1"/><field name="message" readonly="1"/><field name="last_error" readonly="1"/></group></sheet>
            </form>
        </field>
    </record>
    <record id="action_helpdesk_line_config" model="ir.actions.act_window">
        <field name="name">LINE Settings</field><field name="res_model">buz.helpdesk.line.config</field><field name="view_mode">form</field><field name="res_id" ref="line_config_default"/>
    </record>
    <record id="action_helpdesk_line_groups" model="ir.actions.act_window">
        <field name="name">LINE Groups</field><field name="res_model">buz.helpdesk.line.group</field><field name="view_mode">tree,form</field>
    </record>
    <record id="action_helpdesk_line_queue" model="ir.actions.act_window">
        <field name="name">LINE Notification Queue</field><field name="res_model">buz.helpdesk.line.queue</field><field name="view_mode">tree,form</field>
    </record>
    <record id="view_res_company_helpdesk_line" model="ir.ui.view">
        <field name="name">res.company.form.helpdesk.line</field><field name="model">res.company</field><field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='currency_id']" position="after"><field name="helpdesk_line_enabled" groups="buz_it_helpdesk.group_it_helpdesk_manager"/><field name="helpdesk_line_group_id" options="{'no_create': True}" groups="buz_it_helpdesk.group_it_helpdesk_manager"/></xpath></field>
    </record>
</odoo>
