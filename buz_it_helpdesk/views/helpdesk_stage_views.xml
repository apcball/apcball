<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_stage_list" model="ir.ui.view">
        <field name="name">buz.helpdesk.stage.list</field>
        <field name="model">buz.helpdesk.stage</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="fold"/>
                <field name="active"/>
            </tree>
        </field>
    </record>
    <record id="view_helpdesk_stage_form" model="ir.ui.view">
        <field name="name">buz.helpdesk.stage.form</field>
        <field name="model">buz.helpdesk.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="fold"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_helpdesk_stages" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">buz.helpdesk.stage</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
