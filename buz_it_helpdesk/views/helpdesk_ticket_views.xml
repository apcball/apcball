<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">buz.helpdesk.ticket.search</field>
        <field name="model">buz.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="assigned_user_id"/>
                <field name="category_id"/>
                <field name="category_type_id"/>
                <field name="team_id"/>
                <field name="stage_id"/>
                <filter name="my_tickets" string="My Tickets" domain="[('requester_id', '=', uid)]"/>
                <filter name="open" string="Open" domain="[('active', '=', True)]"/>
                <filter name="closed" string="Archived" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_stage" string="Stage" context="{'group_by': 'stage_id'}"/>
                    <filter name="group_team" string="Team" context="{'group_by': 'team_id'}"/>
                    <filter name="group_department" string="Department" context="{'group_by': 'department_id'}"/>
                    <filter name="group_priority" string="Priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">buz.helpdesk.ticket.list</field>
        <field name="model">buz.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <tree default_order="create_date desc">
                <field name="name"/>
                <field name="subject"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="team_id"/>
                <field name="category_type_id"/>
                <field name="assigned_user_id"/>
                <field name="stage_id"/>
                <field name="priority" widget="priority"/>
            </tree>
        </field>
    </record>
    <record id="view_helpdesk_ticket_kanban" model="ir.ui.view">
        <field name="name">buz.helpdesk.ticket.kanban</field>
        <field name="model">buz.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id"
                    group_create="true"
                    group_edit="true"
                    group_delete="true"
                    records_draggable="true"
                    class="o_kanban_mobile">
                <field name="name"/>
                <field name="subject"/>
                <field name="description"/>
                <field name="requester_id"/>
                <field name="priority"/>
                <field name="stage_id"/>
                <field name="team_id"/>
                <field name="category_id"/>
                <field name="category_type_id"/>
                <field name="assigned_user_id"/>
                <field name="create_date"/>
                <field name="active"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_ticket_card {{ record.priority.raw_value == '3' ? 'ticket-urgent' : record.priority.raw_value == '2' ? 'ticket-high' : record.priority.raw_value == '1' ? 'ticket-normal' : 'ticket-low' }}">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    <div class="o_kanban_record_subtitle text-truncate"><field name="subject"/></div>
                                </div>
                                <div class="o_kanban_record_top_right">
                                    <span t-attf-class="badge o_kanban_ticket_priority {{ record.priority.raw_value == '3' ? 'text-bg-danger' : record.priority.raw_value == '2' ? 'text-bg-warning' : record.priority.raw_value == '1' ? 'text-bg-info' : 'text-bg-secondary' }}">
                                        <field name="priority"/>
                                    </span>
                                    <span t-attf-class="badge o_kanban_ticket_stage {{ record.stage_id.value == 'In Progress' ? 'ticket-stage-progress' : record.stage_id.value == 'Pending User' ? 'ticket-stage-pending' : record.stage_id.value == 'New' ? 'ticket-stage-new' : record.stage_id.value == 'Resolved' ? 'ticket-stage-resolved' : record.stage_id.value == 'Closed' ? 'ticket-stage-closed' : 'ticket-stage-draft' }}">
                                        <field name="stage_id"/>
                                    </span>
                                    <div class="o_dropdown_kanban dropdown">
                                        <a role="button" class="dropdown-toggle o-no-caret btn btn-sm" data-bs-toggle="dropdown" title="Actions">
                                            <i class="fa fa-ellipsis-v" role="img" aria-label="Actions"/>
                                        </a>
                                        <div class="dropdown-menu" t-name="dropdown-menu" role="menu">
                                            <a role="menuitem" t-if="record.active.raw_value" class="dropdown-item" type="archive">Archive</a>
                                            <a role="menuitem" t-if="!record.active.raw_value" class="dropdown-item" type="unarchive">Unarchive</a>
                                            <a role="menuitem" class="dropdown-item" type="delete">Delete</a>
                                            <a role="menuitem" class="dropdown-item" type="object" name="copy">Duplicate</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div class="o_kanban_ticket_description text-muted small text-truncate" t-if="record.description.raw_value">
                                    <field name="description"/>
                                </div>
                                <div class="o_kanban_ticket_badges">
                                    <span t-if="record.category_id.raw_value" class="badge text-bg-light border text-truncate">
                                        <i class="fa fa-tag me-1" title="Category"/>
                                        <field name="category_id"/>
                                    </span>
                                    <span t-if="record.category_type_id.raw_value" class="badge text-bg-light border text-truncate">
                                        <field name="category_type_id"/>
                                    </span>
                                </div>
                                <div class="text-muted small text-truncate">
                                    <i class="fa fa-user-o me-1" title="Requester"/>
                                    <field name="requester_id"/>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="o_kanban_ticket_assignee">
                                    <div class="o_kanban_ticket_assignee_name text-muted small text-truncate">
                                        <i class="fa fa-user-o me-1" aria-hidden="true" title="Assigned To"/>
                                        <span t-if="record.assigned_user_id.raw_value"><field name="assigned_user_id"/></span>
                                        <span t-else="">Unassigned</span>
                                    </div>
                                    <div class="o_kanban_ticket_assignee_team text-muted small text-truncate" t-if="record.team_id.raw_value">
                                        <i class="fa fa-users me-1" aria-hidden="true" title="Team"/>
                                        <field name="team_id"/>
                                    </div>
                                </div>
                                <div class="text-muted small text-nowrap">
                                    <i class="fa fa-clock-o me-1" title="Created On"/>
                                    <field name="create_date" widget="date"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">buz.helpdesk.ticket.form</field>
        <field name="model">buz.helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': False}"/>
                    <button name="action_create_ticket" string="Create Ticket" type="object" class="btn-primary" invisible="not is_draft_stage"/>
                    <button name="action_receive_ticket" string="Receive Ticket" type="object" class="btn-primary" invisible="not show_receive_button" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager"/>
                    <button name="action_request_user" string="Waiting for User" type="object" class="btn-secondary" invisible="not show_pending_user_button" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager"/>
                    <button name="action_resume_work" string="Resume Work" type="object" class="btn-primary" invisible="not show_resume_work_button" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager"/>
                    <button name="action_mark_resolved" string="Mark Resolved" type="object" class="btn-success" invisible="not show_resolve_button" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager"/>
                    <button name="action_confirm_resolution" string="Confirm Resolution" type="object" class="btn-primary" invisible="not show_confirm_resolution_button" groups="buz_it_helpdesk.group_it_requester"/>
                    <button name="action_request_rework" string="Request Rework" type="object" class="btn-secondary" invisible="not show_confirm_resolution_button" groups="buz_it_helpdesk.group_it_requester"/>
                    <button name="action_close_ticket" string="Close Ticket" type="object" class="btn-danger" invisible="not show_close_button" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager"/>
                    <button name="action_contact_user_via_line" string="Contact User via LINE" type="object" class="btn-secondary" invisible="not show_contact_line_button" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager"/>
                    <button name="action_open_line_connection" string="LINE Connection" type="object" class="btn-secondary" invisible="not show_line_connection_shortcut" groups="buz_it_helpdesk.group_it_requester"/>
                    <field name="is_draft_stage" invisible="1"/>
                    <field name="is_closed_stage" invisible="1"/>
                    <field name="show_receive_button" invisible="1"/>
                    <field name="show_pending_user_button" invisible="1"/>
                    <field name="show_resume_work_button" invisible="1"/>
                    <field name="show_resolve_button" invisible="1"/>
                    <field name="show_close_button" invisible="1"/>
                    <field name="show_confirm_resolution_button" invisible="1"/>

                    <field name="show_contact_line_button" invisible="1"/>
                    <field name="show_line_connection_shortcut" invisible="1"/>
                    <field name="is_editable" invisible="1"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Closed" bg_color="text-bg-danger" invisible="not is_closed_stage"/>
                    <div class="oe_title">
                        <label for="subject" string="หัวข้อ / Subject" class="oe_edit_only"/>
                        <h1><field name="subject" placeholder="ระบุหัวข้อ Ticket / Enter ticket subject" readonly="not is_editable"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" string="เลขที่ Ticket / Ticket Number" readonly="1"/>
                            <field name="create_ticket_date" string="วันที่สร้าง Ticket / Ticket Created Date" readonly="1"/>
                            <field name="closed_ticket_date" string="วันที่ปิด Ticket / Ticket Closed Date" readonly="1"/>
                            <field name="requester_id" string="ผู้แจ้ง / Requester" readonly="not is_editable"/>
                            <field name="department_id" string="แผนก / Department" readonly="1"/>
                            <field name="priority" string="ความสำคัญ / Priority" widget="priority" options="{'autosave': False}" readonly="not is_editable"/>
                        </group>
                        <group>
                            <field name="category_id" string="หมวดหมู่ / Category" readonly="not is_editable"/>
                            <field name="category_type_id" string="ประเภท / Type" readonly="not is_editable"
                                   domain="[('id', 'in', category_type_ids)]"
                                   invisible="not show_category_type"/>
                            <field name="category_type_ids" invisible="1"/>
                            <field name="show_category_type" invisible="1"/>
                            <field name="team_id" string="ทีม / Team" readonly="not can_manage_assignment" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager"/>
                            <field name="assigned_user_id" string="ผู้รับผิดชอบ / Assigned To" readonly="not can_manage_assignment" groups="buz_it_helpdesk.group_it_support_agent,buz_it_helpdesk.group_it_helpdesk_manager"
                                   domain="[('id', 'in', team_user_ids)]"
                                   options="{'no_create': True}"/>
                            <field name="team_user_ids" invisible="1"/>
                            <field name="can_manage_assignment" invisible="1"/>
                            <field name="active" string="ใช้งาน / Active" readonly="not is_editable"/>
                        </group>
                    </group>
                    <separator string="ไฟล์แนบ / Attachments"/>
                    <field name="attachment_ids" widget="buz_helpdesk_attachment_preview" nolabel="1" readonly="not is_editable"/>
                    <separator string="รายละเอียด / Description"/>
                    <field name="description" nolabel="1" readonly="not is_editable"/>
                </sheet>
                <div class="oe_chatter">
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="action_helpdesk_my_tickets" model="ir.actions.act_window">
        <field name="name">My Tickets</field>
        <field name="res_model">buz.helpdesk.ticket</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_helpdesk_ticket_search"/>
        <field name="domain">[]</field>
        <field name="context">{'default_requester_id': uid, 'search_default_my_tickets': 1}</field>
    </record>
    <record id="action_helpdesk_tickets" model="ir.actions.act_window">
        <field name="name">Tickets</field>
        <field name="res_model">buz.helpdesk.ticket</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_helpdesk_ticket_search"/>
        <field name="domain" eval="[('stage_id', '!=', ref('buz_it_helpdesk.stage_draft'))]"/>
    </record>
</odoo>
