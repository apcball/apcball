<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_it_inventory.ItStore">
        <main class="o_it_store">
            <div class="o_it_store_breadcrumb">IT Management / IT Store</div>
            <div class="o_it_store_header"><div><h1>IT Store</h1><p>เลือกอุปกรณ์และวัสดุสิ้นเปลือง หรือดูสถานะคำขอของคุณ</p></div><button class="btn btn-light" t-on-click="refreshCurrentTab"><i class="fa fa-refresh"/></button></div>
            <nav class="o_it_store_tabs" role="tablist"><button type="button" t-att-class="state.tab === 'catalog' ? 'btn btn-primary' : 'btn btn-light'" t-on-click="() => setTab('catalog')">เบิกสินค้า</button><button type="button" t-att-class="state.tab === 'requests' ? 'btn btn-primary' : 'btn btn-light'" t-on-click="() => setTab('requests')">คำขอของฉัน <span t-if="state.activeCount" class="badge rounded-pill bg-danger"><t t-esc="state.activeCount"/></span></button></nav>
            <t t-if="state.tab === 'catalog'">
                <div class="o_it_store_toolbar"><div class="o_it_store_search"><i class="fa fa-search"/><input type="search" placeholder="ค้นหาอุปกรณ์หรือวัสดุ..." t-model="state.search"/></div><div class="o_it_store_categories"><button t-att-class="state.categoryId ? 'btn btn-light' : 'btn btn-primary'" t-on-click="() => selectCategory(null)">ทั้งหมด</button><t t-foreach="state.categories" t-as="category" t-key="category.id"><button t-att-class="state.categoryId === category.id ? 'btn btn-primary' : 'btn btn-light'" t-on-click="() => selectCategory(category.id)"><t t-esc="category.name"/></button></t></div></div>
                <div t-if="state.catalogError" class="alert alert-danger"><t t-esc="state.catalogError"/></div>
                <div t-elif="state.loading" class="o_it_store_loading"><i class="fa fa-spinner fa-spin"/> กำลังโหลดรายการอุปกรณ์...</div>
                <div t-elif="!filteredItems.length" class="o_it_store_empty">ไม่พบรายการอุปกรณ์ที่ตรงกับเงื่อนไข</div>
                <div t-else="" class="o_it_store_layout"><section class="o_it_store_grid"><t t-foreach="filteredItems" t-as="item" t-key="item.id"><article t-att-class="'o_it_store_card o_it_store_card_' + item.store_status"><div class="o_it_store_card_image"><img t-if="item.image_1920" t-att-src="imageUrl(item)" t-att-alt="item.name"/><i t-else="" class="fa fa-cube o_it_store_placeholder"/></div><div class="o_it_store_card_body"><h2><t t-esc="item.name"/></h2><p class="o_it_store_card_meta"><t t-esc="itemTypeLabel(item)"/></p><p class="o_it_store_card_unit">หน่วย: <t t-esc="item.unit"/></p><div t-att-class="'o_it_store_stock_line o_it_store_stock_' + item.store_status"><span class="o_it_store_stock_dot"/><strong><t t-esc="statusLabel(item)"/> <t t-esc="item.available_qty"/> <t t-esc="item.unit"/></strong></div><div class="o_it_store_card_actions"><div class="o_it_store_stepper"><button type="button" t-att-disabled="selectionQuantity(item) &lt;= 1" t-on-click="() => setSelectionQuantity(item, selectionQuantity(item) - 1)">−</button><span><t t-esc="selectionQuantity(item)"/></span><button type="button" t-att-disabled="!canIncreaseSelection(item)" t-on-click="() => setSelectionQuantity(item, selectionQuantity(item) + 1)">+</button></div><button type="button" class="btn btn-outline-primary o_it_store_add" t-att-disabled="!selectionQuantity(item)" t-on-click="() => addSelectedItem(item)">เพิ่มในคำขอ</button></div></div></article></t></section><aside class="o_it_store_cart"><div class="o_it_store_cart_header"><div><h2>คำขอเบิกของฉัน</h2><span><t t-esc="cartCount"/> รายการ</span></div><i class="fa fa-shopping-basket"/></div><div t-if="!cartLines.length" class="o_it_store_cart_empty"><i class="fa fa-shopping-basket"/><p>ยังไม่มีรายการในคำขอ</p><small>เลือกอุปกรณ์จากรายการด้านซ้าย</small></div><div t-else="" class="o_it_store_cart_lines"><div t-foreach="cartLines" t-as="line" t-key="line.item.id" class="o_it_store_cart_line"><div class="o_it_store_cart_line_image"><img t-if="line.item.image_1920" t-att-src="imageUrl(line.item)" t-att-alt="line.item.name"/><i t-else="" class="fa fa-cube"/></div><div class="o_it_store_cart_line_info"><strong><t t-esc="line.item.name"/></strong><span><t t-esc="line.quantity"/> <t t-esc="line.item.unit"/></span></div><button class="btn btn-link o_it_store_remove" t-on-click="() => removeItem(line.item)"><i class="fa fa-trash"/></button></div></div><button class="btn btn-primary o_it_store_submit" t-att-disabled="!cartLines.length || state.submitting" t-on-click="openCreateModal"><i t-if="state.submitting" class="fa fa-spinner fa-spin"/><t t-else="">สร้างคำขอเบิก</t></button></aside></div>
                <div t-if="state.lastCreatedRequest" class="alert alert-success o_it_store_created_alert">สร้างคำขอ <strong><t t-esc="state.lastCreatedRequest.request_name"/></strong> แล้ว <button class="btn btn-link p-0" t-on-click="() => { setTab('requests'); openRequest({id: state.lastCreatedRequest.request_id}); }">ดูคำขอ</button><button class="btn-close float-end" t-on-click="() => state.lastCreatedRequest = null"/></div>
            </t>
            <t t-else=""><div class="o_it_store_request_toolbar"><div class="o_it_store_search"><i class="fa fa-search"/><input type="search" placeholder="ค้นหาเลขคำขอหรือเหตุผล..." t-model="state.requestSearch" t-on-change="loadRequests"/></div><button class="btn btn-light" t-on-click="loadRequests"><i class="fa fa-refresh"/></button></div><div t-if="state.requestError" class="alert alert-danger"><t t-esc="state.requestError"/></div><div t-elif="state.requestLoading &amp;&amp; !state.requests.length" class="o_it_store_loading"><i class="fa fa-spinner fa-spin"/> กำลังโหลดคำขอ...</div><div t-else="" class="o_it_store_requests"><section><h2>กำลังดำเนินการ</h2><div t-if="!activeRequests.length" class="o_it_store_empty">ไม่มีคำขอที่กำลังดำเนินการ</div><div t-foreach="activeRequests" t-as="request" t-key="request.id" class="o_it_store_request_card" t-on-click="() => openRequest(request)"><div><strong><t t-esc="request.name"/></strong><span><t t-esc="request.request_date"/></span></div><div><span class="badge bg-info"><t t-esc="requestStateLabel(request.state)"/></span><span><t t-esc="request.line_count"/> รายการ · คงค้าง <t t-esc="request.remaining_total_qty"/></span></div></div></section><section><h2>เสร็จสิ้น/ยกเลิก</h2><div t-if="!completedRequests.length" class="o_it_store_empty">ยังไม่มีประวัติคำขอ</div><div t-foreach="completedRequests" t-as="request" t-key="request.id" class="o_it_store_request_card" t-on-click="() => openRequest(request)"><div><strong><t t-esc="request.name"/></strong><span><t t-esc="request.request_date"/></span></div><div><span class="badge bg-secondary"><t t-esc="requestStateLabel(request.state)"/></span><span><t t-esc="request.line_count"/> รายการ · รวม <t t-esc="request.total_qty"/></span></div></div></section><button t-if="state.requestHasMore" class="btn btn-light d-block mx-auto" t-on-click="loadMoreRequests" t-att-disabled="state.requestLoading">โหลดเพิ่ม</button></div></t>
            <div t-if="state.modalOpen" class="o_it_store_modal_backdrop" t-on-click.self="closeModal"><div class="o_it_store_modal" role="dialog" aria-modal="true"><div class="o_it_store_modal_header"><h3>ยืนยันการสร้างคำขอเบิก</h3><button type="button" class="btn btn-link o_it_store_modal_close" t-att-disabled="state.modalSubmitting" t-on-click="closeModal"><i class="fa fa-times"/></button></div><div class="o_it_store_modal_body"><div class="o_it_store_modal_summary"><div class="o_it_store_modal_row"><span>ผู้ขอ</span><strong t-esc="state.requesterName"/></div><div class="o_it_store_modal_row"><span>แผนก</span><strong t-esc="departmentLabel"/></div></div><label class="form-label" for="it_store_reason">เหตุผล <span class="text-danger">*</span></label><textarea id="it_store_reason" class="form-control mb-3" rows="3" placeholder="ระบุเหตุผลในการขอเบิก" t-model="state.reason"/><div class="o_it_store_modal_items"><div class="o_it_store_modal_items_header"><span>รายการสินค้า</span><span>จำนวน</span></div><div t-foreach="cartLines" t-as="line" t-key="line.item.id" class="o_it_store_modal_item"><span class="o_it_store_modal_item_name"><t t-esc="line.item.name"/></span><span class="o_it_store_modal_item_qty"><t t-esc="line.quantity"/> <t t-esc="line.item.unit"/></span></div></div></div><div class="o_it_store_modal_footer"><button type="button" class="btn btn-light" t-att-disabled="state.modalSubmitting" t-on-click="closeModal">กลับไปแก้ไข</button><button type="button" class="btn btn-primary" t-att-disabled="state.modalSubmitting" t-on-click="confirmCreate"><i t-if="state.modalSubmitting" class="fa fa-spinner fa-spin"/><t t-else="">ยืนยันสร้างคำขอ</t></button></div></div></div>
            <div t-if="state.drawerOpen" class="o_it_store_drawer_backdrop" t-on-click.self="closeDrawer"><aside class="o_it_store_drawer" role="dialog" aria-modal="true"><div class="o_it_store_drawer_header"><h3>รายละเอียดคำขอ</h3><button class="btn btn-link" t-on-click="closeDrawer"><i class="fa fa-times"/></button></div><div t-if="state.drawerLoading" class="o_it_store_loading">กำลังโหลดรายละเอียด...</div><div t-elif="state.drawerError" class="alert alert-danger m-3"><t t-esc="state.drawerError"/></div><div t-elif="state.selectedRequest" class="o_it_store_drawer_body"><div class="o_it_store_modal_row"><span>เลขที่</span><strong t-esc="state.selectedRequest.name"/></div><div class="o_it_store_modal_row"><span>สถานะ</span><strong t-esc="requestStateLabel(state.selectedRequest.state)"/></div><div class="o_it_store_modal_row"><span>เหตุผล</span><strong t-esc="state.selectedRequest.reason || '-'"/></div><div t-if="state.selectedRequest.ticket_id" class="o_it_store_modal_row"><span>Ticket</span><strong t-esc="state.selectedRequest.ticket_id[1]"/></div><hr/><div t-foreach="state.selectedRequest.lines" t-as="line" t-key="line.id" class="o_it_store_detail_line"><strong t-esc="line.item_id[1]"/><span>ขอ <t t-esc="line.requested_qty"/> · จ่ายแล้ว <t t-esc="line.issued_qty"/> · ยุติ <t t-esc="line.cancelled_qty"/> · คงค้าง <t t-esc="line.remaining_qty"/> <t t-esc="line.unit"/></span></div></div></aside></div>
        </main>
    </t>
</templates>