<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_it_stock_mobile.App">
        <div class="buz-it-app">
            <aside t-att-class="'it-sidebar ' + (state.nav ? 'is-open' : '')">
                <div class="it-brand"><img src="/buz_it_stock_mobile/static/description/icon.svg" alt=""/> IT Issue <button class="it-mobile-close" t-on-click="() => state.nav = false" aria-label="ปิดเมนู">×</button></div>
                <button class="active" t-on-click="home" t-att-disabled="state.uncertain or state.busy"><i class="fa fa-home"/> หน้าหลัก</button>
                <button t-on-click="() => { state.step = 1; state.nav = false; }" t-att-disabled="state.uncertain or state.busy or state.step === 4"><i class="fa fa-cube"/> เบิกอุปกรณ์</button>
                <button t-on-click="() => this.openAction('buz_it_stock_mobile.action_issues')"><i class="fa fa-list-alt"/> ประวัติการเบิก</button>
                <t t-if="state.boot.manager">
                    <button t-on-click="() => this.openAction('buz_it_stock_mobile.action_products')"><i class="fa fa-archive"/> คลังสินค้า IT</button>
                    <button t-on-click="() => this.openAction('buz_it_stock_mobile.action_config')"><i class="fa fa-cog"/> ตั้งค่าคลัง</button>
                    <button t-on-click="() => this.openAction('buz_it_stock_mobile.action_categories')"><i class="fa fa-tags"/> หมวดสินค้า</button>
                </t>
                <div class="it-sidebar-user"><span class="it-avatar"><i class="fa fa-user"/></span><div><strong t-esc="state.boot.user"/><small t-esc="state.boot.company"/></div><span class="it-online"/></div>
            </aside>
            <div t-if="state.nav" class="it-menu-backdrop" t-on-click="() => state.nav = false"/>
            <main class="it-main">
                <header class="it-header">
                    <button t-if="state.step > 0 and state.step &lt; 4" class="it-icon-button" t-on-click="back" t-att-disabled="state.busy or state.uncertain" aria-label="ย้อนกลับ"><i class="fa fa-arrow-left"/></button>
                    <button t-else="" class="it-icon-button it-menu-toggle" t-on-click="() => state.nav = !state.nav" aria-label="เปิดเมนู"><i class="fa fa-bars"/></button>
                    <h1 t-esc="title"/>
                    <span class="it-warehouse"><i class="fa fa-map-marker"/> <t t-esc="state.boot.warehouse"/></span>
                    <button class="it-icon-button" t-on-click="() => this.openAction('buz_it_stock_mobile.action_issues')" aria-label="ประวัติการเบิก"><i class="fa fa-history"/></button>
                </header>
                <div t-if="state.error" class="it-alert" role="alert"><i class="fa fa-exclamation-circle"/> <t t-esc="state.error"/></div>
                <div t-if="state.busy" class="it-loading" role="status"><i class="fa fa-spinner fa-spin"/> กำลังดำเนินการ…</div>
                <div t-if="state.boot.setup_error" class="it-setup it-panel">
                    <i class="fa fa-sliders"/><h2>ตั้งค่าคลัง IT ก่อนเริ่มใช้งาน</h2><p t-esc="state.boot.setup_error"/>
                    <button t-if="state.boot.manager" class="it-primary" t-on-click="() => this.openAction('buz_it_stock_mobile.action_config')">ตั้งค่าคลัง</button>
                </div>
                <t t-elif="state.ready">
                    <div t-if="state.step === 0" class="it-home">
                        <section class="it-catalog">
                            <div class="it-search-row"><label class="it-search"><i class="fa fa-search"/><input placeholder="ค้นหาอุปกรณ์ ชื่อ รหัส หรือ Serial…" t-att-value="state.search" t-on-input="searchInput" aria-label="ค้นหาอุปกรณ์"/></label></div>
                            <div class="it-chips"><button t-att-class="!state.category ? 'selected' : ''" t-on-click="() => this.selectCategory(false)">ทั้งหมด</button><button t-foreach="state.boot.categories" t-as="category" t-key="category.id" t-att-class="state.category === category.id ? 'selected' : ''" t-on-click="() => this.selectCategory(category.id)" t-esc="category.name"/></div>
                            <h2 class="it-section-title it-mobile-only">หมวดหมู่</h2>
                            <div class="it-category-grid it-mobile-only"><button t-foreach="state.boot.categories" t-as="category" t-key="category.id" t-on-click="() => this.selectCategory(category.id)"><i t-att-class="icon(category)"/><span t-esc="category.name"/></button></div>
                            <div class="it-section-heading"><h2 class="it-section-title">อุปกรณ์พร้อมเบิก</h2><span>เลือกสินค้าเพื่อเพิ่มในตะกร้า</span></div>
                            <div class="it-product-grid">
                                <article class="it-product" t-foreach="state.products" t-as="product" t-key="product.id">
                                    <div class="it-product-image"><img t-if="product.has_image" t-att-src="image(product.id)" t-att-alt="product.name" loading="lazy"/><i t-else="" t-att-class="'fa fa-' + product.category_icon" aria-hidden="true"/></div>
                                    <div class="it-product-info"><h3 t-esc="product.name"/><span class="it-muted" t-esc="product.category"/><small t-att-class="product.available > 0 ? 'it-stock' : 'it-empty-stock'">พร้อมเบิก <t t-esc="number(product.available)"/> <t t-esc="product.uom"/></small></div>
                                    <button class="it-add" t-on-click="() => this.add(product)" t-att-disabled="product.available &lt;= 0 or state.busy" t-att-aria-label="'เพิ่ม ' + product.name"><i class="fa fa-plus"/></button>
                                </article>
                            </div>
                            <div t-if="!state.products.length" class="it-empty"><i class="fa fa-search"/><p>ไม่พบอุปกรณ์ในหมวดหรือคำค้นนี้</p></div>
                            <button t-if="state.more" class="it-secondary it-load-more" t-on-click="() => this.run(() => this.catalog(true))" t-att-disabled="state.busy">โหลดสินค้าเพิ่มเติม</button>
                            <div class="it-cart-bar"><span><i class="fa fa-shopping-cart"/> <strong t-esc="distinctCount"/> รายการ <small t-esc="totals"/></span><button t-on-click="() => state.step = 1" t-att-disabled="!state.cart.length or state.busy">ดูรายการ (<t t-esc="distinctCount"/>) <i class="fa fa-angle-right"/></button></div>
                        </section>
                        <aside t-if="state.dashboard" class="it-dashboard">
                            <section class="it-panel it-recent"><div class="it-section-heading"><h2>รายการเบิกล่าสุด</h2><button class="it-text-button" t-on-click="() => this.openAction('buz_it_stock_mobile.action_issues')">ดูทั้งหมด</button></div>
                                <table><thead><tr><th>เลขที่เอกสาร</th><th>ผู้รับ</th><th>วันที่</th><th>สถานะ</th></tr></thead><tbody><tr t-foreach="state.dashboard.recent" t-as="issue" t-key="issue.id" t-on-click="() => this.openDetail(issue.id)"><td><button class="it-text-button" t-esc="issue.name"/></td><td t-esc="issue.receiver"/><td t-esc="formatDate(issue.date)"/><td><span t-att-class="'it-status ' + issue.state"><t t-esc="{draft: 'ร่าง', awaiting: 'รอเซ็น', done: 'เสร็จสิ้น', cancel: 'ยกเลิก'}[issue.state]"/></span></td></tr></tbody></table>
                                <p t-if="!state.dashboard.recent.length" class="it-muted">ยังไม่มีรายการเบิก เริ่มต้นจากอุปกรณ์ด้านซ้าย</p>
                            </section>
                            <div class="it-dashboard-bottom"><section class="it-panel"><h2>สรุปการเบิก (เดือนนี้)</h2><div class="it-month-count"><strong t-esc="state.dashboard.month_count"/><span>ใบเบิกสำเร็จ</span></div><div class="it-chart" t-foreach="state.dashboard.categories" t-as="category" t-key="category.name + category.uom"><div><span t-esc="category.name"/><strong><t t-esc="number(category.qty)"/> <t t-esc="category.uom"/></strong></div><progress t-att-value="category.qty" t-att-max="state.dashboard.totals[category.uom] || 1"/></div><p t-if="!state.dashboard.categories.length" class="it-muted">ยังไม่มีการเบิกในเดือนนี้</p></section>
                                <section class="it-panel"><h2>คลังสินค้า IT</h2><p class="it-muted" t-esc="state.boot.warehouse"/><t t-if="state.boot.manager"><small class="it-muted">มูลค่าประมาณการจากต้นทุนสินค้า</small><div class="it-value"><t t-esc="state.dashboard.currency"/> <t t-esc="number(state.dashboard.value)"/></div></t><div class="it-stat"><span>สินค้าทั้งหมด</span><strong><t t-esc="state.dashboard.product_count"/> รายการ</strong></div><div class="it-stat" t-foreach="Object.entries(state.dashboard.stock)" t-as="stock" t-key="stock[0]"><span>คงเหลือ</span><strong class="it-stock"><t t-esc="number(stock[1])"/> <t t-esc="stock[0]"/></strong></div></section>
                            </div>
                        </aside>
                    </div>
                    <section t-elif="state.step === 1" class="it-flow">
                        <div class="it-step-label">ขั้นตอน 1 / 3 · ตรวจสอบอุปกรณ์</div>
                        <div t-if="!state.cart.length" class="it-empty"><i class="fa fa-shopping-cart"/><p>ยังไม่มีสินค้าในตะกร้า</p><button class="it-primary" t-on-click="() => state.step = 0">เลือกอุปกรณ์</button></div>
                        <article class="it-cart-line" t-foreach="state.cart" t-as="line" t-key="line.key"><img t-att-src="image(line.product_id)" t-att-alt="line.name"/><div class="it-cart-info"><h3 t-esc="line.name"/><small class="it-muted"><t t-esc="line.lot_name || line.category"/></small><div class="it-qty"><button t-on-click="() => this.changeQty(line, Math.max(line.rounding, line.quantity - 1))" t-att-disabled="line.tracking === 'serial'" aria-label="ลดจำนวน">−</button><input type="number" min="0.001" t-att-step="line.rounding" t-att-value="line.quantity" t-att-readonly="line.tracking === 'serial'" t-on-change="(ev) => this.changeQty(line, ev.target.value)" aria-label="จำนวน"/><button t-on-click="() => this.changeQty(line, line.quantity + 1)" t-att-disabled="line.tracking === 'serial'" aria-label="เพิ่มจำนวน">+</button><small t-esc="line.uom"/></div></div><button class="it-remove" t-on-click="() => this.remove(line)" aria-label="ลบสินค้า"><i class="fa fa-trash-o"/></button></article>
                        <label class="it-field">หมายเหตุ (ถ้ามี)<textarea t-model="state.note" placeholder="เพิ่มเติม…" maxlength="4000"/></label>
                        <div class="it-total">รวม <strong><t t-esc="distinctCount"/> รายการ</strong><br/><span t-esc="totals"/></div>
                        <div class="it-flow-actions"><button class="it-primary" t-on-click="chooseReceiver" t-att-disabled="!state.cart.length or state.busy">ต่อไป · เลือกผู้รับ <i class="fa fa-arrow-right"/></button><button class="it-secondary" t-on-click="back">เลือกอุปกรณ์เพิ่ม</button></div>
                    </section>
                    <section t-elif="state.step === 2" class="it-flow">
                        <div class="it-step-label">ขั้นตอน 2 / 3 · ผู้รับอุปกรณ์</div>
                        <label class="it-field">ค้นหาพนักงาน<label class="it-search"><i class="fa fa-search"/><input placeholder="ชื่อผู้รับอุปกรณ์…" t-att-value="state.employeeSearch" t-on-input="peopleInput"/></label></label>
                        <div t-if="state.employee" class="it-receiver selected"><img t-if="state.employee.image" t-att-src="'data:image/png;base64,' + state.employee.image" alt=""/><span t-else="" class="it-avatar"><i class="fa fa-user"/></span><div><strong t-esc="state.employee.name"/><small t-esc="state.employee.department"/></div><i class="fa fa-check-circle it-stock"/></div>
                        <div class="it-people"><button t-foreach="state.people" t-as="employee" t-key="employee.id" class="it-receiver" t-on-click="() => this.selectEmployee(employee)"><span class="it-avatar"><i class="fa fa-user"/></span><div><strong t-esc="employee.name"/><small t-esc="employee.department"/></div><i class="fa fa-angle-right"/></button><p t-if="!state.people.length" class="it-muted">ไม่พบพนักงาน ลองค้นหาด้วยชื่ออื่น</p></div>
                        <label class="it-field">สถานที่รับ<select t-model="state.locationId"><option value="">ไม่ระบุ</option><option t-foreach="state.boot.locations" t-as="location" t-key="location.id" t-att-value="location.id" t-esc="location.name"/></select></label>
                        <h2>สรุปรายการ</h2><div class="it-panel it-summary"><div t-foreach="state.cart" t-as="line" t-key="line.key"><span><t t-esc="line.name"/><small t-if="line.lot_name" t-esc="line.lot_name"/></span><strong>× <t t-esc="line.quantity"/> <t t-esc="line.uom"/></strong></div></div>
                        <div class="it-flow-actions"><button class="it-primary" t-on-click="confirmRecipient" t-att-disabled="!state.employee or state.busy">ยืนยันการเบิก</button><button class="it-secondary" t-on-click="back" t-att-disabled="state.busy">ย้อนกลับ</button></div>
                    </section>
                    <section t-elif="state.step === 3" class="it-flow">
                        <div class="it-step-label">ขั้นตอน 3 / 3 · เซ็นรับอุปกรณ์</div><h2>ผู้รับ</h2>
                        <div class="it-receiver selected"><span class="it-avatar"><i class="fa fa-user"/></span><div><strong t-esc="state.detail.receiver"/><small t-esc="state.detail.department"/><small t-esc="state.detail.location"/></div></div>
                        <h2>รายการอุปกรณ์</h2><div class="it-panel it-summary"><div t-foreach="state.detail.lines" t-as="line" t-key="itemKey(line.product_id, line.lot_id)"><span><t t-esc="line.name"/><small t-if="line.lot_name" t-esc="line.lot_name"/></span><strong>× <t t-esc="line.quantity"/> <t t-esc="line.uom"/></strong></div></div>
                        <p t-if="state.detail.note" class="it-muted" t-esc="state.detail.note"/>
                        <p class="it-consent">ข้าพเจ้าได้รับอุปกรณ์ดังกล่าว<br/>เรียบร้อยแล้ว</p>
                        <div class="it-signature"><canvas width="800" height="320" t-ref="signature" aria-label="พื้นที่เซ็นชื่อผู้รับ" t-on-pointerdown="startSignature" t-on-pointermove="drawSignature" t-on-pointerup="endSignature" t-on-pointercancel="endSignature" t-on-lostpointercapture="endSignature"/><span t-if="!state.signed" class="it-sign-hint">เซ็นชื่อที่นี่</span><button class="it-secondary" t-on-click="clearSignature" t-att-disabled="state.busy or state.uncertain">ล้าง</button></div>
                        <div t-if="state.uncertain" class="it-alert">กำลังตรวจสอบผลการยืนยัน กรุณาตรวจสถานะก่อนทำรายการต่อ<button class="it-secondary" t-on-click="checkStatus" t-att-disabled="state.busy">ตรวจสอบสถานะ</button></div>
                        <div class="it-flow-actions"><button class="it-success" t-on-click="sign" t-att-disabled="!state.signed or state.busy or state.uncertain"><i class="fa fa-check"/> เซ็นรับและยืนยัน</button><button class="it-secondary" t-on-click="back" t-att-disabled="state.busy or state.uncertain">ย้อนกลับแก้ไข</button></div>
                    </section>
                    <section t-elif="state.step === 4" class="it-flow it-complete"><div class="it-success-icon"><i class="fa fa-check"/></div><h2>เบิกอุปกรณ์สำเร็จ</h2><p class="it-muted">เลขที่เอกสาร</p><h3 class="it-document-number" t-esc="state.detail.name"/><p class="it-muted" t-esc="formatDate(state.detail.signed_on)"/><div class="it-panel it-summary"><div><span>ผู้รับ</span><strong t-esc="state.detail.receiver"/></div><div><span>จำนวน</span><strong t-esc="detailTotals"/></div><div><span>ใบโอนสินค้า</span><strong t-esc="state.detail.picking_name"/></div></div><div class="it-flow-actions"><button class="it-secondary" t-on-click="() => this.openDetail(state.detail.id)">ดูรายละเอียด</button><button class="it-primary" t-on-click="newIssue" t-att-disabled="state.busy">สร้างใบเบิกใหม่</button></div></section>
                </t>
            </main>
            <div t-if="state.lotProduct" class="it-modal-backdrop"><section class="it-lot-modal" role="dialog" aria-modal="true" aria-label="เลือก Serial หรือ Lot"><div class="it-section-heading"><h2>เลือก Serial / Lot</h2><button class="it-icon-button" t-on-click="() => state.lotProduct = null" aria-label="ปิด">×</button></div><p t-esc="state.lotProduct.name"/><div class="it-lot-list"><button t-foreach="state.lots" t-as="lot" t-key="lot.id" t-on-click="() => this.addLine(state.lotProduct, lot)"><span><strong t-esc="lot.name"/><small>พร้อมเบิก <t t-esc="lot.available"/> <t t-esc="state.lotProduct.uom"/></small></span><i t-att-class="state.cart.some(line => line.key === itemKey(state.lotProduct.id, lot.id)) ? 'fa fa-check-circle it-stock' : 'fa fa-plus-circle'"/></button><p t-if="!state.lots.length" class="it-muted">ไม่มี Serial / Lot ที่พร้อมเบิก</p></div><button class="it-primary" t-on-click="() => state.lotProduct = null">เสร็จแล้ว</button></section></div>
        </div>
    </t>
</templates>
