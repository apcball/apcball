<odoo>
    <record id="view_issue_tree" model="ir.ui.view">
        <field name="name">buz.it.issue.tree</field><field name="model">buz.it.issue</field>
        <field name="arch" type="xml"><tree create="0" decoration-success="state == 'done'" decoration-muted="state == 'cancel'">
            <field name="name"/><field name="receiver_name"/><field name="department_name"/><field name="create_uid"/><field name="create_date"/><field name="signed_on"/><field name="state" widget="badge"/><field name="company_id" groups="base.group_multi_company"/>
        </tree></field>
    </record>
    <record id="view_issue_form" model="ir.ui.view">
        <field name="name">buz.it.issue.form</field><field name="model">buz.it.issue</field>
        <field name="arch" type="xml"><form create="0" edit="0" delete="0">
            <header><button name="action_open_app" type="object" string="เปิดในแอป / เซ็นรับ" class="oe_highlight" invisible="state == 'cancel'"/><button name="action_cancel" type="object" string="ยกเลิกใบเบิก" invisible="state in ['done', 'cancel']" confirm="ยกเลิกใบเบิกนี้?"/><field name="state" widget="statusbar" statusbar_visible="draft,awaiting,done"/></header>
            <sheet><h1><field name="name"/></h1><group><group><field name="receiver_name"/><field name="department_name"/><field name="work_location_name"/><field name="note"/></group><group><field name="company_id"/><field name="create_uid"/><field name="signed_on"/><field name="signed_by"/><field name="picking_id"/></group></group>
                <field name="line_ids"><tree create="0" edit="0" delete="0"><field name="product_id"/><field name="quantity"/><field name="lot_id"/></tree></field>
                <group string="ลายเซ็นผู้รับ" invisible="state != 'done'"><field name="signature" widget="image" options="{'size': [480, 200]}"/></group>
            </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
        </form></field>
    </record>
    <record id="action_issues" model="ir.actions.act_window"><field name="name">ประวัติการเบิก IT</field><field name="res_model">buz.it.issue</field><field name="view_mode">tree,form</field></record>
</odoo>
