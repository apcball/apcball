<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SEARCH VIEW -->
    <record id="view_buz_landed_cost_report_search" model="ir.ui.view">
        <field name="name">buz.landed.cost.report.search</field>
        <field name="model">buz.landed.cost.report</field>
        <field name="arch" type="xml">
            <search string="Landed Cost Search">
                <field name="doc_no"/>
                <field name="product_id"/>
                <field name="inventory_name"/>
                <field name="ref_no"/>
                <field name="partner_id"/>
                <filter string="Posted" name="f_done" domain="[('state', '=', 'done')]"/>
                <filter string="Draft" name="f_draft" domain="[('state', '=', 'draft')]"/>
                <separator/>
                <filter string="Over-capitalised in SVL (defect)" name="f_svl_over"
                        domain="[('state', '=', 'done'), ('svl_landed_diff', '&lt;', -0.01)]"/>
                <filter string="Not fully capitalised" name="f_svl_part"
                        domain="[('state', '=', 'done'), ('svl_landed_diff', '&gt;', 0.01)]"/>
                <filter string="Base from SVL fallback" name="f_base_svl" domain="[('base_source', '=', 'svl')]"/>
                <group expand="1" string="Group By">
                    <filter string="Product" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Landed Cost" name="group_lc" context="{'group_by':'landed_cost_id'}"/>
                    <filter string="Vendor" name="group_partner" context="{'group_by':'partner_id'}"/>
                    <filter string="Warehouse" name="group_wh" context="{'group_by':'warehouse_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_buz_landed_cost_report_pivot" model="ir.ui.view">
        <field name="name">buz.landed.cost.report.pivot</field>
        <field name="model">buz.landed.cost.report</field>
        <field name="arch" type="xml">
            <pivot string="Landed Cost Analysis">
                <field name="product_id" type="row"/>
                <field name="date" type="col" interval="month"/>
                <field name="qty" type="measure"/>
                <field name="base_cost" type="measure"/>
                <field name="landed_cost" type="measure"/>
                <field name="total_cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_buz_landed_cost_report_tree" model="ir.ui.view">
        <field name="name">buz.landed.cost.report.tree</field>
        <field name="model">buz.landed.cost.report</field>
        <field name="arch" type="xml">
            <tree string="Landed Cost Summary" create="0" edit="0" delete="0">
                <field name="doc_no"/>
                <field name="date"/>
                <field name="state" optional="hide"/>
                <field name="product_id"/>
                <field name="qty" sum="Qty"/>
                <field name="base_source" optional="hide"/>
                <field name="base_unit_cost" optional="show"/>
                <field name="base_cost" sum="Base" optional="show"/>
                <field name="landed_cost" sum="Landed"/>
                <field name="total_cost" sum="Total" decoration-bf="1"/>
                <field name="unit_cost" decoration-bf="1"/>
                <field name="svl_landed_value" optional="hide"/>
                <field name="svl_landed_diff" optional="hide"/>
                <field name="inventory_name"/>
                <field name="purchase_id" optional="hide"/>
                <field name="partner_id" optional="hide"/>
                <field name="warehouse_id" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_buz_landed_cost_report_form" model="ir.ui.view">
        <field name="name">buz.landed.cost.report.form</field>
        <field name="model">buz.landed.cost.report</field>
        <field name="arch" type="xml">
            <form string="Landed Cost Detail" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="product_id"/></h1>
                    </div>
                    <group col="4">
                        <field name="landed_cost_id"/>
                        <field name="date"/>
                        <field name="inventory_name"/>
                        <field name="ref_no"/>
                        <field name="partner_id"/>
                        <field name="purchase_id"/>
                        <field name="vendor_bill_id"/>
                        <field name="state"/>
                    </group>
                    <group string="Cost" col="4">
                        <field name="qty"/>
                        <field name="base_source"/>
                        <field name="base_cost"/>
                        <field name="landed_cost"/>
                        <field name="total_cost" decoration-bf="1"/>
                        <field name="unit_cost" decoration-bf="1"/>
                    </group>
                    <group string="Cross-check" col="4">
                        <field name="lc_former_cost"/>
                        <field name="svl_base_value"/>
                        <field name="svl_landed_value"/>
                        <field name="svl_landed_diff"/>
                    </group>
                    <notebook>
                        <page string="Cost Breakdown">
                            <field name="detail_ids">
                                <tree string="Cost Lines">
                                    <field name="cost_line_name"/>
                                    <field name="cost_type_id"/>
                                    <field name="split_method"/>
                                    <field name="account_code"/>
                                    <field name="account_name"/>
                                    <field name="amount" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- AUDIT -->
    <record id="view_buz_landed_cost_audit_search" model="ir.ui.view">
        <field name="name">buz.landed.cost.audit.search</field>
        <field name="model">buz.landed.cost.audit</field>
        <field name="arch" type="xml">
            <search string="Landed Cost Audit">
                <field name="name"/>
                <filter string="Posted" name="f_done" domain="[('state', '=', 'done')]"/>
                <filter string="SVL over-capitalised (defect)" name="f_svl_over" domain="[('svl_over', '=', True)]"/>
                <filter string="No SVL created" name="f_svl_none" domain="[('svl_none', '=', True)]"/>
                <filter string="Allocation Mismatch" name="f_alloc" domain="[('alloc_mismatch', '=', True)]"/>
                <filter string="No Journal Entry" name="f_noje" domain="[('has_account_move', '=', False)]"/>
                <group expand="1" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                    <filter string="Month" name="group_month" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_buz_landed_cost_audit_tree" model="ir.ui.view">
        <field name="name">buz.landed.cost.audit.tree</field>
        <field name="model">buz.landed.cost.audit</field>
        <field name="arch" type="xml">
            <tree string="Landed Cost Audit" create="0" edit="0" delete="0"
                  decoration-danger="svl_over or alloc_mismatch">
                <field name="name"/>
                <field name="date"/>
                <field name="state"/>
                <field name="target_model" optional="hide"/>
                <field name="vendor_bill_id" optional="show"/>
                <field name="amount_total" sum="LC Total"/>
                <field name="alloc_total" sum="Allocated"/>
                <field name="svl_total" sum="SVL"/>
                <field name="alloc_diff" sum="Diff"/>
                <field name="uncapitalised" sum="Not capitalised"/>
                <field name="move_count"/>
                <field name="svl_count"/>
                <field name="has_account_move" optional="hide"/>
                <field name="alloc_mismatch" invisible="1"/>
                <field name="svl_over" invisible="1"/>
            </tree>
        </field>
    </record>

    <record id="action_buz_landed_cost_report_summary" model="ir.actions.act_window">
        <field name="name">Landed Cost by Product</field>
        <field name="res_model">buz.landed.cost.report</field>
        <field name="view_mode">tree,pivot,form</field>
        <field name="context">{'search_default_f_done': 1}</field>
    </record>

    <record id="action_buz_landed_cost_audit" model="ir.actions.act_window">
        <field name="name">Landed Cost Audit</field>
        <field name="res_model">buz.landed.cost.audit</field>
        <field name="view_mode">tree</field>
        <field name="context">{'search_default_f_done': 1, 'search_default_f_svl_over': 1}</field>
    </record>

    <menuitem id="menu_landed_cost_report_summary"
              name="Landed Cost by Product"
              parent="stock.menu_warehouse_report"
              action="action_buz_landed_cost_report_summary"
              sequence="101"/>
    <menuitem id="menu_landed_cost_audit"
              name="Landed Cost Audit"
              parent="stock.menu_warehouse_report"
              action="action_buz_landed_cost_audit"
              sequence="102"/>

    <!-- BY COST TYPE (detail grain) -->
    <record id="view_buz_landed_cost_detail_search" model="ir.ui.view">
        <field name="name">buz.landed.cost.report.detail.search</field>
        <field name="model">buz.landed.cost.report.detail</field>
        <field name="arch" type="xml">
            <search string="Landed Cost by Type">
                <field name="doc_no"/>
                <field name="product_id"/>
                <field name="cost_type_id"/>
                <field name="cost_line_name"/>
                <filter string="Posted" name="f_done" domain="[('state', '=', 'done')]"/>
                <filter string="Draft" name="f_draft" domain="[('state', '=', 'draft')]"/>
                <group expand="1" string="Group By">
                    <filter string="Cost Type" name="group_type" context="{'group_by':'cost_type_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by':'product_id'}"/>
                    <filter string="Landed Cost" name="group_lc" context="{'group_by':'landed_cost_id'}"/>
                    <filter string="Month" name="group_month" context="{'group_by':'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_buz_landed_cost_detail_pivot" model="ir.ui.view">
        <field name="name">buz.landed.cost.report.detail.pivot</field>
        <field name="model">buz.landed.cost.report.detail</field>
        <field name="arch" type="xml">
            <pivot string="Landed Cost by Type">
                <field name="product_id" type="row"/>
                <field name="cost_type_id" type="col"/>
                <field name="amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_buz_landed_cost_detail_tree" model="ir.ui.view">
        <field name="name">buz.landed.cost.report.detail.tree</field>
        <field name="model">buz.landed.cost.report.detail</field>
        <field name="arch" type="xml">
            <tree string="Landed Cost by Type" create="0" edit="0" delete="0">
                <field name="doc_no"/>
                <field name="date"/>
                <field name="product_id"/>
                <field name="cost_type_id"/>
                <field name="cost_line_name"/>
                <field name="account_code" optional="show"/>
                <field name="amount" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="action_buz_landed_cost_by_type" model="ir.actions.act_window">
        <field name="name">Landed Cost by Type</field>
        <field name="res_model">buz.landed.cost.report.detail</field>
        <field name="view_mode">pivot,tree</field>
        <field name="context">{'search_default_f_done': 1}</field>
    </record>

    <!-- COST TYPE CONFIG -->
    <record id="view_buz_landed_cost_type_tree" model="ir.ui.view">
        <field name="name">buz.landed.cost.type.tree</field>
        <field name="model">buz.landed.cost.type</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_buz_landed_cost_type" model="ir.actions.act_window">
        <field name="name">Landed Cost Types</field>
        <field name="res_model">buz.landed.cost.type</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_landed_cost_by_type"
              name="Landed Cost by Type"
              parent="stock.menu_warehouse_report"
              action="action_buz_landed_cost_by_type"
              sequence="103"/>
    <menuitem id="menu_landed_cost_type_config"
              name="Landed Cost Types"
              parent="stock.menu_stock_config_settings"
              action="action_buz_landed_cost_type"
              groups="stock.group_stock_manager"
              sequence="90"/>

    <!-- Landed cost type on the landed cost (service) product -->
    <record id="view_product_template_landed_cost_type_form" model="ir.ui.view">
        <field name="name">product.template.landed.cost.type.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock_landed_costs.view_product_landed_cost_form"/>
        <field name="arch" type="xml">
            <field name="split_method_landed_cost" position="after">
                <field name="landed_cost_type_id"
                       invisible="not landed_cost_ok or type != 'service'"/>
            </field>
        </field>
    </record>

    <!-- Extension to Stock Landed Cost Form to show Type -->
    <record id="view_stock_landed_cost_form_inherit_buz" model="ir.ui.view">
        <field name="name">stock.landed.cost.form.inherit.buz</field>
        <field name="model">stock.landed.cost</field>
        <field name="inherit_id" ref="stock_landed_costs.view_stock_landed_cost_form"/>
        <field name="arch" type="xml">
            <field name="date" position="after">
                <field name="currency_rate"/>
            </field>
            <xpath expr="//field[@name='cost_lines']/tree/field[@name='product_id']" position="after">
                <field name="cost_type_id" required="1"/>
            </xpath>
            <xpath expr="//field[@name='cost_lines']/form/group/group/field[@name='product_id']" position="after">
                <field name="cost_type_id" required="1"/>
            </xpath>
        </field>
    </record>

    <!-- Report Action -->
    <record id="action_report_landed_cost_xlsx" model="ir.actions.report">
        <field name="name">Landed Cost Excel Report</field>
        <field name="model">buz.landed.cost.report.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">buz_landed_cost_report.xlsx</field>
        <field name="report_file">Landed_Cost_Report</field>
        <field name="binding_type">report</field>
    </record>
</odoo>
