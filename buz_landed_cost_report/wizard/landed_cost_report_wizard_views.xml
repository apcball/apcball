<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_landed_cost_report_wizard_form" model="ir.ui.view">
        <field name="name">buz.landed.cost.report.wizard.form</field>
        <field name="model">buz.landed.cost.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Landed Cost Report">
                <field name="domain_json" invisible="1"/>
                <group>
                    <group string="Sheets">
                        <field name="include_summary"/>
                        <field name="include_breakdown"/>
                        <field name="include_audit"/>
                    </group>
                    <group string="Scope">
                        <field name="record_count"/>
                    </group>
                </group>
                <div class="text-muted">The export uses the filters currently applied in the report view.</div>
                <footer>
                    <button name="action_export_excel" type="object" string="Export Excel" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lc_export_wizard" model="ir.actions.act_window">
        <field name="name">Export Landed Cost Report</field>
        <field name="res_model">buz.landed.cost.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
