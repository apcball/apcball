<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_buz_loan_return_document_company" model="ir.rule">
        <field name="name">BG/RBG documents by allowed company</field>
        <field name="model_id" ref="model_buz_loan_return_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
    <record id="rule_buz_loan_return_operation_type_company" model="ir.rule">
        <field name="name">BG/RBG Operation Types by allowed company</field>
        <field name="model_id" ref="model_buz_loan_return_operation_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>
</odoo>