    <!-- ลบเมนูและหน้าจอ allowlist รุ่นเดิมออกเมื่ออัปเกรดโมดูล โดยเก็บข้อมูล config ไว้ -->
    <delete model="ir.ui.menu"
            search="[('name', '=', 'Allowed Operation Types'), ('parent_id', '=', ref('menu_buz_loan_return_root'))]"/>
    <delete model="ir.actions.act_window"
            search="[('name', '=', 'Allowed Operation Types'), ('res_model', '=', 'buz.loan.return.operation.type')]"/>
    <delete model="ir.ui.view"
            search="[('model', '=', 'buz.loan.return.operation.type'), ('name', 'in', ['buz.loan.return.operation.type.tree', 'buz.loan.return.operation.type.form'])]"/>
</odoo>
