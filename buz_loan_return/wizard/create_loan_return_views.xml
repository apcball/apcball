<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_loan_return_create_wizard_form" model="ir.ui.view">
        <field name="name">buz.loan.return.create.wizard.form</field>
        <field name="model">buz.loan.return.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create BG/RBG">
                <group>
                    <field name="document_kind" invisible="1"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="source_document_id"
                           invisible="document_kind != 'return'"
                           readonly="1"/>
                    <field name="allowed_operation_type_ids" invisible="1"/>
                    <field name="operation_type_id"
                           domain="[('id', 'in', allowed_operation_type_ids)]"/>
                </group>
                <footer>
                    <button name="action_open_picking" type="object"
                            string="Continue" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_buz_loan_return_create_bg" model="ir.actions.act_window">
        <field name="name">Create BG</field>
        <field name="res_model">buz.loan.return.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_buz_loan_return_create_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_document_kind': 'loan'}</field>
    </record>
</odoo>