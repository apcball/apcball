<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_loan_return_create_wizard_form" model="ir.ui.view">
        <field name="name">buz.loan.return.create.wizard.form</field>
        <field name="model">buz.loan.return.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Create BG/RBG">
                <group>
                    <field name="document_kind" invisible="1"/>
                    <field name="allowed_operation_type_ids" invisible="1"/>
                </group>
                <field name="operation_type_message" readonly="1" nolabel="1"
                       invisible="not operation_type_message"/>
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="operation_type_id"
                               domain="[('id', 'in', allowed_operation_type_ids)]"/>
                        <field name="source_document_id"
                               invisible="document_kind != 'return'" readonly="1"/>
                    </group>
                    <group>
                        <field name="scheduled_date"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="location_id" groups="stock.group_stock_multi_locations"/>
                        <field name="location_dest_id" groups="stock.group_stock_multi_locations"/>
                    </group>
                </group>
                <notebook>
                    <page string="Operations">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="product_uom_id"
                                       domain="[('category_id', '=', product_uom_category_id)]"/>
                                <field name="source_move_id" string="BG Item" readonly="1"/>
                                <field name="product_uom_category_id" string="Category" readonly="1"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button name="action_create_document" type="object" string="Create Document" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_buz_loan_return_create_bg" model="ir.actions.act_window">
        <field name="name">Create BG</field>
        <field name="res_model">buz.loan.return.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_buz_loan_return_create_wizard_form"/>
        <field name="target">new</field>
        <field name="context">{'default_document_kind': 'loan'}</field>
    </record>
</odoo>