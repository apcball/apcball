<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_loan_return_loan_wizard_form" model="ir.ui.view">
        <field name="name">buz.loan.return.loan.wizard.form</field>
        <field name="model">buz.loan.return.loan.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Show Loan">
                <field name="company_id" invisible="1"/>
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="operation_type_id"/>
                        <field name="location_id"/>
                        <field name="location_dest_id"/>
                    </group>
                    <group>
                        <field name="scheduled_date"/>
                        <field name="origin"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <field name="line_ids">
                    <tree editable="bottom">
                        <field name="product_id"/>
                        <field name="quantity"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_create_loan" string="Create Loan" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_buz_loan_return_create_loan" model="ir.actions.act_window">
        <field name="name">Create Show Loan</field>
        <field name="res_model">buz.loan.return.loan.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_buz_loan_return_loan_wizard_form"/>
        <field name="target">current</field>
    </record>
</odoo>
