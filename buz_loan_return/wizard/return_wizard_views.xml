<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_loan_return_return_wizard_form" model="ir.ui.view">
        <field name="name">buz.loan.return.return.wizard.form</field>
        <field name="model">buz.loan.return.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Show Return">
                <field name="company_id" invisible="1"/>
                <group>
                    <group>
                        <field name="source_picking_id"/>
                        <field name="operation_type_id"/>
                        <field name="scheduled_date"/>
                    </group>
                    <group>
                        <field name="location_id"/>
                        <field name="location_dest_id"/>
                    </group>
                </group>
                <field name="line_ids">
                    <tree editable="bottom" create="false" delete="false">
                        <field name="product_id" force_save="1"/>
                        <field name="delivered_qty" sum="Delivered"/>
                        <field name="reserved_qty" sum="Reserved"/>
                        <field name="remaining_qty" sum="Remaining"/>
                        <field name="quantity" sum="Return Quantity"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_create_return" string="Create Return" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_buz_loan_return_create_return" model="ir.actions.act_window">
        <field name="name">Create Show Return</field>
        <field name="res_model">buz.loan.return.return.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_buz_loan_return_return_wizard_form"/>
        <field name="target">current</field>
    </record>
</odoo>
