<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_loan_return_linked_export_wizard_form" model="ir.ui.view">
        <field name="name">buz.loan.return.linked.export.wizard.form</field>
        <field name="model">buz.loan.return.linked.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Linked BG/RBG Report">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export Excel" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_loan_return_linked_export_wizard" model="ir.actions.act_window">
        <field name="name">Linked BG/RBG Report</field>
        <field name="res_model">buz.loan.return.linked.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_loan_return_linked_export"
              name="Linked BG/RBG Report"
              parent="stock.menu_warehouse_report"
              action="action_loan_return_linked_export_wizard"
              sequence="91"
              groups="stock.group_stock_user"/>
    <record id="action_loan_return_linked_export_xlsx" model="ir.actions.report">
        <field name="name">Linked BG/RBG Report</field>
        <field name="model">buz.loan.return.linked.export.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">buz_loan_return_export.loan_return_linked_xlsx</field>
        <field name="report_file">buz_loan_return_export.loan_return_linked_xlsx</field>
        <field name="print_report_name">'Linked BG RBG Report'</field>
    </record>
</odoo>