<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- May only move a Manufacturing / Unbuild Order to today or later -->
        <record id="group_mrp_backdate_future" model="res.groups">
            <field name="name">MRP Backdate: Future Only</field>
            <field name="category_id" ref="base.module_category_manufacturing"/>
            <field name="comment">Can re-date done Manufacturing and Unbuild Orders to today or a future date.</field>
            <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user'))]"/>
        </record>

        <!-- Past and future. Keeps the original xmlid so existing users keep
             their unrestricted behaviour on upgrade. -->
        <record id="group_mrp_backdate" model="res.groups">
            <field name="name">MRP Backdate: Past &amp; Future</field>
            <field name="category_id" ref="base.module_category_manufacturing"/>
            <field name="comment">Users with this access right can backdate Manufacturing and Unbuild Orders.</field>
            <field name="implied_ids" eval="[(4, ref('mrp.group_mrp_user')), (4, ref('group_mrp_backdate_future'))]"/>
        </record>
    </data>
</odoo>
