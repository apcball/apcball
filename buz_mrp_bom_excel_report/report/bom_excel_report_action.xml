        <field name="name">BOM Excel Report</field>
        <field name="model">buz.mrp.bom.excel.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">buz_mrp_bom_excel_report.bom_excel_xlsx</field>
