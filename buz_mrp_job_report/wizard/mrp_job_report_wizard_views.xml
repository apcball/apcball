<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_buz_mrp_job_report_wizard_form" model="ir.ui.view">
        <field name="name">buz.mrp.job.report.wizard.form</field>
        <field name="model">buz.mrp.job.report.wizard</field>
        <field name="arch" type="xml">
            <form string="MRP Job Close Report">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="date_basis"/>
                        <field name="state_filter"/>
                    </group>
                    <group>
                        <field name="picking_type_ids" widget="many2many_tags"/>
                        <field name="product_ids" widget="many2many_tags"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </group>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Export Excel" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_buz_mrp_job_report_wizard" model="ir.actions.act_window">
        <field name="name">MRP Job Close Report</field>
        <field name="res_model">buz.mrp.job.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_buz_mrp_job_report"
              name="Job Close Report (Excel)"
              parent="mrp.menu_mrp_reporting"
              action="action_buz_mrp_job_report_wizard"
              sequence="60"/>
</odoo>
