<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_nc_tag" model="report.paperformat">
        <field name="name">NC Tag A4 (3 per page)</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_nc_tag" model="ir.actions.report">
        <field name="name">NC Tag</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">buz_nc_tag.report_nc_tag</field>
        <field name="report_file">buz_nc_tag.report_nc_tag</field>
        <field name="print_report_name">'NC Tag - %s' % (object.name or '')</field>
        <field name="paperformat_id" ref="buz_nc_tag.paperformat_nc_tag"/>
    </record>

    <template id="report_nc_tag">
        <t t-call="web.basic_layout">
            <style>
                @font-face { font-family:'Sarabun'; src:url('/buz_nc_tag/static/fonts/Sarabun-Regular.ttf'); font-weight:normal; }
                @font-face { font-family:'Sarabun'; src:url('/buz_nc_tag/static/fonts/Sarabun-Bold.ttf'); font-weight:bold; }
                html, body, table, td, div, span { font-family:'Sarabun' !important; font-size:18px; }
                .nc-page { page-break-after:always; }
                .nc-page:last-child { page-break-after:auto; }
                .nc-box { border:2px solid #000; height:116mm; position:relative; overflow:hidden; }
                .nc-foot { position:absolute; left:0; right:0; bottom:0; border-top:2px solid #000; }
                .nc-tag { margin-bottom:3mm; }
                .nc-title { font-size:40px; font-weight:bold; text-align:center; }
                .nc-band { background:#c9d3de; font-weight:bold; }
                .nc-line { border-bottom:1px dotted #000; }
                .nc-opt { display:inline-block; margin-right:12px; }
                .nc-dot { display:inline-block; width:18px; height:18px; border:1px solid #000; border-radius:50%; vertical-align:middle; margin-right:4px; }
                .nc-sq { display:inline-block; width:18px; height:18px; border:1px solid #000; vertical-align:middle; margin-right:4px; }
            </style>
            <t t-foreach="docs" t-as="picking">
                <t t-set="units" t-value="picking._nc_tag_units()"/>
                <t t-foreach="range(0, len(units), 3)" t-as="start">
                    <div class="nc-page">
                    <t t-foreach="units[start:start + 3]" t-as="ml">
                    <t t-set="date" t-value="picking.date_done or picking.scheduled_date"/>
                    <t t-set="model" t-value="ml.product_id.name"/>
                        <table class="nc-tag" style="width:100%;border-collapse:separate;border-spacing:0;">
                            <tr>
                                <!-- Part 1 -->
                                <td style="width:72%;vertical-align:top;padding-right:6px;">
                                    <div class="nc-box">
                                        <table style="width:100%;">
                                            <tr>
                                                <td style="width:30%;font-size:34px;font-weight:bold;padding:4px 8px;">MOGEN</td>
                                                <td class="nc-title">NC TAG<div style="font-size:14px;font-weight:normal;">ส่วนที่ 1</div></td>
                                                <td style="width:30%;padding:4px;">เลขที่ ......................<br/>วันที่ <span t-out="date" t-options="{'widget':'date'}"/></td>
                                            </tr>
                                        </table>
                                        <table style="width:100%;border-top:2px solid #000;table-layout:fixed;">
                                            <tr>
                                                <td style="width:10%;">รหัสรุ่น</td><td class="nc-line" style="width:40%;"><span t-out="model"/></td>
                                                <td style="width:14%;">หมายเลข (Lot)</td><td class="nc-line" style="width:20%;"><span t-out="picking.name"/></td>
                                                <td style="width:8%;">จำนวน</td><td class="nc-line" style="width:8%;">1</td>
                                            </tr>
                                            <tr>
                                                <td>Po</td><td class="nc-line"><span t-out="picking.origin"/></td>
                                                <td>ชื่อลูกค้า</td><td class="nc-line" colspan="3"><span t-out="picking.partner_id.name"/></td>
                                            </tr>
                                        </table>
                                        <div class="nc-band" style="padding:3px 6px;">
                                            สาเหตุของปัญหา
                                            <span class="nc-opt" style="margin-left:12px;"><span class="nc-dot"/>สินค้าโชว์</span>
                                            <span class="nc-opt"><span class="nc-dot"/>จากกระบวนการภายใน</span>
                                            <span class="nc-opt"><span class="nc-dot"/>เปลี่ยนคืนจากลูกค้า</span>
                                            <span class="nc-opt"><span class="nc-dot"/>ไม่ได้ตามมาตรฐาน</span>
                                        </div>
                                        <t t-set="problem" t-value="picking._nc_tag_problem_text()"/>
                                        <div style="padding:3px 6px;">ปัญหาที่พบ
                                            <t t-if="problem">
                                                <div class="nc-line" style="height:52px;line-height:26px;white-space:pre-line;overflow:hidden;" t-out="problem"/>
                                            </t>
                                            <t t-else="">
                                                <div class="nc-line" style="height:26px;"/><div class="nc-line" style="height:26px;"/>
                                            </t>
                                        </div>
                                        <table style="width:100%;">
                                            <tr>
                                                <td style="width:12%;">ชื่อผู้แจ้ง</td><td class="nc-line" style="width:40%;"><span t-out="picking.create_uid.name"/></td>
                                                <td style="width:8%;">แผนก</td><td class="nc-line"><span t-out="picking.department_id.name"/></td>
                                            </tr>
                                        </table>
                                        <div class="nc-band" style="padding:3px 6px;margin-top:4px;border-top:1px solid #000;">
                                            สำหรับเจ้าหน้าที่ผู้เกี่ยวข้อง — การจัดการกับผลิตภัณฑ์
                                            <span style="float:right;">NCR เลขที่ ................</span>
                                        </div>
                                        <table style="width:100%;">
                                            <tr>
                                                <td style="width:45%;padding:3px 6px;"><span class="nc-dot"/>ส่งคืน Supplier ........................</td>
                                                <td style="width:30%;"><span class="nc-dot"/>อนุมัติขายกรณีพิเศษ</td>
                                                <td><span class="nc-dot"/>ทำลาย/รอทำลาย</td>
                                            </tr>
                                            <tr>
                                                <td style="padding:3px 6px;"><span class="nc-dot"/>ซ่อม / เปลี่ยนอะไหล่ / กลับสู่กระบวนการใหม่</td>
                                                <td colspan="2"><span class="nc-dot"/>อื่นๆ ........................</td>
                                            </tr>
                                        </table>
                                        <table class="nc-foot" style="width:100%;font-size:14px;">
                                            <tr><td style="padding:2px 6px;">อนุมัติใช้วันที่ 16/02/2560</td><td style="text-align:right;padding-right:6px;">FM-QAM-25 Rev.03</td></tr>
                                        </table>
                                    </div>
                                </td>
                                <!-- Part 2 -->
                                <td style="width:28%;vertical-align:top;">
                                    <div class="nc-box">
                                        <div class="nc-title" style="border-bottom:2px solid #000;padding:4px;">NC TAG<div style="font-size:14px;font-weight:normal;">ส่วนที่ 2</div></div>
                                        <div style="padding:4px 8px;">
                                            <div>เลขที่ <b t-out="picking.name"/></div>
                                            <div style="margin-top:6px;">รหัสรุ่น <b t-out="model"/></div>
                                            <div style="margin-top:8px;"><span class="nc-dot"/>สินค้าโชว์</div>
                                            <div><span class="nc-dot"/>จากกระบวนการภายใน</div>
                                            <div><span class="nc-dot"/>เปลี่ยนคืนจากลูกค้า</div>
                                            <div><span class="nc-dot"/>ไม่ได้ตามมาตรฐาน</div>
                                            <div style="margin-top:8px;">ชื่อผู้แจ้ง <span t-out="picking.create_uid.name"/></div>
                                            <div>วันที่ <span t-out="date" t-options="{'widget':'date'}"/></div>
                                        </div>
                                        <div class="nc-foot" style="text-align:center;font-size:14px;padding:2px 0;">อนุมัติใช้วันที่ 16/02/2560<br/>FM-QAM-25 Rev.03</div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
