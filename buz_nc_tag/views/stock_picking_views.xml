<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_nc_tag" model="ir.ui.view">
        <field name="name">stock.picking.form.nc.tag</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="%(buz_nc_tag.action_report_nc_tag)d" type="action"
                        string="Print NC Tag"
                        invisible="not picking_type_id.is_nc_tag or state == 'draft'"/>
            </header>
        </field>
    </record>
</odoo>
