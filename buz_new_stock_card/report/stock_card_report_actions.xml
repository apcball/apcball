<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_stock_card_landscape" model="report.paperformat">
        <field name="name">Stock Card A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">18</field>
        <field name="margin_bottom">18</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">20</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_stock_card_pdf" model="ir.actions.report">
        <field name="name">Stock Card PDF</field>
        <field name="model">product.product</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">buz_new_stock_card.report_stock_card_pdf</field>
        <field name="report_file">buz_new_stock_card.report_stock_card_pdf</field>
        <field name="print_report_name">'Stock_Card_%s' % (object.default_code or object.id)</field>
        <field name="paperformat_id" ref="paperformat_stock_card_landscape"/>
        <field name="binding_model_id" eval="False"/>
    </record>
</odoo>
