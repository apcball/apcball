<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_new_stock_card.MainPanel">
        <main class="o_stock_card_main" t-att-aria-busy="props.state.loading ? 'true' : 'false'">
            <div t-if="props.state.loading" class="o_sc_panel o_sc_empty" role="status">
                <i aria-hidden="true" class="fa fa-circle-o-notch fa-spin fa-2x mb-3"/><p>กำลังโหลด Stock Card...</p>
            </div>
            <div t-elif="props.state.error" class="o_sc_panel o_sc_empty" role="alert">
                <i aria-hidden="true" class="fa fa-exclamation-circle fa-2x text-danger mb-3"/><p t-esc="props.state.error"/>
                <button class="btn btn-primary" t-on-click="props.onRetry"><i aria-hidden="true" class="fa fa-refresh me-2"/>ลองใหม่</button>
            </div>
            <div t-elif="!props.state.cardData" class="o_sc_panel o_sc_empty">
                <i aria-hidden="true" class="fa fa-cube fa-3x mb-3"/><h2>ดูความเคลื่อนไหวของสินค้า</h2>
                <p>เลือกสินค้า ช่วงวันที่ และคลังสินค้า แล้วกดค้นหา</p>
            </div>
            <t t-else="">
                <section class="o_product_header o_sc_panel">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-3 mb-1">
                                <h2 t-esc="props.state.product.default_code or props.state.product.display_name"/>
                                <span class="o_sc_status" t-att-class="props.state.product.active ? 'is-active' : 'is-archived'">
                                    <t t-esc="props.state.product.active ? 'Active' : 'Archived'"/>
                                </span>
                            </div>
                            <div class="o_sc_product_name" t-esc="props.state.product.display_name"/>
                        </div>
                        <button class="btn o_sc_product_button" t-on-click="() => this.props.openDocument('product.product', props.state.productId)">
                            ดูข้อมูลสินค้า <i aria-hidden="true" class="fa fa-external-link ms-2"/>
                        </button>
                    </div>
                    <div class="o_sc_product_meta">
                        <span>ประเภทสินค้า : <t t-esc="productType"/></span>
                        <span>หน่วยนับ : <t t-esc="uom"/></span>
                        <span>หมวดสินค้า : <t t-esc="props.state.product.categ_id ? props.state.product.categ_id[1] : '—'"/></span>
                        <span class="o_sc_scope">สถานที่จัดเก็บ : <t t-esc="props.state.scopeLabel"/></span>
                    </div>
                </section>
                <section class="o_sc_summary_grid" aria-label="สรุปจำนวนสินค้า">
                    <div t-foreach="summaryCards" t-as="card" t-key="card.key" class="o_summary_card" t-att-class="'o_card_' + card.key">
                        <div class="o_sc_card_icon"><i t-att-class="'fa ' + card.icon" aria-hidden="true"/></div>
                        <div><div class="o_sc_card_label" t-esc="card.label"/><div class="o_sc_card_value" t-esc="fmt(card.value)"/><div class="o_sc_card_uom" t-esc="uom"/>
                            <div t-if="card.valueBaht !== undefined" class="o_sc_card_value_baht" t-esc="fmt(card.valueBaht) + ' บาท'"/>
                        </div>
                    </div>
                </section>
                <section class="o_sc_transactions o_sc_panel">
                    <div class="o_sc_transactions_header">
                        <h2><i class="fa fa-file-text-o me-3" aria-hidden="true"/>รายการเคลื่อนไหว (Transactions)</h2>
                        <label class="o_sc_page_size">แสดง
                            <select class="form-select" t-on-change="onPageSizeChange" aria-label="จำนวนรายการต่อหน้า">
                                <option t-foreach="[20, 50, 100]" t-as="size" t-key="size" t-att-value="size"
                                        t-att-selected="props.state.pageSize === size"><t t-esc="size"/></option>
                            </select>รายการ
                        </label>
                    </div>
                    <div t-if="!props.state.cardData.lines.length" class="o_sc_empty">
                        <i aria-hidden="true" class="fa fa-inbox fa-2x mb-3"/><h3>ไม่พบรายการเคลื่อนไหว</h3>
                        <p><t t-esc="props.state.dateFrom"/> – <t t-esc="props.state.dateTo"/></p>
                    </div>
                    <div t-else="" class="o_sc_table_scroll" tabindex="0" aria-label="รายการเคลื่อนไหวสินค้า">
                        <table class="table o_stock_card_table">
                            <thead><tr>
                                <th scope="col">#</th><th scope="col">วันที่ / เวลา</th><th scope="col">เอกสาร</th><th scope="col">อ้างอิง</th>
                                <th scope="col">ประเภท</th><th scope="col" class="text-end">รับ (เข้า)</th><th scope="col" class="text-end">จ่าย (ออก)</th>
                                <th scope="col" class="text-end">ยอดคงเหลือ</th>
                                <th t-if="props.state.cardData.can_see_value" scope="col" class="text-end">มูลค่าสินค้า (บาท)</th>
                                <th t-if="props.state.cardData.can_see_value" scope="col" class="text-end">มูลค่ารับ (บาท)</th>
                                <th t-if="props.state.cardData.can_see_value" scope="col" class="text-end">มูลค่าจ่าย (บาท)</th>
                                <th scope="col">สถานที่จัดเก็บ</th>
                            </tr></thead>
                            <tbody>
                                <tr t-foreach="props.state.cardData.lines" t-as="line" t-key="line.seq">
                                    <td t-esc="line.seq"/><td class="text-nowrap" t-esc="line.date"/>
                                    <td><button t-if="line.res_model and line.res_id" class="btn btn-link o_sc_doc_link" t-on-click="() => this.onDocClick(line)" t-esc="line.doc_number"/>
                                        <span t-else="" t-esc="line.doc_number or '—'"/></td>
                                    <td t-esc="line.reference or '—'"/>
                                    <td><span class="o_sc_movement_icon" t-att-class="line['out'] ? 'is-out' : 'is-in'"><i aria-hidden="true" t-att-class="line['out'] ? 'fa fa-sign-out' : 'fa fa-sign-in'"/></span><t t-esc="line.doc_type or (line['out'] ? 'จ่ายสินค้า' : 'รับสินค้า')"/></td>
                                    <td class="text-end o_sc_qty_in" t-esc="line['in'] ? fmt(line['in']) : '—'"/>
                                    <td class="text-end o_sc_qty_out" t-esc="line['out'] ? fmt(line['out']) : '—'"/>
                                    <td class="text-end fw-bold" t-esc="fmt(line.balance)"/>
                                    <td t-if="props.state.cardData.can_see_value" class="text-end" t-esc="fmt(line.value)"/>
                                    <td t-if="props.state.cardData.can_see_value" class="text-end o_sc_qty_in" t-esc="line.value_in ? fmt(line.value_in) : '—'"/>
                                    <td t-if="props.state.cardData.can_see_value" class="text-end o_sc_qty_out" t-esc="line.value_out ? fmt(line.value_out) : '—'"/>
                                    <td t-esc="line.location_name"/>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <footer class="o_sc_pager">
                        <span>แสดง <t t-esc="pageStart"/> – <t t-esc="pageEnd"/> จาก <t t-esc="props.state.cardData.total_count"/> รายการ</span>
                        <nav class="d-flex gap-1" aria-label="หน้ารายการ">
                            <button class="btn" aria-label="หน้าแรก" t-att-disabled="!props.state.cardData.has_prev" t-on-click="() => this.props.onChangePage(0)">«</button>
                            <button class="btn" aria-label="หน้าก่อนหน้า" t-att-disabled="!props.state.cardData.has_prev" t-on-click="() => this.props.onChangePage(props.state.page - 1)">‹</button>
                            <button t-foreach="pages" t-as="page" t-key="page" class="btn" t-att-class="page === props.state.page ? 'btn-primary' : ''"
                                t-att-aria-current="page === props.state.page ? 'page' : false" t-on-click="() => this.props.onChangePage(page)"><t t-esc="page + 1"/></button>
                            <button class="btn" aria-label="หน้าถัดไป" t-att-disabled="!props.state.cardData.has_next" t-on-click="() => this.props.onChangePage(props.state.page + 1)">›</button>
                            <button class="btn" aria-label="หน้าสุดท้าย" t-att-disabled="!props.state.cardData.has_next" t-on-click="() => this.props.onChangePage(lastPage)">»</button>
                        </nav>
                    </footer>
                </section>
            </t>
        </main>
    </t>
</templates>
