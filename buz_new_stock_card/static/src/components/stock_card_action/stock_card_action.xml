<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_new_stock_card.StockCardAction">
        <div class="o_stock_card_action">
            <header class="o_stock_card_header">
                <div class="d-flex align-items-center gap-3">
                    <div class="o_stock_card_logo"><i class="fa fa-cube" aria-hidden="true"/></div>
                    <div><h1>Stock Card</h1><p>ตรวจสอบความเคลื่อนไหวของสินค้าตามช่วงเวลา</p></div>
                </div>
                <div class="o_stock_card_toolbar">
                    <div class="btn-group">
                        <button class="btn o_sc_outline" t-on-click="saveFavorite"><i class="fa fa-bookmark-o me-2" aria-hidden="true"/>เพิ่มรายการโปรด</button>
                        <button class="btn o_sc_outline" t-on-click="loadFavorite" title="โหลดตัวกรองโปรด" aria-label="โหลดตัวกรองโปรด"><i class="fa fa-angle-down" aria-hidden="true"/></button>
                    </div>
                    <button class="btn o_sc_outline" t-on-click="printReport" t-att-disabled="!state.cardData or state.loading" title="พิมพ์รายการในหน้าปัจจุบัน"><i class="fa fa-print me-2" aria-hidden="true"/>พิมพ์รายงาน</button>
                    <button class="btn btn-success" t-on-click="exportExcel" t-att-disabled="!state.cardData or state.loading"><i aria-hidden="true" class="fa fa-file-excel-o me-2"/>Export <i class="fa fa-angle-down ms-3" aria-hidden="true"/></button>
                </div>
            </header>
            <div class="o_stock_card_body">
                <Sidebar state="state" onSelectProduct.bind="onSelectProduct" onSelectLocation.bind="onSelectLocation"
                         onSetDateFrom.bind="onSetDateFrom" onSetDateTo.bind="onSetDateTo"
                         onSetCompany.bind="onSetCompany" onSetWarehouse.bind="onSetWarehouse"
                         onSearch.bind="search" onReset.bind="reset" onToggleShowMovementsOnly.bind="onToggleShowMovementsOnly"/>
                <MainPanel state="state" onRetry.bind="fetchCardData" onChangePage.bind="onChangePage"
                           onChangePageSize.bind="onChangePageSize" openDocument.bind="openDocument"/>
            </div>
        </div>
    </t>
</templates>
