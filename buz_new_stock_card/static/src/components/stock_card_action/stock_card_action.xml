<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_new_stock_card.StockCardAction">
        <div class="o_stock_card_action d-flex flex-column h-100">
            <div class="o_stock_card_header d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <div class="o_stock_card_logo d-flex align-items-center justify-content-center">
                        <i class="fa fa-th-large"/>
                    </div>
                    <div>
                        <h4 class="mb-0">Stock Card</h4>
                    </div>
                </div>
                <div class="o_stock_card_toolbar d-flex gap-2">
                    <button class="btn btn-light btn-sm" t-on-click="() => this.notification.add('ดูวิธีใช้งานได้จากคู่มือระบบ', {type: 'info'})">
                        <i class="fa fa-question-circle"/>
                    </button>
                    <button class="btn btn-outline-success btn-sm" t-on-click="exportExcel">
                        <i class="fa fa-file-excel-o me-1"/>Export Excel
                    </button>
                </div>
            </div>
            <div class="o_stock_card_body d-flex flex-grow-1" style="min-height:0;">
                <Sidebar state="state"
                         onSelectProduct.bind="onSelectProduct"
                         onSelectLocation.bind="onSelectLocation"
                         onSetDateFrom.bind="onSetDateFrom"
                         onSetDateTo.bind="onSetDateTo"
                         onSetCompany.bind="onSetCompany"
                         onSetWarehouse.bind="onSetWarehouse"
                         onSearch.bind="search"
                         onReset.bind="reset"/>
                <MainPanel state="state"
                           onToggleShowMovementsOnly.bind="onToggleShowMovementsOnly"
                           onChangePage.bind="onChangePage"
                           onChangePageSize.bind="onChangePageSize"
                           openDocument.bind="openDocument"/>
            </div>
        </div>
    </t>
</templates>
