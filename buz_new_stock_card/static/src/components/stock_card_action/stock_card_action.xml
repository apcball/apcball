<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_new_stock_card.StockCardAction">
        <div class="o_stock_card_action">
            <header class="o_stock_card_header">
                <div class="d-flex align-items-center gap-3">
                    <div class="o_stock_card_logo"><i class="fa fa-cube" aria-hidden="true"/></div>
                    <div><h1>Stock Card</h1><p>ตรวจสอบความเคลื่อนไหวของสินค้าตามช่วงเวลา</p></div>
                </div>
                <div class="o_stock_card_toolbar">
                    <span class="o_stock_card_breadcrumb"><i class="fa fa-home" aria-hidden="true"/> / Inventory / Stock Card</span>
                    <button class="btn o_help_button" title="วิธีใช้งาน" aria-label="วิธีใช้งาน"
                            t-on-click="() => this.notification.add('เลือกสินค้าและช่วงวันที่ แล้วกดค้นหา เลือก Location เพิ่มเติมได้ในตัวเลือกขั้นสูง', {type: 'info'})"><i aria-hidden="true" class="fa fa-question-circle"/></button>
                    <button class="btn btn-success" t-on-click="exportExcel" t-att-disabled="!state.cardData or state.loading"><i aria-hidden="true" class="fa fa-file-excel-o me-2"/>Export Excel</button>
                </div>
            </header>
            <div class="o_stock_card_body">
                <Sidebar state="state" onSelectProduct.bind="onSelectProduct" onSelectLocation.bind="onSelectLocation"
                         onSetDateFrom.bind="onSetDateFrom" onSetDateTo.bind="onSetDateTo"
                         onSetCompany.bind="onSetCompany" onSetWarehouse.bind="onSetWarehouse"
                         onSearch.bind="search" onReset.bind="reset" onToggleShowMovementsOnly.bind="onToggleShowMovementsOnly"/>
                <MainPanel state="state" onRetry.bind="fetchCardData" onChangePage.bind="onChangePage"
                           onChangePageSize.bind="onChangePageSize" openDocument.bind="openDocument"/>
            </div>
        </div>
    </t>
</templates>
