<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_edit_product" model="ir.ui.view">
        <field name="name">purchase.order.form.edit.product.after.return</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='product_id']"
                   position="after">
                <field name="allow_product_edit" column_invisible="1"/>
                <button name="action_open_change_product_wizard"
                        type="object"
                        string="แก้ไขรหัสสินค้า"
                        icon="fa-pencil"
                        title="แก้ไขรหัสสินค้า (ใช้ได้เมื่อ return ครบ และบิลเป็น draft หรือยังไม่ตั้งบิล)"
                        invisible="not allow_product_edit"
                        groups="buz_po_edit_product.group_po_edit_product"/>
            </xpath>
        </field>
    </record>
</odoo>
