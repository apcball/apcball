<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_po_line_change_product_wizard_form" model="ir.ui.view">
        <field name="name">buz.po.line.change.product.wizard.form</field>
        <field name="model">buz.po.line.change.product.wizard</field>
        <field name="arch" type="xml">
            <form string="แก้ไขรหัสสินค้า (กรณี Return ครบแล้ว)">
                <group>
                    <field name="line_id" invisible="1"/>
                    <field name="old_product_id" readonly="1"/>
                    <field name="new_product_id"/>
                    <field name="reason" placeholder="เช่น รหัสสินค้าผิด แก้ไขหลัง return ครบ"/>
                </group>
                <footer>
                    <button string="ยืนยัน" name="action_confirm" type="object"
                            class="btn-primary"/>
                    <button string="ยกเลิก" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
