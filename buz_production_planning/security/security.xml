<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_buz_production_planning" model="ir.module.category">
        <field name="name">Production Planning</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_plan_user" model="res.groups">
        <field name="name">Planning / User</field>
        <field name="category_id" ref="module_category_buz_production_planning"/>
        <field name="implied_ids" eval="[Command.link(ref('mrp.group_mrp_user')), Command.link(ref('purchase.group_purchase_user'))]"/>
    </record>
    <record id="group_plan_manager" model="res.groups">
        <field name="name">Planning / Manager</field>
        <field name="category_id" ref="module_category_buz_production_planning"/>
        <field name="implied_ids" eval="[Command.link(ref('group_plan_user'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_root')), Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="rule_plan_product_param_company" model="ir.rule">
        <field name="name">Plan product param: multi-company</field>
        <field name="model_id" ref="model_buz_plan_product_param"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_plan_run_company" model="ir.rule">
        <field name="name">Plan run: multi-company</field>
        <field name="model_id" ref="model_buz_plan_run"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_plan_demand_line_company" model="ir.rule">
        <field name="name">Plan demand line: multi-company</field>
        <field name="model_id" ref="model_buz_plan_demand_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_plan_suggestion_company" model="ir.rule">
        <field name="name">Plan suggestion: multi-company</field>
        <field name="model_id" ref="model_buz_plan_suggestion"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_plan_schedule_line_company" model="ir.rule">
        <field name="name">Plan schedule line: multi-company</field>
        <field name="model_id" ref="model_buz_plan_schedule_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
