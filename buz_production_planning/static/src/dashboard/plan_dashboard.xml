<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="buz_production_planning.PlanChart">
        <div class="o_buz_dash_canvas" t-attf-style="height: {{props.height || 280}}px;">
            <canvas t-ref="canvas"/>
        </div>
    </t>

    <t t-name="buz_production_planning.PlanDashboard">
        <div class="o_buz_dash h-100 overflow-auto">
            <div class="o_buz_dash_header d-flex flex-wrap align-items-center gap-2 p-3 border-bottom bg-view">
                <span class="o_buz_dash_logo"><i class="fa fa-calendar"/></span>
                <div class="me-2">
                    <h2 class="m-0">Planning Dashboard</h2>
                    <div class="text-muted small">Plan your resources, maximize capacity</div>
                </div>
                <t t-if="state.run">
                    <label class="visually-hidden" for="o_buz_dash_run">Plan</label>
                    <select id="o_buz_dash_run" class="form-select w-auto" title="Plan shown on this page"
                            t-on-change="onRunChange">
                        <t t-foreach="state.runs" t-as="r" t-key="r.id">
                            <option t-att-value="r.id" t-att-selected="r.id === state.runId" t-esc="r.name"/>
                        </t>
                    </select>
                    <span t-attf-class="badge rounded-pill {{stateBadge}}" t-esc="state.run.state_label"/>
                    <span class="text-muted" t-esc="dateRange"/>
                    <span t-if="state.run.planner" class="text-muted">
                        · <i class="fa fa-user-o me-1"/><t t-esc="state.run.planner"/>
                    </span>
                    <div class="ms-auto d-flex flex-wrap align-items-center gap-2">
                        <span t-if="state.updatedAt" class="text-muted small">Updated <t t-esc="state.updatedAt"/></span>
                        <button class="btn btn-primary" t-on-click="openPlan">Open plan</button>
                        <button class="btn btn-secondary" t-on-click="openGantt">Gantt</button>
                        <button class="btn btn-secondary" t-on-click="load" t-att-disabled="state.loading">
                            <i t-attf-class="fa fa-refresh me-1 {{state.loading ? 'fa-spin' : ''}}"/>Refresh
                        </button>
                    </div>
                </t>
            </div>

            <div t-if="state.loading and !state.run" class="p-5 text-center text-muted">
                <i class="fa fa-spinner fa-spin me-2"/>Loading the dashboard…
            </div>

            <div t-elif="!state.run" class="o_buz_dash_empty p-5 text-center">
                <p class="fs-3 mb-2">No plan yet</p>
                <p class="text-muted">Create a production plan and click Compute Plan. Its numbers will show here.</p>
                <button t-if="state.canCreate" class="btn btn-primary" t-on-click="createPlan">Create a plan</button>
            </div>

            <div t-else="" class="p-3" t-att-class="{ 'opacity-50': state.loading }">
                <div t-if="state.run.next_step_hint" class="alert alert-info d-flex align-items-center mb-3" role="status">
                    <i class="fa fa-lightbulb-o me-2"/>
                    <span><b>Next step:</b> <t t-esc="state.run.next_step_hint"/></span>
                    <button class="btn btn-sm btn-light ms-auto" t-on-click="openPlan">View details <i class="fa fa-arrow-right ms-1"/></button>
                </div>

                <div class="o_buz_dash_cards mb-3">
                    <t t-foreach="state.cards" t-as="card" t-key="card.key">
                        <button type="button" t-attf-class="o_buz_dash_card o_buz_tone_{{card.tone}} o_buz_card_{{card.key}}"
                                t-on-click="() => this.openCard(card)">
                            <span class="o_buz_dash_icon"><i t-attf-class="fa {{iconFor(card)}}"/></span>
                            <span class="o_buz_dash_value" t-esc="card.value"/>
                            <span class="o_buz_dash_label" t-esc="card.label"/>
                            <i class="fa fa-arrow-right o_buz_dash_go"/>
                        </button>
                    </t>
                </div>

                <section class="o_buz_dash_panel mb-3">
                    <div class="d-flex flex-wrap align-items-start gap-2">
                        <div class="me-auto">
                            <h4>Load vs Capacity by <t t-esc="state.period"/></h4>
                            <p class="text-muted small">
                                Hours of planned work against the hours the work centers can work. <span class="text-danger">Red = more work than capacity.</span>
                                <t t-if="state.charts.truncated"> Only the first 26 weeks are shown; the schedule runs further.</t>
                            </p>
                        </div>
                        <div class="o_buz_dash_periods btn-group" role="group">
                            <t t-foreach="['week', 'month', 'quarter']" t-as="p" t-key="p">
                                <button type="button" t-attf-class="btn btn-sm {{state.period === p ? 'btn-primary' : 'btn-light'}}"
                                        t-on-click="() => this.setPeriod(p)" t-esc="p[0].toUpperCase() + p.slice(1)"/>
                            </t>
                        </div>
                    </div>
                    <BuzPlanChart t-if="state.loadChart" config="state.loadChart" height="300"/>
                    <div t-else="" class="o_buz_dash_nodata">
                        <t t-if="state.charts.scheduled">No working time or planned work in this period.</t>
                        <t t-else="">Schedule the plan to see load.</t>
                    </div>
                </section>

                <div class="o_buz_dash_bottom">
                    <section class="o_buz_dash_panel">
                        <div class="d-flex align-items-center mb-2">
                            <h4 class="me-auto"><i class="fa fa-trophy me-2 text-warning"/>Top 5 Suggestions</h4>
                            <a href="#" class="small" t-on-click.prevent="viewAllSuggestions">View all <i class="fa fa-arrow-right"/></a>
                        </div>
                        <ol t-if="state.topSuggestions.length" class="o_buz_dash_list">
                            <li t-foreach="state.topSuggestions" t-as="row" t-key="row.id"
                                t-on-click="() => this.openSuggestion(row)">
                                <span class="o_buz_dash_num" t-esc="row_index + 1"/>
                                <span class="o_buz_dash_name">
                                    <t t-esc="row.action"/> · <t t-esc="row.name"/>
                                </span>
                                <span t-attf-class="o_buz_pill o_buz_pill_{{row.priority}}" t-esc="row.priority_label"/>
                            </li>
                        </ol>
                        <div t-else="" class="o_buz_dash_nodata">No open suggestions in this plan.</div>
                    </section>

                    <section class="o_buz_dash_panel">
                        <h4 class="mb-2"><i class="fa fa-pie-chart me-2 text-primary"/>Plan Status</h4>
                        <div t-if="state.charts.status" class="d-flex align-items-center gap-3">
                            <div class="o_buz_dash_donut"><BuzPlanChart config="state.charts.status" height="190"/></div>
                            <ul class="o_buz_dash_legend list-unstyled m-0 flex-grow-1">
                                <li t-foreach="state.status.rows" t-as="row" t-key="row.key" class="d-flex align-items-center">
                                    <span t-attf-class="o_buz_dot o_buz_dot_{{row.key}}"/>
                                    <span class="me-auto" t-esc="row.label"/>
                                    <b><t t-esc="row.pct"/>%</b>
                                </li>
                            </ul>
                        </div>
                        <div t-else="" class="o_buz_dash_nodata">No open suggestions in this plan. Click Compute Plan first.</div>
                    </section>

                    <section class="o_buz_dash_panel">
                        <div class="d-flex align-items-center mb-2">
                            <h4 class="me-auto"><i class="fa fa-history me-2 text-primary"/>Recent Activity</h4>
                            <a href="#" class="small" t-on-click.prevent="openPlan">View all <i class="fa fa-arrow-right"/></a>
                        </div>
                        <ul t-if="state.activity.length" class="o_buz_dash_timeline list-unstyled m-0">
                            <li t-foreach="state.activity" t-as="row" t-key="row.id" t-on-click="() => this.openActivity(row)">
                                <span class="o_buz_dash_time" t-esc="activityTime(row)"/>
                                <span class="o_buz_dash_text" t-esc="row.text"/>
                            </li>
                        </ul>
                        <div t-else="" class="o_buz_dash_nodata">No activity yet.</div>
                    </section>
                </div>
            </div>
        </div>
    </t>
</templates>
