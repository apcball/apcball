<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_buz_plan_demand_line_tree" model="ir.ui.view">
        <field name="name">buz.plan.demand.line.tree</field>
        <field name="model">buz.plan.demand.line</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0" delete="0">
                <field name="company_id" column_invisible="1"/>
                <field name="run_id" optional="hide"/>
                <field name="product_id" readonly="1"/>
                <field name="bucket_start" readonly="1"/>
                <field name="source" readonly="1"/>
                <field name="qty" readonly="1"/>
                <field name="qty_manual" readonly="source != 'forecast'"/>
                <field name="origin_ref" readonly="1"/>
            </tree>
        </field>
    </record>

    <record id="view_buz_plan_demand_line_pivot" model="ir.ui.view">
        <field name="name">buz.plan.demand.line.pivot</field>
        <field name="model">buz.plan.demand.line</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="product_id" type="row"/>
                <field name="bucket_start" interval="week" type="col"/>
                <field name="qty" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_buz_plan_demand_line_search" model="ir.ui.view">
        <field name="name">buz.plan.demand.line.search</field>
        <field name="model">buz.plan.demand.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_id"/>
                <field name="run_id"/>
                <filter name="delivery" string="Delivery" domain="[('source', '=', 'delivery')]"/>
                <filter name="forecast" string="Forecast" domain="[('source', '=', 'forecast')]"/>
                <filter name="dependent" string="Dependent" domain="[('source', '=', 'dependent')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_source" string="Source" context="{'group_by': 'source'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_buz_plan_demand_line" model="ir.actions.act_window">
        <field name="name">Demand</field>
        <field name="res_model">buz.plan.demand.line</field>
        <field name="view_mode">pivot,tree</field>
    </record>
</odoo>
