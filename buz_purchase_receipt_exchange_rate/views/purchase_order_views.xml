<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_exchange_rate" model="ir.ui.view">
        <field name="name">purchase.order.form.exchange.rate</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="is_foreign_currency_po" invisible="1"/>
                <field name="exchange_rate_date"
                       invisible="not is_foreign_currency_po"
                       readonly="state not in ('draft', 'sent')"/>
            </xpath>
        </field>
    </record>
</odoo>
