<odoo>
    <record id="view_order_form_inherit_margin" model="ir.ui.view">
        <field name="name">sale.order.form.margin</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
             <!-- Prevent selecting Standard Cost Pricelist -->
             <field name="pricelist_id" position="attributes">
                <attribute name="domain">['&amp;', ('is_standard_cost_pricelist', '=', False), '|', ('company_id', '=', False), ('company_id', '=', company_id)]</attribute>
             </field>
             <!-- Warn on the order form when any line is missing a Cost -->
             <xpath expr="//field[@name='order_line']" position="before">
                <div class="alert alert-danger" role="alert" invisible="not missing_cost_warning">
                    <field name="missing_cost_warning" nolabel="1" readonly="1"/>
                </div>
             </xpath>
             <!-- Highlight lines missing a Cost — must be set before Confirm -->
             <xpath expr="//field[@name='order_line']/tree" position="attributes">
                <attribute name="decoration-danger">purchase_price &lt;= 0 and product_id and not is_downpayment and product_type != 'service'</attribute>
             </xpath>
             <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="before">
                <field name="is_downpayment" invisible="1"/>
                <field name="product_type" column_invisible="1"/>
             </xpath>
        </field>
    </record>
</odoo>
