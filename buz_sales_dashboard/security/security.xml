<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_sales_dashboard" model="ir.module.category">
        <field name="name">Sales Dashboard (SO + POS)</field>
        <field name="sequence">20</field>
    </record>

    <!-- its own category: a switch beside the "see" levels, not one of them -->
    <record id="module_category_sales_dashboard_target" model="ir.module.category">
        <field name="name">Sales Dashboard: เป้ายอดขาย</field>
        <field name="sequence">21</field>
    </record>

    <record id="group_own" model="res.groups">
        <field name="name">เห็นของตัวเองและทีมที่เป็นหัวหน้า</field>
        <field name="category_id" ref="module_category_sales_dashboard"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>
    <record id="group_all" model="res.groups">
        <field name="name">เห็นยอดขายทั้งหมด</field>
        <field name="category_id" ref="module_category_sales_dashboard"/>
        <field name="implied_ids" eval="[Command.link(ref('group_own'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <record id="group_target_manager" model="res.groups">
        <field name="name">ตั้งเป้ายอดขาย</field>
        <field name="category_id" ref="module_category_sales_dashboard_target"/>
        <field name="implied_ids" eval="[Command.link(ref('group_all'))]"/>
        <field name="users" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>

    <!-- Sales users get the narrow level. "See all" is granted per user: the
         Sales Administrator role is held too widely to imply it. -->
    <record id="sales_team.group_sale_salesman" model="res.groups">
        <field name="implied_ids" eval="[Command.link(ref('group_own'))]"/>
    </record>

    <record id="report_rule_company" model="ir.rule">
        <field name="name">Sales Dashboard: companies</field>
        <field name="model_id" ref="model_buz_sales_dashboard_report"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="report_rule_own" model="ir.rule">
        <field name="name">Sales Dashboard: own documents and led teams</field>
        <field name="model_id" ref="model_buz_sales_dashboard_report"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_own'))]"/>
    </record>
    <record id="report_rule_leader" model="ir.rule">
        <field name="name">Sales Dashboard: team leaders see all documents</field>
        <field name="model_id" ref="model_buz_sales_dashboard_report"/>
        <field name="domain_force">[('viewer_leads_team', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('group_own'))]"/>
    </record>
    <record id="report_rule_all" model="ir.rule">
        <field name="name">Sales Dashboard: all documents</field>
        <field name="model_id" ref="model_buz_sales_dashboard_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_all'))]"/>
    </record>

    <record id="target_rule_company" model="ir.rule">
        <field name="name">Sales Target: companies</field>
        <field name="model_id" ref="model_buz_sales_target"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="target_rule_own" model="ir.rule">
        <field name="name">Sales Target: own, led teams and their members</field>
        <field name="model_id" ref="model_buz_sales_target"/>
        <field name="domain_force">['|', '|', ('user_id', '=', user.id), ('team_id.user_id', '=', user.id), ('user_id.crm_team_member_ids.crm_team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_own'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="target_rule_leader_read" model="ir.rule">
        <field name="name">Sales Target: team leaders read all</field>
        <field name="model_id" ref="model_buz_sales_target"/>
        <field name="domain_force">[('viewer_leads_team', '=', True)]</field>
        <field name="groups" eval="[Command.link(ref('group_own'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <!-- A sales team leader sets targets of the teams led and of their members. -->
    <record id="target_rule_lead" model="ir.rule">
        <field name="name">Sales Target: edit as team leader</field>
        <field name="model_id" ref="model_buz_sales_target"/>
        <field name="domain_force">['|', '&amp;', ('level', '=', 'team'), ('team_id.user_id', '=', user.id), '&amp;', ('level', '=', 'user'), ('user_id.crm_team_member_ids.crm_team_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_own'))]"/>
        <field name="perm_read" eval="False"/>
    </record>
    <record id="target_rule_all" model="ir.rule">
        <field name="name">Sales Target: read all</field>
        <field name="model_id" ref="model_buz_sales_target"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_all'))]"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="target_rule_manage" model="ir.rule">
        <field name="name">Sales Target: manage all</field>
        <field name="model_id" ref="model_buz_sales_target"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('group_target_manager'))]"/>
    </record>

    <!-- Global on purpose: saved filters are private, also from managers. -->
    <record id="filter_rule_personal" model="ir.rule">
        <field name="name">Sales Dashboard: personal filters</field>
        <field name="model_id" ref="model_buz_sales_dashboard_filter"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
</odoo>
