                @font-face { font-family: Sarabun; src: url('/buz_share_certificate/static/fonts/Sarabun-Regular.ttf') format('truetype'); }
                @font-face { font-family: Sarabun; src: url('/buz_share_certificate/static/fonts/Sarabun-Bold.ttf') format('truetype'); font-weight: bold; }
                .share-page { box-sizing: border-box; margin: 0; padding: 0; position: relative; overflow: hidden; page-break-after: always; color: #000; }
                .share-reference { position: absolute; left: 0; top: 0; width: 100%; height: 100%; overflow: hidden; opacity: .42; z-index: 0; pointer-events: none; color: #333; }
                .share-reference-stub, .share-reference-certificate { position: absolute; top: 0; height: 100%; box-sizing: border-box; overflow: hidden; }
                .share-reference-stub { left: 0; padding: 2mm 3mm; font-size: 5.5pt; line-height: 1.15; }
                .share-reference-certificate { padding: 2mm 4mm; font-size: 6.5pt; line-height: 1.2; }
                .share-reference-title { position: absolute; left: 0; right: 0; top: 11mm; text-align: center; font-weight: bold; }
                .share-reference-row { position: absolute; left: 2mm; right: 2mm; display: flex; align-items: flex-end; gap: .6mm; height: 3mm; white-space: nowrap; }
                .share-reference-row.center { justify-content: center; }
                .share-reference-row.right { justify-content: flex-end; }
                .share-reference-dots { display: block; flex: 1; min-width: 3mm; height: 2.4mm; border-bottom: 1px dotted #333; }
                .share-reference-certificate-title { position: absolute; left: 0; right: 0; top: 75mm; text-align: center; font-size: 14pt; }
                .share-reference-signatures { position: absolute; left: 4mm; right: 4mm; top: 170mm; display: flex; justify-content: space-around; text-align: center; }
                .share-reference-signatures > div { width: 47%; }
                .share-reference-signature-line { height: 4mm; border-bottom: 1px dotted #333; }
                .share-reference-note { position: absolute; left: 0; right: 0; bottom: 1mm; text-align: center; font-size: 5pt; }
                .share-margin-guide { position: absolute; z-index: 0; box-sizing: border-box; border: .2mm dashed #527d91; pointer-events: none; }
                .share-content { position: absolute; left: 0; top: 0; width: 297mm; height: 210mm; z-index: 1; overflow: hidden; }
                .share-value { position: absolute; z-index: 1; display: block; white-space: nowrap; line-height: 1.1; }
                .share-center { text-align: center; }
                .share-right { text-align: right; }
                .share-company { font-weight: bold; }
