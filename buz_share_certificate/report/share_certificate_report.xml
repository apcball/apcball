<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_share_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.basic_layout">
                    <t t-set="layout" t-value="doc.env['buz.share.certificate.layout.config'].sudo().get_default_config()"/>
                    <div class="page share-certificate-page"
                         t-attf-style="width:{{297 - layout.margin_left - layout.margin_right}}mm;height:{{210 - layout.margin_top - layout.margin_bottom}}mm;">
                        <style type="text/css">
                            @font-face {
                                font-family: 'Sarabun';
                                src: url('/buz_share_certificate/static/fonts/Sarabun-Regular.ttf') format('truetype');
                                font-weight: 400;
                                font-style: normal;
                            }
                            @font-face {
                                font-family: 'Sarabun';
                                src: url('/buz_share_certificate/static/fonts/Sarabun-Bold.ttf') format('truetype');
                                font-weight: 700;
                                font-style: normal;
                            }
                            .share-certificate-page {
                                position: relative;
                                margin: 0;
                                padding: 0;
                                overflow: hidden;
                                font-family: 'Sarabun', sans-serif;
                            }
                            .field-value {
                                position: absolute;
                                display: block;
                                white-space: nowrap;
                                color: #171717;
                                line-height: 1.1;
                            }
                            .company-value { font-weight: 700; }
                        </style>
                        <span class="field-value" t-field="doc.company_name" t-att-style="layout.get_position_style('stub_company')"/>
                        <span class="field-value" t-field="doc.company_registration_number" t-att-style="layout.get_position_style('stub_registration')"/>
                        <span class="field-value" t-field="doc.certificate_number" t-att-style="layout.get_position_style('stub_certificate_number')"/>
                        <span class="field-value" t-field="doc.issue_date" t-att-style="layout.get_position_style('stub_issue_date')"/>
                        <span class="field-value" t-field="doc.shareholder_name" t-att-style="layout.get_position_style('stub_shareholder')"/>
                        <span class="field-value" t-field="doc.share_count" t-att-style="layout.get_position_style('stub_share_count')"/>
                        <span class="field-value" t-field="doc.share_number_from" t-att-style="layout.get_position_style('stub_share_number_from')"/>
                        <span class="field-value" t-field="doc.share_number_to" t-att-style="layout.get_position_style('stub_share_number_to')"/>
                        <span class="field-value" t-field="doc.paid_per_share" t-att-style="layout.get_position_style('stub_paid_per_share')"/>
                        <span class="field-value" t-field="doc.total_paid" t-att-style="layout.get_position_style('stub_total_paid')"/>
                        <span class="field-value" t-field="doc.cancelled_certificate_number" t-att-style="layout.get_position_style('stub_cancelled_number')"/>
                        <span class="field-value" t-field="doc.cancelled_date" t-att-style="layout.get_position_style('stub_cancelled_date')"/>
                        <span class="field-value" t-field="doc.received_date" t-att-style="layout.get_position_style('stub_received_date')"/>
                        <span class="field-value" t-field="doc.certificate_number" t-att-style="layout.get_position_style('certificate_number')"/>
                        <span class="field-value company-value" t-field="doc.company_name" t-att-style="layout.get_position_style('certificate_company')"/>
                        <span class="field-value" t-field="doc.company_registration_number" t-att-style="layout.get_position_style('certificate_registration')"/>
                        <span class="field-value" t-field="doc.registered_capital" t-att-style="layout.get_position_style('certificate_registered_capital')"/>
                        <span class="field-value" t-field="doc.registered_share_count" t-att-style="layout.get_position_style('certificate_registered_shares')"/>
                        <span class="field-value" t-field="doc.share_value" t-att-style="layout.get_position_style('certificate_share_value')"/>
                        <span class="field-value" t-field="doc.shareholder_name" t-att-style="layout.get_position_style('certificate_shareholder')"/>
                        <span class="field-value" t-field="doc.share_count" t-att-style="layout.get_position_style('certificate_share_count')"/>
                        <span class="field-value" t-field="doc.share_number_from" t-att-style="layout.get_position_style('certificate_share_number_from')"/>
                        <span class="field-value" t-field="doc.share_number_to" t-att-style="layout.get_position_style('certificate_share_number_to')"/>
                        <span class="field-value" t-field="doc.paid_per_share" t-att-style="layout.get_position_style('certificate_paid_per_share')"/>
                        <span class="field-value" t-field="doc.total_paid" t-att-style="layout.get_position_style('certificate_total_paid')"/>
                        <t t-if="doc.issue_date">
                            <span class="field-value" t-esc="doc.issue_date.day" t-att-style="layout.get_position_style('certificate_issue_day')"/>
                            <span class="field-value" t-esc="doc.issue_date.month" t-att-style="layout.get_position_style('certificate_issue_month')"/>
                            <span class="field-value" t-esc="doc.issue_date.year + 543" t-att-style="layout.get_position_style('certificate_issue_year')"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <data noupdate="1">
    <record id="paperformat_share_certificate" model="report.paperformat">
        <field name="name">Share Certificate A4 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    </data>

    <record id="action_report_share_certificate" model="ir.actions.report">
        <field name="name">พิมพ์ใบหุ้น</field>
        <field name="model">buz.share.certificate.print.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">buz_share_certificate.report_share_certificate</field>
        <field name="report_file">buz_share_certificate.report_share_certificate</field>
        <field name="print_report_name">'Share Certificate - %s' % (object.certificate_number or object.id)</field>
        <field name="paperformat_id" ref="paperformat_share_certificate"/>
    </record>
</odoo>
