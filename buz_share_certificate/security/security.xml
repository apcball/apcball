<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_share_certificate" model="ir.module.category">
        <field name="name">ใบหุ้น</field>
        <field name="sequence">80</field>
    </record>

    <record id="group_share_certificate_user" model="res.groups">
        <field name="name">ผู้ใช้งานใบหุ้น</field>
        <field name="category_id" ref="module_category_share_certificate"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_share_certificate_manager" model="res.groups">
        <field name="name">ผู้จัดการใบหุ้น</field>
        <field name="category_id" ref="module_category_share_certificate"/>
        <field name="implied_ids" eval="[(4, ref('group_share_certificate_user'))]"/>
    </record>
</odoo>
