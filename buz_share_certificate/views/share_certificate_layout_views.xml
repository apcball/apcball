<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_share_certificate_layout_config_form" model="ir.ui.view">
        <field name="name">buz.share.certificate.layout.config.form</field>
        <field name="model">buz.share.certificate.layout.config</field>
        <field name="arch" type="xml">
            <form string="ตั้งค่าแบบพิมพ์ใบหุ้น">
                <header>
                    <button name="action_preview_layout" type="object" string="Preview Layout" class="oe_highlight" icon="fa-eye"/>
                    <button name="action_reset_defaults" type="object" string="คืนค่าเริ่มต้น" class="btn-secondary" icon="fa-refresh"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group string="ตั้งค่าหน้ากระดาษ">
                            <div class="o_form_label">A4 แนวนอน (297 x 210 mm)</div>
                            <field name="margin_top_mm"/>
                            <field name="margin_bottom_mm"/>
                            <field name="margin_left_mm"/>
                            <field name="margin_right_mm"/>
                            <field name="stub_width_mm"/>
                        </group>
                        <group string="ตัวอักษร">
                            <field name="font_family"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        ใช้ Preview เทียบแบบฟอร์ม; X/Y ของทุกฟิลด์นับจากมุมซ้ายบนของกระดาษ A4 จริง ขอบทั้งสี่เป็นเส้นไกด์และไม่เลื่อนฟิลด์
                    </div>
                    <div invisible="not margin_warning" class="alert alert-warning" role="alert">
                        <field name="margin_warning" readonly="1"/>
                    </div>
                    <notebook>
                        <page string="ต้นขั้ว">
                            <group>
                                <group string="ข้อมูลบริษัทและใบหุ้น">
                                    <field name="stub_company_x_mm"/><field name="stub_company_y_mm"/>
                                    <field name="stub_registration_x_mm"/><field name="stub_registration_y_mm"/>
                                    <field name="stub_certificate_number_x_mm"/><field name="stub_certificate_number_y_mm"/>
                                    <field name="stub_issue_date_x_mm"/><field name="stub_issue_date_y_mm"/>
                                    <field name="stub_shareholder_x_mm"/><field name="stub_shareholder_y_mm"/>
                                </group>
                                <group string="จำนวนหุ้นและการชำระ">
                                    <field name="stub_share_count_x_mm"/><field name="stub_share_count_y_mm"/>
                                    <field name="stub_share_number_from_x_mm"/><field name="stub_share_number_from_y_mm"/>
                                    <field name="stub_share_number_to_x_mm"/><field name="stub_share_number_to_y_mm"/>
                                    <field name="stub_paid_per_share_x_mm"/><field name="stub_paid_per_share_y_mm"/>
                                    <field name="stub_total_paid_x_mm"/><field name="stub_total_paid_y_mm"/>
                                </group>
                                <group string="ใบหุ้นเดิมและวันที่รับ">
                                    <field name="stub_previous_certificate_number_x_mm"/><field name="stub_previous_certificate_number_y_mm"/>
                                    <field name="stub_previous_certificate_date_x_mm"/><field name="stub_previous_certificate_date_y_mm"/>
                                    <field name="stub_receipt_date_x_mm"/><field name="stub_receipt_date_y_mm"/>
                                </group>
                            </group>
                        </page>
                        <page string="ใบหุ้น">
                            <group>
                                <group string="ข้อมูลบริษัทและทุน">
                                    <field name="certificate_number_x_mm"/><field name="certificate_number_y_mm"/>
                                    <field name="certificate_company_x_mm"/><field name="certificate_company_y_mm"/>
                                    <field name="certificate_registration_x_mm"/><field name="certificate_registration_y_mm"/>
                                    <field name="certificate_registered_capital_x_mm"/><field name="certificate_registered_capital_y_mm"/>
                                    <field name="certificate_total_shares_x_mm"/><field name="certificate_total_shares_y_mm"/>
                                    <field name="certificate_share_value_x_mm"/><field name="certificate_share_value_y_mm"/>
                                    <field name="certificate_shareholder_x_mm"/><field name="certificate_shareholder_y_mm"/>
                                </group>
                                <group string="จำนวนหุ้นและการชำระ">
                                    <field name="certificate_share_count_x_mm"/><field name="certificate_share_count_y_mm"/>
                                    <field name="certificate_share_number_from_x_mm"/><field name="certificate_share_number_from_y_mm"/>
                                    <field name="certificate_share_number_to_x_mm"/><field name="certificate_share_number_to_y_mm"/>
                                    <field name="certificate_paid_per_share_x_mm"/><field name="certificate_paid_per_share_y_mm"/>
                                    <field name="certificate_total_paid_x_mm"/><field name="certificate_total_paid_y_mm"/>
                                    <field name="certificate_issue_day_x_mm"/><field name="certificate_issue_day_y_mm"/>
                                    <field name="certificate_issue_month_x_mm"/><field name="certificate_issue_month_y_mm"/>
                                    <field name="certificate_issue_year_x_mm"/><field name="certificate_issue_year_y_mm"/>
                                    <field name="certificate_director_one_x_mm"/><field name="certificate_director_one_y_mm"/>
                                    <field name="certificate_director_two_x_mm"/><field name="certificate_director_two_y_mm"/>
                                </group>
                            </group>
                        </page>
                        <page string="ขนาดตัวอักษร">
                            <group>
                                <group string="ต้นขั้ว">
                                    <field name="stub_company_font_size_pt"/><field name="stub_registration_font_size_pt"/>
                                    <field name="stub_certificate_number_font_size_pt"/><field name="stub_issue_date_font_size_pt"/>
                                    <field name="stub_shareholder_font_size_pt"/><field name="stub_share_count_font_size_pt"/>
                                    <field name="stub_share_number_from_font_size_pt"/><field name="stub_share_number_to_font_size_pt"/>
                                    <field name="stub_paid_per_share_font_size_pt"/><field name="stub_total_paid_font_size_pt"/>
                                    <field name="stub_previous_certificate_number_font_size_pt"/>
                                    <field name="stub_previous_certificate_date_font_size_pt"/><field name="stub_receipt_date_font_size_pt"/>
                                </group>
                                <group string="ใบหุ้น">
                                    <field name="certificate_number_font_size_pt"/><field name="certificate_company_font_size_pt"/>
                                    <field name="certificate_registration_font_size_pt"/><field name="certificate_registered_capital_font_size_pt"/>
                                    <field name="certificate_total_shares_font_size_pt"/><field name="certificate_share_value_font_size_pt"/>
                                    <field name="certificate_shareholder_font_size_pt"/><field name="certificate_share_count_font_size_pt"/>
                                    <field name="certificate_share_number_from_font_size_pt"/><field name="certificate_share_number_to_font_size_pt"/>
                                    <field name="certificate_paid_per_share_font_size_pt"/><field name="certificate_total_paid_font_size_pt"/>
                                    <field name="certificate_issue_day_font_size_pt"/><field name="certificate_issue_month_font_size_pt"/>
                                    <field name="certificate_issue_year_font_size_pt"/><field name="certificate_director_one_font_size_pt"/>
                                    <field name="certificate_director_two_font_size_pt"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_share_certificate_layout_config" model="ir.actions.act_window">
        <field name="name">ตั้งค่าแบบพิมพ์ใบหุ้น</field>
        <field name="res_model">buz.share.certificate.layout.config</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_share_certificate_layout_config_form"/>
        <field name="res_id" ref="share_certificate_layout_config_default"/>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_share_certificate_layout_config" name="ตั้งค่าแบบพิมพ์"
              parent="buz_share_certificate.menu_share_certificate_root"
              action="action_share_certificate_layout_config"
              groups="base.group_system" sequence="30"/>
</odoo>
