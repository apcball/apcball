<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_share_certificate_wizard" model="ir.ui.view">
        <field name="name">buz.share.certificate.wizard.form</field>
        <field name="model">buz.share.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="ตัวเลือกการพิมพ์"><field name="certificate_id"/></form>
        </field>
    </record>
    <record id="view_share_certificate_tree" model="ir.ui.view">
        <field name="name">buz.share.certificate.tree</field>
        <field name="model">buz.share.certificate</field>
        <field name="arch" type="xml">
            <tree string="ใบหุ้น">
                <field name="certificate_number"/><field name="company_name"/>
                <field name="shareholder_name"/><field name="issue_date"/>
                <field name="state" widget="badge" decoration-success="state == 'done'"/>
            </tree>
        </field>
    </record>
    <record id="view_share_certificate_form" model="ir.ui.view">
        <field name="name">buz.share.certificate.form</field>
        <field name="model">buz.share.certificate</field>
        <field name="arch" type="xml">
            <form string="กรอกข้อมูลใบหุ้น">
                <header>
                    <button name="action_print_options" type="object" string="พิมพ์ใบหุ้น" class="oe_highlight"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                <group readonly="state == 'done'">
                    <group string="ข้อมูลบริษัทและใบหุ้น">
                        <field name="company_name" readonly="state == 'done'"/><field name="registration_number" readonly="state == 'done'"/>
                        <field name="certificate_number" readonly="state == 'done'"/><field name="issue_date" readonly="state == 'done'"/>
                        <field name="registered_capital" readonly="state == 'done'"/><field name="total_shares" readonly="state == 'done'"/><field name="share_value" readonly="state == 'done'"/>
                    </group>
                    <group string="ข้อมูลผู้ถือหุ้น">
                        <field name="shareholder_name" readonly="state == 'done'"/><field name="share_count" readonly="state == 'done'"/>
                        <field name="share_number_from" readonly="state == 'done'"/><field name="share_number_to" readonly="state == 'done'"/>
                        <field name="paid_per_share" readonly="state == 'done'"/><field name="total_paid" readonly="state == 'done'"/>
                    </group>
                </group>
                <group readonly="state == 'done'">
                    <group string="ใบหุ้นเดิมที่ยกเลิก">
                        <field name="previous_certificate_number" readonly="state == 'done'"/><field name="previous_certificate_date" readonly="state == 'done'"/>
                    </group>
                    <group string="ผู้ลงนามและการรับใบหุ้น">
                        <field name="director_one" readonly="state == 'done'"/><field name="director_two" readonly="state == 'done'"/><field name="receipt_date" readonly="state == 'done'"/>
                    </group>
                </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_share_certificate_template_tree" model="ir.ui.view">
        <field name="name">buz.share.certificate.template.tree</field>
        <field name="model">buz.share.certificate.template</field>
        <field name="arch" type="xml">
            <tree string="Template ใบหุ้น">
                <field name="name"/><field name="company_name"/>
                <field name="shareholder_name"/><field name="certificate_number"/>
            </tree>
        </field>
    </record>
    <record id="view_share_certificate_template_form" model="ir.ui.view">
        <field name="name">buz.share.certificate.template.form</field>
        <field name="model">buz.share.certificate.template</field>
        <field name="arch" type="xml">
            <form string="Template ใบหุ้น">
                <header>
                    <button name="action_use_template" type="object" string="ใช้ Template" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="ข้อมูลบริษัทและใบหุ้น">
                            <field name="company_name"/><field name="registration_number"/>
                            <field name="certificate_number"/><field name="issue_date"/>
                            <field name="registered_capital"/><field name="total_shares"/><field name="share_value"/>
                        </group>
                        <group string="ข้อมูลผู้ถือหุ้น">
                            <field name="shareholder_name"/><field name="share_count"/>
                            <field name="share_number_from"/><field name="share_number_to"/>
                            <field name="paid_per_share"/><field name="total_paid"/>
                        </group>
                    </group>
                    <group>
                        <group string="ใบหุ้นเดิมที่ยกเลิก">
                            <field name="previous_certificate_number"/><field name="previous_certificate_date"/>
                        </group>
                        <group string="ผู้ลงนามและการรับใบหุ้น">
                            <field name="director_one"/><field name="director_two"/><field name="receipt_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_share_certificate_print_options" model="ir.ui.view">
        <field name="name">buz.share.certificate.print.options</field>
        <field name="model">buz.share.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="What do you want to do?">
                <div class="d-flex flex-wrap gap-1 buz_share_certificate_print_options">
                    <button name="action_print_pdf" type="object" string="Print" icon="fa-print" class="btn-info"/>
                    <button name="action_download_pdf" type="object" string="Download" icon="fa-download" class="btn-info"/>
                    <button name="action_open_pdf" type="object" string="Open" icon="fa-file-pdf-o" class="btn-info"/>
                </div>
                <footer><button string="Ok" special="cancel" class="btn-secondary"/></footer>
            </form>
        </field>
    </record>
    <record id="action_share_certificate_wizard" model="ir.actions.act_window">
        <field name="name">ใบหุ้น</field>
        <field name="res_model">buz.share.certificate</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_share_certificate_tree"/>
        <field name="target">current</field>
    </record>
    <record id="action_share_certificate_templates" model="ir.actions.act_window">
        <field name="name">Template ใบหุ้น</field>
        <field name="res_model">buz.share.certificate.template</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_share_certificate_template_tree"/>
        <field name="target">current</field>
    </record>
    <menuitem id="menu_share_certificate_root" name="ใบหุ้น" sequence="50" groups="base.group_user"/>
    <menuitem id="menu_share_certificate_print" name="รายการใบหุ้น" parent="menu_share_certificate_root" action="action_share_certificate_wizard" sequence="10"/>
    <menuitem id="menu_share_certificate_templates" name="Template" parent="menu_share_certificate_root" action="action_share_certificate_templates" sequence="20"/>
</odoo>
