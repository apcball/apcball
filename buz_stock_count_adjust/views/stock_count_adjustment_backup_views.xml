<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_count_adjustment_backup_tree" model="ir.ui.view">
        <field name="name">stock.count.adjustment.backup.tree</field>
        <field name="model">stock.count.adjustment.backup</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="adjustment_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="line_count"/>
                <field name="state"/>
                <field name="restore_date"/>
            </tree>
        </field>
    </record>

    <record id="view_stock_count_adjustment_backup_form" model="ir.ui.view">
        <field name="name">stock.count.adjustment.backup.form</field>
        <field name="model">stock.count.adjustment.backup</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="adjustment_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="state" readonly="1"/>
                        </group>
                        <group>
                            <field name="line_count"/>
                            <field name="restore_date" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="SVL Pre-image" name="svl">
                            <field name="line_ids" readonly="1">
                                <tree>
                                    <field name="layer_id"/>
                                    <field name="product_id"/>
                                    <field name="warehouse_id"/>
                                    <field name="quantity"/>
                                    <field name="value"/>
                                    <field name="unit_cost"/>
                                    <field name="remaining_qty"/>
                                    <field name="remaining_value"/>
                                    <field name="accounting_date"/>
                                    <field name="was_inserted"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Quant Pre-image" name="quant">
                            <field name="quant_line_ids" readonly="1">
                                <tree>
                                    <field name="quant_id"/>
                                    <field name="quantity"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Move Line Pre-image" name="moveline">
                            <field name="moveline_line_ids" readonly="1">
                                <tree>
                                    <field name="move_line_id"/>
                                    <field name="move_id"/>
                                    <field name="location_id"/>
                                    <field name="location_dest_id"/>
                                    <field name="ml_date"/>
                                    <field name="move_date"/>
                                    <field name="was_generated"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group string="Restore Log">
                        <field name="restore_log" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_stock_count_adjustment_backup" model="ir.actions.act_window">
        <field name="name">Count Adjustment Backups</field>
        <field name="res_model">stock.count.adjustment.backup</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_stock_count_adjustment_backup"
              parent="menu_stock_count_adjustment_root"
              action="action_stock_count_adjustment_backup"
              sequence="20"
              groups="buz_stock_count_adjust.group_stock_count_adjustment"/>
</odoo>
