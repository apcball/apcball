<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_count_adjustment_import_form" model="ir.ui.view">
        <field name="name">stock.count.adjustment.import.form</field>
        <field name="model">stock.count.adjustment.import</field>
        <field name="arch" type="xml">
            <form string="Import Adjustment Lines" groups="buz_stock_count_adjust.group_stock_count_adjustment">
                <group>
                    <field name="adjustment_id" invisible="1"/>
                    <field name="file_format"/>
                    <field name="data_file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="import_valid_only"/>
                </group>
                <field name="result_log" readonly="1" invisible="not result_log"/>
                <footer>
                    <button name="action_do_import" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
