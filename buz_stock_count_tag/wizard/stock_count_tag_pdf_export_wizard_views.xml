<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_count_tag_pdf_export_wizard_form" model="ir.ui.view">
        <field name="name">buz.stock.count.tag.pdf.export.wizard.form</field>
        <field name="model">buz.stock.count.tag.pdf.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Stock Count Tag PDF">
                <field name="tag_id" invisible="1"/>
                <group>
                    <p>Leave both fields blank to export all tags, or enter a Tag No. range
                        (e.g. TAG/2026/00028 to TAG/2026/00032) to export only that range.</p>
                    <field name="doc_no_from" placeholder="e.g. TAG/2026/00028"/>
                    <field name="doc_no_to" placeholder="e.g. TAG/2026/00032"/>
                </group>
                <footer>
                    <button name="action_export" type="object" string="Export PDF"
                            class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
