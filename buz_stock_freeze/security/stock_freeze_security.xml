<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_stock_freeze" model="ir.module.category">
        <field name="name">Stock Freeze</field>
        <field name="sequence">26</field>
    </record>

    <record id="group_stock_freeze_override" model="res.groups">
        <field name="name">Stock Freeze Override</field>
        <field name="category_id" ref="module_category_stock_freeze"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_user'))]"/>
    </record>

    <record id="group_stock_freeze_manager" model="res.groups">
        <field name="name">Stock Freeze Manager</field>
        <field name="category_id" ref="module_category_stock_freeze"/>
        <field name="implied_ids" eval="[(4, ref('stock.group_stock_manager'))]"/>
    </record>

    <record id="rule_stock_freeze_period_company" model="ir.rule">
        <field name="name">Stock Freeze Period: multi-company</field>
        <field name="model_id" ref="model_stock_freeze_period"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
