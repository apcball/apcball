<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_stock_freeze" model="ir.ui.view">
        <field name="name">stock.picking.form.stock.freeze</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <field name="freeze_warning" invisible="1"/>
                <div class="alert alert-warning" role="alert"
                     invisible="not freeze_warning">
                    <span class="fa fa-lock" title="Stock Freeze"/>
                    <field name="freeze_warning" nolabel="1" readonly="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
