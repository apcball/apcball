<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_location_lock" model="ir.ui.view">
        <field name="name">stock.picking.form.location.lock</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='note']" position="before">
                <page string="Location Lock" name="location_lock" groups="stock.group_stock_manager">
                    <group>
                        <field name="bypass_location_lock"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
