<odoo>
    <record id="view_buz_picking_tag_tree" model="ir.ui.view">
        <field name="name">buz.picking.tag.tree</field>
        <field name="model">buz.picking.tag</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <record id="view_buz_picking_tag_form" model="ir.ui.view">
        <field name="name">buz.picking.tag.form</field>
        <field name="model">buz.picking.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_buz_picking_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">buz.picking.tag</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_buz_picking_tag"
              name="Tags"
              parent="stock.menu_stock_config_settings"
              action="action_buz_picking_tag"
              sequence="110"/>
</odoo>
