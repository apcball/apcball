<odoo>
    <record id="view_picking_form_tag_ids" model="ir.ui.view">
        <field name="name">stock.picking.form.tag.ids</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="tag_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"/>
            </xpath>
        </field>
    </record>

    <record id="vpicktree_tag_ids" model="ir.ui.view">
        <field name="name">stock.picking.tree.tag.ids</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="tag_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"
                       optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
