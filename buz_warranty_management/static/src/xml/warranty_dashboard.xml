<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve"><t t-name="buz_warranty_management.WarrantyDashboard">
<div class="o_warranty_dashboard" t-ref="root">
<div class="o_wd_header"><h2>Welcome back, <t t-esc="userName"/>! 👋</h2><p>Here's what's happening with your warranty program today.</p>
<div class="o_wd_header_controls">
<div class="o_wd_date_filters"><i class="fa fa-calendar"/><input aria-label="Start date" type="date" t-model="state.filters.date_from" t-on-change="onFilterChange" t-att-disabled="state.loading"/><span>–</span><input aria-label="End date" type="date" t-model="state.filters.date_to" t-on-change="onFilterChange" t-att-disabled="state.loading"/></div>
<div class="o_wd_quick_buttons"><button t-foreach="['today', 'week', 'month', 'quarter', 'year']" t-as="period" t-key="period" class="btn" t-att-class="{'active': state.period === period}" t-att-disabled="state.loading" t-on-click="() => this.onQuickPeriod(period)"><t t-esc="period.charAt(0).toUpperCase() + period.slice(1)"/></button></div>
<select aria-label="Product" class="form-select o_wd_select" t-model="state.filters.product_id" t-on-change="onFilterChange" t-att-disabled="state.loading"><option value="">All Products</option><option t-foreach="state.filterOptions.products" t-as="p" t-key="p.id" t-att-value="p.id"><t t-esc="p.name"/></option></select>
<select aria-label="Customer" class="form-select o_wd_select" t-model="state.filters.customer_id" t-on-change="onFilterChange" t-att-disabled="state.loading"><option value="">All Customers</option><option t-foreach="state.filterOptions.customers" t-as="c" t-key="c.id" t-att-value="c.id"><t t-esc="c.name"/></option></select>
<button class="btn o_wd_refresh" t-on-click="onRefresh" t-att-disabled="state.loading"><i class="fa fa-refresh"/> Refresh</button><button class="btn o_wd_export" t-on-click="exportDashboard" t-att-disabled="state.loading"><i class="fa fa-download"/> Export</button>
</div></div>
<div t-if="state.loading" class="o_wd_empty" role="status"><i class="fa fa-spinner fa-spin"/> Loading warranty analytics...</div>
<t t-else=""><div class="o_wd_kpi_row"><button class="o_wd_kpi_card" t-on-click="openAllWarranties"><div class="kpi-top"><span class="kpi-icon kpi-icon-primary"><i class="fa fa-shield"/></span><div><div class="kpi-title">Total Warranties</div><div class="kpi-value" t-esc="formatNumber(state.data.kpi.total_warranties)"/><div class="kpi-subtitle">Selected period</div></div></div><canvas class="o_wd_spark" data-color="#8b6aff" data-series="warranties"/></button>
<button class="o_wd_kpi_card" t-on-click="openActiveWarranties"><div class="kpi-top"><span class="kpi-icon kpi-icon-success"><i class="fa fa-check-circle"/></span><div><div class="kpi-title">Active Warranties</div><div class="kpi-value" t-esc="formatNumber(state.data.kpi.active_warranties)"/><div class="kpi-subtitle"><strong class="kpi-text-success" t-esc="formatPercent(state.data.kpi.active_percentage)"/> of total</div></div></div><div class="o_wd_progress"><span class="kpi-bg-success" t-att-style="'width:' + progress(state.data.kpi.active_percentage) + '%'"/></div></button>
<button class="o_wd_kpi_card" t-on-click="openExpiredWarranties"><div class="kpi-top"><span class="kpi-icon kpi-icon-danger"><i class="fa fa-times-circle"/></span><div><div class="kpi-title">Expired Warranties</div><div class="kpi-value" t-esc="formatNumber(state.data.kpi.expired_warranties)"/><div class="kpi-subtitle"><strong class="kpi-text-danger" t-esc="formatPercent(state.data.kpi.expired_percentage)"/> of total</div></div></div><div class="o_wd_progress"><span class="kpi-bg-danger" t-att-style="'width:' + progress(state.data.kpi.expired_percentage) + '%'"/></div></button>
<button class="o_wd_kpi_card" t-on-click="openNearExpiryWarranties"><div class="kpi-top"><span class="kpi-icon kpi-icon-warning"><i class="fa fa-exclamation-triangle"/></span><div><div class="kpi-title">Near Expiry (30 Days)</div><div class="kpi-value" t-esc="formatNumber(state.data.kpi.near_expiry_warranties)"/><div class="kpi-subtitle"><strong class="kpi-text-warning" t-esc="nearExpiryPercent()"/> of total</div></div></div><div class="o_wd_progress"><span class="kpi-bg-warning" t-att-style="'width:' + progress(nearExpiryValue()) + '%'"/></div></button>
<button class="o_wd_kpi_card" t-on-click="openWarrantyClaims"><div class="kpi-top"><span class="kpi-icon kpi-icon-purple"><i class="fa fa-wrench"/></span><div><div class="kpi-title">Claims This Month</div><div class="kpi-value" t-esc="formatNumber(state.data.kpi.claims_this_month)"/><div class="kpi-subtitle">Current month</div></div></div><canvas class="o_wd_spark" data-color="#8b6aff" data-series="claims"/></button></div>
<div class="o_wd_analytics">
<section class="o_wd_panel"><header><h3><i class="fa fa-pie-chart"/> Warranty Status Overview</h3></header><div class="o_wd_donut_wrap"><div class="o_wd_donut_chart"><canvas t-ref="warrantyStatusChart"/><div class="o_wd_donut_total"><strong t-esc="formatNumber(state.data.kpi.total_warranties)"/><span>Total</span></div></div><div class="o_wd_donut_legend"><div t-foreach="statusLegend()" t-as="row" t-key="row.label" class="o_wd_legend_item"><span class="o_wd_legend_dot" t-att-style="'background:' + row.color"/><span class="o_wd_legend_label" t-esc="row.label"/><strong t-esc="formatNumber(row.value)"/><span class="o_wd_legend_pct" t-esc="row.pct"/></div><div t-if="!statusLegend().length" class="o_wd_empty">No warranties in this period</div></div></div></section>
<section class="o_wd_panel"><header><h3><i class="fa fa-bar-chart"/> Claims Trend</h3><span class="o_wd_caption">Monthly · selected period</span></header><div class="o_wd_chart_body"><canvas t-ref="claimsTrendChart"/><div t-if="!state.data.claims_trend.length" class="o_wd_chart_empty">No claims in this period</div></div></section>
<section class="o_wd_panel"><header><h3><i class="fa fa-clipboard"/> Top 5 Products by Claims</h3><button class="o_wd_link" t-on-click="openWarrantyClaims">View All <i class="fa fa-arrow-right"/></button></header><div class="o_wd_ranking"><div t-if="!topProductRows().length" class="o_wd_empty">No claims in this period</div><div t-foreach="topProductRows()" t-as="row" t-key="row.id" class="o_wd_rank_row"><span class="o_wd_rank_num" t-esc="row.rank"/><img t-att-src="'/web/image/product.product/' + row.id + '/image_128'" t-att-alt="row.name" loading="lazy"/><div class="o_wd_rank_detail"><div class="o_wd_rank_heading"><span t-att-title="row.name" t-esc="row.name"/><strong t-esc="formatNumber(row.value)"/></div><div class="o_wd_progress"><span t-att-style="'width:' + row.barPct + '%'"/></div></div></div></div></section>
</div><div class="o_wd_tables"><section class="o_wd_panel"><header><h3><i class="fa fa-id-card-o"/> Recent Warranty Cards</h3><button class="o_wd_link" t-on-click="openAllWarranties">View All <i class="fa fa-arrow-right"/></button></header><div class="o_wd_table_scroll"><table><thead><tr><th>#</th><th>Warranty No.</th><th>Customer</th><th>Product</th><th>Warranty Period</th><th>Status</th></tr></thead><tbody>
<tr t-foreach="state.data.recent_warranties" t-as="r" t-key="r.id"><td t-esc="r_index + 1"/><td><button class="o_wd_link" t-on-click="() => this.openWarrantyCard(r.id)" t-esc="r.name"/></td><td t-esc="r.partner_name"/><td t-esc="r.product_name"/><td class="o_wd_nowrap"><t t-esc="displayDate(r.start_date)"/> – <t t-esc="displayDate(r.end_date)"/></td><td><span t-att-class="'o_wd_badge o_wd_badge_' + warrantyStatus(r).key" t-esc="warrantyStatus(r).label"/></td></tr><tr t-if="!state.data.recent_warranties.length"><td colspan="6" class="o_wd_empty">No records in this period</td></tr></tbody></table></div></section><section class="o_wd_panel"><header><h3><i class="fa fa-clock-o"/> Recent Claims</h3><button class="o_wd_link" t-on-click="openWarrantyClaims">View All <i class="fa fa-arrow-right"/></button></header><div class="o_wd_table_scroll"><table><thead><tr><th>#</th><th>Claim No.</th><th>Date</th><th>Customer</th><th>Product</th><th>Status</th></tr></thead><tbody>
<tr t-foreach="state.data.recent_claims" t-as="r" t-key="r.id"><td t-esc="r_index + 1"/><td><button class="o_wd_link" t-on-click="() => this.openClaim(r.id)" t-esc="r.name"/></td><td class="o_wd_nowrap" t-esc="displayDate(r.date)"/><td t-esc="r.partner_name"/><td t-esc="r.product_name"/><td><span t-att-class="'o_wd_badge o_wd_badge_' + r.state" t-esc="r.state_label"/></td></tr><tr t-if="!state.data.recent_claims.length"><td colspan="6" class="o_wd_empty">No records in this period</td></tr></tbody></table></div></section></div>
</t></div></t></templates>
