<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_delivery_order" model="ir.ui.view">
        <field name="name">account.move.form.inherit.delivery.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Delivery Order field right after the journal div -->
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="available_picking_ids" invisible="1"/>
                <field name="picking_ids"
                       invisible="move_type not in ('out_invoice', 'out_refund')"
                       widget="many2many_tags_open"
                       options="{'no_create': True}"
                       readonly="0"
                       string="Delivery Order"/>
            </xpath>

        </field>
    </record>

    <record id="view_out_credit_note_tree_inherit_delivery_order" model="ir.ui.view">
        <field name="name">account.out.credit.note.tree.inherit.delivery.order</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_credit_note_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="picking_ids" string="Delivery Order" widget="many2many_tags" optional="show" readonly="1"/>
            </field>
        </field>
    </record>
</odoo>
