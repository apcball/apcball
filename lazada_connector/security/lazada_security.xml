<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_lazada_user" model="res.groups">
        <field name="name">Lazada User</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Can use Lazada stock import/export wizards and see the Lazada menu.</field>
    </record>
    <record id="group_lazada_manager" model="res.groups">
        <field name="name">Lazada Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_lazada_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manages Lazada connections, credentials, order sync and shipping.</field>
    </record>
</odoo>
