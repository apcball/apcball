<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lazada_buyer_address_import_wizard_form" model="ir.ui.view">
        <field name="name">lazada.buyer.address.import.wizard.form</field>
        <field name="model">lazada.buyer.address.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Buyer Addresses">
                <sheet>
                    <p class="text-muted" invisible="state == 'done'">
                        Upload the order export from Lazada Seller Center
                        (Orders → Export, .xlsx or .csv). Buyer name, phone,
                        shipping address and tax invoice data are copied to the
                        customer of each matching Lazada order, plus shipping
                        and seller discount on quotations. No orders are created.
                    </p>
                    <group invisible="state == 'done'">
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name"
                               widget="binary"/>
                    </group>
                    <field name="state" invisible="1"/>
                    <field name="result_message" invisible="state != 'done'"
                           nolabel="1"/>
                </sheet>
                <footer>
                    <button name="action_import" string="Import"
                            type="object" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Close" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_lazada_buyer_address_import" model="ir.actions.act_window">
        <field name="name">Import Buyer Addresses</field>
        <field name="res_model">lazada.buyer.address.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="lazada_connector_buyer_address_import_menu"
              name="Import Buyer Addresses"
              parent="lazada_connector_root_menu"
              action="action_lazada_buyer_address_import" sequence="41"
              groups="lazada_connector.group_lazada_manager"/>
</odoo>
