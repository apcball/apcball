<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lazada_order_sync_wizard_form" model="ir.ui.view">
        <field name="name">lazada.order.sync.wizard.form</field>
        <field name="model">lazada.order.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Lazada Orders">
                <sheet>
                    <field name="state" invisible="1"/>
                    <group invisible="state == 'done'">
                        <field name="config_id" options="{'no_create': True}"/>
                        <field name="import_orders_from"/>
                        <field name="import_orders_to"/>
                    </group>
                    <p class="text-muted" invisible="state == 'done'">
                        Import Orders fetches the orders created between the
                        two dates above (leave "Import Orders To" empty for
                        up to now). Sync Order Status refreshes the status of
                        the orders already in Odoo, and ignores the dates.
                    </p>
                    <field name="result_message" nolabel="1" readonly="1"
                           invisible="state != 'done'"/>
                </sheet>
                <footer>
                    <button name="action_import_orders" type="object"
                            string="Import Orders" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button name="action_sync_status" type="object"
                            string="Sync Order Status" class="btn-secondary"
                            invisible="state == 'done'"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_lazada_order_sync" model="ir.actions.act_window">
        <field name="name">Sync Orders</field>
        <field name="res_model">lazada.order.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="lazada_connector_order_sync_menu" name="Sync Orders"
              parent="lazada_connector_root_menu"
              action="action_lazada_order_sync" sequence="31"
              groups="lazada_connector.group_lazada_manager"/>
</odoo>
