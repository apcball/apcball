<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lazada_stock_import_wizard_form" model="ir.ui.view">
        <field name="name">lazada.stock.import.wizard.form</field>
        <field name="model">lazada.stock.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Lazada Stock">
                <sheet>
                    <p class="text-muted">
                        Upload a Lazada stock export containing SKU and quantity
                        (or stock) columns. Existing Odoo On Hand quantities are
                        not changed.
                    </p>
                    <group>
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name"
                               widget="binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="Import"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_lazada_stock_export_wizard_form" model="ir.ui.view">
        <field name="name">lazada.stock.export.wizard.form</field>
        <field name="model">lazada.stock.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Lazada Stock">
                <sheet>
                    <p class="text-muted">
                        Exports every product linked to Lazada (SKU, Lazada
                        item/SKU IDs and stock). The file can be edited and
                        re-imported via Import Stock File.
                    </p>
                    <group>
                        <field name="product_count" readonly="1"/>
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name"
                               widget="binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_regenerate" string="Regenerate"
                            type="object" class="btn-secondary"/>
                    <button string="Close" special="cancel"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_lazada_stock_import" model="ir.actions.act_window">
        <field name="name">Import Lazada Stock</field>
        <field name="res_model">lazada.stock.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_lazada_stock_export" model="ir.actions.act_window">
        <field name="name">Export Lazada Stock</field>
        <field name="res_model">lazada.stock.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_lazada_stock_file_tree" model="ir.ui.view">
        <field name="name">product.product.tree.lazada.stock.file</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree string="Import Stock File" create="false">
                <field name="default_code"/>
                <field name="name"/>
                <field name="lazada_stock"/>
                <field name="lazada_item_id"/>
                <field name="lazada_sku_id"/>
                <field name="lazada_pushed_stock"/>
                <field name="lazada_last_sync"/>
                <field name="lazada_sync_stock_out"/>
            </tree>
        </field>
    </record>

    <record id="action_lazada_stock_file" model="ir.actions.act_window">
        <field name="name">Import Stock File</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_lazada_stock_file_tree"/>
        <field name="domain">[('default_code', '!=', False)]</field>
    </record>
    <menuitem id="lazada_connector_stock_import_menu" name="Import Stock File"
              parent="lazada_connector_root_menu"
              action="action_lazada_stock_file" sequence="40"/>

    <!-- Cog menu (gear) entries on product lists -->
    <record id="action_lazada_stock_import_server" model="ir.actions.server">
        <field name="name">Import Stock File (Lazada)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env.ref("lazada_connector.action_lazada_stock_import").sudo().read()[0]</field>
    </record>

    <record id="action_lazada_stock_export_server" model="ir.actions.server">
        <field name="name">Export All (Lazada Stock)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env.ref("lazada_connector.action_lazada_stock_export").sudo().read()[0]</field>
    </record>
</odoo>
