<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_lazada" model="ir.ui.view">
        <field name="name">sale.order.form.lazada</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='client_order_ref']" position="after">
                <field name="lazada_order_id" readonly="1" force_save="1"
                       invisible="not is_lazada_order"/>
                <field name="lazada_order_status" readonly="1"
                       invisible="not is_lazada_order"/>
                <field name="is_lazada_order" invisible="1"/>
            </xpath>
        </field>
    </record>

    <record id="action_lazada_orders" model="ir.actions.act_window">
        <field name="name">Lazada Orders</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('is_lazada_order', '=', True)]</field>
    </record>
    <menuitem id="lazada_connector_orders_menu" name="Orders"
              parent="lazada_connector_root_menu" action="action_lazada_orders"
              sequence="30"/>
</odoo>
