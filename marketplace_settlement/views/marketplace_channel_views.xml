<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_marketplace_channel_tree" model="ir.ui.view">
        <field name="name">marketplace.channel.tree</field>
        <field name="model">marketplace.channel</field>
        <field name="arch" type="xml">
            <tree string="Trade Channels" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="view_marketplace_channel_form" model="ir.ui.view">
        <field name="name">marketplace.channel.form</field>
        <field name="model">marketplace.channel</field>
        <field name="arch" type="xml">
            <form string="Trade Channel">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_marketplace_channel_search" model="ir.ui.view">
        <field name="name">marketplace.channel.search</field>
        <field name="model">marketplace.channel</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_marketplace_channel" model="ir.actions.act_window">
        <field name="name">Trade Channels</field>
        <field name="res_model">marketplace.channel</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a trade channel</p>
            <p>Trade channels feed the "Trade Channel" field on settlements, profiles,
               vendor bills, sale orders and invoices.</p>
        </field>
    </record>

    <menuitem id="menu_marketplace_channel" name="Trade Channels"
              parent="menu_marketplace_settlement"
              action="action_marketplace_channel" sequence="99"/>

</odoo>
