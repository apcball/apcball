<odoo>
    <record id="group_sop_ai_user" model="res.groups">
        <field name="name">S&amp;OP AI User</field>
        <field name="category_id" ref="mogen_sop_core.module_category_mogen_sop"/>
        <field name="implied_ids" eval="[(4, ref('mogen_sop_core.group_sop_viewer'))]"/>
    </record>
    <record id="group_sop_ai_manager" model="res.groups">
        <field name="name">S&amp;OP AI Manager</field>
        <field name="category_id" ref="mogen_sop_core.module_category_mogen_sop"/>
        <field name="implied_ids" eval="[(4, ref('group_sop_ai_user'))]"/>
    </record>
    <record id="rule_sop_ai_provider_company" model="ir.rule">
        <field name="name">AI provider multi-company</field><field name="model_id" ref="model_mogen_sop_ai_provider"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_sop_ai_user'))]"/>
    </record>
    <record id="rule_sop_ai_prompt_company" model="ir.rule">
        <field name="name">AI prompt template multi-company</field><field name="model_id" ref="model_mogen_sop_ai_prompt_template"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_sop_ai_user'))]"/>
    </record>
    <record id="rule_sop_ai_analysis_company" model="ir.rule">
        <field name="name">AI analysis multi-company</field><field name="model_id" ref="model_mogen_sop_ai_analysis"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_sop_ai_user'))]"/>
    </record>
    <record id="rule_sop_ai_recommendation_company" model="ir.rule">
        <field name="name">AI recommendation multi-company</field><field name="model_id" ref="model_mogen_sop_ai_recommendation"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_sop_ai_user'))]"/>
    </record>
    <record id="rule_sop_ai_conversation_owner" model="ir.rule">
        <field name="name">AI conversation owner</field><field name="model_id" ref="model_mogen_sop_ai_conversation"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_sop_ai_user'))]"/>
    </record>
    <record id="rule_sop_ai_message_owner" model="ir.rule">
        <field name="name">AI message conversation owner</field><field name="model_id" ref="model_mogen_sop_ai_message"/>
        <field name="domain_force">[('conversation_id.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_sop_ai_user'))]"/>
    </record>
</odoo>
