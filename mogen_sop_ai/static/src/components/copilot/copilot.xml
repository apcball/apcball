<templates xml:space="preserve"><t t-name="mogen_sop_ai.Copilot" owl="1"><div class="o_sop_copilot container-fluid p-3"><div class="d-flex justify-content-between"><h2>Smart S&amp;OP Copilot</h2><button class="btn btn-outline-secondary" t-on-click="clear" t-att-disabled="!state.conversationId">Clear conversation</button></div><div class="border rounded p-3 my-3 o_sop_copilot_messages"><t t-if="!state.messages.length"><p class="text-muted">Ask about the active plan, scenario, shortages, risks, or decisions.</p></t><t t-foreach="state.messages" t-as="message" t-key="message.id"><article t-att-class="message.role === 'user' ? 'text-end mb-3' : 'mb-3'"><strong t-esc="message.role"/><p t-esc="message.content"/><div t-if="message.sources.length"><button t-foreach="message.sources" t-as="source" t-key="source.model + source.id" class="btn btn-link btn-sm p-0 me-2" t-on-click="() => openSource(source)" t-esc="source.name"/></div><small class="text-danger" t-if="message.error" t-esc="message.error"/></article></t><div t-if="state.loading" class="text-muted">Analysis queued. Refresh this conversation after background processing completes.</div><div t-if="state.error" class="alert alert-danger" t-esc="state.error"/></div><div class="input-group"><input class="form-control" placeholder="Ask a Smart S&amp;OP question" t-model="state.question" t-on-keydown="(ev) => ev.key === 'Enter' && ask()"/><button class="btn btn-primary" t-on-click="ask" t-att-disabled="state.loading">Ask</button></div><p class="small text-muted mt-2">Copilot provides evidence and draft recommendations only; it never executes operational actions.</p></div></t></templates>
