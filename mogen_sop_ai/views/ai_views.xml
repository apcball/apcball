<odoo>
    <record id="action_sop_ai_copilot" model="ir.actions.client"><field name="name">Smart S&amp;OP Copilot</field><field name="tag">mogen_sop_ai.copilot</field></record>
    <record id="view_sop_ai_provider_tree" model="ir.ui.view"><field name="name">mogen.sop.ai.provider.tree</field><field name="model">mogen.sop.ai.provider</field><field name="arch" type="xml"><tree><field name="name"/><field name="company_id" groups="base.group_multi_company"/><field name="provider_type"/><field name="model_name"/><field name="active"/><field name="test_status"/></tree></field></record>
    <record id="view_sop_ai_provider_form" model="ir.ui.view"><field name="name">mogen.sop.ai.provider.form</field><field name="model">mogen.sop.ai.provider</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="company_id"/><field name="provider_type"/><field name="base_url"/><field name="model_name"/><field name="timeout_seconds"/><field name="maximum_tokens"/><field name="temperature"/><field name="api_key_reference" groups="mogen_sop_ai.group_sop_ai_manager"/><field name="active"/><field name="test_status" readonly="1"/><field name="last_test_date" readonly="1"/></group></sheet></form></field></record>
    <record id="action_sop_ai_provider" model="ir.actions.act_window"><field name="name">AI Gateway Providers</field><field name="res_model">mogen.sop.ai.provider</field><field name="view_mode">tree,form</field></record>

    <record id="view_sop_ai_prompt_tree" model="ir.ui.view"><field name="name">mogen.sop.ai.prompt.template.tree</field><field name="model">mogen.sop.ai.prompt.template</field><field name="arch" type="xml"><tree><field name="name"/><field name="code"/><field name="analysis_type"/><field name="version"/><field name="active"/></tree></field></record>
    <record id="view_sop_ai_prompt_form" model="ir.ui.view"><field name="name">mogen.sop.ai.prompt.template.form</field><field name="model">mogen.sop.ai.prompt.template</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="company_id"/><field name="analysis_type"/><field name="version"/><field name="active"/></group><notebook><page string="Instructions"><field name="system_instruction"/><field name="user_prompt_template"/></page><page string="JSON Schema"><field name="output_schema"/></page></notebook></sheet></form></field></record>
    <record id="action_sop_ai_prompt" model="ir.actions.act_window"><field name="name">AI Prompt Templates</field><field name="res_model">mogen.sop.ai.prompt.template</field><field name="view_mode">tree,form</field></record>

    <record id="view_sop_ai_analysis_tree" model="ir.ui.view"><field name="name">mogen.sop.ai.analysis.tree</field><field name="model">mogen.sop.ai.analysis</field><field name="arch" type="xml"><tree><field name="name"/><field name="company_id" invisible="1"/><field name="analysis_type"/><field name="sop_plan_id"/><field name="provider_id"/><field name="model_name"/><field name="state"/><field name="requested_by_id"/><field name="completed_at"/></tree></field></record>
    <record id="view_sop_ai_analysis_form" model="ir.ui.view"><field name="name">mogen.sop.ai.analysis.form</field><field name="model">mogen.sop.ai.analysis</field><field name="arch" type="xml"><form><header><button name="action_queue" type="object" string="Queue Analysis" class="btn-primary" invisible="state not in ('draft', 'failed')"/><field name="state" widget="statusbar" statusbar_visible="draft,queued,running,completed,failed,reviewed"/></header><sheet><group><group><field name="name"/><field name="company_id" invisible="1"/><field name="analysis_type"/><field name="sop_plan_id"/><field name="version_id"/><field name="scenario_plan_id"/><field name="requested_by_id"/></group><group><field name="provider_id"/><field name="model_name" readonly="1"/><field name="prompt_template_id"/><field name="prompt_template_version" readonly="1"/><field name="retry_count" readonly="1"/><field name="max_retries"/><field name="next_attempt_at" readonly="1"/></group></group><notebook><page string="Input"><field name="input_snapshot" readonly="state != 'draft'"/><field name="input_payload_hash" readonly="1"/></page><page string="Response"><field name="response_text" readonly="1"/><field name="structured_response" readonly="1"/><field name="token_usage" readonly="1"/><field name="estimated_cost" readonly="1"/><field name="confidence" readonly="1"/></page><page string="Audit"><field name="validation_errors" readonly="1"/><field name="error_message" readonly="1"/><field name="calculation_log" readonly="1"/></page></notebook></sheet><chatter/></form></field></record>
    <record id="action_sop_ai_analysis" model="ir.actions.act_window"><field name="name">AI Analyses</field><field name="res_model">mogen.sop.ai.analysis</field><field name="view_mode">tree,form</field></record>

    <record id="view_sop_ai_recommendation_tree" model="ir.ui.view"><field name="name">mogen.sop.ai.recommendation.tree</field><field name="model">mogen.sop.ai.recommendation</field><field name="arch" type="xml"><tree><field name="title"/><field name="company_id" invisible="1"/><field name="ai_analysis_id"/><field name="sop_plan_id"/><field name="recommendation_type"/><field name="priority"/><field name="product_id"/><field name="quantity"/><field name="state"/></tree></field></record>
    <record id="view_sop_ai_recommendation_form" model="ir.ui.view"><field name="name">mogen.sop.ai.recommendation.form</field><field name="model">mogen.sop.ai.recommendation</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve for Conversion" class="btn-primary" invisible="state not in ('proposed', 'reviewed')" groups="mogen_sop_ai.group_sop_ai_manager"/><button name="action_reject" type="object" string="Reject" invisible="state not in ('proposed', 'reviewed')" groups="mogen_sop_ai.group_sop_ai_manager"/><button name="action_convert_to_sop_recommendation" type="object" string="Create Draft S&amp;OP Recommendation" invisible="state != 'approved'" groups="mogen_sop_ai.group_sop_ai_manager"/><field name="state" widget="statusbar" statusbar_visible="proposed,reviewed,approved,rejected,converted"/></header><sheet><group><group><field name="ai_analysis_id"/><field name="company_id" invisible="1"/><field name="sop_plan_id"/><field name="recommendation_type"/><field name="priority"/><field name="title"/></group><group><field name="product_id"/><field name="warehouse_id"/><field name="quantity"/><field name="required_date"/><field name="confidence" readonly="1"/><field name="recommendation_id" readonly="1"/></group></group><notebook><page string="Recommendation"><field name="description"/><field name="reason"/><field name="expected_impact"/></page><page string="Evidence"><field name="source_reference_ids" readonly="1"/><field name="proposed_action" readonly="1"/></page></notebook></sheet></form></field></record>
    <record id="action_sop_ai_recommendation" model="ir.actions.act_window"><field name="name">AI Recommendations</field><field name="res_model">mogen.sop.ai.recommendation</field><field name="view_mode">tree,form</field></record>
</odoo>
