<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="sequence_sop_plan" model="ir.sequence">
        <field name="name">S&amp;OP Plan</field>
        <field name="code">mogen.sop.plan</field>
        <field name="prefix">SOP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="sequence_sop_scenario" model="ir.sequence">
        <field name="name">S&amp;OP Scenario</field>
        <field name="code">mogen.sop.scenario</field>
        <field name="prefix">SCN/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
