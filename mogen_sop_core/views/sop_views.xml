<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sop_plan_tree" model="ir.ui.view">
        <field name="name">mogen.sop.plan.tree</field>
        <field name="model">mogen.sop.plan</field>
        <field name="arch" type="xml">
            <tree decoration-muted="state == 'cancelled'" decoration-success="state == 'approved'" decoration-info="state == 'locked'">
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" optional="hide"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="planning_granularity"/>
                <field name="scenario_id"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_sop_plan_form" model="ir.ui.view">
        <field name="name">mogen.sop.plan.form</field>
        <field name="model">mogen.sop.plan</field>
        <field name="arch" type="xml">
            <form string="S&amp;OP Plan">
                <header>
                    <button name="action_prepare_data" type="object" string="Prepare Data" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" type="object" string="Start Review" class="btn-primary" invisible="state != 'data_prepared'"/>
                    <button name="action_consensus" type="object" string="Confirm Consensus" class="btn-primary" invisible="state != 'review'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="mogen_sop_core.group_sop_manager" invisible="state != 'consensus'"/>
                    <button name="action_lock" type="object" string="Lock" class="btn-primary" groups="mogen_sop_core.group_sop_manager" invisible="state != 'approved'"/>
                    <button name="action_create_version" type="object" string="New Version" groups="mogen_sop_core.group_sop_demand_planner,mogen_sop_core.group_sop_supply_planner" invisible="state in ('locked', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('locked', 'cancelled')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft" groups="mogen_sop_core.group_sop_manager" invisible="state not in ('data_prepared', 'review', 'consensus', 'cancelled', 'locked')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,data_prepared,review,consensus,approved,locked"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_demand_lines" type="object" class="oe_stat_button" icon="fa-line-chart">
                            <field name="demand_line_count" widget="statinfo" string="Demand Lines"/>
                        </button>
                        <button name="action_view_supply_lines" type="object" class="oe_stat_button" icon="fa-truck">
                            <field name="supply_line_count" widget="statinfo" string="Supply Lines"/>
                        </button>
                        <button name="action_view_inventory_health" type="object" class="oe_stat_button" icon="fa-cubes">
                            <field name="inventory_health_count" widget="statinfo" string="Inventory Health"/>
                        </button>
                        <button name="action_view_recommendations" type="object" class="oe_stat_button" icon="fa-lightbulb-o">
                            <field name="recommendation_count" widget="statinfo" string="Recommendations"/>
                        </button>
                        <button name="action_view_alerts" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="alert_count" widget="statinfo" string="Alerts"/>
                        </button>
                        <button name="action_view_versions" type="object" class="oe_stat_button" icon="fa-code-fork">
                            <field name="version_count" widget="statinfo" string="Versions"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Locked" bg_color="text-bg-info" invisible="state != 'locked'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Planning cycle name"/></h1>
                        <div><field name="code" readonly="1"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="planning_granularity"/>
                            <field name="warehouse_ids" widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="scenario_id"/>
                            <field name="active_version_id" readonly="1"/>
                            <field name="snapshot_date"/>
                            <field name="user_id"/>
                            <field name="manager_id"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_date" invisible="not approved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Versions">
                            <field name="version_ids" readonly="state == 'locked'">
                                <tree decoration-success="is_current" decoration-muted="state == 'archived'">
                                    <field name="version_number"/>
                                    <field name="name"/>
                                    <field name="state" widget="badge"/>
                                    <field name="created_by_id"/>
                                    <field name="created_date"/>
                                    <field name="is_current"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Recommendations">
                            <field name="recommendation_ids" readonly="state == 'locked'">
                                <tree>
                                    <field name="name"/>
                                    <field name="recommendation_type"/>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="required_date"/>
                                    <field name="priority" widget="priority"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Alerts">
                            <field name="alert_ids" readonly="state == 'locked'">
                                <tree decoration-danger="severity == 'critical'" decoration-warning="severity == 'warning'">
                                    <field name="name"/>
                                    <field name="alert_type"/>
                                    <field name="severity" widget="badge"/>
                                    <field name="product_id"/>
                                    <field name="assigned_user_id"/>
                                    <field name="state" widget="badge"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="note" placeholder="Planning assumptions, decisions, and meeting notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sop_plan_search" model="ir.ui.view">
        <field name="name">mogen.sop.plan.search</field>
        <field name="model">mogen.sop.plan</field>
        <field name="arch" type="xml">
            <search string="S&amp;OP Plans">
                <field name="name"/>
                <field name="code"/>
                <field name="scenario_id"/>
                <field name="user_id"/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="in_progress" string="In Progress" domain="[('state', 'in', ('data_prepared', 'review', 'consensus'))]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="locked" string="Locked" domain="[('state', '=', 'locked')]"/>
                <separator/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                <filter name="group_scenario" string="Scenario" context="{'group_by': 'scenario_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_sop_plan" model="ir.actions.act_window">
        <field name="name">Planning Cycles</field>
        <field name="res_model">mogen.sop.plan</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sop_plan_search"/>
        <field name="context">{'search_default_in_progress': 1}</field>
    </record>

    <record id="view_sop_version_tree" model="ir.ui.view">
        <field name="name">mogen.sop.plan.version.tree</field>
        <field name="model">mogen.sop.plan.version</field>
        <field name="arch" type="xml">
            <tree create="false" delete="false" decoration-success="is_current" decoration-muted="state == 'archived'">
                <field name="plan_id"/>
                <field name="version_number"/>
                <field name="name"/>
                <field name="state" widget="badge"/>
                <field name="created_by_id"/>
                <field name="created_date"/>
                <field name="is_current"/>
            </tree>
        </field>
    </record>

    <record id="view_sop_version_form" model="ir.ui.view">
        <field name="name">mogen.sop.plan.version.form</field>
        <field name="model">mogen.sop.plan.version</field>
        <field name="arch" type="xml">
            <form string="Plan Version" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id" readonly="1"/>
                            <field name="version_number" readonly="1"/>
                            <field name="state"/>
                            <field name="is_current"/>
                        </group>
                        <group>
                            <field name="created_by_id"/>
                            <field name="created_date"/>
                        </group>
                    </group>
                    <field name="note"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_sop_plan_version" model="ir.actions.act_window">
        <field name="name">Plan Versions</field>
        <field name="res_model">mogen.sop.plan.version</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="view_sop_scenario_tree" model="ir.ui.view">
        <field name="name">mogen.sop.scenario.tree</field>
        <field name="model">mogen.sop.scenario</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="company_id" optional="hide"/>
                <field name="scenario_type" widget="badge"/>
                <field name="sales_factor"/>
                <field name="lead_time_factor"/>
                <field name="purchase_cost_factor"/>
                <field name="production_capacity_factor"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_sop_scenario_form" model="ir.ui.view">
        <field name="name">mogen.sop.scenario.form</field>
        <field name="model">mogen.sop.scenario</field>
        <field name="arch" type="xml">
            <form string="S&amp;OP Scenario">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                        <div><field name="code" readonly="1"/></div>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="scenario_type"/>
                            <field name="active"/>
                        </group>
                        <group string="Factors">
                            <field name="sales_factor"/>
                            <field name="lead_time_factor"/>
                            <field name="purchase_cost_factor"/>
                            <field name="production_capacity_factor"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sop_scenario_search" model="ir.ui.view">
        <field name="name">mogen.sop.scenario.search</field>
        <field name="model">mogen.sop.scenario</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="group_type" string="Type" context="{'group_by': 'scenario_type'}"/>
                <filter name="group_company" string="Company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
            </search>
        </field>
    </record>

    <record id="action_sop_scenario" model="ir.actions.act_window">
        <field name="name">Scenarios</field>
        <field name="res_model">mogen.sop.scenario</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sop_scenario_search"/>
    </record>

    <record id="view_sop_recommendation_tree" model="ir.ui.view">
        <field name="name">mogen.sop.recommendation.tree</field>
        <field name="model">mogen.sop.recommendation</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'approved'" decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="company_id" optional="hide"/>
                <field name="recommendation_type"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="quantity"/>
                <field name="required_date"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_sop_recommendation_form" model="ir.ui.view">
        <field name="name">mogen.sop.recommendation.form</field>
        <field name="model">mogen.sop.recommendation</field>
        <field name="arch" type="xml">
            <form string="S&amp;OP Recommendation">
                <header>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="mogen_sop_core.group_sop_manager" invisible="state not in ('draft', 'reviewed')"/>
                    <button name="action_reject" type="object" string="Reject" groups="mogen_sop_core.group_sop_manager" invisible="state in ('rejected', 'executed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,reviewed,approved,rejected,executed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="company_id"/>
                            <field name="recommendation_type"/>
                            <field name="priority" widget="priority"/>
                            <field name="required_date"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="warehouse_id"/>
                            <field name="quantity"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approved_date" invisible="not approved_date"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Rationale">
                            <group>
                                <field name="reason"/>
                                <field name="impact"/>
                            </group>
                        </page>
                        <page string="Source">
                            <group>
                                <field name="source_model"/>
                                <field name="source_res_id"/>
                                <field name="purchase_order_id"/>
                                <field name="manufacturing_order_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sop_recommendation_search" model="ir.ui.view">
        <field name="name">mogen.sop.recommendation.search</field>
        <field name="model">mogen.sop.recommendation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <filter name="pending" string="Pending" domain="[('state', 'in', ('draft', 'reviewed'))]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="urgent" string="Urgent" domain="[('priority', '=', '3')]"/>
                <separator/>
                <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'recommendation_type'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_sop_recommendation_pivot" model="ir.ui.view">
        <field name="name">mogen.sop.recommendation.pivot</field>
        <field name="model">mogen.sop.recommendation</field>
        <field name="arch" type="xml">
            <pivot string="Recommendations">
                <field name="plan_id" type="row"/>
                <field name="recommendation_type" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_sop_recommendation_graph" model="ir.ui.view">
        <field name="name">mogen.sop.recommendation.graph</field>
        <field name="model">mogen.sop.recommendation</field>
        <field name="arch" type="xml">
            <graph string="Recommendation Quantity">
                <field name="recommendation_type"/>
                <field name="quantity" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_sop_recommendation" model="ir.actions.act_window">
        <field name="name">Recommendations</field>
        <field name="res_model">mogen.sop.recommendation</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_sop_recommendation_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="view_sop_alert_tree" model="ir.ui.view">
        <field name="name">mogen.sop.alert.tree</field>
        <field name="model">mogen.sop.alert</field>
        <field name="arch" type="xml">
            <tree decoration-danger="severity == 'critical' and state != 'resolved'" decoration-warning="severity == 'warning' and state != 'resolved'" decoration-muted="state == 'resolved'">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="company_id" optional="hide"/>
                <field name="alert_type"/>
                <field name="severity" widget="badge"/>
                <field name="product_id"/>
                <field name="warehouse_id"/>
                <field name="assigned_user_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_sop_alert_form" model="ir.ui.view">
        <field name="name">mogen.sop.alert.form</field>
        <field name="model">mogen.sop.alert</field>
        <field name="arch" type="xml">
            <form string="S&amp;OP Alert">
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_resolve" type="object" string="Resolve" class="btn-primary" invisible="state == 'resolved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,acknowledged,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="company_id"/>
                            <field name="alert_type"/>
                            <field name="severity"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="product_id"/>
                            <field name="warehouse_id"/>
                            <field name="resolved_date" invisible="not resolved_date"/>
                        </group>
                    </group>
                    <field name="message"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_sop_alert_search" model="ir.ui.view">
        <field name="name">mogen.sop.alert.search</field>
        <field name="model">mogen.sop.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="plan_id"/>
                <field name="product_id"/>
                <field name="assigned_user_id"/>
                <filter name="unresolved" string="Unresolved" domain="[('state', '!=', 'resolved')]"/>
                <filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/>
                <separator/>
                <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                <filter name="group_type" string="Type" context="{'group_by': 'alert_type'}"/>
                <filter name="group_severity" string="Severity" context="{'group_by': 'severity'}"/>
                <filter name="group_state" string="State" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>

    <record id="view_sop_alert_pivot" model="ir.ui.view">
        <field name="name">mogen.sop.alert.pivot</field>
        <field name="model">mogen.sop.alert</field>
        <field name="arch" type="xml">
            <pivot string="Alerts">
                <field name="plan_id" type="row"/>
                <field name="severity" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="view_sop_alert_graph" model="ir.ui.view">
        <field name="name">mogen.sop.alert.graph</field>
        <field name="model">mogen.sop.alert</field>
        <field name="arch" type="xml">
            <graph string="Alerts">
                <field name="alert_type"/>
                <field name="severity"/>
            </graph>
        </field>
    </record>

    <record id="action_sop_alert" model="ir.actions.act_window">
        <field name="name">Alerts</field>
        <field name="res_model">mogen.sop.alert</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_sop_alert_search"/>
        <field name="context">{'search_default_unresolved': 1}</field>
    </record>
</odoo>
