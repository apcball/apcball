<odoo>
    <record id="group_sop_executive" model="res.groups">
        <field name="name">S&amp;OP Executive</field>
        <field name="category_id" ref="mogen_sop_core.module_category_mogen_sop"/>
        <field name="implied_ids" eval="[(4, ref('mogen_sop_core.group_sop_viewer')), (4, ref('mogen_sop_ai.group_sop_ai_user'))]"/>
    </record>
    <record id="rule_sop_executive_summary_cache_company" model="ir.rule"><field name="name">Executive summary cache multi-company</field><field name="model_id" ref="model_mogen_sop_executive_summary_cache"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_sop_executive'))]"/></record>
</odoo>
