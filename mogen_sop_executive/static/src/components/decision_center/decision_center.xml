<templates xml:space="preserve"><t t-name="mogen_sop_executive.DecisionCenter" owl="1"><div class="o_sop_decision_center container-fluid p-3"><div class="d-flex justify-content-between align-items-center"><h2>S&amp;OP Executive Decision Center</h2><div><button class="btn btn-outline-secondary me-2" t-on-click="refresh">Refresh</button><button class="btn btn-primary" t-on-click="generateSummary">Generate AI Summary</button></div></div><div t-if="state.loading" class="p-5 text-center text-muted">Loading stored decision data…</div><div t-if="state.error" class="alert alert-danger" t-esc="state.error"/><t t-if="!state.loading"><section class="row g-3 my-1"><div class="col-6 col-md-3" t-foreach="state.kpis" t-as="kpi" t-key="kpi.name"><div class="card h-100"><div class="card-body"><small t-esc="kpi.name"/><h3 t-esc="kpi.value"/></div></div></div></section><section class="row g-3"><div class="col-12 col-lg-6"><div class="card"><div class="card-header">Decision Queue</div><ul class="list-group list-group-flush"><li class="list-group-item" t-foreach="state.queue" t-as="item" t-key="item.type + item.id"><strong t-esc="item.priority"/> — <span t-esc="item.title"/></li><li t-if="!state.queue.length" class="list-group-item text-muted">No pending decisions.</li></ul></div></div><div class="col-12 col-lg-6"><div class="card"><div class="card-header">AI Executive Summary</div><div class="card-body"><p t-esc="state.summary.summary || 'No cached summary. Generate one on demand.'"/><small class="text-muted" t-if="state.summary.generated_at">Generated <t t-esc="state.summary.generated_at"/> · <t t-esc="state.summary.provider"/> / <t t-esc="state.summary.model"/></small></div></div></div><div class="col-12 col-lg-6"><div class="card"><div class="card-header">Scenario Comparison</div><div class="card-body"><p t-if="!state.scenarios.length" class="text-muted">Select scenarios to compare.</p><p t-foreach="state.scenarios" t-as="row" t-key="row.id"><strong t-esc="row.name"/> — Risk <t t-esc="row.risk_score"/></p></div></div></div><div class="col-12 col-lg-6"><div class="card"><div class="card-header">Forecast Performance</div><div class="card-body"><p t-if="!state.forecast.length" class="text-muted">No stored forecast performance.</p><p t-foreach="state.forecast" t-as="row" t-key="row.model"><t t-esc="row.model"/>: <t t-esc="row.forecast_qty"/></p></div></div></div></section></t></div></t></templates>
