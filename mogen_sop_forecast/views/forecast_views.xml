  <record id="view_sop_forecast_result_pivot" model="ir.ui.view"><field name="name">mogen.sop.forecast.result.pivot</field><field name="model">mogen.sop.forecast.result</field><field name="arch" type="xml"><pivot><field name="product_id" type="row"/><field name="forecast_qty" type="measure"/></pivot></field></record>
  <record id="view_sop_forecast_result_graph" model="ir.ui.view"><field name="name">mogen.sop.forecast.result.graph</field><field name="model">mogen.sop.forecast.result</field><field name="arch" type="xml"><graph type="bar"><field name="product_id"/><field name="forecast_qty" type="measure"/></graph></field></record>
  <record id="action_sop_forecast_result" model="ir.actions.act_window"><field name="name">Forecast Results</field><field name="res_model">mogen.sop.forecast.result</field><field name="view_mode">tree,pivot,graph</field></record>
