<odoo>
  <record id="view_sop_forecast_model_tree" model="ir.ui.view"><field name="name">mogen.sop.forecast.model.tree</field><field name="model">mogen.sop.forecast.model</field><field name="arch" type="xml"><tree><field name="name"/><field name="code"/><field name="model_type"/><field name="active"/></tree></field></record>
  <record id="view_sop_forecast_model_form" model="ir.ui.view"><field name="name">mogen.sop.forecast.model.form</field><field name="model">mogen.sop.forecast.model</field><field name="arch" type="xml"><form><sheet><group><field name="name"/><field name="code"/><field name="company_id"/><field name="model_type"/><field name="active"/><field name="history_periods"/><field name="minimum_history_points"/><field name="alpha"/><field name="seasonal_periods"/><field name="weight_config"/></group></sheet></form></field></record>
  <record id="action_sop_forecast_model" model="ir.actions.act_window"><field name="name">Forecast Models</field><field name="res_model">mogen.sop.forecast.model</field><field name="view_mode">tree,form</field></record>
  <record id="view_sop_forecast_run_tree" model="ir.ui.view"><field name="name">mogen.sop.forecast.run.tree</field><field name="model">mogen.sop.forecast.run</field><field name="arch" type="xml"><tree><field name="name"/><field name="sop_plan_id"/><field name="state"/><field name="processed_product_count"/><field name="total_product_count"/></tree></field></record>
  <record id="view_sop_forecast_run_form" model="ir.ui.view"><field name="name">mogen.sop.forecast.run.form</field><field name="model">mogen.sop.forecast.run</field><field name="arch" type="xml"><form><header><button name="action_prepare_data" type="object" string="Prepare"/><button name="action_run_models" type="object" string="Run Models"/><button name="action_cancel" type="object" string="Cancel"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="sop_plan_id"/><field name="version_id"/><field name="company_id"/><field name="warehouse_ids"/><field name="granularity"/><field name="forecast_horizon"/><field name="history_date_start"/><field name="history_date_end"/><field name="date_start"/><field name="date_end"/><field name="model_ids"/><field name="processed_product_count"/><field name="total_product_count"/><field name="calculation_log" readonly="1"/><field name="error_message" readonly="1"/></group></sheet></form></field></record>
  <record id="action_sop_forecast_run" model="ir.actions.act_window"><field name="name">Forecast Runs</field><field name="res_model">mogen.sop.forecast.run</field><field name="view_mode">tree,form</field></record>
