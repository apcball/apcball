<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_office_supply_user" model="res.groups">
        <field name="name">Office Supply User</field>
        <field name="category_id" ref="base.module_category_inventory"/>
    </record>

    <record id="group_office_supply_manager" model="res.groups">
        <field name="name">Office Supply Manager</field>
        <field name="category_id" ref="base.module_category_inventory"/>
        <field name="implied_ids" eval="[(4, ref('group_office_supply_user'))]"/>
    </record>

    <record id="rule_office_supply_user_own_requisition" model="ir.rule">
        <field name="name">Office Supply User: own requisitions</field>
        <field name="model_id" ref="model_office_supply_requisition"/>
        <field name="domain_force">['|', ('employee_id.user_id', '=', user.id), ('create_uid', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_office_supply_user'))]"/>
    </record>

    <record id="rule_office_supply_manager_all_requisition" model="ir.rule">
        <field name="name">Office Supply Manager: all requisitions</field>
        <field name="model_id" ref="model_office_supply_requisition"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_office_supply_manager'))]"/>
    </record>
</odoo>
