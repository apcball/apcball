<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree view -->
    <record id="view_office_supply_requisition_tree" model="ir.ui.view">
        <field name="name">office.supply.requisition.tree</field>
        <field name="model">office.supply.requisition</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'done'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="location_id"/>
                <field name="amount_total" sum="มูลค่ารวม"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- Kanban view: เห็นชัด กดง่าย เหมาะกับมือถือ -->
    <record id="view_office_supply_requisition_kanban" model="ir.ui.view">
        <field name="name">office.supply.requisition.kanban</field>
        <field name="model">office.supply.requisition</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" quick_create="false">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click p-3">
                            <strong><field name="name"/></strong>
                            <div><field name="employee_id"/></div>
                            <div><field name="date"/></div>
                            <span class="badge"
                                  t-attf-class="badge-#{record.state.raw_value == 'done' ? 'success' : 'secondary'}">
                                <field name="state"/>
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_office_supply_requisition_form" model="ir.ui.view">
        <field name="name">office.supply.requisition.form</field>
        <field name="model">office.supply.requisition</field>
        <field name="arch" type="xml">
            <form class="office_supply_requisition_form">
                <header class="office_supply_form_header">
                    <button name="action_confirm_request" type="object" string="ยืนยันการเบิก"
                            class="btn-primary office_supply_primary_btn" invisible="state != 'draft'"/>
                    <button name="action_sign_and_confirm" type="object" string="เซ็นรับและยืนยัน"
                            class="btn-primary office_supply_primary_btn" invisible="state != 'confirmed'"/>
                    <button name="action_reject" type="object" string="ปฏิเสธ"
                            class="btn-secondary office_supply_secondary_btn" invisible="state not in ('confirmed', 'signed')"/>
                    <button name="action_reset_draft" type="object" string="ตั้งเป็นร่าง"
                            class="btn-light office_supply_reset_btn" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" class="office_supply_statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title office_supply_title_wrap">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <div class="office_supply_card office_supply_summary_card">
                        <group>
                            <group>
                                <field name="requester_id"/>
                                <field name="receiver_id"/>
                                <field name="employee_id"/>
                                <field name="date"/>
                                <field name="submitted_by_id" readonly="1"/>
                                <field name="submitted_date" readonly="1"/>
                            </group>
                            <group>
                                <field name="location_id"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="signed_by" readonly="1"/>
                                <field name="signed_on" readonly="1"/>
                                <field name="approved_by_id" readonly="1"/>
                                <field name="approved_date" readonly="1"/>
                            </group>
                        </group>
                    </div>

                    <div class="office_supply_card office_supply_reject_card">
                        <group>
                            <field name="reject_reason" readonly="state in ('draft', 'done')"/>
                        </group>
                    </div>

                    <notebook class="office_supply_notebook">
                        <page string="รายการเบิก">
                            <div class="office_supply_card office_supply_list_card">
                                <field name="line_ids" readonly="state == 'done'">
                                    <tree editable="bottom">
                                        <field name="product_id"/>
                                        <field name="qty_available"/>
                                        <field name="product_uom_qty"/>
                                        <field name="product_uom_id"/>
                                        <field name="price_subtotal" sum="มูลค่ารวม"/>
                                    </tree>
                                </field>
                            </div>
                            <group class="oe_subtotal_footer office_supply_total_box">
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="ลายเซ็นผู้รับ">
                            <div class="office_supply_card office_supply_signature_card">
                                <field name="signature" widget="signature" attrs="{'readonly': [('state', '=', 'done')]}"/>
                            </div>
                        </page>
                        <page string="หมายเหตุ">
                            <div class="office_supply_card office_supply_note_card">
                                <field name="note"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search view -->
    <record id="view_office_supply_requisition_search" model="ir.ui.view">
        <field name="name">office.supply.requisition.search</field>
        <field name="model">office.supply.requisition</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="employee_id"/>
                <filter string="ของฉัน" name="my_requisition"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <filter string="ร่าง" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="ยืนยันการเบิก" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="เซ็นรับแล้ว" name="signed" domain="[('state', '=', 'signed')]"/>
                <filter string="เบิกแล้ว" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="ถูกปฏิเสธ" name="rejected" domain="[('reject_reason', '!=', False), ('reject_reason', '!=', '')]"/>
                <group expand="0" string="จัดกลุ่ม">
                    <filter string="ผู้เบิก" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="ผู้รับอุปกรณ์" name="group_receiver" context="{'group_by': 'receiver_id'}"/>
                    <filter string="สถานะ" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_office_supply_requisition" model="ir.actions.act_window">
        <field name="name">เบิกจ่ายของสำนักงาน</field>
        <field name="res_model">office.supply.requisition</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_my_requisition': 1}</field>
        <field name="help">สร้างใบเบิกของสำนักงานใบแรกของคุณ</field>
    </record>

</odoo>
