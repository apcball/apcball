<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_lite_order_tree" model="ir.ui.view">
        <field name="name">pos.lite.order.tree</field>
        <field name="model">pos.lite.order</field>
        <field name="arch" type="xml">
            <tree decoration-success="state in ('paid','done')" decoration-muted="state == 'cancelled'" decoration-warning="state == 'held'" decoration-danger="return_status == 'Return'">
                <field name="name"/>
                <field name="date_order" string="Date"/>
                <field name="state" widget="badge" decoration-success="state in ('paid','done')" decoration-warning="state == 'held'" decoration-danger="state == 'cancelled'"/>
                <field name="channel" widget="badge"/>
                <field name="trade_channel" widget="badge" optional="show"/>
                <field name="partner_id"/>
                <field name="partner_shipping_id" optional="hide" string="Delivery"/>
                <field name="warehouse_id"/>
                <field name="location_id" optional="show"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="amount_paid" sum="Paid" widget="monetary" optional="hide"/>
                <field name="amount_residual" sum="Due" widget="monetary" decoration-danger="amount_residual > 0" optional="hide"/>
                <field name="margin" sum="Margin" widget="monetary" optional="hide"/>
                <field name="return_status" widget="badge" decoration-danger="return_status == 'Return'" decoration-success="return_status == 'Sale'" optional="show"/>
                <field name="exchange_status" widget="badge" decoration-warning="exchange_status == 'Exchange'" decoration-muted="exchange_status == 'Direct'" optional="hide"/>
                <field name="return_of_order_id" optional="hide"/>
                <field name="return_count" invisible="1" optional="hide"/>
                <field name="invoice_id" optional="show"/>
                <field name="picking_id" optional="hide"/>
                <field name="session_id" optional="hide"/>
                <field name="employee_id" optional="hide" string="Employee"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_lite_order_search" model="ir.ui.view">
        <field name="name">pos.lite.order.search</field>
        <field name="model">pos.lite.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                 <field name="invoice_id"/>
                <field name="partner_id" context="{'pos_lite_partner_search': 1}"/>
                <field name="partner_phone"/>
                <field name="warehouse_id"/>
                <field name="location_id"/>
                <field name="channel"/>
                <field name="trade_channel"/>
                <field name="session_id"/>
                <field name="employee_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Held" name="held" domain="[('state', '=', 'held')]"/>
                <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="Returns" name="returns" domain="[('is_return', '=', True)]" invisible="1"/>
                <filter string="Sales" name="sales" domain="[('is_return', '=', False)]" invisible="1"/>
                <separator/>
                <filter string="Today" name="today" domain="[('date_order', '&gt;=', (context_today()).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="This Week" name="this_week" domain="[('date_order', '&gt;=', (context_today() - relativedelta(weeks=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <filter string="This Month" name="this_month" domain="[('date_order', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter string="Has Invoice" name="has_invoice" domain="[('invoice_id', '!=', False)]"/>
                <filter string="No Invoice" name="no_invoice" domain="[('invoice_id', '=', False), ('state', 'in', ('paid','done'))]"/>
                <filter string="Has Picking" name="has_picking" domain="[('picking_id', '!=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Channel" name="group_channel" context="{'group_by': 'channel'}"/>
                    <filter string="Trade Channel" name="group_trade_channel" context="{'group_by': 'trade_channel'}"/>
                    <filter string="Warehouse" name="group_warehouse" context="{'group_by': 'warehouse_id'}"/>
                    <filter string="Location" name="group_location" context="{'group_by': 'location_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Session" name="group_session" context="{'group_by': 'session_id'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'date_order:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pos_lite_order_form" model="ir.ui.view">
        <field name="name">pos.lite.order.form</field>
        <field name="model">pos.lite.order</field>
        <field name="arch" type="xml">
            <form string="POS Lite Order" class="o_pos_lite_order_form">
                <header>
                    <!-- Draft/Held actions -->
                    <button name="action_quick_pay_and_process" type="object" string="Process" class="oe_highlight" invisible="state not in ('draft', 'held')" groups="pos_lite.group_pos_lite_user"/>
                    <button name="action_hold" type="object" string="Hold" invisible="state != 'draft'"/>
                    <button name="action_resume" type="object" string="Resume" class="oe_highlight" invisible="state != 'held'"/>
                    <!-- Paid actions -->
                    <button name="action_done" type="object" string="Mark Done" invisible="state != 'paid'"/>
                    <!-- Return/Exchange — only for completed orders -->
                    <button name="action_create_return" type="object" string="Return" icon="fa-arrow-right" class="btn-primary" invisible="state != 'done'"/>
                    <button name="action_create_exchange" type="object" string="Exchange" class="btn-secondary" invisible="1"/>
                    <!-- General -->
                    <button name="action_reorder" type="object" string="Re-order" icon="fa-history" class="btn-secondary" invisible="state == 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state == 'cancelled' or (state == 'done' and not is_return)"/>
                    <!-- Print -->
                    <button name="action_print_invoice" type="object" string="Print Invoice" icon="fa-print" class="btn-secondary" invisible="state == 'draft'" groups="pos_lite.group_pos_lite_user"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,paid,done,cancelled"/>
                </header>
                <sheet class="o_pos_lite_order_form">
                    <!-- Stat buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not invoice_id">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="invoice_id"/></span>
                                <span class="o_stat_text">Print Invoice</span>
                            </div>
                        </button>
                        <button name="action_view_picking" type="object" class="oe_stat_button" icon="fa-truck" invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="picking_id"/></span>
                                <span class="o_stat_text">Picking</span>
                            </div>
                        </button>
                        <button name="action_view_returns" type="object" class="oe_stat_button" icon="fa-undo" invisible="is_return or return_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="return_count"/></span>
                                <span class="o_stat_text">Returns</span>
                            </div>
                        </button>
                        <button name="action_view_exchanges" type="object" class="oe_stat_button" icon="fa-exchange" invisible="is_return or exchange_count == 0">
                            <div class="o_stat_info">
                                <span class="o_stat_value"><field name="exchange_count"/></span>
                                <span class="o_stat_text">Exchanges</span>
                            </div>
                        </button>
                        <button name="action_view_payments" type="object" class="oe_stat_button" icon="fa-money" invisible="not payment_ids">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Refund Records</span>
                            </div>
                        </button>
                    </div>

                    <!-- Title -->
                    <div class="pl_order_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="state" widget="badge" readonly="1"
                               decoration-success="state in ('paid', 'done')"
                               decoration-warning="state == 'held'"
                               decoration-info="state == 'draft'"
                               decoration-danger="state == 'cancelled'"/>
                    </div>

                    <field name="is_late_return" invisible="1"/>
                    <div class="alert alert-warning" role="alert" colspan="2"
                         invisible="not is_late_return or state != 'draft'">
                        <span>Late return/exchange: the credit note was left unposted and the
                        receipt was left unvalidated. Complete both manually from the
                        Invoice and Picking buttons above.</span>
                    </div>

                    <field name="company_id" invisible="1"/>
                    <field name="currency_id" invisible="1"/>
                    <field name="is_return" invisible="1"/>
                    <div class="pl_order_meta">
                        <div class="pl_meta_item">
                            <i class="fa fa-calendar pl_meta_icon" aria-hidden="true"/>
                            <div><label for="date_order" string="Order Date"/><field name="date_order" readonly="state != 'draft'"/></div>
                        </div>
                        <div class="pl_meta_item">
                            <i class="fa fa-shopping-basket pl_meta_icon" aria-hidden="true"/>
                            <div><label for="channel"/><field name="channel" readonly="state == 'done'"/></div>
                        </div>
                        <div class="pl_meta_item">
                            <i class="fa fa-shopping-bag pl_meta_icon" aria-hidden="true"/>
                            <div><label for="trade_channel"/><field name="trade_channel" readonly="state == 'done'"/></div>
                        </div>
                        <div class="pl_meta_item">
                            <i class="fa fa-home pl_meta_icon" aria-hidden="true"/>
                            <div><label for="warehouse_id"/><field name="warehouse_id" options="{'no_create': True}" readonly="state == 'done'"/></div>
                        </div>
                        <div class="pl_meta_item">
                            <i class="fa fa-map-marker pl_meta_icon" aria-hidden="true"/>
                            <div><label for="location_id"/><field name="location_id" options="{'no_create': True}"/></div>
                        </div>
                        <div class="pl_meta_item">
                            <i class="fa fa-list pl_meta_icon" aria-hidden="true"/>
                            <div><label for="pricelist_id"/><field name="pricelist_id" readonly="state == 'done'"/></div>
                        </div>
                    </div>

                    <!-- Return/Exchange info -->
                    <div class="pl_return_info" invisible="not is_return">
                        <h3>Return Info</h3>
                        <field name="is_exchange" invisible="1"/>
                        <div class="pl_return_fields">
                            <div class="pl_return_item"><label for="return_of_order_id"/><field name="return_of_order_id" readonly="1"/></div>
                            <div class="pl_return_item"><label for="return_reason"/><field name="return_reason" readonly="1"/></div>
                            <div class="pl_return_item" invisible="not is_exchange"><label for="exchange_of_order_id"/><field name="exchange_of_order_id" readonly="1"/></div>
                            <div class="pl_return_item" invisible="not is_exchange"><label for="exchange_return_order_id"/><field name="exchange_return_order_id" readonly="1"/></div>
                        </div>
                    </div>

                    <!-- Exchange info — original order side -->
                    <group class="pl_exchange_info" invisible="is_return or exchange_count == 0">
                        <group string="Exchange Summary" col="2">
                            <field name="exchange_return_total" readonly="1" widget="monetary" string="Return Value"/>
                            <field name="exchange_new_total" readonly="1" widget="monetary" string="New Items Value"/>
                            <field name="exchange_difference" readonly="1" widget="monetary"
                                   string="Difference"
                                   decoration-success="exchange_customer_gets_refund == True"
                                   decoration-danger="exchange_customer_pays == True"/>
                            <field name="exchange_customer_pays" invisible="1"/>
                            <field name="exchange_customer_gets_refund" invisible="1"/>
                            <div class="alert alert-info" colspan="2" role="alert"
                                 invisible="not exchange_customer_pays">
                                <span>Customer pays extra <field name="exchange_difference" widget="monetary"/> for the new items.</span>
                            </div>
                            <div class="alert alert-success" colspan="2" role="alert"
                                 invisible="not exchange_customer_gets_refund">
                                <span>Customer gets refunded <field name="exchange_difference" widget="monetary" decoration-success="True"/> (new items cost less).</span>
                            </div>
                        </group>
                    </group>

                    <div class="pl_order_layout">
                        <div class="pl_order_main">
                            <div class="pl_address_grid">
                                <div class="pl_card pl_card_customer">
                                    <h2 class="pl_card_heading"><i class="fa fa-user pl_card_icon" aria-hidden="true"/><span>Customer</span></h2>
                                    <group>
                                        <field name="partner_id" context="{'pos_lite_partner_search': 1}" options="{'no_create_edit': False}" placeholder="Search or create customer..." readonly="state == 'done'"/>
                                        <field name="customer_name" placeholder="Customer Name" readonly="1"/>
                                    </group>
                                    <div class="pl_contact_row" invisible="not partner_phone"><i class="fa fa-phone" title="Phone"/><field name="partner_phone" widget="phone" readonly="1"/></div>
                                    <div class="pl_contact_row" invisible="not partner_email"><i class="fa fa-envelope" title="Email"/><field name="partner_email" widget="email"/></div>
                                    <div class="pl_contact_row" invisible="not partner_address"><i class="fa fa-map-marker" title="Address"/><field name="partner_address" readonly="1"/></div>
                                </div>
                                <div class="pl_card pl_card_invoice">
                                    <h2 class="pl_card_heading"><i class="fa fa-truck pl_card_icon" aria-hidden="true"/><label for="partner_invoice_id" string="Invoice Address"/></h2>
                                    <field name="partner_invoice_id" options="{'no_create_edit': False}" placeholder="Auto-filled from customer" readonly="state == 'done'"/>
                                    <field name="invoice_contact_address" class="pl_contact_address"/>
                                </div>
                                <div class="pl_card pl_card_shipping">
                                    <h2 class="pl_card_heading"><i class="fa fa-home pl_card_icon" aria-hidden="true"/><label for="partner_shipping_id" string="Delivery Address"/></h2>
                                    <field name="partner_shipping_id" options="{'no_create_edit': False}" placeholder="Auto-filled from customer" readonly="state == 'done'"/>
                                    <field name="shipping_contact_address" class="pl_contact_address"/>
                                </div>
                            </div>
                            <div class="pl_card pl_lines_card">
                                <notebook class="pl_order_notebook">
                                    <page string="Order Lines">
                                        <field name="line_ids" mode="tree" class="pl_order_lines" nolabel="1" readonly="state == 'done'">
                                            <tree editable="bottom" decoration-danger="is_low_stock" decoration-warning="qty_available &gt; 0 and qty_available &lt; qty">
                                                <field name="company_id" column_invisible="True"/>
                                                <field name="currency_id" column_invisible="True"/>
                                                <field name="product_image" widget="image" class="oe_avatar" readonly="1" options="{'size': [32, 32]}" string=" "/>
                                                <field name="product_id" context="{'pos_lite_search': 1}" string="Product"/>
                                                <field name="description" optional="show"/>
                                                <field name="qty"/>
                                                <field name="qty_available" readonly="1" string="Stock"
                                                       decoration-danger="qty_available &lt; qty"
                                                       decoration-success="qty_available &gt;= qty"/>
                                                <field name="is_low_stock" column_invisible="True"/>
                                                <field name="price_unit" string="Price"/>
                                                <field name="discount_type" string="Type" optional="hide"/>
                                                <field name="discount" string="Discount"/>
                                                <field name="price_subtotal" string="Subtotal" readonly="1" sum="Subtotal" optional="show"/>
                                                <field name="price_tax" string="Tax" readonly="1" sum="Tax" optional="show"/>
                                                <field name="price_total" string="Total" readonly="1" sum="Total"/>
                                                <field name="standard_cost_price" readonly="1" optional="show" string="Cost" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                                <field name="margin" readonly="1" sum="Margin" widget="monetary"/>
                                            </tree>
                                        </field>
                                    </page>
                                    <page string="Refund Records" invisible="not payment_ids">
                                        <field name="payment_ids" nolabel="1">
                                            <tree editable="bottom" readonly="state not in ('draft', 'held')">
                                                <field name="state" invisible="1"/>
                                                <field name="company_id" invisible="1"/>
                                                <field name="payment_method"/>
                                                <field name="amount"/>
                                                <field name="journal_id"/>
                                                <field name="reference"/>
                                                <field name="payment_date"/>
                                                <field name="note"/>
                                                <field name="account_payment_id" readonly="1" optional="hide"/>
                                            </tree>
                                        </field>
                                    </page>
                                    <page string="Exchanges" invisible="exchange_count == 0">
                                        <group string="Exchange Orders">
                                            <field name="exchange_order_ids" nolabel="1" readonly="1">
                                                <tree>
                                                    <field name="name"/>
                                                    <field name="date_order" string="Date"/>
                                                    <field name="state" widget="badge"
                                                           decoration-success="state in ('paid','done')"
                                                           decoration-danger="state == 'cancelled'"/>
                                                    <field name="amount_total" widget="monetary"/>
                                                    <field name="exchange_return_order_id" string="Return Order" optional="hide"/>
                                                </tree>
                                            </field>
                                        </group>
                                    </page>
                                    <page string="Notes">
                                        <field name="note" placeholder="Add notes, delivery instructions, LINE message details..." readonly="state == 'done'"/>
                                    </page>
                                </notebook>
                            </div>
                            <div class="pl_card pl_information_card">
                                <h2 class="pl_card_heading"><i class="fa fa-file-text-o pl_card_icon" aria-hidden="true"/><span>Additional Information</span></h2>
                                <group>
                                    <group><field name="currency_id" readonly="1"/></group>
                                    <group>
                                        <field name="create_uid" string="Created by" readonly="1"/>
                                        <field name="create_date" string="Created on" readonly="1"/>
                                        <field name="write_date" string="Last Updated" readonly="1"/>
                                    </group>
                                </group>
                            </div>
                        </div>
                        <div class="pl_order_sidebar">
                            <div class="pl_card pl_card_session">
                                <h2 class="pl_card_heading"><i class="fa fa-circle-o pl_card_icon" aria-hidden="true"/><span>Session Information</span></h2>
                                <group>
                                    <field name="session_id" options="{'no_create': True}" readonly="state == 'done'"/>
                                    <field name="employee_id" readonly="state not in ('draft', 'held')"/>
                                </group>
                            </div>
                            <div class="pl_card pl_summary_card">
                                <h2 class="pl_card_heading"><i class="fa fa-calculator pl_card_icon" aria-hidden="true"/><span>Order Summary</span></h2>
                                <div class="pl_summary_row"><label for="amount_untaxed" string="Untaxed"/><field name="amount_untaxed" widget="monetary"/></div>
                                <div class="pl_summary_row"><label for="amount_tax" string="Tax"/><field name="amount_tax" widget="monetary"/></div>
                                <div class="pl_summary_row pl_grand_total"><label for="amount_total" string="Total"/><field name="amount_total" widget="monetary"/></div>
                                <div class="pl_margin_panel">
                                    <div class="pl_summary_row"><label for="margin" string="Margin"/><field name="margin" widget="monetary" decoration-success="margin &gt;= 0" decoration-danger="margin &lt; 0"/></div>
                                    <div class="pl_summary_row"><label for="margin_percent" string="Margin %"/><field name="margin_percent" widget="percentage" decoration-success="margin_percent &gt;= 0" decoration-danger="margin_percent &lt; 0"/></div>
                                </div>
                                <div class="pl_payment_summary">
                                    <div class="pl_summary_row"><label for="amount_paid" string="Paid"/><field name="amount_paid" widget="monetary"/></div>
                                    <div class="pl_summary_row"><label for="amount_residual" string="Due"/><field name="amount_residual" widget="monetary" decoration-danger="amount_residual &gt; 0"/></div>
                                    <div class="pl_summary_row"><label for="amount_change" string="Change"/><field name="amount_change" widget="monetary"/></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pos_lite_orders" model="ir.actions.act_window">
        <field name="name">POS Lite Orders</field>
        <field name="res_model">pos.lite.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_channel': 'phone', 'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_no_content_smiling_face">Create the first lightweight order.</p>
        </field>
    </record>

    <!-- Held Orders Action -->
    <record id="action_pos_lite_held_orders" model="ir.actions.act_window">
        <field name="name">Held Orders</field>
        <field name="res_model">pos.lite.order</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state', '=', 'held')]</field>
    </record>
</odoo>
