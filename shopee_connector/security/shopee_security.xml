<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="group_shopee_user" model="res.groups">
        <field name="name">Shopee User</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="comment">Can use Shopee stock import/export wizards and see the Shopee menu.</field>
    </record>
    <record id="group_shopee_manager" model="res.groups">
        <field name="name">Shopee Manager</field>
        <field name="category_id" ref="base.module_category_sales_sales"/>
        <field name="implied_ids" eval="[(4, ref('group_shopee_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Manages Shopee connections, credentials, order sync and shipping.</field>
    </record>
</odoo>
