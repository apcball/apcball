<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_shopee_stock_import_wizard_form" model="ir.ui.view">
        <field name="name">shopee.stock.import.wizard.form</field>
        <field name="model">shopee.stock.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Shopee Stock">
                <sheet>
                    <p class="text-muted">
                        Upload a Shopee stock export containing SKU and quantity
                        (or stock) columns. Existing Odoo On Hand quantities are
                        not changed.
                    </p>
                    <group>
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name"
                               widget="binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_import" string="Import"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_shopee_stock_export_wizard_form" model="ir.ui.view">
        <field name="name">shopee.stock.export.wizard.form</field>
        <field name="model">shopee.stock.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Shopee Stock">
                <sheet>
                    <p class="text-muted">
                        Exports every product linked to Shopee (SKU, Shopee
                        item/model IDs and stock). The file can be edited and
                        re-imported via Import Stock File.
                    </p>
                    <group>
                        <field name="product_count" readonly="1"/>
                        <field name="file_name" invisible="1"/>
                        <field name="file_data" filename="file_name"
                               widget="binary"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_regenerate" string="Regenerate"
                            type="object" class="btn-secondary"/>
                    <button string="Close" special="cancel"
                            class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_shopee_stock_import" model="ir.actions.act_window">
        <field name="name">Import Shopee Stock</field>
        <field name="res_model">shopee.stock.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_shopee_stock_export" model="ir.actions.act_window">
        <field name="name">Export Shopee Stock</field>
        <field name="res_model">shopee.stock.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_shopee_stock_file_tree" model="ir.ui.view">
        <field name="name">product.product.tree.shopee.stock.file</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <tree string="Import Stock File" create="false">
                <field name="shopee_linked" widget="boolean_favorite" optional="hide"/>
                <field name="default_code"/>
                <field name="name"/>
                <field name="shopee_stock"/>
                <field name="shopee_item_id"/>
                <field name="shopee_model_id"/>
                <field name="shopee_pushed_stock"/>
                <field name="shopee_last_sync"/>
                <field name="shopee_sync_stock_out"/>
            </tree>
        </field>
    </record>

    <record id="action_shopee_stock_file" model="ir.actions.act_window">
        <field name="name">Import Stock File</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_shopee_stock_file_tree"/>
        <field name="domain">[('default_code', '!=', False)]</field>
    </record>
    <menuitem id="shopee_connector_stock_import_menu" name="Import Stock File"
              parent="shopee_connector_root_menu"
              action="action_shopee_stock_file" sequence="40"
              active="False"/>

    <!-- Cog menu (gear) entries on product lists -->
    <record id="action_shopee_stock_import_server" model="ir.actions.server">
        <field name="name">Import Stock File</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env.ref("shopee_connector.action_shopee_stock_import").sudo().read()[0]</field>
    </record>

    <record id="action_shopee_stock_export_server" model="ir.actions.server">
        <field name="name">Export All (Shopee Stock)</field>
        <field name="model_id" ref="product.model_product_product"/>
        <field name="binding_model_id" ref="product.model_product_product"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = env.ref("shopee_connector.action_shopee_stock_export").sudo().read()[0]</field>
    </record>
</odoo>
