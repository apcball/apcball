<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Wizard Form View -->
    <record id="view_stock_valuation_recalculate_wizard_form" model="ir.ui.view">
        <field name="name">stock.valuation.recalculate.wizard.form</field>
        <field name="model">stock.valuation.recalculate.wizard</field>
        <field name="arch" type="xml">
            <form string="Recalculate Stock Valuation">
                <header>
                    <button name="action_recalculate" 
                            string="Start Recalculation" 
                            type="object" 
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close" 
                            string="Close" 
                            type="object" 
                            class="btn-secondary"
                            invisible="state != 'done'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,processing,done"/>
                </header>
                <sheet>
                    <div class="oe_title" invisible="state != 'draft'">
                        <h1>
                            <i class="fa fa-calculator"/> Recalculate Stock Valuation by Warehouse
                        </h1>
                    </div>
                    
                    <group invisible="state != 'draft'">
                        <group>
                            <field name="warehouse_ids" widget="many2many_tags" 
                                   options="{'no_create': True}"/>
                        </group>
                    </group>
                    
                    <group string="Mode" invisible="state != 'draft'">
                        <field name="dry_run"/>
                    </group>

                    <group string="Operations to Perform" invisible="state != 'draft'">
                        <field name="diagnose_value_residual"/>
                        <field name="recalculate_remaining"/>
                        <field name="fix_null_remaining"/>
                        <field name="fix_negative_remaining"/>
                        <field name="fix_excess_remaining"/>
                    </group>
                    
                    <notebook invisible="state != 'draft'">
                        <page string="ℹ️ Information">
                            <group>
                                <div style="padding: 10px; background: #f8d7da; border-left: 4px solid #dc3545; margin: 10px 0;">
                                    <h4 style="margin-top: 0; color: #721c24;">
                                        <i class="fa fa-warning"/> Read this before unticking Dry Run
                                    </h4>
                                    <p>
                                        This wizard writes directly to <b>stock_valuation_layer</b>. On this
                                        database that table is the <b>only</b> book of record for stock value —
                                        product categories are FIFO with manual periodic valuation, so no
                                        journal entry will ever contradict a bad write. There is no undo.
                                    </p>
                                    <p>
                                        Run it with <b>Dry Run</b> on first and read the before → after list.
                                        Take a database backup before applying anything on production.
                                    </p>
                                </div>

                                <div style="padding: 10px; background: #f0f8ff; border-left: 4px solid #2196F3; margin: 10px 0;">
                                    <h4 style="margin-top: 0; color: #1976D2;">
                                        <i class="fa fa-info-circle"/> What each operation does
                                    </h4>
                                    <ul>
                                        <li><b>Report Value Residual:</b> read-only. Lists product/warehouse pairs
                                            holding value with no quantity behind it, after allowing for
                                            landed-cost and revaluation layers, which leave value on purpose.</li>
                                        <li><b>Rebuild Remaining Qty/Value:</b> replays FIFO chronologically per
                                            product per warehouse and rewrites remaining_qty / remaining_value.
                                            Landed-cost layers are replayed at their own date, matching what the
                                            engine did originally.</li>
                                        <li><b>NULL Remaining Value:</b> outgoing layers should carry 0, not NULL.</li>
                                        <li><b>Negative / Excess Remaining:</b> narrow resets for layers whose
                                            remaining quantity is outside [0, quantity].</li>
                                    </ul>
                                </div>

                                <div style="padding: 10px; background: #fff3cd; border-left: 4px solid #ffc107; margin: 10px 0;">
                                    <h4 style="margin-top: 0; color: #ff9800;">
                                        <i class="fa fa-exclamation-triangle"/> Limits
                                    </h4>
                                    <ul>
                                        <li>Warehouses are required — they bound both the write transaction and
                                            the blast radius.</li>
                                        <li><b>origin_remaining_qty / origin_remaining_value are not rebuilt.</b>
                                            Replaying them needs to know, per move, whether it was an internal
                                            transfer or a real outgoing move.</li>
                                        <li>Where outgoing quantity exceeded everything ever received at a
                                            warehouse, the replay cannot invent the missing stock. Receive it
                                            first, then re-run.</li>
                                        <li>Value on outgoing layers is never rewritten. Forcing totals to zero
                                            fabricates COGS; residuals are reported instead.</li>
                                    </ul>
                                </div>
                            </group>
                        </page>
                    </notebook>
                    
                    <!-- Results Display -->
                    <div invisible="state != 'done'">
                        <field name="result_message" nolabel="1"/>
                    </div>
                    
                    <div invisible="state != 'processing'" style="text-align: center; padding: 50px;">
                        <h3>
                            <i class="fa fa-spinner fa-spin"/> Processing...
                        </h3>
                        <p>Please wait while recalculation is in progress.</p>
                    </div>
                    
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_stock_valuation_recalculate" model="ir.actions.act_window">
        <field name="name">Recalculate Valuation</field>
        <field name="res_model">stock.valuation.recalculate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <!-- Gate the action too, not just the menu: without this the wizard is
             still reachable by URL for anyone who knows the action id. -->
        <field name="groups_id" eval="[(6, 0, [ref('stock_fifo_by_location.group_stock_valuation_repair')])]"/>
    </record>
    
    <!-- Menu -->
    <menuitem id="menu_stock_valuation_recalculate"
              name="Recalculate Valuation"
              parent="stock.menu_warehouse_config"
              action="action_stock_valuation_recalculate"
              sequence="100"
              groups="stock_fifo_by_location.group_stock_valuation_repair"/>

    <!-- menuitem's groups= adds to groups_id rather than replacing it, so an
         upgrade from a version that pointed at stock.group_stock_manager would
         leave that group attached and keep the menu visible to all 19 of its
         members. Force the replacement. -->
    <record id="menu_stock_valuation_recalculate" model="ir.ui.menu">
        <field name="groups_id"
               eval="[(6, 0, [ref('stock_fifo_by_location.group_stock_valuation_repair')])]"/>
    </record>
    
</odoo>
