<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_fifo_recalculation_backup_tree" model="ir.ui.view">
            <field name="name">fifo.recalculation.backup.tree</field>
            <field name="model">fifo.recalculation.backup</field>
            <field name="arch" type="xml">
                <tree string="FIFO Repair Backups"
                      decoration-success="state=='active'"
                      decoration-muted="state=='restored'"
                      decoration-danger="state=='expired'">
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="warehouse_ids" widget="many2many_tags"/>
                    <field name="layer_count"/>
                    <field name="state"/>
                    <field name="restore_date"/>
                </tree>
            </field>
        </record>

        <record id="view_fifo_recalculation_backup_form" model="ir.ui.view">
            <field name="name">fifo.recalculation.backup.form</field>
            <field name="model">fifo.recalculation.backup</field>
            <field name="arch" type="xml">
                <form string="FIFO Repair Backup">
                    <header>
                        <button name="action_restore" string="Restore Backup" type="object"
                                class="btn-primary" invisible="state != 'active'"
                                confirm="Restore remaining_qty and remaining_value on these layers to their pre-repair values?"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <div class="alert alert-info" role="alert">
                            Restoring puts back <code>remaining_qty</code> and
                            <code>remaining_value</code> only — those are the only
                            columns the repair writes.
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="layer_count"/>
                            </group>
                            <group>
                                <field name="warehouse_ids" widget="many2many_tags"/>
                                <field name="restore_date" invisible="state != 'restored'"/>
                            </group>
                        </group>
                        <group invisible="not restore_log">
                            <field name="restore_log" nolabel="1"/>
                        </group>
                        <notebook>
                            <page string="Backed Up Layers">
                                <field name="line_ids" nolabel="1" readonly="1">
                                    <tree string="Backed Up Layers">
                                        <field name="layer_id"/>
                                        <field name="product_id"/>
                                        <field name="warehouse_id"/>
                                        <field name="quantity"/>
                                        <field name="unit_cost"/>
                                        <field name="value"/>
                                        <field name="remaining_qty"/>
                                        <field name="remaining_value"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_fifo_recalculation_backup" model="ir.actions.act_window">
            <field name="name">FIFO Repair Backups</field>
            <field name="res_model">fifo.recalculation.backup</field>
            <field name="view_mode">tree,form</field>
            <field name="groups_id" eval="[(6, 0, [ref('stock_fifo_by_warehouse_recal.group_fifo_recalculation')])]"/>
        </record>

        <record id="view_fifo_recalculation_config_tree" model="ir.ui.view">
            <field name="name">fifo.recalculation.config.tree</field>
            <field name="model">fifo.recalculation.config</field>
            <field name="arch" type="xml">
                <tree string="Scheduled FIFO Checks" decoration-bf="is_default==True">
                    <field name="name"/>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="is_default"/>
                    <field name="warehouse_ids" widget="many2many_tags"/>
                    <field name="active"/>
                </tree>
            </field>
        </record>

        <record id="view_fifo_recalculation_config_form" model="ir.ui.view">
            <field name="name">fifo.recalculation.config.form</field>
            <field name="model">fifo.recalculation.config</field>
            <field name="arch" type="xml">
                <form string="Scheduled FIFO Check">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_fifo_recalculation_wizard)d"
                                    type="action"
                                    class="oe_stat_button"
                                    icon="fa-calculator"
                                    string="Run Now"
                                    context="{'default_warehouse_ids': warehouse_ids, 'default_product_ids': product_ids, 'default_product_categ_ids': product_categ_ids}"/>
                        </div>
                        <widget name="web_ribbon" title="Default" bg_color="bg-info" invisible="not is_default"/>
                        <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                        <div class="oe_title">
                            <label for="name"/>
                            <h1>
                                <field name="name" placeholder="e.g. Monthly FIFO Check"/>
                            </h1>
                        </div>
                        <div class="alert alert-info" role="alert">
                            The scheduled run only reports. It replays the FIFO queue,
                            emails the differences to the users below, and writes nothing.
                        </div>
                        <group>
                            <group string="Basic Settings">
                                <field name="active" widget="boolean_toggle"/>
                                <field name="is_default" widget="boolean_toggle"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group string="Notifications">
                                <field name="notification_user_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                        <group string="Scope">
                            <group>
                                <field name="warehouse_ids" widget="many2many_tags"/>
                                <field name="product_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="product_categ_ids" widget="many2many_tags"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_fifo_recalculation_config" model="ir.actions.act_window">
            <field name="name">Scheduled FIFO Check</field>
            <field name="res_model">fifo.recalculation.config</field>
            <field name="view_mode">tree,form</field>
            <field name="groups_id" eval="[(6, 0, [ref('stock_fifo_by_warehouse_recal.group_fifo_recalculation')])]"/>
        </record>

        <menuitem id="menu_fifo_recalculation_backup"
                  name="FIFO Repair Backups"
                  parent="stock.menu_stock_warehouse_mgmt"
                  action="action_fifo_recalculation_backup"
                  sequence="101"/>

        <menuitem id="menu_fifo_recalculation_config"
                  name="Scheduled FIFO Check"
                  parent="stock.menu_stock_warehouse_mgmt"
                  action="action_fifo_recalculation_config"
                  sequence="102"/>

        <!-- See the note in fifo_recalculation_wizard_views.xml: `groups` on a
             menuitem adds, it does not replace. -->
        <record id="menu_fifo_recalculation_backup" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('stock_fifo_by_warehouse_recal.group_fifo_recalculation')])]"/>
        </record>
        <record id="menu_fifo_recalculation_config" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('stock_fifo_by_warehouse_recal.group_fifo_recalculation')])]"/>
        </record>

    </data>
</odoo>
