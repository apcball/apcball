<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_fifo_recalculation_wizard_form" model="ir.ui.view">
            <field name="name">fifo.recalculation.wizard.form</field>
            <field name="model">fifo.recalculation.wizard</field>
            <field name="arch" type="xml">
                <form string="Repair FIFO Queue by Warehouse">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,preview,done"/>
                    </header>
                    <sheet>
                        <field name="can_rollback" invisible="1"/>
                        <field name="can_apply" invisible="1"/>
                        <field name="backup_id" invisible="1"/>

                        <div class="alert alert-info" role="alert">
                            <b>This tool corrects the FIFO queue in place.</b>
                            It replays the FIFO engine over the valuation layers that
                            already exist and rewrites only <code>remaining_qty</code> and
                            <code>remaining_value</code> where they disagree with the replay.
                            <br/>
                            No layer is deleted or created, and <code>value</code> — the
                            amount that reaches the P&amp;L — is compared and reported but
                            never written.
                        </div>

                        <div class="alert alert-danger" role="alert" invisible="not block_reason">
                            <field name="block_reason" nolabel="1" readonly="1"/>
                        </div>

                        <div class="alert alert-success" role="alert" invisible="state != 'done'">
                            <b>Applied.</b> Corrected
                            <field name="layers_changed" nolabel="1" readonly="1" class="oe_inline"/>
                            layers. Use Rollback to put them back exactly as they were.
                        </div>

                        <group>
                            <group string="Scope">
                                <field name="company_id" options="{'no_create': True}"/>
                                <field name="warehouse_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                <field name="product_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                                <field name="product_categ_ids" widget="many2many_tags" options="{'no_create': True}"
                                       invisible="product_ids != []"/>
                            </group>
                            <group string="Safety">
                                <field name="dry_run"/>
                                <field name="include_reordered"/>
                                <field name="max_mismatch_percent"/>
                            </group>
                        </group>

                        <group string="Result" invisible="state == 'draft'">
                            <group>
                                <field name="layers_scanned"/>
                                <field name="layers_changed"/>
                                <field name="pairs_blocked"/>
                            </group>
                            <group>
                                <field name="value_delta"/>
                                <field name="cogs_mismatch_count"/>
                                <field name="cogs_mismatch_value"/>
                            </group>
                        </group>

                        <notebook invisible="state == 'draft'">
                            <page string="Preview" name="preview">
                                <field name="line_ids" nolabel="1" readonly="1">
                                    <tree string="Preview Lines"
                                          decoration-muted="skip_reason != False"
                                          decoration-warning="shortage_qty &gt; 0"
                                          decoration-danger="cogs_mismatch_count &gt; 0">
                                        <field name="product_id"/>
                                        <field name="warehouse_id"/>
                                        <field name="layer_change_count" sum="Layers"/>
                                        <field name="qty_before"/>
                                        <field name="qty_after"/>
                                        <field name="diff_qty" sum="Qty Diff"/>
                                        <field name="value_before"/>
                                        <field name="value_after"/>
                                        <field name="diff_value" sum="Value Diff"/>
                                        <field name="shortage_qty" optional="show"/>
                                        <field name="reordered_layers" optional="show"/>
                                        <field name="cogs_mismatch_count" optional="show"/>
                                        <field name="cogs_mismatch_value" optional="show" sum="Mismatch"/>
                                        <field name="skip_reason"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Log" name="log">
                                <field name="log_text" nolabel="1" widget="text"/>
                            </page>
                        </notebook>
                    </sheet>

                    <footer>
                        <button name="action_preview" string="Preview" type="object"
                                class="btn-primary" invisible="state == 'done'"/>
                        <button name="action_export_excel" string="Export to Excel" type="object"
                                class="btn-secondary" invisible="state == 'draft'"/>
                        <button name="action_apply" string="Apply Correction" type="object"
                                class="btn-danger" invisible="not can_apply or dry_run"
                                confirm="This writes remaining_qty and remaining_value on the layers listed in the preview. A backup is taken first and Rollback restores it exactly. Continue?"/>
                        <button name="action_rollback" string="Rollback" type="object"
                                class="btn-warning" invisible="not can_rollback"
                                confirm="Restore remaining_qty and remaining_value to their pre-repair values?"/>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_fifo_recalculation_wizard" model="ir.actions.act_window">
            <field name="name">Repair FIFO Queue</field>
            <field name="res_model">fifo.recalculation.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_fifo_recalculation_wizard_form"/>
            <!-- Gate the action itself, not only the menu: an action reachable
                 by URL is reachable by anyone who has the URL. -->
            <field name="groups_id" eval="[(6, 0, [ref('stock_fifo_by_warehouse_recal.group_fifo_recalculation')])]"/>
        </record>

        <menuitem id="menu_fifo_recalculation_wizard"
                  name="Repair FIFO Queue"
                  parent="stock.menu_stock_warehouse_mgmt"
                  action="action_fifo_recalculation_wizard"
                  sequence="100"/>

        <!-- `groups` on <menuitem> ADDS to groups_id on upgrade rather than
             replacing it, so a group removed from the menuitem stays granted.
             An explicit record with (6, 0, [...]) is the only way to make the
             set authoritative. -->
        <record id="menu_fifo_recalculation_wizard" model="ir.ui.menu">
            <field name="groups_id" eval="[(6, 0, [ref('stock_fifo_by_warehouse_recal.group_fifo_recalculation')])]"/>
        </record>

    </data>
</odoo>
